    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
    sh:message "A TriggerTier must have exactly one tierThreshold."@en
  ] ;

  sh:property [
    sh:path ctr:tierPayoutPercentage ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
    sh:minInclusive "0.0"^^xsd:decimal ;
    sh:maxInclusive "1.0"^^xsd:decimal ;
    sh:message "tierPayoutPercentage must be in [0.0, 1.0]."@en
  ] ;

  sh:property [
    sh:path ctr:tierPayoutCap ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal
  ] ;

  sh:property [
    sh:path ctr:tierSequence ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:message "A TriggerTier must have exactly one tierSequence."@en
  ] .

#-----------------------------------------------------------------------
# 5.16  PremiumFacetShape  [REMEDIATION: CSO-015]
#-----------------------------------------------------------------------

ctr:PremiumFacetShape
  a sh:NodeShape ;
  sh:targetClass ctr:PremiumFacet ;
  sh:name "PremiumFacetShape"@en ;

  sh:property [
    sh:path ctr:premiumBasis ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class skos:Concept ;
    sh:message "A PremiumFacet must have exactly one premiumBasis."@en
  ] ;

  sh:property [
    sh:path ctr:premiumAmount ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal
  ] ;

  sh:property [
    sh:path ctr:premiumCurrency ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 3 ;
    sh:maxLength 3
  ] ;

  sh:property [
    sh:path ctr:premiumRate ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal
  ] ;

  sh:property [
    sh:path ctr:minimumPremium ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal
  ] ;

  sh:property [
    sh:path ctr:depositPremium ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal
  ] .

