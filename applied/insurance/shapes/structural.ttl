    sh:maxInclusive "1.0"^^xsd:decimal ;
    sh:message "participantShare must be a decimal in [0.0, 1.0]."@en
  ] ;

  sh:property [
    sh:path ctr:payoutBasis ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class skos:Concept ;
    sh:message "A PoolParticipationFacet must have exactly one payoutBasis."@en
  ] ;

  sh:property [
    sh:path ctr:participantPayoutCap ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal
  ] .

