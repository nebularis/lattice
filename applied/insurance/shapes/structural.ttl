#-----------------------------------------------------------------------
# 5.24  CoveredPerilsDerivationShape  [REMEDIATION: CSO-020]
#-----------------------------------------------------------------------

ctr:CoveredPerilsDerivationShape
  a sh:NodeShape ;
  sh:targetClass ctr:Contract ;
  sh:name "CoveredPerilsDerivationShape"@en ;
  sh:rule [
    a sh:SPARQLRule ;
    sh:prefixes [
      sh:declare [ sh:prefix "ctr" ; sh:namespace "https://www.nebularis.org/neuro-semantic/insurance/contract#" ] ;
      sh:declare [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#" ]
    ] ;
    sh:construct """
      CONSTRUCT {
        ?this ctr:effectivePerilScope ?peril .
      }
      WHERE {
        ?this ctr:hasRootElement ?root .
        ?root (ctr:hasChild)* ?el .
        ?el ctr:hasTermApplication ?ta .
        ?ta ctr:functionType ?ft ;
            ctr:hasPerilScope ?peril .
        ?ft skos:notation "CoverageGrant" .
        FILTER NOT EXISTS {
          ?root (ctr:hasChild)* ?exEl .
          ?exEl ctr:hasTermApplication ?exTa .
          ?exTa ctr:functionType ?exFt ;
                ctr:hasPerilScope ?peril .
          ?exFt skos:notation "Exclusion" .
        }
      }
    """
  ] .

#-----------------------------------------------------------------------
# 5.25  Scheme Membership for Concept-Valued Scope Properties  [3.4.0]
#-----------------------------------------------------------------------

ctr:PerilScopeConceptShape
  a sh:NodeShape ;
  sh:property [ sh:path skos:inScheme ; sh:hasValue apex-voc:PerilScheme ; sh:minCount 1 ;
                sh:message "Peril scope values must be concepts in apex-voc:PerilScheme."@en ] .

ctr:TerritoryScopeConceptShape
  a sh:NodeShape ;
  sh:property [ sh:path skos:inScheme ; sh:hasValue apex-voc:TerritoryScheme ; sh:minCount 1 ;
                sh:message "Territory scope values must be concepts in apex-voc:TerritoryScheme."@en ] .

ctr:ActorScopeConceptShape
  a sh:NodeShape ;
  sh:property [ sh:path skos:inScheme ; sh:hasValue core:ActorScheme ; sh:minCount 1 ;
                sh:message "Actor scope values should come from core:ActorScheme."@en ] .

ctr:PartyRoleTypeConceptShape
  a sh:NodeShape ;
  sh:property [ sh:path skos:inScheme ; sh:hasValue ctr-voc:PartyRoleTypeScheme ; sh:minCount 1 ] .

ctr:CoverageTypeScopeConceptShape
  a sh:NodeShape ;
  sh:property [ sh:path skos:inScheme ; sh:minCount 1 ;
                sh:or (
                  [ sh:hasValue ctr-voc:CoverageTypeScheme ]
                  [ sh:node ctr:CoverageTypeImplementationSchemeShape ]
                ) ;
                sh:message "Coverage type scope values must come from the legacy CSO scheme or from an implementation scheme declaring gov:satisfiesSchemeConstraint gov:CoverageTypeSchemeContract."@en ] .

ctr:LineOfBusinessScopeConceptShape
  a sh:NodeShape ;
  sh:property [ sh:path skos:inScheme ; sh:minCount 1 ;
                sh:or (
                  [ sh:hasValue ctr-voc:LineOfBusinessScheme ]
                  [ sh:node ctr:LineOfBusinessImplementationSchemeShape ]
                ) ;
                sh:message "Line-of-business scope values must come from the legacy CSO scheme or from an implementation scheme declaring gov:satisfiesSchemeConstraint gov:LineOfBusinessSchemeContract."@en ] .

ctr:AssetClassScopeConceptShape
  a sh:NodeShape ;
  sh:property [ sh:path skos:inScheme ; sh:minCount 1 ;
                sh:or (
                  [ sh:hasValue ctr-voc:AssetClassScheme ]
                  [ sh:node ctr:AssetClassImplementationSchemeShape ]
                ) ;
                sh:message "Asset-class scope values must come from the legacy CSO scheme or from an implementation scheme declaring gov:satisfiesSchemeConstraint gov:AssetClassSchemeContract."@en ] .

ctr:CoverageTypeImplementationSchemeShape
  a sh:NodeShape ;
  sh:property [ sh:path rdf:type ; sh:hasValue gov:ImplementationReferenceScheme ; sh:minCount 1 ] ;
  sh:property [ sh:path gov:satisfiesSchemeConstraint ; sh:hasValue gov:CoverageTypeSchemeContract ; sh:minCount 1 ] .

ctr:LineOfBusinessImplementationSchemeShape
  a sh:NodeShape ;
  sh:property [ sh:path rdf:type ; sh:hasValue gov:ImplementationReferenceScheme ; sh:minCount 1 ] ;
  sh:property [ sh:path gov:satisfiesSchemeConstraint ; sh:hasValue gov:LineOfBusinessSchemeContract ; sh:minCount 1 ] .

ctr:AssetClassImplementationSchemeShape
  a sh:NodeShape ;
  sh:property [ sh:path rdf:type ; sh:hasValue gov:ImplementationReferenceScheme ; sh:minCount 1 ] ;
  sh:property [ sh:path gov:satisfiesSchemeConstraint ; sh:hasValue gov:AssetClassSchemeContract ; sh:minCount 1 ] .

ctr:QuestionSubjectConceptShape
  a sh:NodeShape ;
  sh:property [ sh:path skos:inScheme ; sh:hasValue ctr-voc:QuestionSubjectScheme ; sh:minCount 1 ] .

ctr:QuestionScopeConceptShape
  a sh:NodeShape ;
  sh:property [ sh:path skos:inScheme ; sh:hasValue ctr-voc:QuestionScopeScheme ; sh:minCount 1 ] .

ctr:TermApplicationSchemeMembershipShape
  a sh:NodeShape ;
  sh:targetClass ctr:TermApplication ;
  sh:property [ sh:path ctr:hasPerilScope ; sh:node ctr:PerilScopeConceptShape ] ;
  sh:property [ sh:path ctr:hasTerritoryScope ; sh:node ctr:TerritoryScopeConceptShape ] ;
  sh:property [ sh:path ctr:hasActorScope ; sh:node ctr:ActorScopeConceptShape ;
                sh:severity sh:Warning ;
                sh:message "Actor scope currently points to core:ActorScheme, which has sparse concept population. Treat out-of-scheme actor values as migration debt."@en ] ;
  sh:property [ sh:path ctr:claimantRole ; sh:node ctr:PartyRoleTypeConceptShape ] ;
  sh:property [ sh:path ctr:indemnityPayeeRole ; sh:node ctr:PartyRoleTypeConceptShape ] ;
  sh:property [ sh:path ctr:hasCoverageTypeScope ; sh:node ctr:CoverageTypeScopeConceptShape ] ;
  sh:property [ sh:path ctr:hasLineOfBusinessScope ; sh:node ctr:LineOfBusinessScopeConceptShape ] ;
  sh:property [ sh:path ctr:hasAssetClassScope ; sh:node ctr:AssetClassScopeConceptShape ] .

ctr:ContractPerilSchemeMembershipShape
  a sh:NodeShape ;
  sh:targetClass ctr:Contract ;
  sh:property [ sh:path ctr:effectivePerilScope ; sh:node ctr:PerilScopeConceptShape ] .

ctr:QuestionSchemeMembershipShape
  a sh:NodeShape ;
  sh:targetClass ctr:Question ;
  sh:property [ sh:path ctr:hasSubject ; sh:node ctr:QuestionSubjectConceptShape ] ;
  sh:property [ sh:path ctr:hasScope ; sh:node ctr:QuestionScopeConceptShape ] .
