    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:message "A Submission must have a content hash."@en
  ] ;

  sh:property [
    sh:path ctr:submissionStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class skos:Concept ;
    sh:message "A Submission must have exactly one submissionStatus."@en
  ] ;

  sh:property [
    sh:path ctr:hasSubmissionDocument ;
    sh:maxCount 1 ;
    sh:message "A Submission may reference one submission document artifact."@en
  ] ;

  sh:property [
