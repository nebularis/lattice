    sh:maxCount 1 ;
    sh:datatype xsd:dateTime
  ] ;

  sh:property [
    sh:path ctr:hasTargetPremiumRange ;
    sh:maxCount 2 ;
    sh:class ctr:MonetaryExtent ;
    sh:message "hasTargetPremiumRange supports at most 2 MonetaryExtent instances (low and high bounds)."@en
  ] .

