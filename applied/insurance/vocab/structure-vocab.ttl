# 6. SKOS CONTROLLED VOCABULARIES
###############################################################################

#-----------------------------------------------------------------------
# PayoutStructureScheme  [TODO: indexing]
#-----------------------------------------------------------------------

ctr-voc:PayoutStructureScheme
  a skos:ConceptScheme ;
  skos:prefLabel "Trigger Payout Structure Vocabulary"@en ;
  dct:isPartOf <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr-voc:BinaryPayout
  a skos:Concept ;
  skos:inScheme ctr-voc:PayoutStructureScheme ;
  skos:notation "Binary" ;
  skos:prefLabel "Binary"@en ;
  skos:definition """Full limit is paid if the trigger index meets or exceeds
ctr:triggerThreshold; zero is paid otherwise. No TriggerTier instances required.
Projects to FBO step-function TriggerGate."""@en .

ctr-voc:LinearPayout
  a skos:Concept ;
  skos:inScheme ctr-voc:PayoutStructureScheme ;
  skos:notation "Linear" ;
  skos:prefLabel "Linear"@en ;
  skos:definition """Payout scales linearly between ctr:linearFloorThreshold (0%
payout) and ctr:linearCeilingThreshold (100% payout). Common in weather
derivatives, agricultural parametric products, and some ILS structures.
ctr:triggerThreshold is not used when payoutStructure = Linear (floor/ceiling
replace it). Projects to FBO linear interpolation FlowAction."""@en .

ctr-voc:GraduatedPayout
  a skos:Concept ;
  skos:inScheme ctr-voc:PayoutStructureScheme ;
  skos:notation "Graduated" ;
  skos:prefLabel "Graduated"@en ;
  skos:definition """Payout follows a discrete step table defined by one or more
TriggerTier instances. Each tier specifies a threshold and a payoutPercentage.
At least one TriggerTier must be present. Projects to FBO lookup-table payout
using the tier sequence."""@en .

