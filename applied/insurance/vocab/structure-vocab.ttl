#-----------------------------------------------------------------------
# 6.7b  LiabilityDirection Scheme  [LIABILITY DIMENSION]
#
# Duplicate resolved in 3.3.2. core:LiabilityDirectionScheme in nsd-core carries the same
# prefLabel and the same two notations, and nsd-tower ranges its liability-direction property
# against it. The duplication was invisible until 3.3.1, because nsd-core declared a relative
# ontology IRI and CSO's owl:imports of it resolved to nothing.
#
# Neither copy is retired. core: sits below CSO in the import graph and is used by the tower
# stratum; CSO cannot be its source without inverting the dependency. The two are instead
# reconciled by skos:exactMatch, so a consumer holding either concept can resolve the other,
# and the notations are held identical as the machine join key.
#
# ctr-voc:MixedDirection is a genuine extension with no core counterpart. It is asserted here
# rather than pushed down because a mixed direction is a contract-drafting artefact: it arises
# when one term covers both first- and third-party harm, which is a structural fact about the
# wording, not a shared foundational category.
#-----------------------------------------------------------------------

ctr-voc:LiabilityDirectionScheme
  a skos:ConceptScheme ;
  skos:prefLabel "Liability Direction Vocabulary"@en ;
  rdfs:comment """Aligned to core:LiabilityDirectionScheme (nsd-core). Concept-level exactMatch
links are asserted below. Where a consumer spans both the contract and tower strata it should
join on skos:notation, which is identical across the two schemes."""@en ;
  dct:isPartOf <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr-voc:FirstPartyDirection
  a skos:Concept ; skos:inScheme ctr-voc:LiabilityDirectionScheme ;
  skos:notation "FIRST_PARTY" ; skos:prefLabel "First Party"@en ;
  skos:exactMatch core:Liability_FirstParty .

ctr-voc:ThirdPartyDirection
  a skos:Concept ; skos:inScheme ctr-voc:LiabilityDirectionScheme ;
  skos:notation "THIRD_PARTY" ; skos:prefLabel "Third Party"@en ;
  skos:exactMatch core:Liability_ThirdParty .

ctr-voc:MixedDirection
  a skos:Concept ; skos:inScheme ctr-voc:LiabilityDirectionScheme ;
  skos:notation "MIXED" ; skos:prefLabel "Mixed"@en ;
  rdfs:comment """No core: counterpart. A consumer resolving this concept against
core:LiabilityDirectionScheme will find nothing, and must treat the term as covering both
directions rather than as unmapped."""@en .

