#-----------------------------------------------------------------------
# 6.3  FlowType Scheme  [REMEDIATION: CSO-006, CSO-017]
#-----------------------------------------------------------------------

ctr-voc:FlowTypeScheme
  a skos:ConceptScheme ;
  skos:prefLabel "Flow Directive Type Vocabulary"@en ;
  dct:isPartOf <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr-voc:Erosion
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "Erosion" ; skos:prefLabel "Erosion"@en ;
  skos:definition "A sub-limit, defense cost, or other charge erodes a parent limit. Projects to FBO Erosion (→^e)."@en .

ctr-voc:Aggregation
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "Aggregation" ; skos:prefLabel "Aggregation"@en ;
  skos:definition "Losses accumulate within a window before the covered element responds. Projects to FBO Aggregation (→^a)."@en .

ctr-voc:Override
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "Override" ; skos:prefLabel "Override"@en ;
  skos:definition "A specific term supersedes a general term. Structural only — no FBO FlowAction."@en .

ctr-voc:ScopeExpansion
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "ScopeExpansion" ; skos:prefLabel "Scope Expansion"@en ;
  skos:definition "A write-back restores coverage previously excluded. Structural only — modifies scope graph."@en .

ctr-voc:ScopeNarrowing
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "ScopeNarrowing" ; skos:prefLabel "Scope Narrowing"@en ;
  skos:definition "A sub-limit or condition further restricts a parent coverage grant. Projects to FBO Limitation (→^l)."@en .

ctr-voc:FollowForm
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "FollowForm" ; skos:prefLabel "Follow Form"@en ;
  skos:definition "A following insurer's terms are derived from a lead insurer's terms. Structural only — evaluation delegation."@en .

ctr-voc:DropDown
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "DropDown" ; skos:prefLabel "Drop Down"@en ;
  skos:definition "An excess layer responds at a lower attachment when an underlying aggregate is exhausted. Projects to FBO Attachment (→^t) with modified gate condition."@en .

ctr-voc:AttachmentGate
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "AttachmentGate" ; skos:prefLabel "Attachment Gate"@en ;
  skos:definition "A coverage grant activates only when a specified condition is satisfied. Projects to FBO Attachment (→^t)."@en .

ctr-voc:Contribution
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "Contribution" ; skos:prefLabel "Contribution"@en ;
  skos:definition "Multiple policies share a loss. Projects to FBO PoolDistribute (→^pd) or custom."@en .

ctr-voc:DefenseErosion
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "DefenseErosion" ; skos:prefLabel "Defense Erosion"@en ;
  skos:broader ctr-voc:Erosion ;
  skos:definition "Defense costs erode the occurrence or aggregate limit. Specialisation of Erosion. Projects to FBO Erosion (→^e) with defense-specific configuration."@en .

ctr-voc:CutThrough
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "CutThrough" ; skos:prefLabel "Cut Through"@en ;
  skos:definition "A reinsurer pays the insured directly, bypassing the cedent. Projects to custom flow in FBO."@en .

ctr-voc:QuotaShareCession
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "QuotaShareCession" ; skos:prefLabel "Quota Share Cession"@en ;
  skos:definition "Premium and losses flow proportionally from cedent to reinsurer panel. Projects to proportion scaling in FBO evaluation."@en .

ctr-voc:Reinstatement
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "Reinstatement" ; skos:prefLabel "Reinstatement"@en ;
  skos:definition "After a paid loss, the layer limit is reinstated subject to reinstatement premium. Projects to FBO reinstatement state machine."@en .

ctr-voc:AnnualAggregateDeductible
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "AnnualAggregateDeductible" ; skos:prefLabel "Annual Aggregate Deductible"@en ;
  skos:definition "Retentions accumulate across events before cover responds. Projects to FBO Aggregation (→^a) with threshold gate."@en .

ctr-voc:CollateralDraw
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "CollateralDraw" ; skos:prefLabel "Collateral Draw"@en ;
  skos:definition "A collateralised vehicle pays via trust draw. Target references rcv:CollateralFacility by cross-domain IRI. Projects to FBO CollateralDraw (→^cd)."@en .

ctr-voc:ParametricTrigger
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "ParametricTrigger" ; skos:prefLabel "Parametric Trigger"@en ;
  skos:definition "A parametric payout is initiated when an oracle confirms an index threshold. Projects to FBO TriggerGate (→^tg) and/or GraduatedPayout (→^gp)."@en .

ctr-voc:LossCorridorRetention
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "LossCorridorRetention" ; skos:prefLabel "Loss Corridor Retention"@en ;
  skos:definition "Cedent retains a band of losses between a low and high threshold. Projects to custom corridor flow in FBO."@en .

ctr-voc:PrimacyOrdering
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "PrimacyOrdering" ; skos:prefLabel "Primacy Ordering"@en ;
  skos:definition "An external programme (e.g., NFIP) responds before this contract. Projects to FBO Attachment (→^t) with primacy configuration."@en .

ctr-voc:FollowFortunes
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "FollowFortunes" ; skos:prefLabel "Follow Fortunes"@en ;
  skos:definition "Reinsurer is bound by cedent's good-faith settlements within treaty scope. Structural only — governance constraint."@en .

ctr-voc:SignalActivation
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "SignalActivation" ; skos:prefLabel "Signal Activation"@en ;
  skos:definition "A signal condition enables or disables a downstream flow. Projects to FBO SignalActivate (→^sa) or SignalDeactivate (→^sd)."@en .

ctr-voc:PoolDistribution
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "PoolDistribution" ; skos:prefLabel "Pool Distribution"@en ;
  skos:definition "A pool allocates payouts across participants. Projects to FBO PoolDistribute (→^pd)."@en .

ctr-voc:CoinsurancePenalty
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "CoinsurancePenalty" ; skos:prefLabel "Coinsurance Penalty"@en ;
  skos:definition "Applies proportional under-insurance penalty semantics based on coinsurancePercentage declared on RetentionFacet."@en .

# New concepts added per REMEDIATION CSO-006 and CSO-017
ctr-voc:SignalGate
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "SignalGate" ; skos:prefLabel "Signal Gate"@en ;
  skos:definition "Activates or deactivates coverage based on a signal stream state (targets a coverage grant, distinct from SignalActivation which targets a flow). Projects to FBO SignalGate (→^sg)."@en .

ctr-voc:TriggerGate
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "TriggerGate" ; skos:prefLabel "Trigger Gate"@en ;
  skos:definition "Gates coverage activation on trigger expression evaluation (standalone flow type for clarity in composite structures). Projects to FBO TriggerGate (→^tg)."@en .

ctr-voc:SubrogationRecovery
  a skos:Concept ; skos:inScheme ctr-voc:FlowTypeScheme ;
  skos:notation "SubrogationRecovery" ; skos:prefLabel "Subrogation Recovery"@en ;
  skos:definition "Models recovery flows from liable third parties back to the coverage structure. Projects to FBO SubrogationRecovery."@en .

