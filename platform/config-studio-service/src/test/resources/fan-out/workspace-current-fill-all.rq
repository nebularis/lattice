INSERT {
  GRAPH $derived {
    ?c <https://www.nebularis.org/neuro-semantic/lattice/config-studio/promotion#workspaceCurrent> ?v
  }
}
WHERE {
  { FILTER(ISIRI($source) && ISIRI($derived)) }
  {
    SELECT ?k
    WHERE {
      { BIND(<https://www.nebularis.org/neuro-semantic/lattice/config-studio#Workspace> AS ?k) } UNION {
        GRAPH ?mg1 {
          ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://www.nebularis.org/neuro-semantic/lattice/config-studio#Workspace>
        }
      } UNION {
        GRAPH ?mg1 {
          ?m1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://www.nebularis.org/neuro-semantic/lattice/config-studio#Workspace>
        }
        GRAPH ?mg2 {
          ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m1
        }
      } UNION {
        GRAPH ?mg1 {
          ?m2 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://www.nebularis.org/neuro-semantic/lattice/config-studio#Workspace>
        }
        GRAPH ?mg2 {
          ?m1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m2
        }
        GRAPH ?mg3 {
          ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m1
        }
      }
    }
  }
  GRAPH $source { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?k }
  GRAPH ?g1 {
    ?c <https://www.nebularis.org/neuro-semantic/lattice/config-studio#dependsOn> ?x1
  }
  GRAPH ?g2 {
    ?x1 <https://www.nebularis.org/neuro-semantic/lattice/config-studio#current> ?v
  }
}
