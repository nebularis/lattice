SELECT DISTINCT ?src
WHERE {
  {
    {
      SELECT ?k
      WHERE {
        { BIND(<https://example.org/lending#Drawdown> AS ?k) } UNION {
          GRAPH ?mg1 {
            ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://example.org/lending#Drawdown>
          }
        } UNION {
          GRAPH ?mg1 {
            ?m1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://example.org/lending#Drawdown>
          }
          GRAPH ?mg2 {
            ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m1
          }
        } UNION {
          GRAPH ?mg1 {
            ?m2 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://example.org/lending#Drawdown>
          }
          GRAPH ?mg2 {
            ?m1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m2
          }
          GRAPH ?mg3 {
            ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m1
          }
        }
      }
    }
    VALUES (?s ?p ?o) { {{{delta}}} }
    FILTER(sameTerm(?p, <https://example.org/lending#drawnUnder>))
    BIND(?s AS ?c)
    GRAPH ?src { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?k }
  } UNION {
    {
      SELECT ?k
      WHERE {
        { BIND(<https://example.org/lending#Drawdown> AS ?k) } UNION {
          GRAPH ?mg1 {
            ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://example.org/lending#Drawdown>
          }
        } UNION {
          GRAPH ?mg1 {
            ?m1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://example.org/lending#Drawdown>
          }
          GRAPH ?mg2 {
            ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m1
          }
        } UNION {
          GRAPH ?mg1 {
            ?m2 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://example.org/lending#Drawdown>
          }
          GRAPH ?mg2 {
            ?m1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m2
          }
          GRAPH ?mg3 {
            ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m1
          }
        }
      }
    }
    VALUES (?s ?p ?o) { {{{delta}}} }
    FILTER(sameTerm(?p, <https://example.org/lending#borrower>))
    GRAPH ?h1 { ?c <https://example.org/lending#drawnUnder> ?s }
    GRAPH ?src { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?k }
  } UNION {
    {
      SELECT ?k
      WHERE {
        { BIND(<https://example.org/lending#Drawdown> AS ?k) } UNION {
          GRAPH ?mg1 {
            ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://example.org/lending#Drawdown>
          }
        } UNION {
          GRAPH ?mg1 {
            ?m1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://example.org/lending#Drawdown>
          }
          GRAPH ?mg2 {
            ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m1
          }
        } UNION {
          GRAPH ?mg1 {
            ?m2 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* <https://example.org/lending#Drawdown>
          }
          GRAPH ?mg2 {
            ?m1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m2
          }
          GRAPH ?mg3 {
            ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?m1
          }
        }
      }
    }
    VALUES (?s ?p ?o) { {{{delta}}} }
    FILTER(sameTerm(?p, <https://example.org/lending#borrowerSector>))
    GRAPH ?h2 { ?r1 <https://example.org/lending#borrower> ?s }
    GRAPH ?h1 { ?c <https://example.org/lending#drawnUnder> ?r1 }
    GRAPH ?src { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?k }
  } UNION {
    VALUES (?s ?p ?o) { {{{delta}}} }
    FILTER(sameTerm(?p, <http://www.w3.org/2000/01/rdf-schema#subClassOf>))
    FILTER(ISIRI(?s))
    BIND(?s AS ?k)
    GRAPH ?src { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?k }
  } UNION {
    VALUES (?s ?p ?o) { {{{delta}}} }
    FILTER(sameTerm(?p, <http://www.w3.org/2000/01/rdf-schema#subClassOf>))
    FILTER(ISIRI(?s))
    GRAPH ?ug1 {
      ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?s
    }
    GRAPH ?src { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?k }
  } UNION {
    VALUES (?s ?p ?o) { {{{delta}}} }
    FILTER(sameTerm(?p, <http://www.w3.org/2000/01/rdf-schema#subClassOf>))
    FILTER(ISIRI(?s))
    GRAPH ?ug1 {
      ?u1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?s
    }
    GRAPH ?ug2 {
      ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?u1
    }
    GRAPH ?src { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?k }
  } UNION {
    VALUES (?s ?p ?o) { {{{delta}}} }
    FILTER(sameTerm(?p, <http://www.w3.org/2000/01/rdf-schema#subClassOf>))
    FILTER(ISIRI(?s))
    GRAPH ?ug1 {
      ?u2 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?s
    }
    GRAPH ?ug2 {
      ?u1 <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?u2
    }
    GRAPH ?ug3 {
      ?k <http://www.w3.org/2000/01/rdf-schema#subClassOf>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>)* ?u1
    }
    GRAPH ?src { ?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?k }
  }
}
