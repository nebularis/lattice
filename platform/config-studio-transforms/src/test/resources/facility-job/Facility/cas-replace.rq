PREFIX pat: <https://www.nebularis.org/neuro-semantic/lattice/persistence-store#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DELETE {
  GRAPH <urn:g:facilities> { {{{retractTriples}}} }
  GRAPH <urn:g:meta/6> {
    $root pat:epoch ?rowEpoch ; pat:seq $expectedSeq ; pat:head ?prevRev
  }
}
INSERT {
  GRAPH <urn:g:facilities> { {{{assertTriples}}} }
  GRAPH ?addGraph { {{{assertTriples}}} }
  GRAPH ?delGraph { {{{retractTriples}}} }
  GRAPH <urn:g:meta/6> { $root pat:epoch $epoch ; pat:seq $nextSeq ; pat:head $newRev }
  GRAPH <urn:g:txn> { $txnId pat:rev $newRev ; pat:requestDigest $requestDigest }
  GRAPH ?logGraph2 {
    $newRev a pat:Revision ; pat:target $root ; pat:epoch $epoch ; pat:seq $nextSeq ; pat:prevRev ?prevRev ; pat:txn ?txnKey ; pat:recordedAt ?now ; pat:asserts ?addGraph ; pat:retracts ?delGraph
  }
}
WHERE {
  {
    FILTER(ISIRI($root) && DATATYPE($epoch) = DATATYPE("0"^^xsd:long) && DATATYPE($expectedSeq) = DATATYPE("0"^^xsd:long) && DATATYPE($nextSeq) = DATATYPE("0"^^xsd:long) && ISIRI($newRev) && ISIRI($txnId) && DATATYPE($requestDigest) = xsd:string)
  }
  BIND(IRI(CONCAT(STR(<urn:g:txlog/>), SUBSTR(STR(NOW()), 1, 7))) AS ?logGraph)
  BIND(?logGraph AS ?logGraph2)
  BIND(IRI(CONCAT(STR($newRev), "/add")) AS ?addGraph)
  BIND(IRI(CONCAT(STR($newRev), "/del")) AS ?delGraph)
  GRAPH <urn:g:dataset> { <urn:g:dataset> pat:epoch $epoch }
  GRAPH <urn:g:meta/6> {
    $root pat:epoch ?rowEpoch ; pat:seq $expectedSeq .
    OPTIONAL { $root pat:head ?prevRev }
    FILTER NOT EXISTS { GRAPH <urn:g:meta/6> { $root pat:deleted "true"^^xsd:boolean } }
  }
  FILTER NOT EXISTS { GRAPH <urn:g:txn> { $txnId pat:rev ?any } }
  BIND(STR($txnId) AS ?txnKey)
  BIND(NOW() AS ?now)
}
