{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && bash \"$CLAUDE_PROJECT_DIR/tools/claude-cloud-setup.sh\" --session; exit 0",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v vyd-hook >/dev/null 2>&1 && vyd-hook --client claude-code --ask 'mise run graph:ask -- find' || echo '{}'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
