{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && bash \"$CLAUDE_PROJECT_DIR/tools/claude-cloud-setup.sh\" --session; exit 0",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v vyd-hook >/dev/null 2>&1 && vyd-hook --client claude-code --ask 'mise run graph:ask -- find' || echo '{}'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v mise >/dev/null 2>&1; then mise exec -- python \"$CLAUDE_PROJECT_DIR/tools/secret_read_guard.py\"; exit $?; fi; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.build/config-studio/infra/broker/**)",
      "Read(./.build/config-studio/infra/compose/rabbitmq-studio.conf)",
      "Read(**/.build/config-studio/infra/broker/**)"
    ]
  }
}
