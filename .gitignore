# Operating-system and editor state
.DS_Store
.idea/
.vscode/

# Build artifacts and caches consolidated in .build/
.build/pytest-cache/*
!.build/pytest-cache/.gitkeep
.build/yarn-cache/*
!.build/yarn-cache/.gitkeep
.build/mork-review-workbench-test-results/*
!.build/mork-review-workbench-test-results/.gitkeep
.build/surface-contract-studio-test-results/*
!.build/surface-contract-studio-test-results/.gitkeep
# Formal-methods toolchains, build outputs and caches (formal-methods-phase-0, epic E6)
.build/formal/*
!.build/formal/.gitkeep
# Rocq and Isabelle compiled artefacts, wherever spikes/formal-prover's theories are built
*.vo
*.vos
*.vok
*.glob
.*.aux
.Rocqdep.d
*.heap.gz

# Node and Yarn installs, caches, and build output
node_modules/
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
apps/*/dist/
coverage/
playwright-report/

# Java and Maven build output
**/target/
*.class

# Python bytecode, environments, packaging metadata, and test output
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/
venv/
env/
ENV/
# Track D's spike keeps its environment scripts at spikes/formal-prover/env/ (formal-methods-
# phase-0.md §7), which the Python virtualenv rule above would otherwise swallow (env/ matches
# at any depth, and Windows git matches it case-insensitively against ENV/ too).
!spikes/formal-prover/env/
.tox/
.nox/
.eggs/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Erlang and Elixir dependency and compilation output
_build/
deps/

# Local environment files and logs
.env
.env.*
!.env.example
*.log

# TEMP FILES
**/execution/*
!**/execution/.gitkeep
ontology/mork/mtp/out/
**/.DS_Store
**/catalog*.xml
**/*Catalog*.xml
# Generated import catalogs are tracked (ADR-A88, tools/ontology_catalog.py)
!ontology/catalog-v001.xml
!ontology/**/spec/catalog-v001.xml
!ontology/**/vocab/catalog-v001.xml
WINGMAN
.local/**
*.patch
/.yarn
