{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/surface/mork-handoff-policy/1.0.0",
  "title": "Surface to MORK staging handoff policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectionKind", "reviewRequirements", "stagingOnly", "activationAuthority"],
  "properties": {
    "projectionKind": {"enum": ["derivation", "join", "expansion", "graph_construction"]},
    "reviewRequirements": {"type": "array", "uniqueItems": true, "items": {"enum": ["DerivationReview", "ExpansionReview", "MappingReview"]}},
    "stagingOnly": {"const": true},
    "activationAuthority": {"const": "mork_governance_workflow"}
  }
}
