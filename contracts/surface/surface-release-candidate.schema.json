{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/surface/surface-release-candidate/1.0.0",
  "title": "Surface release candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateId", "revisionId", "generatedGraph", "generatedOutputs", "semanticGates"],
  "properties": {
    "candidateId": {"type": "string", "minLength": 1},
    "revisionId": {"type": "string", "minLength": 1},
    "generatedGraph": {"$ref": "surface-revision.schema.json#/$defs/graphReference"},
    "generatedOutputs": {"type": "array", "minItems": 1, "items": {"$ref": "../release/release-intent.schema.json#/$defs/contentReference"}},
    "semanticGates": {"type": "array", "minItems": 1, "items": {"$ref": "../release/release-intent.schema.json#/$defs/gateEvidence"}}
  }
}
