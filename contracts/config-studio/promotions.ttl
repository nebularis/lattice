# SPDX-License-Identifier: CC-BY-SA-4.0
# The studio's promotions (ADR-A149 decision 14, PB-Q14 (b)), derived and never authoritative (PRI-52). Each reads one family
# of aggregates, its cst:sourceFamily, and its rows for one source live in that source's partition,
# urn:lattice:studio:promoted:{source graph}, kept by the write that changes the source and rebuilt by a rebuild job only at
# start or on an administrator's request. The summaries join a workspace to its parts' version rows, which no read path
# expresses, so they are the query workspace-summaries.rq, kept beside this file and evaluated as they are read.
#
# The terms promotion covers skos:Concept only. The members of the other units of publication-units.ttl are not covered yet.

@prefix srf:  <https://www.nebularis.org/neuro-semantic/lattice/surface#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix cst:  <https://www.nebularis.org/neuro-semantic/lattice/config-studio#> .
@prefix prm:  <https://www.nebularis.org/neuro-semantic/lattice/config-studio/promotion#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

prm:profile a srf:SurfaceProfile ;
    fnd:hasIdentity prm:profile-identity ;
    srf:generatorVersion "lattice-surface-compiler/0.1.0" ;
    srf:canonicalisationVersion "srf-canon/1" ;
    srf:entailmentRegime srf:NoEntailment ;
    srf:namingNormalisation srf:SanitisedLocalName ;
    srf:symbolMode srf:PunnedSymbols ;
    srf:permittedStackDepth 0 .

# Every lineage graph of the registry, urn:lattice:studio:lineage/*. Answers each lineage's current version.
prm:registry-promotion a srf:PromotionContract ;
    fnd:hasIdentity prm:registry-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "registry" ;
    cst:sourceFamily "lineage" ;
    srf:carrier fnd:PersistentIdentity ;
    srf:readProperty cst:current ;
    srf:targetNamespace "https://www.nebularis.org/neuro-semantic/lattice/config-studio/promotion#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile prm:profile ;
    srf:promotesTo prm:current ;
    srf:sourceFidelity srf:ExactSource .

# Every job graph but a rebuild job's, urn:lattice:studio:job:{id}. Membership only, a job's status stays in its own graph.
prm:jobs-promotion a srf:PromotionContract ;
    fnd:hasIdentity prm:jobs-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "jobs" ;
    cst:sourceFamily "job" ;
    srf:carrier cst:Job ;
    srf:readProperty cst:workspace ;
    srf:targetNamespace "https://www.nebularis.org/neuro-semantic/lattice/config-studio/promotion#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile prm:profile ;
    srf:promotesTo prm:workspace ;
    srf:sourceFidelity srf:ExactSource .

# Every description graph, urn:lattice:studio:description/*. Answers which workspaces follow a lineage or pin a version.
prm:holders-follows-promotion a srf:PromotionContract ;
    fnd:hasIdentity prm:holders-follows-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "holders-follows" ;
    cst:sourceFamily "description" ;
    srf:carrier cst:Workspace ;
    srf:readProperty cst:dependsOn ;
    srf:targetNamespace "https://www.nebularis.org/neuro-semantic/lattice/config-studio/promotion#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile prm:profile ;
    srf:promotesTo prm:dependsOn ;
    srf:sourceFidelity srf:ExactSource .

# Every description graph. Answers which workspaces hold an import.
prm:holders-imports-promotion a srf:PromotionContract ;
    fnd:hasIdentity prm:holders-imports-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "holders-imports" ;
    cst:sourceFamily "description" ;
    srf:carrier cst:Workspace ;
    srf:readProperty cst:holdsImport ;
    srf:targetNamespace "https://www.nebularis.org/neuro-semantic/lattice/config-studio/promotion#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile prm:profile ;
    srf:promotesTo prm:holdsImport ;
    srf:sourceFidelity srf:ExactSource .

# Every version graph, urn:lattice:studio:version/*. The label of each concept a version defines.
prm:terms-label-promotion a srf:PromotionContract ;
    fnd:hasIdentity prm:terms-label-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "terms-label" ;
    cst:sourceFamily "version" ;
    srf:carrier skos:Concept ;
    srf:readProperty skos:prefLabel ;
    srf:targetNamespace "https://www.nebularis.org/neuro-semantic/lattice/config-studio/promotion#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile prm:profile ;
    srf:promotesTo prm:prefLabel ;
    srf:sourceFidelity srf:ExactSource .

# Every version graph. The version each concept names.
prm:terms-version-promotion a srf:PromotionContract ;
    fnd:hasIdentity prm:terms-version-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "terms-version" ;
    cst:sourceFamily "version" ;
    srf:carrier skos:Concept ;
    srf:readProperty skos:inScheme ;
    srf:targetNamespace "https://www.nebularis.org/neuro-semantic/lattice/config-studio/promotion#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile prm:profile ;
    srf:promotesTo prm:inScheme ;
    srf:sourceFidelity srf:ExactSource .
