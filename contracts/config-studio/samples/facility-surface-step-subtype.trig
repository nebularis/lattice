# SPDX-License-Identifier: MPL-2.0
#
# The input of a simulate run of target surface, for the facility sample's surface part (a revolving drawdown, typed by a subclass of the carrier's class, is added). The sample world is the graphs that are not
# reserved, as it was before the edit. The edit is the quads a write added and removed, which are the quads of a persistence step's delta part, in
# <urn:lattice:studio:step/added/{graph}> and <urn:lattice:studio:step/removed/{graph}>, where {graph} is the edited graph's IRI percent-encoded as
# ENCODE_FOR_URI does, urn%3Ag%3Afacilities for <urn:g:facilities>. Each borrower is in a graph of its own, <urn:g:borrower/{id}>, as the facility
# persistence profile places it, so the promotion's three-hop read path leaves the facilities graph for the borrower's. The graph <urn:g:vocabulary> holds the sector concepts as the vocabulary configuration states them,
# since the compiler reads the end of the path with its triples, and a step reads only the world it is sent. Every IRI is a placeholder under example.org.

@prefix cst: <https://www.nebularis.org/neuro-semantic/lattice/config-studio#> .
@prefix ex:  <https://example.org/lending#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:g:vocabulary> {
    ex:FoodProcessing a skos:Concept ; skos:broader ex:Manufacturing ; skos:inScheme ex:SectorScheme2026 , ex:SectorScheme2027 ; skos:prefLabel "Food processing"@en .
    ex:RevolvingDrawdown rdfs:subClassOf ex:Drawdown .
}

<urn:g:borrower/acme-foods> {
    ex:acme-foods a ex:Borrower ; ex:borrowerSector ex:FoodProcessing .
}

<urn:g:facilities> {
    ex:facility-1 a ex:Facility ; ex:borrower ex:acme-foods ; ex:hasDrawdown ex:drawdown-1 ; ex:margin 3.25 .
    ex:drawdown-1 a ex:Drawdown ; ex:drawnUnder ex:facility-1 ; ex:drawnAmount 40000000.0 .
}

<urn:lattice:studio:step> {
    <urn:lattice:studio:step> a cst:SimulationStepRequest ;
        cst:forPart cst:Surface ;
        cst:transactionTime "2026-04-02T09:30:00Z"^^xsd:dateTime .
}

<urn:lattice:studio:step/added/urn%3Ag%3Afacilities> {
    ex:drawdown-2 a ex:RevolvingDrawdown ; ex:drawnUnder ex:facility-1 ; ex:drawnAmount 5000000.0 .
    ex:facility-1 ex:hasDrawdown ex:drawdown-2 .
}
