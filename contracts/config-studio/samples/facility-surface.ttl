# SPDX-License-Identifier: MPL-2.0
#
# The surface configuration of the facility agreement sample, two contracts over the baseline's
# carrier data.
#
# The promotion restates the sector of a drawdown's borrower on the drawdown itself. The sector is
# three hops from a drawdown, through the facility it is drawn under and that facility's borrower, so
# a consumer asking which drawdowns carry a sector would otherwise traverse the path for each one.
#
# The index retrieves borrowers by sector. Its value population is the members of the scheme the
# vocabulary configuration's sector contract resolves to at compile time, with a nominal class and a
# membership assertion per member, and a closure relation over skos:broader so that asking for
# industrials also finds a borrower in food processing. The 2026 edition is in force at the sample's
# compile time, and the 2027 edition takes over on 2027-01-01.

@prefix srf:  <https://www.nebularis.org/neuro-semantic/lattice/surface#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex:   <https://example.org/lending#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:facility-surface-profile a srf:SurfaceProfile ;
    fnd:hasIdentity ex:facility-surface-profile-identity ;
    srf:generatorVersion "lattice-surface-compiler/0.1.0" ;
    srf:canonicalisationVersion "srf-canon/1" ;
    srf:entailmentRegime srf:NoEntailment ;
    srf:namingNormalisation srf:SanitisedLocalName ;
    srf:symbolMode srf:PunnedSymbols ;
    srf:permittedStackDepth 0 ;
    srf:defaultPopulationBudget 5000 .

# --- the promotion, over a three-hop read path ------------------------------------------------------

ex:drawdown-sector-step-0 a srf:PathStep ;
    srf:stepIndex 0 ;
    srf:stepProperty ex:drawnUnder ;
    srf:stepDirection srf:Forward .

ex:drawdown-sector-step-1 a srf:PathStep ;
    srf:stepIndex 1 ;
    srf:stepProperty ex:borrower ;
    srf:stepDirection srf:Forward .

ex:drawdown-sector-step-2 a srf:PathStep ;
    srf:stepIndex 2 ;
    srf:stepProperty ex:borrowerSector ;
    srf:stepDirection srf:Forward .

ex:drawdown-sector-promotion a srf:PromotionContract ;
    fnd:hasIdentity ex:drawdown-sector-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "drawdown-sector" ;
    srf:carrier ex:Drawdown ;
    srf:hasPathStep ex:drawdown-sector-step-0 , ex:drawdown-sector-step-1 , ex:drawdown-sector-step-2 ;
    srf:targetNamespace "https://example.org/lending/exec#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile ex:facility-surface-profile ;
    srf:promotesTo <https://example.org/lending/exec#drawdownSector> ;
    srf:sourceFidelity srf:ExactSource .

# --- the index, over a population drawn on the vocabulary -------------------------------------------

ex:borrower-sector-population a srf:ContractBoundPopulation ;
    srf:fromSchemeContract ex:SectorContract .

ex:borrower-sector-index a srf:IndexContract ;
    fnd:hasIdentity ex:borrower-sector-index-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "borrower-sector" ;
    srf:carrier ex:Borrower ;
    srf:readProperty ex:borrowerSector ;
    srf:targetNamespace "https://example.org/lending/exec#"^^xsd:anyURI ;
    srf:realisationMode srf:DefinitionAndMaterialised ;
    srf:surfaceProfile ex:facility-surface-profile ;
    srf:valuePopulation ex:borrower-sector-population ;
    srf:indexForm srf:NominalClass , srf:MembershipAssertion , srf:ClosureRelation ;
    srf:namingPolicy srf:LocalNameFromValue ;
    srf:closureBasis skos:broader .

# --- the projections, one of each kind ----------------------------------------------------------------
#
# Each projection lowers into a MORK mapping scheme that the surface compile job compiles with mork_rdf, and a projection step runs over the
# sample world. They are clean-room and generic to lending facilities. The carrier data is the baseline's, and the properties a projection writes
# are the target terms it names, which hold no declaration of their own.

# A derivation, the commitment weighted by the margin, which is a facility's size and its price in one figure.

ex:fm-subject a srf:ProjectionRoleBinding ;
    srf:roleKind srf:EvaluationSubjectRole .

ex:fm-commitment a srf:ProjectionRoleBinding ;
    srf:roleKind srf:RequiredEvidenceRole ;
    srf:bindsProperty ex:commitment ;
    srf:bindsDatatype xsd:decimal .

ex:fm-margin a srf:ProjectionRoleBinding ;
    srf:roleKind srf:RequiredEvidenceRole ;
    srf:bindsProperty ex:margin ;
    srf:bindsDatatype xsd:decimal .

ex:fm-target a srf:ProjectionRoleBinding ;
    srf:roleKind srf:ResultTargetRole ;
    srf:bindsProperty ex:marginWeightedCommitment ;
    srf:bindsDatatype xsd:decimal ;
    srf:derivedAs ex:fm-expression .

ex:fm-expression a srf:ProductExpression ;
    srf:resultDatatype xsd:decimal ;
    srf:leftOperand ex:fm-commitment ;
    srf:rightOperand ex:fm-margin .

ex:facility-margin-projection a srf:ProjectionContract ;
    fnd:hasIdentity ex:facility-margin-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "facility-margin" ;
    srf:carrier ex:Facility ;
    srf:projectionKind srf:DerivationProjection ;
    srf:hasRoleBinding ex:fm-subject , ex:fm-commitment , ex:fm-margin , ex:fm-target ;
    srf:targetNamespace "https://example.org/lending/projection/facility-margin/exec#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile ex:facility-surface-profile ;
    srf:backendPolicy ex:projection-backend-policy .

ex:projection-backend-policy a srf:ProjectionBackendPolicy ;
    srf:allowedBackend srf:SparqlBackend , srf:NativeIrBackend ;
    srf:deterministicOnly true ;
    srf:llmCompletionPolicy srf:NoLLMCompletion .

# A graph construction with one node for each instance, a schedule for each drawdown.

ex:ds-subject a srf:ProjectionRoleBinding ;
    srf:roleKind srf:EvaluationSubjectRole .

ex:ds-amount a srf:ProjectionRoleBinding ;
    srf:roleKind srf:RequiredEvidenceRole ;
    srf:bindsProperty ex:drawnAmount .

ex:ds-date a srf:ProjectionRoleBinding ;
    srf:roleKind srf:RequiredEvidenceRole ;
    srf:bindsProperty ex:drawdownDate .

ex:ds-link a srf:ProjectionRoleBinding ;
    srf:roleKind srf:ResultTargetRole ;
    srf:bindsProperty ex:hasSchedule ;
    srf:constructedAs ex:ds-node .

ex:ds-node a srf:ConstructedNode ;
    srf:constructedClass ex:RepaymentSchedule ;
    srf:nodeIdentity srf:PerInstance ;
    srf:writes [ srf:writesProperty ex:scheduledAmount ; srf:fromBinding ex:ds-amount ] ,
               [ srf:writesProperty ex:scheduleStart ; srf:fromBinding ex:ds-date ] .

ex:drawdown-schedule-projection a srf:ProjectionContract ;
    fnd:hasIdentity ex:drawdown-schedule-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "drawdown-schedule" ;
    srf:carrier ex:Drawdown ;
    srf:projectionKind srf:GraphConstructionProjection ;
    srf:hasRoleBinding ex:ds-subject , ex:ds-amount , ex:ds-date , ex:ds-link ;
    srf:targetNamespace "https://example.org/lending/projection/drawdown-schedule/exec#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile ex:facility-surface-profile ;
    srf:backendPolicy ex:projection-backend-policy .

# A graph construction by key, one exposure node for each borrower, shared by the borrower's facilities.

ex:be-subject a srf:ProjectionRoleBinding ;
    srf:roleKind srf:EvaluationSubjectRole .

ex:be-borrower a srf:ProjectionRoleBinding ;
    srf:roleKind srf:RequiredEvidenceRole ;
    srf:bindsProperty ex:borrower .

ex:be-link a srf:ProjectionRoleBinding ;
    srf:roleKind srf:ResultTargetRole ;
    srf:bindsProperty ex:hasBorrowerExposure ;
    srf:constructedAs ex:be-node .

ex:be-node a srf:ConstructedNode ;
    srf:constructedClass ex:BorrowerExposure ;
    srf:nodeIdentity srf:ByKey ;
    srf:keyBinding ex:be-borrower ;
    srf:writes [ srf:writesProperty ex:exposureOf ; srf:fromBinding ex:be-borrower ] .

ex:borrower-exposure-projection a srf:ProjectionContract ;
    fnd:hasIdentity ex:borrower-exposure-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "borrower-exposure" ;
    srf:carrier ex:Facility ;
    srf:projectionKind srf:GraphConstructionProjection ;
    srf:hasRoleBinding ex:be-subject , ex:be-borrower , ex:be-link ;
    srf:targetNamespace "https://example.org/lending/projection/borrower-exposure/exec#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile ex:facility-surface-profile ;
    srf:backendPolicy ex:projection-backend-policy .

# A join, the branch a facility is booked at, found by the code each states.

ex:fb-subject a srf:ProjectionRoleBinding ;
    srf:roleKind srf:EvaluationSubjectRole .

ex:fb-code a srf:ProjectionRoleBinding ;
    srf:roleKind srf:RequiredEvidenceRole ;
    srf:bindsProperty ex:bookingBranchCode .

ex:fb-match a srf:ProjectionRoleBinding ;
    srf:roleKind srf:RequiredEvidenceRole ;
    srf:bindsCarrier ex:Branch ;
    srf:bindsProperty ex:branchCode .

ex:fb-link a srf:ProjectionRoleBinding ;
    srf:roleKind srf:ResultTargetRole ;
    srf:bindsProperty ex:bookedAt ;
    srf:joinedAs ex:fb-join .

ex:fb-join a srf:JoinStatement ;
    srf:joinsOn [ srf:joinLeft ex:fb-code ; srf:joinRight ex:fb-match ] ;
    srf:joinMatches srf:AtMostOne .

ex:facility-branch-projection a srf:ProjectionContract ;
    fnd:hasIdentity ex:facility-branch-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "facility-branch" ;
    srf:carrier ex:Facility ;
    srf:projectionKind srf:JoinProjection ;
    srf:hasRoleBinding ex:fb-subject , ex:fb-code , ex:fb-match , ex:fb-link ;
    srf:targetNamespace "https://example.org/lending/projection/facility-branch/exec#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile ex:facility-surface-profile ;
    srf:backendPolicy ex:projection-backend-policy .

# An expansion, the facilities a facility refinances directly or through others.

ex:fr-subject a srf:ProjectionRoleBinding ;
    srf:roleKind srf:EvaluationSubjectRole .

ex:fr-refinances a srf:ProjectionRoleBinding ;
    srf:roleKind srf:CandidateEvidenceRole ;
    srf:bindsProperty ex:refinances .

ex:fr-link a srf:ProjectionRoleBinding ;
    srf:roleKind srf:ResultTargetRole ;
    srf:bindsProperty ex:refinancesInChain ;
    srf:expandedAs ex:fr-expansion .

ex:fr-expansion a srf:ExpansionStatement ;
    srf:expandsFrom ex:fr-refinances ;
    srf:expansionSource srf:TransitiveClosure .

ex:facility-refinancing-projection a srf:ProjectionContract ;
    fnd:hasIdentity ex:facility-refinancing-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "facility-refinancing" ;
    srf:carrier ex:Facility ;
    srf:projectionKind srf:ExpansionProjection ;
    srf:hasRoleBinding ex:fr-subject , ex:fr-refinances , ex:fr-link ;
    srf:targetNamespace "https://example.org/lending/projection/facility-refinancing/exec#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile ex:facility-surface-profile ;
    srf:backendPolicy ex:projection-backend-policy .

# A node for each member, a covenant test for each covenant a facility lists, keyed by the facility's reference and the covenant.

ex:ct-subject a srf:ProjectionRoleBinding ;
    srf:roleKind srf:EvaluationSubjectRole .

ex:ct-reference a srf:ProjectionRoleBinding ;
    srf:roleKind srf:RequiredEvidenceRole ;
    srf:bindsProperty ex:facilityReference .

ex:ct-covenants a srf:ProjectionRoleBinding ;
    srf:roleKind srf:RequiredEvidenceRole ;
    srf:bindsProperty ex:covenants .

ex:ct-link a srf:ProjectionRoleBinding ;
    srf:roleKind srf:ResultTargetRole ;
    srf:bindsProperty ex:hasCovenantTest ;
    srf:expandedAs ex:ct-expansion ;
    srf:constructedAs ex:ct-node .

ex:ct-expansion a srf:ExpansionStatement ;
    srf:expandsFrom ex:ct-covenants ;
    srf:expansionSource srf:ListMembers .

ex:ct-node a srf:ConstructedNode ;
    srf:constructedClass ex:CovenantTest ;
    srf:nodeIdentity srf:ByKey ;
    srf:keyBinding ex:ct-reference ;
    srf:keyMember true ;
    srf:writes [ srf:writesProperty ex:testsCovenant ; srf:fromMember true ] ,
               [ srf:writesProperty ex:testedFacilityReference ; srf:fromBinding ex:ct-reference ] .

ex:facility-covenant-test-projection a srf:ProjectionContract ;
    fnd:hasIdentity ex:facility-covenant-test-identity ;
    fnd:hasGovernanceState fnd:Active ;
    srf:contractKey "facility-covenant-test" ;
    srf:carrier ex:Facility ;
    srf:projectionKind srf:ExpansionProjection ;
    srf:hasRoleBinding ex:ct-subject , ex:ct-reference , ex:ct-covenants , ex:ct-link ;
    srf:targetNamespace "https://example.org/lending/projection/facility-covenant-test/exec#"^^xsd:anyURI ;
    srf:realisationMode srf:Materialised ;
    srf:surfaceProfile ex:facility-surface-profile ;
    srf:backendPolicy ex:projection-backend-policy .
