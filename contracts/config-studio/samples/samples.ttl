# SPDX-License-Identifier: MPL-2.0
#
# The Configuration Studio's samples (ADR-A136). Each part names a repository file: an ontology
# module's file by module, role and file name, resolved through the repository catalogue, or a
# file by its path from this folder. tools/config_studio_stage.py resolves and stages them.

@prefix cst:  <https://www.nebularis.org/neuro-semantic/lattice/config-studio#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:lattice:studio:sample:lending> a cst:Sample ;
    rdfs:label "Lending" ;
    rdfs:comment "Loan applications, parties and branches, with a strong persistence profile and a uniqueness key per branch." ;
    cst:part [ cst:fileName "lending-baseline.ttl" ] ,
             [ cst:module "persistence" ; cst:role "examples" ; cst:fileName "baseline-single-class.ttl" ] .

<urn:lattice:studio:sample:employment> a cst:Sample ;
    rdfs:label "Employment job families" ;
    rdfs:comment "Role assignments classified by a job family hierarchy, with an index contract that retrieves by any ancestor family." ;
    cst:part [ cst:module "surface" ; cst:role "examples" ; cst:fileName "employment-job-family.ttl" ] .

<urn:lattice:studio:sample:saas> a cst:Sample ;
    rdfs:label "SaaS subscriptions" ;
    rdfs:comment "Subscriptions, plans and pricing, with a promotion of the billing currency over a three-step read path." ;
    cst:part [ cst:module "surface" ; cst:role "examples" ; cst:fileName "saas-subscription-currency.ttl" ] .

<urn:lattice:studio:sample:lending-eligibility> a cst:Sample ;
    rdfs:label "Lending eligibility" ;
    rdfs:comment "A sector condition that meets a hierarchical classification or one lender's flat list depending on the binding scope, and a credit score range, with questions to test them." ;
    cst:part [ cst:module "eligibility" ; cst:role "examples" ; cst:fileName "flat-scheme-lending.ttl" ] ,
             [ cst:module "eligibility" ; cst:role "examples" ; cst:fileName "interval-containment.ttl" ] .

<urn:lattice:studio:sample:vocabulary-bindings> a cst:Sample ;
    rdfs:label "Scheme bindings" ;
    rdfs:comment "Category schemes bound by region and tier, and an edition handed over to its successor at a date, to explore how a concept scheme resolves." ;
    cst:part [ cst:module "vocabulary" ; cst:role "examples" ; cst:fileName "conjunctive-scopes.ttl" ] ,
             [ cst:module "vocabulary" ; cst:role "examples" ; cst:fileName "temporal-handover.ttl" ] .

<urn:lattice:studio:sample:quantities> a cst:Sample ;
    rdfs:label "Quantities and units" ;
    rdfs:comment "Value spaces, units, conversions and derived rate spaces, with the operations each space permits." ;
    cst:part [ cst:module "quantification" ; cst:role "examples" ; cst:fileName "additivity.ttl" ] .

<urn:lattice:studio:sample:facility> a cst:Sample ;
    rdfs:label "Facility agreement, every part" ;
    rdfs:comment "A facility agreement with its borrower, lenders and drawdowns, configured in all five parts over one baseline. Sector editions handed over at a date and region schemes bound by scope give a resolution table with Resolved, Fallback, Unresolved and Conflict rows. Eligibility conditions combine concepts of those schemes with amount and margin ranges, and seventeen questions cover Permitted, Denied and Undetermined, one before the handover and some under a scope. Persistence covers a composite facility and a borrower with personal data and erasure, and surface promotes a sector over a three-hop path and indexes borrowers by sector." ;
    cst:part [ cst:fileName "lending-baseline.ttl" ] ,
             [ cst:fileName "facility-baseline.ttl" ] ,
             [ cst:fileName "facility-vocabulary.ttl" ] ,
             [ cst:fileName "facility-quantification.ttl" ] ,
             [ cst:fileName "facility-eligibility.ttl" ] ,
             [ cst:fileName "facility-persistence.ttl" ] ,
             [ cst:fileName "facility-surface.ttl" ] .

<urn:lattice:studio:sample:builder> a cst:Sample ;
    rdfs:label "Contract builder, a facility form" ;
    rdfs:comment "The Wording layer's facility form in the library, with a variation slot, an optional clause and a clause included when the facility is syndicated, and two assemblies of it, one that assembles and one refused for a missing lender count, and the stated meaning of three clauses, two confirmed and one waiting for review." ;
    cst:part [ cst:module "wording" ; cst:role "examples" ; cst:fileName "facility-form.ttl" ] ,
             [ cst:fileName "builder-assemblies.ttl" ] ,
             [ cst:fileName "builder-meaning.ttl" ] .

<urn:lattice:studio:sample:odrl-mappings> a cst:Sample ;
    rdfs:label "ODRL mappings" ;
    rdfs:comment "The hand-made MORK mapping pack from an ODRL 2.2 policy to stated meaning, and a language model's proposal for the same source with each of its mappings reviewed against the pack, to explore in mapping mode." ;
    cst:part [ cst:fileName "../odrl/odrl-instrument.mork.ttl" ] ,
             [ cst:fileName "../odrl/trial/history.ttl" ] .

<urn:lattice:studio:sample:legalruleml-mappings> a cst:Sample ;
    rdfs:label "LegalRuleML mappings" ;
    rdfs:comment "Two proposals mapping LegalRuleML's metamodel to stated meaning, one made cold and one made with the ODRL trial's history, each mapping with its review, to explore in mapping mode." ;
    cst:part [ cst:fileName "../legalruleml/trial/history.ttl" ] .
