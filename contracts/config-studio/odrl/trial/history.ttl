odrl:Agreement a mork:Entity,
        owl:NamedIndividual ;
    mork:representationScheme <https://example.org/lattice/odrl/mapping#Src> .

odrl:Assertion a mork:Entity,
        owl:NamedIndividual ;
    mork:representationScheme <https://example.org/lattice/odrl/mapping#Src> .

odrl:Offer a mork:Entity,
        owl:NamedIndividual ;
    mork:representationScheme <https://example.org/lattice/odrl/mapping#Src> .

odrl:Policy a mork:Entity,
        owl:NamedIndividual ;
    mork:representationScheme <https://example.org/lattice/odrl/mapping#Src> .

odrl:Privacy a mork:Entity,
        owl:NamedIndividual ;
    mork:representationScheme <https://example.org/lattice/odrl/mapping#Src> .

odrl:Request a mork:Entity,
        owl:NamedIndividual ;
    mork:representationScheme <https://example.org/lattice/odrl/mapping#Src> .

odrl:Set a mork:Entity,
        owl:NamedIndividual ;
    mork:representationScheme <https://example.org/lattice/odrl/mapping#Src> .

odrl:Ticket a mork:Entity,
        owl:NamedIndividual ;
    mork:representationScheme <https://example.org/lattice/odrl/mapping#Src> .

<https://example.org/lattice/odrl/mapping#C_Policy> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/odrl/mapping#MS> ;
    mork:representedAs odrl:Agreement,
        odrl:Assertion,
        odrl:Offer,
        odrl:Policy,
        odrl:Privacy,
        odrl:Request,
        odrl:Set,
        odrl:Ticket .

<https://example.org/lattice/odrl/mapping#Cn_Conseq> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/odrl/mapping#MS> ;
    mork:path "odrl:consequence" .

<https://example.org/lattice/odrl/mapping#Cn_Duty> a mork:DataConcept,
        owl:NamedIndividual ;
