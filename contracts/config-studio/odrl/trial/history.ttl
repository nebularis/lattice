<https://example.org/lattice/odrl/mapping#Hyp_Logical> a mork:Hypothesis,
        owl:NamedIndividual ;
    mork:mappingNote "odrl:and, or, xone, andSequence logical constraints have no counterpart in the cards other than a profile's composition operation, whose individuals are not on the cards. Not mapped." ;
    mork:mappingScheme <https://example.org/lattice/odrl/mapping#MS> ;
    prov:wasGeneratedBy <urn:mork-propose:run:run-1> .

<https://example.org/lattice/odrl/mapping#Hyp_Policy> a mork:Hypothesis,
        owl:NamedIndividual ;
    mork:mappingNote "Policy kind (Set, Offer, Agreement) and odrl:profile are not carried. Unsure whether ins:classification or a version fits." ;
    mork:mappingScheme <https://example.org/lattice/odrl/mapping#MS> ;
    prov:wasGeneratedBy <urn:mork-propose:run:run-1> .

<https://example.org/lattice/odrl/mapping#Hyp_Refinement> a mork:Hypothesis,
        owl:NamedIndividual ;
    mork:mappingNote "odrl:refinement on actions and parties would narrow the activity. Not mapped, unsure whether an Eligibility condition on the activity or a qualifier fits." ;
    mork:mappingScheme <https://example.org/lattice/odrl/mapping#MS> ;
    prov:wasGeneratedBy <urn:mork-propose:run:run-1> .

<https://example.org/lattice/odrl/mapping#Hyp_SetOps> a mork:Hypothesis,
        owl:NamedIndividual ;
    mork:mappingNote "odrl:isAllOf, hasPart, isPartOf and a literal right operand under eq have no clear Eligibility strategy. Not mapped, and a literal under eq would need a Quantity value." ;
    mork:mappingScheme <https://example.org/lattice/odrl/mapping#MS> ;
    prov:wasGeneratedBy <urn:mork-propose:run:run-1> .

