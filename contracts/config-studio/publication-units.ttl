# SPDX-License-Identifier: CC-BY-SA-4.0
# The units a workspace publishes (ADR-A149 decision 2). Each is an aggregate: a root of one of its classes, the nodes
# that name the root by its member property, every blank node reached from either, and every named node minted under the
# root's IRI. Read by the browser, the service and the worker.

@prefix cst:  <https://www.nebularis.org/neuro-semantic/lattice/config-studio#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix voc:  <https://www.nebularis.org/neuro-semantic/lattice/vocabulary#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix elg:  <https://www.nebularis.org/neuro-semantic/lattice/eligibility#> .
@prefix dal:  <https://www.nebularis.org/neuro-semantic/lattice/persistence#> .
@prefix srf:  <https://www.nebularis.org/neuro-semantic/lattice/surface#> .
@prefix mork: <http://www.nebularis.org/ontologies/Mork#> .
@prefix wrd:  <https://www.nebularis.org/neuro-semantic/lattice/wording#> .
@prefix ins:  <https://www.nebularis.org/neuro-semantic/lattice/instrument#> .

cst:ConceptSchemeUnit a cst:PublicationUnit ; rdfs:label "Concept scheme" ; cst:authoredIn "vocabulary" ;
    cst:rootClass skos:ConceptScheme , voc:ConceptScheme ; cst:memberBy skos:inScheme .
cst:SchemeContractUnit a cst:PublicationUnit ; rdfs:label "Scheme contract" ; cst:authoredIn "vocabulary" ; cst:rootClass voc:SchemeContract .
cst:SchemeBindingUnit a cst:PublicationUnit ; rdfs:label "Scheme binding" ; cst:authoredIn "vocabulary" ; cst:rootClass voc:SchemeBinding .
cst:ValueSpaceUnit a cst:PublicationUnit ; rdfs:label "Value space" ; cst:authoredIn "quantification" ; cst:rootClass qnt:ValueSpace .
cst:RangeSetUnit a cst:PublicationUnit ; rdfs:label "Range set" ; cst:authoredIn "quantification" ; cst:rootClass qnt:RangeSet .
cst:EligibilityProfileUnit a cst:PublicationUnit ; rdfs:label "Eligibility profile" ; cst:authoredIn "eligibility" ;
    cst:rootClass elg:AdmissionProfile , elg:OperationalProfile .
cst:PersistenceProfileUnit a cst:PublicationUnit ; rdfs:label "Persistence profile" ; cst:authoredIn "persistence" ; cst:rootClass dal:DataAccessProfile .
cst:SurfaceContractUnit a cst:PublicationUnit ; rdfs:label "Surface contract" ; cst:authoredIn "surface" ;
    cst:rootClass srf:PromotionContract , srf:IndexContract , srf:ProjectionContract .
cst:MappingSchemeUnit a cst:PublicationUnit ; rdfs:label "Mapping scheme" ; cst:authoredIn "mapping" ;
    cst:rootClass mork:MappingScheme ; cst:memberBy mork:mappingScheme .
cst:RepresentationSchemeUnit a cst:PublicationUnit ; rdfs:label "Source representation" ; cst:authoredIn "mapping" ;
    cst:rootClass mork:RepresentationScheme ; cst:memberBy skos:inScheme .
cst:FormUnit a cst:PublicationUnit ; rdfs:label "Form" ; cst:authoredIn "library" ; cst:rootClass wrd:Wording .
cst:MeaningUnit a cst:PublicationUnit ; rdfs:label "Stated meaning" ; cst:authoredIn "meaning" ; cst:rootClass ins:Template .
