{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/authoring/authoring-template/0.1.0",
  "title": "Word authoring POC: authoring template",
  "type": "object",
  "additionalProperties": false,
  "required": ["templateId", "version", "title", "domain", "sections", "variables"],
  "properties": {
    "templateId": {"$ref": "https://schemas.nebularis.org/lattice/authoring/common/0.1.0#/$defs/Key"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "domain": {"$ref": "https://schemas.nebularis.org/lattice/authoring/common/0.1.0#/$defs/Key"},
    "sections": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/TemplateSection"}},
    "variables": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "https://schemas.nebularis.org/lattice/authoring/common/0.1.0#/$defs/VariableDeclaration"}
    }
  },
  "$defs": {
    "TemplateSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionKey", "heading", "elementKinds", "allowedTermKinds", "required", "guidance"],
      "properties": {
        "sectionKey": {"$ref": "https://schemas.nebularis.org/lattice/authoring/common/0.1.0#/$defs/SectionKey"},
        "heading": {"type": "string", "minLength": 1, "maxLength": 100},
        "elementKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "https://schemas.nebularis.org/lattice/authoring/common/0.1.0#/$defs/ElementKind"}
        },
        "allowedTermKinds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"$ref": "https://schemas.nebularis.org/lattice/authoring/common/0.1.0#/$defs/TermKind"}
        },
        "required": {"type": "boolean"},
        "guidance": {"type": "string", "minLength": 0, "maxLength": 1000}
      }
    }
  }
}
