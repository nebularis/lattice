{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/events/projection-lower-request/1.0.0",
  "title": "Surface Projection lower request",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "correlationId", "contractGraph", "profileGraph", "stagingNamespace"],
  "properties": {
    "jobId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "contractGraph": {"$ref": "#/$defs/graphReference"},
    "profileGraph": {"$ref": "#/$defs/graphReference"},
    "stagingNamespace": {"type": "string", "format": "uri"}
  },
  "$defs": {"graphReference": {"type": "object", "additionalProperties": false, "required": ["tenantId", "projectId", "graphIri", "revisionHash"], "properties": {"tenantId": {"type": "string", "minLength": 1}, "projectId": {"type": "string", "minLength": 1}, "graphIri": {"type": "string", "format": "uri"}, "revisionHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}}
}
