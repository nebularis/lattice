{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/events/graph-validation-result/1.0.0",
  "title": "Graph validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "correlationId", "outcome", "graph"],
  "properties": {
    "jobId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["valid", "invalid", "unsupported"]},
    "graph": {"$ref": "graph-validation-request.schema.json#/properties/graph"},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}
