{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/events/graph-validation-request/1.0.0",
  "title": "Graph validation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "correlationId", "graph", "profileId"],
  "properties": {
    "jobId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "format": "uri"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "projectId", "graphIri", "revisionHash"],
      "properties": {
        "tenantId": {"type": "string", "minLength": 1},
        "projectId": {"type": "string", "minLength": 1},
        "graphIri": {"type": "string", "format": "uri"},
        "revisionHash": {"type": "string", "minLength": 1}
      }
    }
  }
}
