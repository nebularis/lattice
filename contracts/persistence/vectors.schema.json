{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/persistence/vectors/1.0.0",
  "title": "LATTICE persistence conformance vectors",
  "description": "Conformance vectors for the canonical N-Triples of a payload, the request digest, the payload check, the events of an append, the caller check, the audit outcome, reference modes and checkpoint versions. Normative definition: ADR-A123 (the digest contract and its addenda) and ADR-A132 decision 4. An implementation is conformant when it reproduces every canonical line and every digest, refuses every payload in the refusals, and gives each check the result the vector states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vectorsFormat",
    "description",
    "ntriples",
    "refusals",
    "digests",
    "payloadChecks",
    "eventChecks",
    "callerChecks",
    "auditOutcomes",
    "referenceChecks",
    "checkpointChecks"
  ],
  "properties": {
    "vectorsFormat": {
      "const": "lattice-persistence-vectors/1"
    },
    "description": {
      "type": "string"
    },
    "ntriples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "triples",
          "canonical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "triples": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/triple"
            }
          },
          "canonical": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The canonical lines, sorted by UTF-8 bytes, without duplicates."
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "refusal",
          "triples"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "refusal": {
            "enum": [
              "BlankNode",
              "LiteralSubject",
              "InvalidIri"
            ]
          },
          "triples": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/triple"
            }
          }
        }
      }
    },
    "digests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "operationKind",
          "target",
          "expected",
          "parts",
          "canonicalParts",
          "encodedHex",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "operationKind": {
            "type": "string",
            "description": "The operation's kind as the compiled profile names it, for example Replace."
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "description": "The target IRI without angle brackets, or null for an empty component."
          },
          "expected": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The expected seq, written as a decimal string in the digest, or null for an empty component."
          },
          "parts": {
            "type": "array",
            "description": "The content parts, in the contract's order. An event part has rows and triples, the others have triples.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "PayloadPart",
                    "EventPart",
                    "AddPart",
                    "DelPart"
                  ]
                },
                "triples": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/triple"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/row"
                  }
                }
              }
            }
          },
          "canonicalParts": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "encodedHex": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$",
            "description": "The bytes that are hashed."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "payloadChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "root",
          "shape",
          "edges",
          "triples",
          "outside"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "shape": {
            "type": [
              "string",
              "null"
            ],
            "description": "The boundary shape, or null for a family with no shape, which bounds nothing."
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/edge"
            }
          },
          "triples": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/triple"
            }
          },
          "outside": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The subjects that are neither the root nor reached from it by owned edges, sorted."
          }
        }
      }
    },
    "eventChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "events",
          "triples",
          "refusals"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event",
                "type",
                "opSeq",
                "occurredAt"
              ],
              "properties": {
                "event": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "opSeq": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "occurredAt": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/term"
                    }
                  ]
                }
              }
            }
          },
          "triples": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/triple"
            }
          },
          "refusals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The refusal codes, sorted. Empty when the request passes."
          }
        }
      }
    },
    "callerChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "operation",
          "values",
          "refusals"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "parameters"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "graphPrefix": {
                "type": "string"
              },
              "graphSuffix": {
                "type": "string"
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "kind",
                    "required"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "Iri",
                        "Long",
                        "Position",
                        "Digest",
                        "RegistryList"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "equalsGraphName": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "iri"
                  ],
                  "properties": {
                    "iri": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "int"
                  ],
                  "properties": {
                    "int": {
                      "type": "integer"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "literal"
                  ],
                  "properties": {
                    "literal": {
                      "type": "string"
                    },
                    "datatype": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "string"
                  ],
                  "properties": {
                    "string": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "strings"
                  ],
                  "properties": {
                    "strings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          },
          "allowEmptyLogGraphs": {
            "type": "boolean"
          },
          "refusals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The refusal codes, sorted. Empty when the request passes."
          }
        }
      }
    },
    "auditOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "rows",
          "logGraphs",
          "examined",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "logGraphs": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "The graphs the caller listed, an empty array when it listed none, null for an audit that lists none."
          },
          "examined": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The receipts the listed graphs hold, or null where the caller did not count."
          },
          "outcome": {
            "enum": [
              "Clean",
              "Failed",
              "NothingExamined"
            ]
          }
        }
      }
    },
    "referenceChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "root",
          "shape",
          "edges",
          "triples",
          "versions",
          "refusals"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "shape": {
            "type": "string"
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/edge"
            }
          },
          "triples": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/triple"
            }
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The IRIs the caller knows to be versions."
          },
          "refusals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The refusal codes, sorted. Empty when the request passes."
          }
        }
      }
    },
    "checkpointChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "version",
          "membershipProperty",
          "members",
          "checkpoint",
          "triples",
          "refusals"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "membershipProperty": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checkpoint": {
            "type": "boolean"
          },
          "triples": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/triple"
            }
          },
          "refusals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The refusal codes, sorted. Empty when the request passes."
          }
        }
      }
    }
  },
  "$defs": {
    "term": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iri"
          ],
          "properties": {
            "iri": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": "string"
            },
            "datatype": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bnode"
          ],
          "properties": {
            "bnode": {
              "type": "string"
            }
          }
        }
      ]
    },
    "triple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s",
        "p",
        "o"
      ],
      "properties": {
        "s": {
          "$ref": "#/$defs/term"
        },
        "p": {
          "$ref": "#/$defs/term"
        },
        "o": {
          "$ref": "#/$defs/term"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "type",
        "opSeq",
        "occurredAt"
      ],
      "properties": {
        "event": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "opSeq": {
          "type": "integer"
        },
        "occurredAt": {
          "$ref": "#/$defs/term"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "predicate",
        "inverse",
        "ownership",
        "targetShape",
        "mode"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "inverse": {
          "type": "boolean"
        },
        "ownership": {
          "enum": [
            "Owned",
            "Reference",
            "Vocabulary"
          ]
        },
        "targetShape": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "ByIdentity",
            "Pinned"
          ]
        }
      }
    }
  }
}
