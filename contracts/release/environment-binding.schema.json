{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/release/environment-binding/1.0.0",
  "title": "Immutable release environment binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "environment", "artifactDigest", "bindingEvidence"],
  "properties": {
    "releaseId": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "artifactDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "bindingEvidence": {"type": "string", "minLength": 1}
  }
}
