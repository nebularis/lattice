{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/release/export-descriptor/1.0.0",
  "title": "Portable release export descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "artifactDigest", "exportDigest", "uri"],
  "properties": {
    "releaseId": {"type": "string", "minLength": 1},
    "artifactDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "exportDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "uri": {"type": "string", "format": "uri"}
  }
}
