{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/mork/retrospective-challenge/1.0.0",
  "title": "MORK retrospective challenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["challengeId", "decisionId", "snapshotHash", "reason"],
  "properties": {
    "challengeId": {"type": "string", "minLength": 1},
    "decisionId": {"type": "string", "minLength": 1},
    "snapshotHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reason": {"type": "string", "minLength": 1}
  }
}