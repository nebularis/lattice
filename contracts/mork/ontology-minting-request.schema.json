{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/mork/ontology-minting-request/1.0.0",
  "title": "MORK ontology minting request",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "namedAxiom", "affectedApprovalIds", "rationale"],
  "properties": {
    "requestId": {"type": "string", "minLength": 1},
    "namedAxiom": {"type": "string", "format": "uri"},
    "affectedApprovalIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1}
  }
}