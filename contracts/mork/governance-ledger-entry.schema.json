{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/mork/governance-ledger-entry/1.0.0",
  "title": "MORK replayable governance ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["entryId", "occurredAt", "kind", "subjectId", "correlationId", "evidenceReference"],
  "properties": {
    "entryId": {"type": "string", "minLength": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "kind": {"enum": ["queue_ordered", "calibration_passed", "calibration_failed", "bulk_blocked", "approval_reopened", "challenge_opened"]},
    "subjectId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "evidenceReference": {"type": "string", "minLength": 1}
  }
}