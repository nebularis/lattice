{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nebularis.org/lattice/identity/minting-anchors/1.0.0",
  "title": "LATTICE identity minting anchor vectors",
  "description": "Hand-authored vector sets verified with tools that share no code with any minting library (verify-anchors.py, openssl). Every conformant implementation must pass them in addition to its recipes' generated vectors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchorsFormat",
    "unicodeVersion",
    "ucdSource",
    "description",
    "sets"
  ],
  "properties": {
    "anchorsFormat": {
      "const": "lattice-minting-anchors/1"
    },
    "unicodeVersion": {
      "const": "16.0.0"
    },
    "ucdSource": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.nebularis.org/lattice/identity/minting-vectors/1.0.0"
      }
    }
  }
}
