    skos:definition "The Model Context Protocol, for giving a model tools and data." ;
    skos:editorialNote "proposed" .

fct:tool-use rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-integration ;
    skos:prefLabel "tool use" ;
    skos:definition "A model calling functions or tools that an application declares to it." ;
    skos:editorialNote "proposed" .

fct:agent-sdk rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-integration, fct:library ;
    skos:prefLabel "agent SDKs" ;
    skos:definition "Frameworks for building agents that plan and act with tools, such as the Claude Agent SDK." ;
    skos:editorialNote "proposed" .

fct:coding-agent rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-integration, fct:tool ;
    skos:prefLabel "coding agents" ;
    skos:definition "Agents that read and change a codebase, such as Claude Code and GitHub Copilot, and the instructions they read." ;
    skos:editorialNote "proposed" .

fct:structured-output rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-integration ;
    skos:prefLabel "structured output" ;
    skos:definition "Constraining a model to answer in a schema, such as JSON matching a JSON Schema." ;
    skos:editorialNote "proposed" .

fct:vector-index rdf:type skos:Concept ; skos:inScheme fct:Technology ;
