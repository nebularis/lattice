    skos:editorialNote "proposed" .

fct:model-training rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-operations ;
    skos:prefLabel "model training" ;
    skos:definition "Training and fine-tuning models, including adapters such as LoRA." ;
    skos:editorialNote "proposed" .

fct:experiment-tracking rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-operations ;
    skos:prefLabel "experiment tracking" ;
    skos:definition "Recording runs, parameters and results, such as with MLflow." ;
    skos:editorialNote "proposed" .

fct:model-formats rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai, fct:format ;
    skos:prefLabel "model formats" ;
    skos:definition "Formats that hold model weights, such as ONNX, GGUF and safetensors." ;
    skos:editorialNote "proposed" .

fct:gpu rdf:type skos:Concept ; skos:inScheme fct:Technology ;
