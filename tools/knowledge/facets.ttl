    skos:editorialNote "proposed" .

fct:gemini rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:llm ;
    skos:prefLabel "Gemini" ;
    skos:definition "Google's Gemini models and API." ;
    skos:editorialNote "proposed" .

fct:open-weight-llm rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:llm ;
    skos:prefLabel "open-weight language models" ;
    skos:definition "Language models whose weights are published, such as Llama, Mistral and Qwen, run on one's own hardware." ;
    skos:editorialNote "proposed" .

fct:embeddings rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-model ;
    skos:prefLabel "embeddings" ;
    skos:definition "Embedding models and the vector similarity that ranks by them." .

fct:bge rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:embeddings ;
    skos:prefLabel "BGE" ;
    skos:definition "The BAAI general embedding models, such as bge-small-en-v1.5." ;
    skos:editorialNote "proposed" .

fct:static-embeddings rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:embeddings ;
    skos:prefLabel "static embeddings" ;
    skos:definition "Embeddings looked up per token rather than computed by a transformer, such as model2vec." ;
    skos:editorialNote "proposed" .

fct:reranker rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-model ;
    skos:prefLabel "rerankers" ;
    skos:definition "Cross-encoder models that rescore a short list of candidates against a question." ;
    skos:editorialNote "proposed" .

fct:multimodal-model rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-model ;
    skos:prefLabel "multimodal models" ;
    skos:definition "Models that read or produce images, audio or video as well as text." ;
    skos:editorialNote "proposed" .

fct:speech-model rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-model ;
    skos:prefLabel "speech models" ;
    skos:definition "Speech recognition and speech synthesis models." ;
    skos:editorialNote "proposed" .

fct:classical-ml rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-model ;
    skos:prefLabel "classical machine learning" ;
    skos:definition "Linear models, decision trees, gradient boosting, clustering and other machine learning that is not deep learning." ;
    skos:editorialNote "proposed" .

fct:onnxruntime rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-runtime, fct:library ;
    skos:prefLabel "ONNX Runtime" ;
    skos:definition "ONNX Runtime, for running exported models." .

fct:llama-cpp rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-runtime ;
    skos:prefLabel "llama.cpp" ;
    skos:definition "llama.cpp and its GGUF models, for running models on a CPU or a laptop." ;
    skos:editorialNote "proposed" .

fct:vllm rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-runtime ;
    skos:prefLabel "vLLM" ;
    skos:definition "vLLM and other servers that run models for many callers at once." ;
    skos:editorialNote "proposed" .

fct:ollama rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-runtime ;
    skos:prefLabel "Ollama" ;
    skos:definition "Ollama, for running open-weight models locally." ;
    skos:editorialNote "proposed" .

fct:pytorch rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-framework, fct:library ;
    skos:prefLabel "PyTorch" ;
    skos:definition "PyTorch." ;
    skos:editorialNote "proposed" .

fct:tensorflow rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-framework, fct:library ;
    skos:prefLabel "TensorFlow" ;
    skos:definition "TensorFlow and Keras." ;
    skos:editorialNote "proposed" .

fct:jax rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-framework, fct:library ;
    skos:prefLabel "JAX" ;
    skos:definition "JAX." ;
    skos:editorialNote "proposed" .

fct:transformers rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-framework, fct:library ;
    skos:prefLabel "Transformers" ;
    skos:definition "The Hugging Face Transformers library." ;
    skos:editorialNote "proposed" .

fct:sentence-transformers rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-framework, fct:library ;
    skos:prefLabel "sentence-transformers" ;
    skos:definition "The sentence-transformers library for embedding and reranking." ;
    skos:editorialNote "proposed" .

fct:scikit-learn rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-framework, fct:library ;
    skos:prefLabel "scikit-learn" ;
    skos:definition "scikit-learn." ;
    skos:editorialNote "proposed" .

fct:tokenizers rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-framework, fct:library ;
    skos:prefLabel "tokenizers" ;
    skos:definition "Tokenizer libraries, such as Hugging Face tokenizers and tiktoken." ;
    skos:editorialNote "proposed" .

fct:langchain rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-framework, fct:library ;
    skos:prefLabel "LangChain" ;
    skos:definition "LangChain and LangGraph, for composing model calls into chains and graphs." ;
    skos:editorialNote "proposed" .

fct:mcp rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:broader fct:ai-integration, fct:standard ;
