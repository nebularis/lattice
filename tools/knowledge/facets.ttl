# SPDX-License-Identifier: CC-BY-SA-4.0
# NB: This document has been produced using GenAI
#
# The facets of the knowledge index (ADR-A134).
#
# A facet is a closed set of values a register entry is tagged with. graph:ask -- find ranks every
# entry by meaning and raises those whose facet values match the question's. Three facets live here,
# each a concept scheme:
#
#   Activity    what the person or agent is doing when the entry matters
#   Quality     which characteristic the entry protects or trades
#   Technology  which technology the entry is specific to, left empty when it is not specific
#
# Each facet follows a published division of its field, so it covers the field rather than this
# repository's habits, and needs few additions. Activity follows the knowledge areas of SWEBOK v4, the
# DAMA-DMBOK 2 data-management areas, TOGAF's architecture domains and the DevOps loop. Quality
# follows the characteristics of ISO/IEC 25010:2023 and the data qualities of ISO/IEC 25012, with
# what this repository needs beyond them, such as determinism, development efficiency and
# auditability. The definitions are our own words. Technology names what this repository uses and
# what an agent is likely to ask about.
#
# The structural facets, kind, audience, phase, stratum and the quanta, are T-Box individuals in
# knowledge.ttl, because a check reads them. These are concepts, because the maintainer amends them.
#
# An entry takes one to three values of Activity and of Quality, and as many of Technology as it is
# specific to, always the most specific value that fits. A value may have several broader values, as
# SKOS allows, so Java is both a language and a platform. A value carrying skos:editorialNote "group"
# organises the others and is never tagged. A question's value matches an entry's when one lies on
# the other's broader chain, so a question about physical data modelling still raises an entry tagged
# data modelling. A value carrying skos:editorialNote "proposed" is not yet ratified.
#
# Outside ontology/ and the substrate release of ADR-A129. It describes how we work in this
# repository, not the domain, and no value names private work.

@prefix fct:  <https://www.nebularis.org/neuro-semantic/lattice/dev/facets#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://www.nebularis.org/neuro-semantic/lattice/dev/facets>
    rdf:type owl:Ontology ;
    rdfs:label "LATTICE knowledge-index facets" ;
    owl:versionInfo "0.3.0" .

fct:Activity rdf:type skos:ConceptScheme ;
    skos:prefLabel "activity" ;
    skos:definition "What the person or agent is doing when the entry matters. A skill loaded for a task supplies it." .

fct:Quality rdf:type skos:ConceptScheme ;
    skos:prefLabel "quality" ;
    skos:definition "The characteristic an entry protects, or trades against another." .

fct:Technology rdf:type skos:ConceptScheme ;
    skos:prefLabel "technology" ;
    skos:definition "The technology an entry is specific to. An entry true of any technology carries none." .


######################################################################
#    Activity
######################################################################

fct:analysis rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "analysis" ;
    skos:definition "Working out what is needed and what is true of the domain, before anything is built." ;
    skos:editorialNote "group" .

fct:architecture rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "architecture" ;
    skos:definition "Deciding a system's structure, its parts and how they couple, and the qualities it must have." ;
    skos:editorialNote "group" .

fct:design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "design" ;
    skos:definition "Any of the design activities, from a single layer to a whole solution." ;
    skos:editorialNote "group" .

fct:data-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "data management" ;
    skos:definition "Governing, integrating and looking after data over its life, as DAMA-DMBOK divides the field." ;
    skos:editorialNote "group" .

fct:coding rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "coding" ;
    skos:definition "Turning a design into working code, queries and configuration." ;
    skos:editorialNote "group" .

fct:verification rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "verification and validation" ;
    skos:definition "Showing that what was built is right, and is what was needed." ;
    skos:editorialNote "group" .

fct:operations rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "operations" ;
    skos:definition "Building, deploying, running and supporting software once it exists, the DevOps loop." ;
    skos:editorialNote "group" .

fct:security-engineering rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "security engineering" ;
    skos:definition "Designing, building and running so that misuse fails and a breach is contained." ;
    skos:editorialNote "group" .

fct:delivery-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "delivery management" ;
    skos:definition "Planning, sequencing and governing the work itself." ;
    skos:editorialNote "group" .

fct:technical-writing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:topConceptOf fct:Activity ;
    skos:prefLabel "technical writing" ;
    skos:definition "Writing and presenting what others need to read, such as guides, references, decisions and diagrams." ;
    skos:editorialNote "group" .

fct:requirements-analysis rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:analysis ;
    skos:prefLabel "requirements analysis" ;
    skos:definition "Working out what a stakeholder, a regulation, a contract or the law needs, before anything is designed." .

fct:requirements-elicitation rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:requirements-analysis ;
    skos:prefLabel "requirements elicitation" ;
    skos:definition "Drawing needs out of stakeholders, documents and regulations." .

fct:requirements-specification rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:requirements-analysis ;
    skos:prefLabel "requirements specification" ;
    skos:definition "Writing requirements down so they can be checked, with their acceptance criteria." .

fct:domain-analysis rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:analysis ;
    skos:prefLabel "domain analysis" ;
    skos:definition "Learning a domain's concepts, rules and vocabulary from its experts and texts, including how the law and contract drafting answer a question." .

fct:regulatory-analysis rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:analysis ;
    skos:prefLabel "regulatory analysis" ;
    skos:definition "Working out what a law, regulation or standard requires of a system or its data." .

fct:business-process-analysis rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:analysis ;
    skos:prefLabel "business process analysis" ;
    skos:definition "Studying how work is done today, with its roles, steps and hand-offs, before redesigning it." .

fct:feasibility-analysis rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:analysis ;
    skos:prefLabel "feasibility analysis" ;
    skos:definition "Testing whether an approach can work at acceptable cost before committing to it, by a spike, a prototype or a measurement." .

fct:cross-layer-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:architecture, fct:design ;
    skos:prefLabel "cross-layer design" ;
    skos:definition "Deciding which layer or module a concept belongs in, and what each may depend on." .

fct:enterprise-architecture rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:architecture ;
    skos:prefLabel "enterprise architecture" ;
    skos:definition "Relating business, data, application and technology architecture across an organisation, as TOGAF divides it." .

fct:solution-architecture rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:architecture ;
    skos:prefLabel "solution architecture" ;
    skos:definition "Shaping the components, deployments and integrations of one solution, and the qualities each must meet." .

fct:architecture-decision-making rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:architecture ;
    skos:prefLabel "architecture decision-making" ;
    skos:definition "Framing an architecturally significant choice, comparing the options on their consequences, and recording it as an ADR." .

fct:quality-attribute-analysis rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:architecture ;
    skos:prefLabel "quality attribute analysis" ;
    skos:definition "Setting the qualities a system must have, with their scenarios and measures, and the trade-offs between them." .

fct:technology-selection rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:architecture ;
    skos:prefLabel "technology selection" ;
    skos:definition "Choosing a language, store, library, platform or service, including its licence and the cost of leaving it." .

fct:dependency-analysis rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:architecture ;
    skos:prefLabel "dependency and coupling analysis" ;
    skos:definition "Tracing which parts depend on which, and what must change and release together." .

fct:fitness-function-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:architecture, fct:verification ;
    skos:prefLabel "fitness function design" ;
    skos:definition "Designing the checks that keep an architectural characteristic from eroding, atomic or holistic, triggered or continual." .

fct:process-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design ;
    skos:prefLabel "process design" ;
    skos:definition "Designing how work, messages or decisions pass between participants over time." .

fct:solution-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design ;
    skos:prefLabel "solution design" ;
    skos:definition "Designing a component, service, compiler or library that executes against the ontologies, including how it stores and reads data." .

fct:integration-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design ;
    skos:prefLabel "integration design" ;
    skos:definition "Designing how data or messages move between systems, formats or stores, inbound or outbound." .

fct:api-and-contract-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design, fct:coding ;
    skos:prefLabel "API and contract design" ;
    skos:definition "Designing a wire contract, a schema, a recipe format or a programming interface that others call." .

fct:ux-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design ;
    skos:prefLabel "UX design" ;
    skos:definition "Designing what a person sees and does in an application or an add-in." .

fct:data-modelling rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design ;
    skos:prefLabel "data modelling" ;
    skos:definition "Designing the structure, meaning and constraints of data, at the conceptual, logical or physical level." .

fct:conceptual-data-modelling rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-modelling ;
    skos:prefLabel "conceptual data modelling" ;
    skos:definition "Naming the things, relations and rules of a domain without regard to how they are stored." .

fct:logical-data-modelling rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-modelling ;
    skos:prefLabel "logical data modelling" ;
    skos:definition "Giving a conceptual model keys, cardinalities, constraints and shapes, independent of any one store." .

fct:physical-data-modelling rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-modelling ;
    skos:prefLabel "physical data modelling" ;
    skos:definition "Fitting a logical model to a store, with its indexes, partitions, graphs, encodings and write paths." .

fct:ontology-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design, fct:conceptual-data-modelling, fct:logical-data-modelling ;
    skos:prefLabel "ontology design" ;
    skos:definition "Designing classes, properties, shapes and vocabularies within one layer or applied module." .

fct:schema-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:logical-data-modelling, fct:api-and-contract-design ;
    skos:prefLabel "schema design" ;
    skos:definition "Designing a schema others validate against, such as a SHACL shape, a JSON Schema or a table definition." .

fct:identity-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-modelling ;
    skos:prefLabel "identity design" ;
    skos:definition "Deciding how things are identified, keyed and versioned, and how their identifiers are minted." .

fct:temporal-modelling rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-modelling ;
    skos:prefLabel "temporal modelling" ;
    skos:definition "Modelling validity periods, recording time, history, versions and as-of reads." .

fct:event-and-message-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design, fct:integration-design ;
    skos:prefLabel "event and message design" ;
    skos:definition "Designing the events and messages systems exchange, with their schemas, ordering and delivery guarantees." .

fct:algorithm-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design, fct:coding ;
    skos:prefLabel "algorithm design" ;
    skos:definition "Designing a procedure and its complexity, such as an evaluator, a resolution rule or a compiler pass." .

fct:language-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:design ;
    skos:prefLabel "language and compiler design" ;
    skos:definition "Designing a notation, its grammar and semantics, and the compiler or interpreter that reads it." .

fct:data-governance rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-management ;
    skos:prefLabel "data governance" ;
    skos:definition "Deciding who owns, may change and must approve data and vocabularies, and under what policy." .

fct:metadata-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-management ;
    skos:prefLabel "metadata management" ;
    skos:definition "Recording what data means, where it came from and how it moved, including its lineage." .

fct:reference-and-master-data rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-management ;
    skos:prefLabel "reference and master data" ;
    skos:definition "Managing the shared code lists, vocabularies and golden records that many systems depend on." .

fct:data-quality-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-management ;
    skos:prefLabel "data quality management" ;
    skos:definition "Measuring and improving data against its quality dimensions, with the rules that test them." .

fct:data-integration rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-management, fct:integration-design ;
    skos:prefLabel "data integration" ;
    skos:definition "Moving and reconciling data between sources, by mapping, transformation and lifting into a common model." .

fct:data-migration rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-management ;
    skos:prefLabel "data migration" ;
    skos:definition "Moving data from one model or store to another, and proving nothing was lost or changed in meaning." .

fct:data-lifecycle rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-management ;
    skos:prefLabel "data retention and archiving" ;
    skos:definition "Deciding how long data is kept, when it is pruned or archived, and how it is erased." .

fct:analytics-and-reporting rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-management ;
    skos:prefLabel "analytics and reporting" ;
    skos:definition "Deriving measures, aggregates and reports from data, including warehousing and business intelligence." .

fct:document-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:data-management ;
    skos:prefLabel "document and content management" ;
    skos:definition "Managing documents, their versions, wording and attachments as records." .

fct:implementation rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:coding ;
    skos:prefLabel "implementation" ;
    skos:definition "Writing or changing code." .

fct:query-writing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:coding ;
    skos:prefLabel "query writing" ;
    skos:definition "Writing or tuning SPARQL, a SHACL-SPARQL constraint or a query a compiler generates." .

fct:refactoring rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:coding ;
    skos:prefLabel "refactoring" ;
    skos:definition "Changing code's structure without changing what it does." .

fct:debugging rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:coding ;
    skos:prefLabel "debugging" ;
    skos:definition "Finding and fixing the cause of a defect, from its symptom to its root." .

fct:code-review rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:coding, fct:verification ;
    skos:prefLabel "code review" ;
    skos:definition "Reading a change for defects, design and conformance before it merges." .

fct:dependency-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:coding ;
    skos:prefLabel "dependency management" ;
    skos:definition "Adding, pinning, upgrading and removing the libraries and tools a codebase depends on." .

fct:performance-tuning rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:coding ;
    skos:prefLabel "performance tuning" ;
    skos:definition "Measuring where time or memory goes and removing it, without changing results." .

fct:code-generation rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:coding ;
    skos:prefLabel "code generation" ;
    skos:definition "Writing the generators, templates and compilers that emit code, queries or documents." .

fct:testing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:verification ;
    skos:prefLabel "testing" ;
    skos:definition "Writing, running, speeding up or repairing tests, checks and benchmarks." .

fct:unit-testing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:testing ;
    skos:prefLabel "unit testing" ;
    skos:definition "Testing one function, class or module apart from the rest." .

fct:integration-testing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:testing ;
    skos:prefLabel "integration testing" ;
    skos:definition "Testing parts together, such as code against a real store or service." .

fct:end-to-end-testing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:testing ;
    skos:prefLabel "end-to-end testing" ;
    skos:definition "Testing a whole flow the way a user or caller drives it." .

fct:conformance-testing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:testing ;
    skos:prefLabel "conformance testing" ;
    skos:definition "Testing an implementation against a specification or a shared set of vectors, so several implementations agree." .

fct:property-based-testing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:testing ;
    skos:prefLabel "property-based testing" ;
    skos:definition "Testing a stated property over generated inputs rather than chosen examples." .

fct:regression-testing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:testing ;
    skos:prefLabel "regression testing" ;
    skos:definition "Recording what a system reports and checking that a change leaves it as it was." .

fct:performance-testing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:testing ;
    skos:prefLabel "performance testing" ;
    skos:definition "Measuring time, memory or throughput under a stated load, including benchmarks." .

fct:security-testing rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:testing, fct:security-engineering ;
    skos:prefLabel "security testing" ;
    skos:definition "Testing for vulnerabilities, by scanning, fuzzing or penetration." .

fct:scenario-and-test-data rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:verification, fct:testing ;
    skos:prefLabel "scenarios and test data" ;
    skos:definition "Writing the examples, fixtures and scenarios a model or a test must accept or refuse." .

fct:formal-verification rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:verification ;
    skos:prefLabel "formal verification" ;
    skos:definition "Stating laws and proving or bound-checking them in a prover or model checker." .

fct:static-analysis rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:verification ;
    skos:prefLabel "static analysis" ;
    skos:definition "Checking code or models without running them, such as linting, type checking and dependency rules." .

fct:acceptance rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:verification ;
    skos:prefLabel "acceptance" ;
    skos:definition "Confirming with stakeholders that what was built meets the need, at a gate." .

fct:environment rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "environment" ;
    skos:definition "Setting up, running or repairing the toolchain, the tasks and the local services a developer works with." .

fct:build-automation rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "build automation" ;
    skos:definition "Compiling, packaging and assembling software reproducibly." .

fct:continuous-integration rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "continuous integration" ;
    skos:definition "Merging and checking every change automatically and often." .

fct:continuous-delivery rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "continuous delivery" ;
    skos:definition "Keeping every change releasable, and moving it through environments automatically." .

fct:deployment rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "deployment" ;
    skos:definition "Putting a release onto its runtime with its configuration, and rolling it back." .

fct:infrastructure-as-code rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "infrastructure as code" ;
    skos:definition "Declaring infrastructure and environments in versioned files that a tool applies." .

fct:configuration-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "configuration management" ;
    skos:definition "Controlling which versions of software, configuration and data make up a system." .

fct:release-and-versioning rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations, fct:delivery-management, fct:configuration-management ;
    skos:prefLabel "release and versioning" ;
    skos:definition "Versioning, releasing and tagging ontologies and packages, and the branches and merges a release moves through." .

fct:monitoring rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "monitoring and observability" ;
    skos:definition "Collecting and reading metrics, logs and traces so a running system's state is known." .

fct:incident-response rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations, fct:security-engineering ;
    skos:prefLabel "incident response" ;
    skos:definition "Detecting, containing and resolving an outage or a breach, and learning from it." .

fct:backup-and-recovery rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "backup and recovery" ;
    skos:definition "Keeping copies that let a system be restored, and rehearsing the restore." .

fct:capacity-planning rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "capacity planning" ;
    skos:definition "Forecasting load and sizing resources to meet it." .

fct:platform-engineering rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:operations ;
    skos:prefLabel "platform engineering" ;
    skos:definition "Building the shared tooling, templates and services other teams build and run on." .

fct:threat-modelling rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:security-engineering ;
    skos:prefLabel "threat modelling" ;
    skos:definition "Naming what could be attacked, by whom and how, and what stops it." .

fct:identity-and-access-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:security-engineering, fct:design ;
    skos:prefLabel "identity and access design" ;
    skos:definition "Designing authentication, authorisation, roles and the scope of what each caller may reach." .

fct:secrets-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:security-engineering ;
    skos:prefLabel "secrets management" ;
    skos:definition "Storing, rotating and injecting credentials and keys so none reach code, logs or commits." .

fct:cryptography-design rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:security-engineering ;
    skos:prefLabel "cryptography design" ;
    skos:definition "Choosing and applying hashing, signing and encryption correctly." .

fct:supply-chain-security rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:security-engineering ;
    skos:prefLabel "supply chain security" ;
    skos:definition "Trusting what software is built from, its dependencies, tools and images, by pinning, provenance and verification." .

fct:vulnerability-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:security-engineering ;
    skos:prefLabel "vulnerability management" ;
    skos:definition "Finding, triaging and fixing known weaknesses in code and dependencies." .

fct:privacy-engineering rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:security-engineering ;
    skos:prefLabel "privacy engineering" ;
    skos:definition "Building data protection in, by minimisation, purpose limits, consent and erasure." .

fct:compliance-assessment rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:security-engineering, fct:verification ;
    skos:prefLabel "compliance assessment" ;
    skos:definition "Showing that a system meets a standard, a regulation or a licence, with evidence." .

fct:delivery rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:delivery-management ;
    skos:prefLabel "delivery" ;
    skos:definition "Running a unit of work, with its slices, plans, status records, Validation Packs, handoffs and commits, and knowing when to stop for a decision." .

fct:planning-and-estimation rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:delivery-management ;
    skos:prefLabel "planning and estimation" ;
    skos:definition "Breaking work down, sequencing it and estimating its cost." .

fct:risk-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:delivery-management ;
    skos:prefLabel "risk management" ;
    skos:definition "Naming what could go wrong with the work or the system, and deciding what to do about it." .

fct:technical-debt-management rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:delivery-management ;
    skos:prefLabel "technical debt management" ;
    skos:definition "Recording, weighing and paying down known shortfalls." .

fct:licensing-and-ip rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:delivery-management ;
    skos:prefLabel "licensing and intellectual property" ;
    skos:definition "Deciding which licence governs a contribution, and what may be used, published or distributed." .

fct:documentation rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:technical-writing ;
    skos:prefLabel "documentation" ;
    skos:definition "Writing READMEs, guides, ADRs, sketches and other prose others read, and deciding what of it may be published." .

fct:presenting-decisions rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:technical-writing ;
    skos:prefLabel "presenting decisions" ;
    skos:definition "Laying out a decision's options and consequences for someone else to choose between." .

fct:diagramming rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:technical-writing ;
    skos:prefLabel "diagramming" ;
    skos:definition "Drawing the views, flows and states that explain a design." .

fct:onboarding rdf:type skos:Concept ; skos:inScheme fct:Activity ;
    skos:broader fct:technical-writing ;
    skos:prefLabel "training and onboarding" ;
    skos:definition "Teaching others to use or contribute, through guides, examples and walk-throughs." .


######################################################################
#    Quality
######################################################################

fct:functional-suitability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "functional suitability" ;
    skos:definition "Whether it does what is needed, completely, correctly and appropriately." ;
    skos:editorialNote "group" .

fct:performance-efficiency rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "performance efficiency" ;
    skos:definition "How it uses time and resources, and how much it can take." ;
    skos:editorialNote "group" .

fct:compatibility rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "compatibility" ;
    skos:definition "Working beside, and together with, other systems." ;
    skos:editorialNote "group" .

fct:interaction-capability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "interaction capability" ;
    skos:definition "How well people can use it." ;
    skos:editorialNote "group" .

fct:reliability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "reliability" ;
    skos:definition "Doing the right thing over time, despite faults." ;
    skos:editorialNote "group" .

fct:maintainability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "maintainability" ;
    skos:definition "How easily it can be understood, tested and changed." ;
    skos:editorialNote "group" .

fct:flexibility rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "flexibility" ;
    skos:definition "How easily it adapts to new conditions, loads and environments." ;
    skos:editorialNote "group" .

fct:safety rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "safety" ;
    skos:definition "Avoiding harm to people, property or the environment." ;
    skos:editorialNote "group" .

fct:data-quality rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "data quality" ;
    skos:definition "The qualities of data itself, as ISO/IEC 25012 divides them." ;
    skos:editorialNote "group" .

fct:cost rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "cost" ;
    skos:definition "What it costs to build and to run." ;
    skos:editorialNote "group" .

fct:governance-and-compliance rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "governance and compliance" ;
    skos:definition "Meeting obligations, and being able to show that they were met." ;
    skos:editorialNote "group" .

fct:correctness rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:functional-suitability ;
    skos:prefLabel "correctness" ;
    skos:definition "A query, check, evaluation or document gives the answer the model's meaning requires." .

fct:completeness rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:functional-suitability, fct:data-quality ;
    skos:prefLabel "completeness" ;
    skos:definition "Nothing needed is missing, whether a function or a value." .

fct:appropriateness rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:functional-suitability ;
    skos:prefLabel "appropriateness" ;
    skos:definition "It does what the user's goal needs, and nothing that gets in the way of it." .

fct:determinism rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:robustness, fct:functional-suitability ;
    skos:prefLabel "determinism" ;
    skos:definition "The same input gives the same output, whatever the order, the hash seed, the clock or the implementation." .

fct:performance rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:performance-efficiency ;
    skos:prefLabel "performance" ;
    skos:definition "How long one operation takes at runtime, such as a read on a hot path or a validation." .

fct:throughput rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:performance-efficiency ;
    skos:prefLabel "throughput" ;
    skos:definition "How much work completes per unit of time under load." .

fct:storage rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:performance-efficiency ;
    skos:prefLabel "storage" ;
    skos:definition "How much is stored per write, per entity or per version, and for how long." .

fct:parallelism rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:performance-efficiency, fct:functional-suitability ;
    skos:prefLabel "parallelism" ;
    skos:definition "Work split across cores, processes or workers stays correct, and gets faster as workers are added up to a measured limit. The twin of concurrency." ;
    skos:editorialNote "proposed" .

fct:memory rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:performance-efficiency ;
    skos:prefLabel "memory" ;
    skos:definition "How much memory an operation or a process holds at its peak." .

fct:scalability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:performance-efficiency, fct:flexibility ;
    skos:prefLabel "scalability" ;
    skos:definition "How a cost grows as data, history, writers or entries grow." .

fct:interoperability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:compatibility ;
    skos:prefLabel "interoperability" ;
    skos:definition "Exchanging data or calls with another system, and both reading them the same way." .

fct:co-existence rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:compatibility ;
    skos:prefLabel "co-existence" ;
    skos:definition "Running beside other software on a shared host or store without harming it." .

fct:standards-conformance rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:compatibility ;
    skos:prefLabel "standards conformance" ;
    skos:definition "Following the published standard a consumer expects, such as SPARQL 1.1 or SHACL." .

fct:accessibility rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:interaction-capability ;
    skos:prefLabel "accessibility" ;
    skos:definition "People with disabilities can use what is built, in an application or a document." .

fct:learnability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:interaction-capability ;
    skos:prefLabel "learnability" ;
    skos:definition "How quickly a new user or contributor becomes productive." .

fct:operability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:interaction-capability ;
    skos:prefLabel "operability" ;
    skos:definition "How easily a person operates and controls it." .

fct:user-error-protection rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:interaction-capability ;
    skos:prefLabel "user error protection" ;
    skos:definition "Protecting a user from making a mistake, and from its consequences." .

fct:self-descriptiveness rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:interaction-capability, fct:understandability ;
    skos:prefLabel "self-descriptiveness" ;
    skos:definition "It explains itself by its names, messages and documentation, without outside help." .

fct:availability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:reliability ;
    skos:prefLabel "availability" ;
    skos:definition "Being there when needed, measured as uptime." .

fct:robustness rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:reliability ;
    skos:prefLabel "robustness" ;
    skos:definition "Behaving well on failure, such as a partial write, a retry, a restore, missing data or bad input." .

fct:recoverability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:reliability ;
    skos:prefLabel "recoverability" ;
    skos:definition "Returning to a correct state after a failure, knowing what was lost." .

fct:concurrency rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:reliability, fct:functional-suitability ;
    skos:prefLabel "concurrency" ;
    skos:definition "Staying correct when writers or readers act at the same time." .

fct:partition-tolerance rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:reliability ;
    skos:prefLabel "partition tolerance" ;
    skos:definition "It keeps working when the network between its parts fails. One of the three properties of the CAP theorem, which a distributed system trades against the other two." ;
    skos:editorialNote "proposed" .

fct:replica-consistency rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:reliability ;
    skos:prefLabel "replica consistency" ;
    skos:definition "Every read sees the latest write, across every copy or replica. One of the three properties of the CAP theorem, and distinct from consistency between records." ;
    skos:editorialNote "proposed" .

fct:security rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:topConceptOf fct:Quality ;
    skos:prefLabel "security" ;
    skos:definition "Resisting misuse, such as an injected query, a forged or replayed request, or code reaching a store it should not." .

fct:confidentiality rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:security ;
    skos:prefLabel "confidentiality" ;
    skos:definition "What must not be disclosed stays undisclosed, such as personal data, secrets, private material and a person's own setup." .

fct:integrity rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:security ;
    skos:prefLabel "integrity" ;
    skos:definition "Data and code cannot be changed without authority, and a change is detectable." .

fct:authenticity rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:security ;
    skos:prefLabel "authenticity" ;
    skos:definition "Who or what an actor claims to be can be proved." .

fct:accountability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:security ;
    skos:prefLabel "accountability" ;
    skos:definition "Every action can be traced to whoever took it." .

fct:non-repudiation rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:security ;
    skos:prefLabel "non-repudiation" ;
    skos:definition "An action, once taken, cannot later be denied." .

fct:privacy rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:security, fct:governance-and-compliance ;
    skos:prefLabel "privacy" ;
    skos:definition "Personal data is collected, used and kept only as its purpose and the law allow." .

fct:evolvability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:maintainability, fct:flexibility ;
    skos:prefLabel "evolvability" ;
    skos:definition "Changing something later safely, which turns on versions, compatibility, coupling and what a change forces elsewhere." .

fct:modularity rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:maintainability ;
    skos:prefLabel "modularity" ;
    skos:definition "Parts can change apart, because they are loosely coupled and each is cohesive." .

fct:reusability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:maintainability ;
    skos:prefLabel "reusability" ;
    skos:definition "A part can serve more than one system or purpose." .

fct:understandability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:maintainability ;
    skos:prefLabel "understandability" ;
    skos:definition "A human or AI reader can tell what a thing is and means, whether an element in code, a term in a document or a concept in a model." ;
    skos:editorialNote "proposed" .

fct:naming-conventions rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:understandability ;
    skos:prefLabel "naming conventions" ;
    skos:definition "Things are named by a rule and by the terms the project already uses, so a name says what it refers to." ;
    skos:editorialNote "proposed" .

fct:consistent-terminology rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:understandability ;
    skos:prefLabel "consistent terminology" ;
    skos:definition "A term means one thing wherever it appears, in code, documents and models, and one thing has one term." ;
    skos:editorialNote "proposed" .

fct:concept-definition rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:understandability ;
    skos:prefLabel "concept definition" ;
    skos:definition "Each concept is defined once, where it lives, in words that do not need the reader to know its implementation." ;
    skos:editorialNote "proposed" .

fct:readability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:understandability ;
    skos:prefLabel "readability" ;
    skos:definition "Code and prose can be read and followed quickly, by their structure, layout and length." ;
    skos:editorialNote "proposed" .

fct:analysability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:maintainability ;
    skos:prefLabel "analysability" ;
    skos:definition "The effect of a change, or the cause of a failure, can be worked out." .

fct:testability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:maintainability ;
    skos:prefLabel "testability" ;
    skos:definition "It can be tested well, with clear criteria and inputs a test controls." .

fct:observability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:maintainability, fct:reliability ;
    skos:prefLabel "observability" ;
    skos:definition "A running system's internal state can be inferred from what it emits." .

fct:portability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:flexibility ;
    skos:prefLabel "portability" ;
    skos:definition "Working on every operating system, engine, store or host a consumer may use." .

fct:installability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:flexibility ;
    skos:prefLabel "installability" ;
    skos:definition "It can be installed, upgraded and removed reliably." .

fct:replaceability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:flexibility ;
    skos:prefLabel "replaceability" ;
    skos:definition "It can be swapped for another part that does the same job." .

fct:configurability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:flexibility ;
    skos:prefLabel "configurability" ;
    skos:definition "Behaviour changes by configuration rather than by code." .

fct:fail-safety rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:safety ;
    skos:prefLabel "fail-safety" ;
    skos:definition "Hazards are identified, warned of and contained, and a failure leaves things safe." .

fct:consistency rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:data-quality ;
    skos:prefLabel "consistency" ;
    skos:definition "Records and documents agree with each other. One fact has one source, and copies cannot diverge." .

fct:accuracy rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:data-quality ;
    skos:prefLabel "accuracy" ;
    skos:definition "A value correctly represents the real thing it stands for." .

fct:currentness rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:data-quality ;
    skos:prefLabel "currentness" ;
    skos:definition "A value is as up to date as its use needs." .

fct:precision rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:data-quality ;
    skos:prefLabel "precision" ;
    skos:definition "A value carries as much detail as its use needs, and states the detail it has." .

fct:provenance rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:data-quality, fct:governance-and-compliance ;
    skos:prefLabel "provenance" ;
    skos:definition "Where a value came from, who asserted it and how it was derived is recorded." .

fct:efficiency rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:cost ;
    skos:prefLabel "efficiency" ;
    skos:definition "What development costs, such as the time of builds and tests, the tokens and reading an agent spends, and the maintainer's effort. Runtime speed is performance." .

fct:operating-cost rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:cost ;
    skos:prefLabel "operating cost" ;
    skos:definition "What it costs to run, in compute, storage, licences and people." .

fct:auditability rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:governance-and-compliance, fct:security ;
    skos:prefLabel "auditability" ;
    skos:definition "A third party can reconstruct what happened and why, from the record alone." .

fct:regulatory-compliance rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:governance-and-compliance ;
    skos:prefLabel "regulatory compliance" ;
    skos:definition "It meets what a law or a regulation requires." .

fct:licence-compliance rdf:type skos:Concept ; skos:inScheme fct:Quality ;
    skos:broader fct:governance-and-compliance ;
    skos:prefLabel "licence compliance" ;
    skos:definition "It uses and distributes only as each licence allows." .


######################################################################
#    Technology
######################################################################

fct:language rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:topConceptOf fct:Technology ;
    skos:prefLabel "language" ;
    skos:definition "A language code or queries are written in." ;
    skos:editorialNote "group" .

fct:standard rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:topConceptOf fct:Technology ;
    skos:prefLabel "standard" ;
    skos:definition "A W3C or other published standard the ontologies or their tools follow." ;
    skos:editorialNote "group" .

fct:platform rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:topConceptOf fct:Technology ;
    skos:prefLabel "platform" ;
    skos:definition "A runtime that code is deployed onto." ;
    skos:editorialNote "group" .

fct:store rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:topConceptOf fct:Technology ;
    skos:prefLabel "store" ;
    skos:definition "A triple store or dataset server." ;
    skos:editorialNote "group" .

fct:library rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:topConceptOf fct:Technology ;
    skos:prefLabel "library" ;
    skos:definition "A library our code calls." ;
    skos:editorialNote "group" .

fct:messaging rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:topConceptOf fct:Technology ;
    skos:prefLabel "messaging" ;
    skos:definition "A protocol or broker messages travel over." ;
    skos:editorialNote "group" .

fct:tool rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:topConceptOf fct:Technology ;
    skos:prefLabel "tool" ;
    skos:definition "A developer tool that is neither a library nor a runtime." ;
    skos:editorialNote "group" .

fct:format rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:topConceptOf fct:Technology ;
    skos:prefLabel "format" ;
    skos:definition "A data or document format." ;
    skos:editorialNote "group" .

fct:notation rdf:type skos:Concept ; skos:inScheme fct:Technology ;
    skos:topConceptOf fct:Technology ;
    skos:prefLabel "notation" ;
    skos:definition "A modelling or diagram notation." ;
    skos:editorialNote "group" .

