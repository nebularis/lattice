<xsl:stylesheet xmlns:fn0="urn:lattice:mork-transforms" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="3.0" exclude-result-prefixes="#all"><xsl:output method="text" encoding="UTF-8" /><xsl:function name="fn0:literal" as="xs:string"><xsl:param name="s" as="xs:string" /><xsl:sequence select="'&quot;' || replace(replace(replace(replace($s, '\\', '\\\\'), '&quot;', '\\&quot;'), codepoints-to-string(10), '\\n'), codepoints-to-string(13), '\\r') || '&quot;'" /></xsl:function><xsl:template match="/"><xsl:variable name="lines" as="xs:string*"><xsl:for-each select="/Q{urn:example:policy}policies/Q{urn:example:policy}policy"><xsl:if test="exists(@Q{}number)"><xsl:variable name="n1" select="'&lt;' || 'urn:example:base/policy/' || encode-for-uri(string((@Q{}number)[1])) || '&gt;'" as="xs:string" /><xsl:sequence select="$n1 || ' ' || '&lt;http://www.w3.org/1999/02/22-rdf-syntax-ns#type&gt;' || ' ' || '&lt;urn:example:target#Policy&gt;' || ' .'" /><xsl:for-each select="Q{urn:example:policy}holder"><xsl:sequence select="$n1 || ' ' || '&lt;urn:example:target#holderName&gt;' || ' ' || fn0:literal(string(.)) || ' .'" /></xsl:for-each><xsl:sequence select="'&lt;urn:example:target#Acme&gt;' || ' ' || '&lt;urn:example:target#insures&gt;' || ' ' || $n1 || ' .'" /><xsl:sequence select="$n1 || ' ' || '&lt;urn:example:target#status&gt;' || ' ' || '&quot;active&quot;' || ' .'" /><xsl:for-each select="Q{urn:example:policy}cover"><xsl:variable name="n2" select="'&lt;' || 'urn:example:base/cover/' || string-join(for $a in ancestor-or-self::* return encode-for-uri(local-name($a)) || '/' || (count($a/preceding-sibling::*[node-name(.) eq node-name($a)]) + 1), '/') || '&gt;'" as="xs:string" /><xsl:sequence select="$n2 || ' ' || '&lt;http://www.w3.org/1999/02/22-rdf-syntax-ns#type&gt;' || ' ' || '&lt;urn:example:target#Cover&gt;' || ' .'" /><xsl:sequence select="$n2 || ' ' || '&lt;urn:example:target#coverOf&gt;' || ' ' || $n1 || ' .'" /><xsl:for-each select="Q{urn:example:policy}code"><xsl:if test="string(.) = ('FIRE', 'FLOOD')"><xsl:sequence select="$n2 || ' ' || '&lt;urn:example:target#peril&gt;' || ' ' || (if (string(.) eq 'FIRE') then '&lt;urn:example:target#Fire&gt;' else if (string(.) eq 'FLOOD') then '&lt;urn:example:target#Flood&gt;' else '') || ' .'" /></xsl:if></xsl:for-each></xsl:for-each></xsl:if></xsl:for-each></xsl:variable><xsl:for-each select="sort(distinct-values($lines), 'http://www.w3.org/2005/xpath-functions/collation/codepoint')"><xsl:value-of select=". || codepoints-to-string(10)" /></xsl:for-each></xsl:template></xsl:stylesheet>