# SPDX-License-Identifier: CC-BY-SA-4.0
# Policies with their holders and covers, read from CSV, one row for each policy and cover (source.csv). The XML, JSON and YAML schemes beside it map the same data.
# No runtime reads a CSV source yet, so the studio compiles this scheme to RML, and the Sample pane lists that form as waiting.
@prefix mork: <http://www.nebularis.org/ontologies/Mork#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix tgt:  <urn:example:target#> .
@prefix src:  <urn:example:source/csv#> .
@prefix m:    <urn:example:mapping/csv#> .

m:Scheme a mork:MappingScheme .

src:Source a mork:RepresentationScheme ; mork:format mork:CSV .
src:Row a skos:Concept ; skos:inScheme src:Source ; mork:path "$" .
src:Fire a skos:Concept ; skos:inScheme src:Source ; skos:notation "FIRE" .
src:Flood a skos:Concept ; skos:inScheme src:Source ; skos:notation "FLOOD" .

m:Policy a mork:Datum ; mork:mappingScheme m:Scheme ; mork:mappingFor src:Row ;
    mork:exactTBoxMatch tgt:Policy ; mork:conceptName "policy" ; mork:dataRef "policy" .
m:Holder a mork:DataMapping ; mork:mappingScheme m:Scheme ; mork:compositeBroaderMapping m:Policy ;
    mork:exactRBoxMatch tgt:holderName ; mork:dataRef "holder" .
m:Peril a mork:DataMapping ; mork:mappingScheme m:Scheme ; mork:compositeBroaderMapping m:Policy ;
    mork:exactRBoxMatch tgt:peril ; mork:dataRef "cover" .
m:FireRow a mork:DataMapping ; mork:mappingScheme m:Scheme ; mork:compositeBroaderMapping m:Peril ;
    mork:mappingFor src:Fire ; mork:exactABoxMatch tgt:Fire .
m:FloodRow a mork:DataMapping ; mork:mappingScheme m:Scheme ; mork:compositeBroaderMapping m:Peril ;
    mork:mappingFor src:Flood ; mork:exactABoxMatch tgt:Flood .
