{{! fork-detection-audit: guide F5. Revision IRIs are deterministic, so
    two writers that both win a CAS from one version mint the same
    revision subject: a fork shows as two txn claims on one revision,
    never as two revisions sharing a prevRev. Read-only standing alert.
    Reads txn claims, which are pruned; the receipt-side audits cover
    older history.}}
PREFIX pat: <https://example.org/lattice/patterns#>

SELECT ?rev (COUNT(DISTINCT ?t) AS ?n)
WHERE {
  GRAPH {{{txnGraph}}} { ?t pat:rev ?rev }
}
GROUP BY ?rev
HAVING (COUNT(DISTINCT ?t) > 1)
