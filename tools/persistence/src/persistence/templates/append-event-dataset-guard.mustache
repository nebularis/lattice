{{! append-event-dataset-guard: guide §10.1, event-grain append, dal:DatasetLevelGuard
    variant: guards on the dataset epoch, reads the row's pat:epoch and
    rewrites it to the current epoch (a lazy rebase after a bump), and
    continues pat:seq, so the receipt chain crosses the epoch boundary.
    Server-assigned next position: the counter read-and-increment is in the
    same transaction as the event write, on one shared statement (G2). The
    stream row must exist first (bootstrap-version-row). The head and
    prevRev chain are maintained here as in the CAS form. $revBase is the
    caller's revision IRI prefix including the zero-padded epoch, for
    example "urn:rev:orders/1/e0000000000000000003/" as a string literal.
    The sequence is left-padded to 19 digits here. The append form has no
    version guard: the txn claim is its only protection against a late
    retry, so the txn graph's TTL must cover the redelivery horizon (guide
    §24.2). requestDigest is computed by the caller as lower-case
    hex SHA-256 over the tuple-encoded operation kind, target, expected
    seq and sorted canonical N-Triples of the skolemized payload (guide
    §15.2), and recorded on the txn claim so a confirmation can tell a
    replay from a different request reusing the txn id.
    Note for template authors: never put a Mustache tag inside this
    comment block. Chevron's comment parser ends at the first closing
    double-brace it sees, which silently truncates the comment. }}
PREFIX pat: <https://example.org/lattice/patterns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DELETE { GRAPH {{{metaGraphPrefix}}} { $stream pat:epoch ?rowEpoch ; pat:seq ?n ; pat:head ?prev } }
INSERT {
  GRAPH {{{metaGraphPrefix}}} { $stream pat:epoch $epoch ; pat:seq ?n1 ; pat:head ?rev }
  GRAPH {{{txnGraph}}}        { $txnId pat:rev ?rev ; pat:requestDigest $requestDigest }
  GRAPH ?eventGraph {
      $event a $eventType ; pat:revision ?rev ; pat:opSeq $opSeq ; pat:occurredAt $occurredAt
  }
  GRAPH ?logGraph {
      ?rev a pat:Revision ; pat:target $stream ; pat:epoch $epoch ; pat:seq ?n1 ;
           pat:prevRev ?prev ; pat:txn ?txnKey ; pat:recordedAt ?now
  }
}
WHERE {
  GRAPH {{{datasetGraph}}} { {{{datasetNode}}} pat:epoch $epoch }
  GRAPH {{{metaGraphPrefix}}} { $stream pat:epoch ?rowEpoch ; pat:seq ?n }
  OPTIONAL { GRAPH {{{metaGraphPrefix}}} { $stream pat:head ?prev } }
  FILTER NOT EXISTS { GRAPH {{{metaGraphPrefix}}} { $stream pat:deleted true } }
  FILTER NOT EXISTS { GRAPH {{{txnGraph}}} { $txnId pat:rev ?any } }
  BIND(STRDT(STR(?n + 1), xsd:long) AS ?n1)
  BIND(IRI(CONCAT(STR($revBase),
                  SUBSTR(CONCAT("0000000000000000000", STR(?n1)), STRLEN(STR(?n1)) + 1))) AS ?rev)
  BIND(SUBSTR(STR(NOW()), 1, 7) AS ?month)
  BIND(IRI(CONCAT(STR({{{logGraphPrefix}}}), ?month)) AS ?logGraph)
  BIND(IRI(CONCAT(STR({{{eventGraphPrefix}}}), ?month)) AS ?eventGraph)
  BIND(STR($txnId) AS ?txnKey)
  BIND(NOW() AS ?now)
}
