# The dataset-guard variant of the patch-log rows replace of a composite family (H2.12).
# base: composite-property-boundary-shacl.ttl
@prefix dal: <https://www.nebularis.org/neuro-semantic/lattice/persistence#> .
@prefix ex:  <https://example.org/lending#> .

ex:SnapshotStore a dal:CapabilitySpec ;
    dal:providesCas                     dal:Linearizable ;
    dal:providesSnapshotUpdateSemantics true .

ex:OrderEpoch a dal:EpochProfile ;
    dal:appliesTo       ex:OrderClass ;
    dal:epochGuardScope dal:DatasetLevelGuard ;
    dal:epochAuthority  dal:ExternalHighWaterMark .

ex:OrderEncodingProfile a dal:WriteDisciplineProfile ;
    dal:appliesTo       ex:OrderClass ;
    dal:replaceEncoding dal:WholeState .
