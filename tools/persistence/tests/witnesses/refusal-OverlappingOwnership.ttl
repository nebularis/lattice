# Two composite aggregates cannot both own a line item.
# base: composite-property-boundary-shacl.ttl
@prefix dal: <https://www.nebularis.org/neuro-semantic/lattice/persistence#> .
@prefix ex:  <https://example.org/lending#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:QuoteClass a dal:ClassScope ; dal:targetClass ex:Quote .
ex:QuoteBoundaryProfile a dal:AggregateBoundaryProfile ;
    dal:appliesTo ex:QuoteClass ; dal:strategy dal:CompositePropertyBoundary ;
    dal:boundaryShape ex:QuoteShape ; dal:dataGraph <urn:g:quotes> .
ex:QuoteShape a sh:NodeShape ; sh:targetClass ex:Quote ;
    sh:property [ sh:path ex:lineItem ; sh:node ex:LineItemShape ; dal:ownership dal:Owned ] .
