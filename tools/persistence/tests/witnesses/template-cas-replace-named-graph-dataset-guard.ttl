@prefix dal: <https://www.nebularis.org/neuro-semantic/lattice/persistence#> .
@prefix ex:  <https://example.org/lending#> .

ex:LoanApplicationStrongProfile dal:receiptModel dal:ReceiptOnly .

ex:LoanApplicationEpoch a dal:EpochProfile ;
    dal:appliesTo       ex:LoanApplicationClass ;
    dal:epochGuardScope dal:DatasetLevelGuard ;
    dal:epochAuthority  dal:ExternalHighWaterMark .

ex:namedgraphWriteProfile a dal:WriteDisciplineProfile ;
    dal:appliesTo        ex:LoanApplicationClass ;
    dal:replaceEncoding  dal:WholeState .
