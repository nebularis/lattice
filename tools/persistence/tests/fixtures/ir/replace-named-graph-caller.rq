PREFIX pat: <https://www.nebularis.org/neuro-semantic/lattice/persistence-store#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DELETE {
  GRAPH $g { ?s ?p ?o }
  GRAPH <urn:g:meta> { $root pat:seq $expectedSeq ; pat:head ?prevRev }
}
INSERT {
  GRAPH $g { {{{payloadTriples}}} }
  GRAPH <urn:g:meta> { $root pat:epoch $epoch ; pat:seq $nextSeq ; pat:head $newRev }
  GRAPH <urn:g:txn> { $txnId pat:rev $newRev ; pat:requestDigest $requestDigest }
  GRAPH ?logGraph {
    $newRev a pat:Revision ; pat:target $root ; pat:epoch $epoch ; pat:seq $nextSeq ; pat:prevRev ?prevRev ; pat:txn ?txnKey ; pat:recordedAt ?now
  }
}
WHERE {
  {
    FILTER(ISIRI($root) && DATATYPE($epoch) = DATATYPE("0"^^xsd:long) && DATATYPE($expectedSeq) = DATATYPE("0"^^xsd:long) && DATATYPE($nextSeq) = DATATYPE("0"^^xsd:long) && ISIRI($newRev) && ISIRI($txnId) && DATATYPE($requestDigest) = xsd:string && ISIRI($g) && sameTerm($g, IRI(CONCAT("urn:g:orders/", ENCODE_FOR_URI(STR($root)), ""))))
  }
  BIND(IRI(CONCAT(STR(<urn:g:txlog/>), SUBSTR(STR(NOW()), 1, 7))) AS ?logGraph)
  GRAPH <urn:g:meta> {
    $root pat:epoch $epoch ; pat:seq $expectedSeq .
    OPTIONAL { $root pat:head ?prevRev }
    FILTER NOT EXISTS { GRAPH <urn:g:meta> { $root pat:deleted "true"^^xsd:boolean } }
  }
  FILTER NOT EXISTS { GRAPH <urn:g:txn> { $txnId pat:rev ?any } }
  BIND(STR($txnId) AS ?txnKey)
  BIND(NOW() AS ?now)
  OPTIONAL { GRAPH $g { ?s ?p ?o } }
}
