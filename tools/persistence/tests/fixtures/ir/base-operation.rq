PREFIX pat: <https://example.org/lattice/patterns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

DELETE {
  GRAPH <urn:g:meta> { $root pat:seq $expectedSeq }
}
INSERT {
  GRAPH <urn:g:data> { {{{payloadTriples}}} }
  GRAPH <urn:g:meta> { $root pat:seq $nextSeq ; pat:head $newRev }
  GRAPH <urn:g:txn> { $txnId pat:rev $newRev }
  GRAPH ?logGraph { $newRev a pat:Revision ; pat:prevRev ?prevRev ; pat:recordedAt ?now }
}
WHERE {
  {
    FILTER(ISIRI($root) && DATATYPE($epoch) = xsd:long && DATATYPE($expectedSeq) = xsd:long && DATATYPE($nextSeq) = xsd:long && ISIRI($newRev) && ISIRI($txnId))
  }
  BIND(IRI(CONCAT("urn:g:log/", SUBSTR(STR(NOW()), 1, 7))) AS ?logGraph)
  GRAPH <urn:g:meta> {
    $root pat:epoch $epoch ; pat:seq $expectedSeq .
    OPTIONAL { $root pat:head ?prevRev }
    FILTER NOT EXISTS { $root pat:deleted "true"^^xsd:boolean }
  }
  FILTER NOT EXISTS { GRAPH <urn:g:txn> { $txnId pat:rev ?any } }
  BIND(NOW() AS ?now)
}
