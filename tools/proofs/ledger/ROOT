(* The ledger laws, ADR-A131 decisions 3, 4 and 6, over the kernel extracted from
   ontology/ledger/README.md section 10 (ADR-A-FM2, plan ledger, LG-7). Agreement imports the
   shared session, LatticeShared, to prove the kernel's amount is the shared amount (ADR-A-FM2's
   addendum of 2026-11-18). *)

session Ledger = LatticeBase +
  options [document = false, quick_and_dirty = false, timeout = 90]
  sessions
    LatticeShared
  theories
    Kernel
    Allocation
    Draws
    Rounding
    Predicates
    Ranks
    Units
    Merge
    Pots
    Credits
    Readings
    Agreement
