+    def _mapping_for(self, combined: Graph, contract_iri: str) -> URIRef:
+        return next(
+            mapping
+            for mapping in combined.subjects(RDF.type, MORK.DataMapping)
+            if combined.value(mapping, MORK.mappingFor) == URIRef(contract_iri)
+        )
