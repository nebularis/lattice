    <replaceforms.maxr0>3000</replaceforms.maxr0>
    <replaceforms.quick>0</replaceforms.quick>
    <replaceforms.timeout>900</replaceforms.timeout>
    <exec.mainClass>org.nebularis.lattice.benchmark.replaceforms.ReplaceForms</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-tdb2</artifactId>
      <version>${jena.version}</version>
