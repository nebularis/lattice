        wrd:partText """Passport: This policy does not serve as a master Passport policy. Each of the following Coverage Sections shall serve as a master Passport policy solely with respect to the coverage provided thereunder: Not Applicable.""" ] .
ex:item-8 a wrd:Text ;
    fnd:hasIdentity ex:item-8-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "Item 8" ; wrd:rankKey "a7" ;
