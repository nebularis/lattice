    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:time ; qnt:numericValue "2019-08-01T00:00:00Z"^^xsd:dateTime ] .
ex:v-fid-premium a wrd:VariableValue ; wrd:forVariable ex:var-fid-premium ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "2800"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-cpl-separate-limit a wrd:VariableValue ; wrd:forVariable ex:var-cpl-separate-limit ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "1000000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-cpl-retention a wrd:VariableValue ; wrd:forVariable ex:var-cpl-retention ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "10000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-cpl-continuity a wrd:VariableValue ; wrd:forVariable ex:var-cpl-continuity ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:time ; qnt:numericValue "2019-12-01T00:00:00Z"^^xsd:dateTime ] .
ex:v-cpl-retro a wrd:VariableValue ; wrd:forVariable ex:var-cpl-retro ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:time ; qnt:numericValue "2019-12-01T00:00:00Z"^^xsd:dateTime ] .
ex:v-cpl-premium a wrd:VariableValue ; wrd:forVariable ex:var-cpl-premium ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "2487"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-tria-premium a wrd:VariableValue ; wrd:forVariable ex:var-tria-premium ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "0"^^xsd:decimal ; qnt:inUnit ex:usd ] .

# ---- the policy and its parties ----------------------------------------------
#
# The Insured Person, the indemnifying Organization and the spouse or
# representative are contingent occupancies (ADR-A102), each resolved from
# the Claim on each occasion (D17, I11). Subsidiaries and a debtor-in-
# possession are contingent too, with no resolution: the fragment does not
# define Subsidiary.

ex:policy-v1 a ins:Instrument ;
    fnd:hasIdentity ex:policy-identity ;
    ins:expressedIn ex:policy-wording-v1 ;
    ins:party ex:insurer-occ , ex:named-entity-occ , ex:subsidiary-occ , ex:dip-occ ,
              ex:insured-person-occ , ex:indemnifying-org-occ , ex:spouse-occ .

ex:acme a pty:Actor ; rdfs:label "Acme Insurance Company (anonymised)" .
ex:named-entity-actor a pty:Actor ; rdfs:label "the Named Entity, a non-profit (anonymised)" .

# Item 4's two addresses, by purpose: GTC 9 notices, and CPL 5 notices of
# Claim. ins:noticeAddress records strings, not which notices each takes.
ex:insurer-occ a pty:RoleOccupancy ;
    fnd:hasIdentity ex:insurer-occ-identity ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2024-06-01T00:01:00-04:00"^^xsd:dateTime ] ;
    pty:inRole ex:Insurer ; pty:occupiedBy ex:acme ;
    ins:noticeAddress "[Insurer Address, withheld]" , "[Claims Address, withheld]" .
ex:named-entity-occ a pty:RoleOccupancy ;
    fnd:hasIdentity ex:named-entity-occ-identity ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2024-06-01T00:01:00-04:00"^^xsd:dateTime ] ;
    pty:inRole ex:NamedEntity ; pty:occupiedBy ex:named-entity-actor ;
    ins:noticeAddress "[Named Entity Address, withheld]" .
ex:subsidiary-occ a pty:RoleOccupancy ;
    fnd:hasIdentity ex:subsidiary-occ-identity ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2024-06-01T00:01:00-04:00"^^xsd:dateTime ] ;
    pty:inRole ex:Subsidiary .
ex:dip-occ a pty:RoleOccupancy ;
    fnd:hasIdentity ex:dip-occ-identity ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2024-06-01T00:01:00-04:00"^^xsd:dateTime ] ;
    pty:inRole ex:DebtorInPossession .

ex:insured-person-occ a pty:RoleOccupancy ;
    fnd:hasIdentity ex:insured-person-occ-identity ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2024-06-01T00:01:00-04:00"^^xsd:dateTime ] ;
    pty:inRole ex:InsuredPerson ;
    ins:resolvedBy ex:insured-person-resolution .
ex:indemnifying-org-occ a pty:RoleOccupancy ;
    fnd:hasIdentity ex:indemnifying-org-occ-identity ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2024-06-01T00:01:00-04:00"^^xsd:dateTime ] ;
    pty:inRole ex:IndemnifyingOrganization ;
    ins:resolvedBy ex:indemnifying-org-resolution .
ex:spouse-occ a pty:RoleOccupancy ;
    fnd:hasIdentity ex:spouse-occ-identity ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2024-06-01T00:01:00-04:00"^^xsd:dateTime ] ;
    pty:inRole ex:SpouseOrRepresentative ;
    ins:resolvedBy ex:spouse-resolution .

# From the Claim to whom it is made against, kept if an Insured Person under
# the CPL section's definition, which the fragment does not include.
ex:insured-person-resolution a ins:PartyResolution ;
    ins:resolvesFrom ex:Claim ;
    ins:resolutionStep [ a elg:EvidenceStep ; elg:stepIndex 0 ; elg:stepProperty ex:madeAgainst ; elg:stepDirection elg:Forward ] ;
    ins:resolutionFilter ex:is-insured-person .
ex:indemnifying-org-resolution a ins:PartyResolution ;
    ins:resolvesFrom ex:Claim ;
    ins:resolutionStep [ a elg:EvidenceStep ; elg:stepIndex 0 ; elg:stepProperty ex:indemnifiedBy ; elg:stepDirection elg:Forward ] ;
    ins:resolutionFilter ex:is-organization .
ex:spouse-resolution a ins:PartyResolution ;
    ins:resolvesFrom ex:Claim ;
    ins:resolutionStep [ a elg:EvidenceStep ; elg:stepIndex 0 ; elg:stepProperty ex:madeAgainst ; elg:stepDirection elg:Forward ] ;
    ins:resolutionFilter ex:is-spouse-or-representative .

