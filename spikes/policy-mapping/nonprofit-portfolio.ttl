tmpl:term-ccp-3n a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3n .
tmpl:excl-3n-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3n ;
