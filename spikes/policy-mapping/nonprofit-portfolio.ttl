    elg:hasCondition ex:insured-by-do , ex:securities-claim .
ex:securities-or-excess a elg:Condition ;
    elg:conditionKey "securities-or-excess" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AnySufficient ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:hasCondition ex:securities-claim , ex:excess-of-do .
ex:consented-costs-scope a elg:Condition ;
    elg:conditionKey "consented-costs-scope" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
