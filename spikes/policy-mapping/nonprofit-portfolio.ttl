ex:is-e-discovery-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the activity develops, collects, stores, organises, catalogues, preserves or produces electronically stored information""" .
ex:is-e-discovery a elg:Condition ;
