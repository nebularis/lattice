ex:inadequate-consideration-not-carved-back a elg:Condition ;
    elg:conditionKey "inadequate-consideration-not-carved-back" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
