ex:is-spouse-or-representative-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the person is a spouse, domestic partner, estate, heir or legal representative of an Insured Person""" .
ex:is-spouse-or-representative a elg:Condition ;
    elg:conditionKey "is-spouse-or-representative" ;
