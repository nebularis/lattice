    elg:requiredConcept ex:loss-before-actual-claim-fact .
ex:is-insured-person-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the person is an Insured Person under the CPL section""" .
ex:is-insured-person a elg:Condition ;
    elg:conditionKey "is-insured-person" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:is-insured-person-fact .
ex:is-organization-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the entity is an Organization""" .
