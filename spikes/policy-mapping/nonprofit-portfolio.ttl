ex:securities-adjudicated a elg:Condition ;
    elg:conditionKey "securities-adjudicated" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:hasCondition ex:securities-claim , ex:securities-conduct , ex:finally-adjudicated .
ex:conduct-adjudicated a elg:Condition ;
    elg:conditionKey "conduct-adjudicated" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AnySufficient ;
