ex:pending-or-prior-as-of-continuity a elg:Condition ;
    elg:conditionKey "pending-or-prior-as-of-continuity" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AnySufficient ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:hasCondition ex:litigation-by-continuity , ex:proceeding-with-notice .
ex:brought-by-organization-not-defense-costs a elg:Condition ;
    elg:conditionKey "brought-by-organization-not-defense-costs" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:hasCondition ex:brought-by-organization , ex:not-defense-costs .
ex:security-holder-claim-not-carved-back a elg:Condition ;
