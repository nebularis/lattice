    wrd:directlyComprises ex:var-tria-premium ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """TRIA Premium, Taxes and Surcharges: (a) TRIA Premium: """ ] ,
                    [ a wrd:TextPart ; wrd:partIndex 1 ; wrd:refersToVariable ex:var-tria-premium-identity ] ,
                    [ a wrd:TextPart ; wrd:partIndex 2 ;
        wrd:partText """. 'TRIA Premium' means the premium for Certified Acts of Terrorism Coverage under Terrorism Risk Insurance Act, as amended. Amount indicated above is included in Premium. A copy of the TRIA disclosure sent with the original quote is attached hereto.""" ] .
