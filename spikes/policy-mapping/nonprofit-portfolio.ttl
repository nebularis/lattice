    elg:conditionKey "erisa-not-counsel-to-fiduciary" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:hasCondition ex:erisa , ex:not-counsel-to-erisa-fiduciary .
ex:pollution-not-carved-back a elg:Condition ;
    elg:conditionKey "pollution-not-carved-back" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
