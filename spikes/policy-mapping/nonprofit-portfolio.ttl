ex:attestation a wrd:Text ;
    fnd:hasIdentity ex:attestation-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "Attestation" ; wrd:rankKey "a8" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """IN WITNESS WHEREOF, the Insurer has caused this Policy to be signed by its President, Secretary and Authorized Representative. This Policy shall not be valid unless signed below at the time of issuance by an authorized representative of the insurer.""" ] .

ex:tria-disclosure a wrd:Text ;
    fnd:hasIdentity ex:tria-disclosure-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "TRIA disclosure" ; wrd:rankKey "a3" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    ins:encodingStatus ins-voc:NoMeaning ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Policyholder Disclosure: Notice of Terrorism Insurance Coverage (Coverage Included). Coverage for acts of terrorism is included in your policy. [The statutory disclosure under the Terrorism Risk Insurance Act, as amended in 2015, follows: the Act's definition of an act of terrorism, the federal reimbursement percentages by year, and the $100 billion annual cap.] The portion of your annual premium that is attributable to coverage for acts of terrorism is $0, and does not include any charges for the portion of losses covered by the United States government under the Act.""" ] .

ex:gtc a wrd:Element ;
    fnd:hasIdentity ex:gtc-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Section ; wrd:objectId "General Terms and Conditions" ; wrd:rankKey "a4" ;
    wrd:directlyComprises ex:gtc-recital , ex:gtc-1 , ex:gtc-2 , ex:gtc-3 , ex:gtc-4 , ex:gtc-5 , ex:gtc-6 , ex:gtc-7 , ex:gtc-8 , ex:gtc-9 , ex:gtc-10 , ex:gtc-11 , ex:gtc-12 , ex:gtc-13 , ex:gtc-14 , ex:gtc-15 , ex:gtc-16 .
ex:gtc-recital a wrd:Text ;
    fnd:hasIdentity ex:gtc-recital-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC recital" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """In consideration of the payment of the premium, and each of their respective rights and obligations in this policy, the Insureds and the Insurer agree as follows:""" ] .
ex:gtc-1 a wrd:Text ;
    fnd:hasIdentity ex:gtc-1-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 1" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """These General Terms and Conditions shall apply to all Coverage Sections, unless any Coverage Section states specifically that all or part of these General Terms and Conditions shall not apply to such Coverage Section. The definitions, terms, conditions and limitations set forth in each Coverage Section shall apply only to that particular Coverage Section.""" ] .
ex:gtc-2 a wrd:Text ;
    fnd:hasIdentity ex:gtc-2-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 2" ; wrd:rankKey "a2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """The Insurer shall be liable only for the amount of Loss arising from each Claim or group of Related Claims that exceeds the Retention amount stated in Item 6 of the Declarations as applicable to the Coverage Section affording coverage to such Claim or group of Related Claims. Amounts within such Retention shall remain uninsured. A single Retention amount shall apply to each Claim or group of Related Claims. If a Claim or a group of Related Claims triggers more than one Coverage Section all of which are subject to a Shared Limit of Liability, the highest applicable Retention amount shall apply to such Claim or group of Related Claims. If a Claim or a group of Related Claims triggers more than one Coverage Section at least one of which is subject to a Separate Limit of Liability, the Retention applicable to Loss in connection with such Claim or group of Related Claims under any such Coverage Section subject to a Separate Limit of Liability shall apply separately to such Loss, and the applicable Retention for such Coverage Section shall not be satisfied by payments of Loss made towards the Retention required under any other Coverage Section.""" ] .
ex:gtc-3 a wrd:Text ;
    fnd:hasIdentity ex:gtc-3-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 3" ; wrd:rankKey "a3" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """The Policy Aggregate is the Insurer's maximum liability for all Loss under all Coverage Sections combined. Under no circumstances shall the Insurer be responsible to pay any Loss in excess of the Policy Aggregate. The term "Limits of Liability" refers to the several types of limits provided under this policy, including the Policy Aggregate, any Separate Limits of Liability, any Shared Limits of Liability, and any sublimits of liability set forth in any applicable Coverage Sections. If Separate Limits of Liability are stated in Item 6 of the Declarations, then each such Separate Limit of Liability shall be the maximum limit of the Insurer's liability for all Loss arising out of all Claims first made against the Insureds during the Policy Period or the Discovery Period (if applicable) with respect to the applicable Coverage Section as stated on the Declarations. Each Separate Limit of Liability shall be part of, and not in addition to, the Policy Aggregate for all Loss under this policy and shall in no way serve to increase the Policy Aggregate as therein stated. If Shared Limits of Liability are stated in Item 6 of the Declarations, then each such Shared Limit of Liability shall be the maximum limit of the Insurer's liability for all Loss arising out of all Claims first made against the Insureds during the Policy Period or the Discovery Period (if applicable) with respect to all Coverage Sections for which such Shared Limit of Liability is applicable, as indicated on the Declarations. In the event that the amount stated as a Shared Limit of Liability in Item 6 of the Declarations for a Coverage Section is less than the amount(s) stated for the other Coverage Section(s) with which it shares such Shared Limit of Liability, such lesser amount stated in Item 6 shall serve as the limit of liability for all Loss in the aggregate under such Coverage Section, subject to reduction through any prior payments of Loss under such Shared Limit of Liability. Each Shared Limit of Liability shall be part of, and not in addition to, the Policy Aggregate for all Loss under this policy and shall in no way serve to increase the Policy Aggregate as therein stated. Each sublimit of liability set forth in any Coverage Section is the maximum limit of the Insurer's liability for all Loss in the aggregate under this policy that is subject to that sublimit of liability. All sublimits of liability shall be part of, and not in addition to, the Policy Aggregate and any applicable Separate Limit of Liability or Shared Limit of Liability. All Related Claims that pursuant to the applicable Notice and Reporting Clause are considered made or received during the Policy Period or Discovery Period (if applicable), shall also be subject to the applicable Limits of Liability set forth in this policy. Each of the Limits of Liability for the Discovery Period (if applicable) shall be part of, and not in addition to, each of the corresponding Limits of Liability for the Policy Period. Defense Costs are not payable by the Insurer in addition to the Limits of Liability. Defense Costs are part of Loss and as such are subject to the Limits of Liability for Loss.""" ] .
ex:gtc-4 a wrd:Text ;
    fnd:hasIdentity ex:gtc-4-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 4" ; wrd:rankKey "a4" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Except as indicated below, if the Named Entity shall cancel or the Named Entity or the Insurer shall refuse to renew this policy, the Named Entity shall have the right to a period of up to six (6) years following the effective date of such cancellation or nonrenewal ("Discovery Period"), upon payment of an Additional Premium Amount described in each Coverage Section, in which to give written notice to the Insurer of: (i) Claims first made against an Insured; (ii) if provided by a purchased Coverage Section, Pre-Claim Inquiries first received by an Insured Person; and (iii) circumstances of which an Organization or an Insured shall become aware, in any such case, during the Discovery Period and solely with respect to any covered acts, errors, omissions, failures or violations (including but not limited to Wrongful Acts, Privacy Events and Security Failures) occurring prior to the end of the Policy Period and otherwise covered by this policy. In the event of a Transaction, the Named Entity shall have the right to request an offer from the Insurer of a Discovery Period with respect to covered acts, errors, omissions, failures or violations (including but not limited to Wrongful Acts, Privacy Events and Security Failures) occurring prior to the effective time of the Transaction and otherwise covered by this policy. The Insurer shall offer such Discovery Period pursuant to such terms, conditions, exclusions and additional premium as the Insurer may reasonably decide. In the event of a Transaction, the right to a Discovery Period shall not otherwise exist except as indicated in this paragraph. If the Named Entity exercises its right to purchase a Discovery Period, that period incepts at the end of the Policy Period or, if purchased in the event of a Transaction, as of the effective time of such Transaction. The right to purchase a Discovery Period shall terminate unless written notice of election, together with any additional premium due, is received by the Insurer no later than thirty (30) days after the effective date of the cancellation, nonrenewal or Transaction. Any Discovery Period is not cancelable and the additional premium charged is non-refundable in whole or in part. This Discovery Clause shall not apply to any cancellation resulting from non-payment of premium.""" ] .
ex:gtc-5 a wrd:Text ;
    fnd:hasIdentity ex:gtc-5-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 5" ; wrd:rankKey "a5" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """In the event of a Transaction, this policy shall continue in full force and effect only as to those covered acts, errors, omissions, failures or violations (including but not limited to Wrongful Acts, Privacy Events and Security Failures) occurring prior to the effective time of the Transaction and otherwise covered by this policy, and no portion of the premium paid for this policy shall be refundable. The Named Entity shall also have the right to an offer by the Insurer of a Discovery Period described in Clause 4 above. This policy may not be canceled after the effective time of the Transaction. Notwithstanding the foregoing, this policy may continue in full force and effect as to those covered acts, errors, omissions, failures or violations (including but not limited to Wrongful Acts, Privacy Events and Security Failures) occurring subsequent to the effective time of the Transaction and otherwise covered by this policy, if: (a) within thirty (30) days subsequent to the effective time of such Transaction the Insurer has been provided with full particulars of the Transaction, the related entity(ies) and any other information requested by the Insurer; and (b) the Insurer waives the restrictions set forth above with respect to such Transaction by written endorsement to this policy and the Named Entity or its successor has paid any additional premium and accepted any amendments to this policy required by the Insurer.""" ] .
ex:gtc-6 a wrd:Element ;
    fnd:hasIdentity ex:gtc-6-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 6" ; wrd:rankKey "a6" ;
    wrd:directlyComprises ex:gtc-6a , ex:gtc-6b , ex:gtc-6c .
ex:gtc-6a a wrd:Text ;
    fnd:hasIdentity ex:gtc-6a-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 6(a)" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    ins:encodingStatus ins-voc:NoMeaning ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Worldwide Territory. The coverage afforded by this policy shall apply anywhere in the world.""" ] .
ex:gtc-6b a wrd:Text ;
    fnd:hasIdentity ex:gtc-6b-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 6(b)" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Passport. If a Coverage Section is listed in Item 7 of the Declarations, then such Coverage Section and the applicable provisions of these General Terms and Conditions shall act as a master policy solely with respect to the coverage provided by such Coverage Section. The coverage afforded by such Coverage Section shall be provided in conjunction with the Passport foreign underlyer policy issued in each jurisdiction selected by the Named Entity. The specific structure of the coverage provided by such Coverage Section in conjunction with each Passport foreign underlyer policy is set forth in the Passport Structure Appendix for such Coverage Section that is attached to this policy.""" ] .
ex:gtc-6c a wrd:Text ;
    fnd:hasIdentity ex:gtc-6c-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 6(c)" ; wrd:rankKey "a2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Spousal, Domestic Partner and Legal Representative Extension. If a Claim against an Insured Person includes a Claim against: (1) the lawful spouse or legally recognized domestic partner of such Insured Person; or (2) a property interest of such spouse or domestic partner; and in either such case, such Claim arises from any actual or alleged Wrongful Acts of such Insured Person, this policy shall pay covered Loss arising from the Claim made against such spouse or domestic partner or the property of such spouse or domestic partner to the extent that such Loss does not arise from a Claim for any actual or alleged act, error or omission of such spouse or domestic partner. This policy shall pay covered Loss arising from a Claim made against the estates, heirs, or legal representatives of any deceased Insured Person, and the legal representatives of any Insured Person in the event of incompetence, insolvency or bankruptcy, who was an Insured Person at the time the Wrongful Acts upon which such Claim is based were alleged to have been committed.""" ] .
ex:gtc-7 a wrd:Element ;
    fnd:hasIdentity ex:gtc-7-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 7" ; wrd:rankKey "a7" ;
    wrd:directlyComprises ex:gtc-7a , ex:gtc-7b , ex:gtc-7c .
ex:gtc-7a a wrd:Text ;
    fnd:hasIdentity ex:gtc-7a-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 7(a)" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """By Named Entity: This policy may be canceled by the Named Entity at any time only by mailing written prior notice to the Insurer or by surrender of this policy to the Insurer's authorized agent or to the Insurer.""" ] .
ex:gtc-7b a wrd:Text ;
    fnd:hasIdentity ex:gtc-7b-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 7(b)" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """By the Insurer: This policy may be canceled by the Insurer only in the event of non-payment of premium by delivering to the Named Entity by registered, certified or other first class mail, at the Named Entity Address, written notice stating when, not less than fifteen (15) days, the cancellation shall be effective. Proof of mailing or delivery of such notice as aforesaid shall be sufficient proof of notice and this policy shall be deemed canceled as to all Insureds at the date and hour specified in such notice.""" ] .
ex:gtc-7c a wrd:Text ;
    fnd:hasIdentity ex:gtc-7c-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 7(c)" ; wrd:rankKey "a2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Return of Premium: If this policy shall be canceled, the Insurer shall retain the pro rata proportion of the premium hereon.""" ] .
ex:gtc-8 a wrd:Text ;
    fnd:hasIdentity ex:gtc-8-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 8" ; wrd:rankKey "a8" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """In the event the Insurer recovers amounts it paid under this policy, the Insurer shall reinstate the Limits of Liability of this policy to the extent of such recovery, less its costs incurred in administering and obtaining such recovery. The Insurer assumes no duty to seek a recovery of any amounts paid under this policy.""" ] .
ex:gtc-9 a wrd:Text ;
    fnd:hasIdentity ex:gtc-9-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 9" ; wrd:rankKey "a9" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Except for the giving of a notice of Claim, which shall be governed by the Notice and Reporting Clause of the applicable Coverage Section, all notices required under this policy to be given by an Insured to the Insurer shall be given in writing to the Insurer at the Insurer Address. It is agreed that the Named Entity shall act on behalf of all Insureds with respect to the giving of notice of a Claim, Pre-Claim Inquiry, Crisis or circumstances, the giving and receiving of notice of conditional renewal, premium increase, nonrenewal and cancellation, the payment of premiums and the receiving of any return premiums that may become due under this policy, the receipt and acceptance of any endorsements issued to form a part of this policy, the exercising or declining of the right to tender the defense of a Claim, Crisis or circumstance to the Insurer, and the exercising or declining to exercise any right to a Discovery Period.""" ] .
ex:gtc-10 a wrd:Text ;
    fnd:hasIdentity ex:gtc-10-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 10" ; wrd:rankKey "b0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """This policy and any and all rights hereunder are not assignable without the prior written consent of the Insurer.""" ] .
ex:gtc-11 a wrd:Text ;
    fnd:hasIdentity ex:gtc-11-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 11" ; wrd:rankKey "b1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Except as provided in any Alternative Dispute Resolution Clause of a Coverage Section, no action shall lie against the Insurer unless, as a condition precedent thereto, there shall have been full compliance with all of the terms of this policy, nor until the amount of an Insured's obligation to pay shall have been finally determined either by judgment against such Insured after actual trial or by written agreement of such Insured, the claimant and the Insurer. Any Insured or the legal representative thereof who has secured such judgment or written agreement shall be entitled thereafter to recover under this policy to the extent of the insurance afforded by this policy. No person or organization shall have any right under this policy to join the Insurer as a party to any action against an Insured or the Named Entity to determine an Insured's liability, nor shall the Insurer be impleaded by any Insured or by any spouse, domestic partner or legal representative thereof.""" ] .
ex:gtc-12 a wrd:Text ;
    fnd:hasIdentity ex:gtc-12-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 12" ; wrd:rankKey "b2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Bankruptcy or insolvency of any Insured or of their estates shall not relieve the Insurer of any of its obligations under this policy. In such event, the Insurer and each Insured agree to cooperate in any efforts by the Insurer or any Insured to obtain relief for the benefit of the Insured Persons from any stay or injunction applicable to the distribution of the policy proceeds.""" ] .
ex:gtc-13 a wrd:Text ;
    fnd:hasIdentity ex:gtc-13-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 13" ; wrd:rankKey "b3" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """In the event that there is an inconsistency between: (i) any period of limitation in this policy relating to the giving of notice of cancellation or discovery/extended reporting election, and (ii) the minimum or maximum period required by applicable law, where such law allows, the Insurer will resolve the inconsistency by applying the notice period that is more favorable to the Insureds. Otherwise, the notice period is hereby amended to the extent necessary to conform to applicable law. Coverage under this policy shall not be provided to the extent prohibited by any law.""" ] .
ex:gtc-14 a wrd:Text ;
    fnd:hasIdentity ex:gtc-14-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 14" ; wrd:rankKey "b4" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """All premiums, limits, retentions, Loss and other amounts under this policy are expressed and payable in the currency of the United States of America. If judgment is rendered, settlement is denominated or other elements of Loss are stated or incurred in a currency other than United States of America dollars, payment of covered Loss due under this policy (subject to the terms, conditions and limitations of this policy) will be made either in such other currency (at the option of the Insurer and if agreeable to the Named Entity) or, in United States of America dollars, at the rate of exchange published in The Wall Street Journal on the date the Insurer's obligation to pay such Loss is established (or if not published on such date the next publication date of The Wall Street Journal).""" ] .
ex:gtc-15 a wrd:Text ;
    fnd:hasIdentity ex:gtc-15-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 15" ; wrd:rankKey "b5" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    ins:encodingStatus ins-voc:NoMeaning ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """The descriptions in the headings of this policy are solely for convenience, and form no part of the terms and conditions of coverage.""" ] .
ex:gtc-16 a wrd:Element ;
    fnd:hasIdentity ex:gtc-16-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 16" ; wrd:rankKey "b6" ;
    wrd:directlyComprises ex:gtc-16a , ex:gtc-16b , ex:gtc-16c .
ex:gtc-16a a wrd:Text ;
    fnd:hasIdentity ex:gtc-16a-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 16(a)" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Terms appearing in bold in a Coverage Section shall have the meaning and/or value ascribed to them in the Definitions Clause of that Coverage Section. If a term appearing in bold in a Coverage Section is not defined in the Definitions Clause of that Coverage Section, then the meaning and/or value ascribed to such term in the Declarations or below in Clause 16(c) Definitions of General Applicability shall apply for purposes of coverage provided under that particular Coverage Section. Certain terms, including without limitation the following, appear in bold and are defined in more than one Coverage Section: (1) Claim; (2) Crisis; (3) Defense Costs; (4) Insured; (5) Insured Person; (6) Loss; (7) Pre-Claim Inquiry; (8) Privacy Event; (9) Related Claim; (10) Security Failure; (11) Wrongful Act. Each of these terms shall have the meaning ascribed to the term in a Coverage Section in which the term appears, but that meaning shall apply solely for purposes of coverage provided under that particular Coverage Section.""" ] .
ex:gtc-16b a wrd:Text ;
    fnd:hasIdentity ex:gtc-16b-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 16(b)" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Terms appearing in bold in these General Terms and Conditions and not defined below in Clause 16(c) Definitions of General Applicability shall have the meaning and/or value ascribed to them in the Declarations or in a particular Coverage Section for purposes of coverage provided under that particular Coverage Section.""" ] .
ex:gtc-16c a wrd:Element ;
    fnd:hasIdentity ex:gtc-16c-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "GTC 16(c)" ; wrd:rankKey "a2" ;
    wrd:directlyComprises ex:def-continuity , ex:def-coverage-section , ex:def-e-consultant , ex:def-e-discovery , ex:def-e-services , ex:def-enforcement-body , ex:def-foreign-jurisdiction , ex:def-organization , ex:def-policy-period , ex:def-retroactive , ex:def-separate-limit , ex:def-shared-limit , ex:def-transaction .
ex:def-continuity a wrd:Text ;
    fnd:hasIdentity ex:def-continuity-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Continuity Date" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Continuity Date" means the date set forth in Item 6 of the Declarations with respect to each Coverage Section.""" ] .
ex:def-coverage-section a wrd:Text ;
    fnd:hasIdentity ex:def-coverage-section-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Coverage Section" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Coverage Section" means each Coverage Section that is purchased by the Named Entity as reflected in Item 6 of the Declarations.""" ] .
ex:def-e-consultant a wrd:Text ;
    fnd:hasIdentity ex:def-e-consultant-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) E-Consultant Firm" ; wrd:rankKey "a2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"E-Consultant Firm" means a pre-approved e-discovery consulting firm. A list of pre-approved E-Consultant Firms is accessible through [the Insurer's online panel directory] under the "e-Consultant Panel Members" link.""" ] .
ex:def-e-discovery a wrd:Text ;
    fnd:hasIdentity ex:def-e-discovery-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) E-Discovery" ; wrd:rankKey "a3" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"E-Discovery" means the development, collection, storage, organization, cataloging, preservation and/or production of electronically stored information.""" ] .
ex:def-e-services a wrd:Text ;
    fnd:hasIdentity ex:def-e-services-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) E-Discovery Consultant Services" ; wrd:rankKey "a4" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"E-Discovery Consultant Services" means solely the following services performed by an E-Consultant Firm: (1) assisting the Insured with managing and minimizing the internal and external costs associated with E-Discovery; (2) assisting the Insured in developing or formulating an E-Discovery strategy which shall include interviewing qualified and cost effective E-Discovery vendors; (3) serving as project manager, advisor and/or consultant to the Insured, defense counsel and the Insurer in executing and monitoring the E-Discovery strategy; and (4) such other services provided by the E-Discovery Consultant Firm that the Insured, Insurer and E-Discovery Consultant Firm agree are reasonable and necessary given the circumstances of the Claim.""" ] .
ex:def-enforcement-body a wrd:Text ;
    fnd:hasIdentity ex:def-enforcement-body-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Enforcement Body" ; wrd:rankKey "a5" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Enforcement Body" means: (1) any federal, state, local or foreign law enforcement authority or other governmental investigative authority (including, but not limited to, the U.S. Department of Justice, the U.S. Securities and Exchange Commission and any attorney general), or (2) the enforcement unit of any securities or commodities exchange or other self-regulatory organization.""" ] .
ex:def-foreign-jurisdiction a wrd:Text ;
    fnd:hasIdentity ex:def-foreign-jurisdiction-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Foreign Jurisdiction" ; wrd:rankKey "a6" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Foreign Jurisdiction" means any jurisdiction, other than the United States of America or any of its territories or possessions.""" ] .
ex:def-organization a wrd:Text ;
    fnd:hasIdentity ex:def-organization-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Organization" ; wrd:rankKey "a7" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Organization" means: (1) the Named Entity; (2) each Subsidiary; and (3) in the event a bankruptcy proceeding shall be instituted by or against any of the foregoing entities, the resulting debtor-in-possession (or equivalent status outside the United States of America), if any.""" ] .
ex:def-policy-period a wrd:Text ;
    fnd:hasIdentity ex:def-policy-period-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Policy Period" ; wrd:rankKey "a8" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Policy Period" means the period of time from the Inception Date to the earlier of the Expiration Date or the effective date of cancellation of this policy. The Policy Period incepts and expires as of 12:01 A.M. on such dates at the Named Entity Address.""" ] .
ex:def-retroactive a wrd:Text ;
    fnd:hasIdentity ex:def-retroactive-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Retroactive Date" ; wrd:rankKey "a9" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Retroactive Date" means the date set forth in Item 6 of the Declarations as such for each Coverage Section.""" ] .
ex:def-separate-limit a wrd:Text ;
    fnd:hasIdentity ex:def-separate-limit-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Separate Limit of Liability" ; wrd:rankKey "b0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Separate Limit of Liability" means the applicable Separate Limit of Liability, if any, stated in Item 6 of the Declarations.""" ] .
ex:def-shared-limit a wrd:Text ;
    fnd:hasIdentity ex:def-shared-limit-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Shared Limit of Liability" ; wrd:rankKey "b1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Shared Limit of Liability" means the applicable Shared Limit of Liability, if any, stated in Item 6 of the Declarations, which limit of liability shall be shared between all of the Coverage Sections which are listed as being subject to such Shared Limit of Liability in the Declarations.""" ] .
ex:def-transaction a wrd:Text ;
    fnd:hasIdentity ex:def-transaction-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Definition ; wrd:objectId "16(c) Transaction" ; wrd:rankKey "b2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """"Transaction" means: (1) the Named Entity consolidating with or merging into another entity such that the Named Entity is not the surviving entity, or selling all or substantially all of its assets to any other person or entity or group of persons or entities acting in concert; (2) any person or entity or group of persons or entities acting in concert acquiring Management Control of the Named Entity; or (3) any additional meaning ascribed to the term Transaction in any Coverage Section, but such additional meaning shall apply solely to the coverage provided by such Coverage Section.""" ] .

ex:do a wrd:Element ;
    fnd:hasIdentity ex:do-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Section ; wrd:objectId "Non-Profit D&O Coverage Section" ; wrd:rankKey "a5" .

ex:epl a wrd:Element ;
    fnd:hasIdentity ex:epl-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Section ; wrd:objectId "EPL Coverage Section" ; wrd:rankKey "a6" .

ex:fid a wrd:Element ;
    fnd:hasIdentity ex:fid-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Section ; wrd:objectId "Fiduciary Coverage Section" ; wrd:rankKey "a7" .

ex:cpl a wrd:Element ;
    fnd:hasIdentity ex:cpl-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Section ; wrd:objectId "CPL Coverage Section" ; wrd:rankKey "a8" ;
    wrd:directlyComprises ex:cpl-notice , ex:cpl-recital , ex:ccp-1 , ex:ccp-2 , ex:ccp-3 , ex:ccp-4 , ex:ccp-5 .
ex:cpl-notice a wrd:Text ;
    fnd:hasIdentity ex:cpl-notice-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL notice" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Notice: Pursuant to Clause 1 of the General Terms and Conditions, the General Terms and Conditions are incorporated by reference into, made a part of, and are expressly applicable to this CPL Coverage Section, unless otherwise explicitly stated to the contrary in this CPL Coverage Section.""" ] .
ex:cpl-recital a wrd:Text ;
    fnd:hasIdentity ex:cpl-recital-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL recital" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """In consideration of the payment of the premium, and each of their respective rights and obligations in this policy, the Insureds and the Insurer agree as follows:""" ] .
ex:ccp-1 a wrd:Text ;
    fnd:hasIdentity ex:ccp-1-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 1" ; wrd:rankKey "a2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Insuring Agreements. All coverage granted for Loss under this Coverage Section is provided solely with respect to Claims first made against an Insured during the Policy Period or any applicable Discovery Period and reported to the Insurer as required by this Coverage Section. Subject to the foregoing and the other terms, conditions and limitations of this policy, this Coverage Section affords the following coverage: A. Counsel Professional Liability. This policy shall pay amounts an Insured Person is legally obligated to pay as Loss arising from any Claim made against such Insured Person for Wrongful Acts, except when and to the extent that the Organization has indemnified the Insured Person for such Loss. B. Organization Indemnification of Insured Persons. This policy shall pay amounts the Organization is legally obligated to pay as Loss arising from any Claim made against an Insured Person for Wrongful Acts, but only to the extent that the Organization has indemnified the Insured Person for such Loss.""" ] .
ex:ccp-2 a wrd:Element ;
    fnd:hasIdentity ex:ccp-2-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2" ; wrd:rankKey "a3" ;
    wrd:directlyComprises ex:ccp-2a , ex:ccp-2b , ex:ccp-2c , ex:ccp-2d .
ex:ccp-2a a wrd:Text ;
    fnd:hasIdentity ex:ccp-2a-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(a)" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """The Insurer's Duty To Defend: The Insurer has the right and duty to defend a Claim brought against an Insured Person for Wrongful Acts, even if the Claim is groundless, false or fraudulent. The Insurer shall pay for Defense Costs incurred in the defense of a Claim for Wrongful Acts. The Insurer shall have no duty to defend a Claim insured by D&O Coverage or a Securities Claim.""" ] .
ex:ccp-2b a wrd:Text ;
    fnd:hasIdentity ex:ccp-2b-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(b)" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Defense Costs: The Insurer shall indemnify for Defense Costs incurred in: (i) any Securities Claim; or (ii) in any Claim where the coverage afforded by this Coverage Section is excess of D&O Coverage, provided that such Defense Costs are incurred with the Insurer's prior written consent in the defense of Wrongful Acts.""" ] .
ex:ccp-2c a wrd:Text ;
    fnd:hasIdentity ex:ccp-2c-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(c)" ; wrd:rankKey "a2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """When the Insurer's Duty Ends: The Insurer's duty to defend and any obligation to indemnify an Insured Person shall end: (i) once the Policy Aggregate or any applicable Separate Limit of Liability or Shared Limit of Liability has been exhausted by payment of Defense Costs or Loss; or (ii) if the Insured Person or, if applicable, an Organization, fails or refuses to consent to a settlement that the Insurer recommends and the claimant will accept. The Insured Person must then defend the Claim at their own expense. As a consequence of such failure or refusal to consent, the Insurer's liability for Loss shall not exceed the amount for which the Insurer could have settled such Claim had the Insured Person or, if applicable, an Organization, consented, plus Defense Costs incurred prior the time the Insurer made such recommendation, plus seventy percent (70%) of Defense Costs incurred with the Insurer's consent after the date of the Insured Person's or, if applicable, an Organization's refusal. Provided, however, this subparagraph (c)(ii) shall not apply to the settlement of the following proceedings that are brought in connection with a Securities Claim when such settlement would require an Insured Person to enter into a plea of guilty: (1) criminal proceeding commenced by a return of an indictment, information, notice of charges or similar document; or (2) a civil, administrative or regulatory investigation of an Insured Person by the Securities and Exchange Commission, Department of Justice or a similar state or foreign government authority, commenced by the service of a subpoena on such Insured Person.""" ] .
ex:ccp-2d a wrd:Element ;
    fnd:hasIdentity ex:ccp-2d-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(d)" ; wrd:rankKey "a3" ;
    wrd:directlyComprises ex:ccp-2d1 , ex:ccp-2d2 , ex:ccp-2d3 , ex:ccp-2d4 , ex:ccp-2d5 , ex:ccp-2d6 .
ex:ccp-2d1 a wrd:Text ;
    fnd:hasIdentity ex:ccp-2d1-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(d)(1)" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """In addition to providing notice as required under this Coverage Section, each and every Insured Person and Organization must also: (i) send the Insurer copies of all demands, suit papers, other legal documents and invoices for Defense Costs received by such Insured Person, as soon as practicable; (ii) immediately record the specifics of any Claim and the date such Insured Person first received such Claim; (iii) upon the Insurer's request, furnish to the Insurer any and all documentation within the possession of the Insured Person; and (iv) give to the Insurer, and to any counsel the Insurer selects to represent an Insured Person in connection with a Claim, full cooperation and such information as the Insurer or the counsel may require, including, but not limited to, assisting the Insurer or the counsel in: (1) any investigation of a Claim, or other matter relating to the coverage afforded under this Coverage Section (including submission to an examination by the Insurer or the Insurer's designee, under oath if required by the Insurer); (2) making settlements; (3) enforcing any legal rights any Insured Person or the Insurer may have against any person or entity who may be liable to an Insured Person; (4) attending depositions, hearings and trials; (5) securing and giving evidence, and obtaining the attendance of witnesses; and (6) any inspection or survey conducted by the Insurer.""" ] .
ex:ccp-2d2 a wrd:Text ;
    fnd:hasIdentity ex:ccp-2d2-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(d)(2)" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """No Insured Person or Organization shall admit any liability, settle any Claim, assume any financial obligation or pay any money in connection with any Claim without the Insurer's prior written consent. If any Insured Person or Organization does, it will be at their own expense and such amounts shall not be applied to the applicable Retention.""" ] .
ex:ccp-2d3 a wrd:Text ;
    fnd:hasIdentity ex:ccp-2d3-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(d)(3)" ; wrd:rankKey "a2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """The Insurer shall have the right to associate fully and effectively with each and every Insured Person and, with respect to Insuring Agreement B. Organization Indemnification of Insured Persons, the Organization, in the defense of any Claim or any matter that involves or appears reasonably likely to involve, the Insurer, including, but not limited to, negotiating a settlement.""" ] .
ex:ccp-2d4 a wrd:Text ;
    fnd:hasIdentity ex:ccp-2d4-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(d)(4)" ; wrd:rankKey "a3" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """This Coverage Section affords no coverage for Defense Costs incurred by, settlements by or on behalf of, contractual obligations of, or judgments against any entity whether arising out of a Claim made against the Organization, based upon any legal obligation to pay any amount that the Organization has or may have to a claimant, or derived from the acts or omissions of Insured Persons. No Organization is covered in any respect under Insuring Agreement A. Counsel Professional Liability or under Clause 2. DEFENSE AND SETTLEMENT. The Organization is covered, subject to this Coverage Section's terms, conditions, exclusions and other limitations only with respect to its indemnification of Insured Persons under Insuring Agreement B. Organization Indemnification of Insured Persons as respects a Claim against such Insured Person.""" ] .
ex:ccp-2d5 a wrd:Text ;
    fnd:hasIdentity ex:ccp-2d5-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(d)(5)" ; wrd:rankKey "a4" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Panel Counsel: The following shall only apply to a Securities Claims and related Claims for which there is no other D&O Coverage: The list of approved panel counsel law firms ("Panel Counsel") is accessible through [the Insurer's online panel directory] under the "Directors & Officers (Securities Claims)" link. The list provides the Insureds with a choice of law firms from which a selection of legal counsel shall be made to conduct the defense of any Securities Claim made against such Insureds. With the express prior written consent of the Insurer, an Insured may select a Panel Counsel different from that selected by another Insured defendant if such selection is required due to an actual conflict of interest or is otherwise reasonably justifiable. The list of Panel Counsel may be amended from time to time by the Insurer. However, if a firm is removed from the list during the Policy Period, the Insureds shall be entitled to select such firm to conduct the defense of any Securities Claim made against such Insureds during the Policy Period. The Insureds shall select a Panel Counsel to defend the Securities Claim made against the Insureds in the jurisdiction in which the Securities Claim is brought. In the event the Claim is brought in a jurisdiction not included on the list, the Insureds shall select a Panel Counsel in the listed jurisdiction which is the nearest geographic jurisdiction to either where the Securities Claim is brought or where the headquarters of the Named Entity is located. In such instance the Insureds also may, with the express prior written consent of the Insurer, which consent shall not be unreasonably withheld, select a non-Panel Counsel in the jurisdiction in which the Securities Claim is brought to function as "local counsel" on the Claim to assist the Panel Counsel which will function as "lead counsel" in conducting the defense of the Securities Claim.""" ] .
ex:ccp-2d6 a wrd:Text ;
    fnd:hasIdentity ex:ccp-2d6-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 2(d)(6)" ; wrd:rankKey "a5" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """In all events, no Insured Person shall intentionally take any action, or fail to take any required action, which prejudices the Insurer's rights.""" ] .
ex:ccp-3 a wrd:Element ;
    fnd:hasIdentity ex:ccp-3-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3" ; wrd:rankKey "a4" ;
    wrd:directlyComprises ex:ccp-3-intro , ex:ccp-3a , ex:ccp-3a-imputation , ex:ccp-3b , ex:ccp-3c , ex:ccp-3d , ex:ccp-3e , ex:ccp-3f , ex:ccp-3g , ex:ccp-3h , ex:ccp-3i , ex:ccp-3j , ex:ccp-3wage , ex:ccp-3k , ex:ccp-3l , ex:ccp-3m , ex:ccp-3n , ex:ccp-3o , ex:ccp-3p , ex:ccp-3q , ex:ccp-3r .
ex:ccp-3-intro a wrd:Text ;
    fnd:hasIdentity ex:ccp-3-intro-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3 intro" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Exclusions. The Insurer shall not be liable to make any payment for Loss in connection with any Claim made against an Insured Person:""" ] .
ex:ccp-3a a wrd:Text ;
    fnd:hasIdentity ex:ccp-3a-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(a)" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(a) arising out of, based upon or attributable to: (i) with respect to all Claims other than Securities Claims, any: (1) dishonest, fraudulent, criminal or malicious act or omission (other than malicious prosecution), (2) intentional or knowing violation of the law, (3) profit, remuneration or pecuniary advantage to which an Insured Person was not legally entitled, or (4) commingling, misappropriation, or improper use of funds; provided, however, the Insurer will defend a Claim against an Insured Person alleging any of the foregoing conduct until there is a final judgment against, final adjudication against, adverse finding of fact against in a binding arbitration proceeding or plea of guilty or no contest by an Insured Person as to such conduct, at which time the Insured Person shall reimburse the Insurer for Defense Costs; or (ii) with respect to Securities Claims, any: (1) deliberate criminal or deliberate fraudulent act; or (2) profit, remuneration or pecuniary advantage to which an Insured Person was not legally entitled; provided, however, the Insurer will defend a Securities Claim against an Insured Person alleging any of the foregoing conduct until there is a final judgment against, final adjudication against, adverse finding of fact against or plea of guilty or no contest by an Insured Person as to such conduct, at which time the Insured Person shall reimburse the Insurer for Defense Costs;""" ] .
ex:ccp-3a-imputation a wrd:Text ;
    fnd:hasIdentity ex:ccp-3a-imputation-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(a) imputation" ; wrd:rankKey "a2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """For the purpose of determining the applicability of the foregoing Exclusion 3(a): (1) the facts pertaining to and knowledge possessed by any Insured Person shall not be imputed to any other Insured Person; and (2) only facts pertaining to and knowledge possessed by any past, present or future chairman of the board, president, chief executive officer, chief operating officer, chief financial officer or General Counsel (or equivalent positions) of an Organization shall be imputed to an Organization.""" ] .
ex:ccp-3b a wrd:Text ;
    fnd:hasIdentity ex:ccp-3b-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(b)" ; wrd:rankKey "a3" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(b) alleging, arising out of, based upon, or attributable to employment of any individual or any employment practice (including but not limited to wrongful dismissal, discharge or termination, discrimination, harassment, retaliation or other employment-related claim); provided, however, this exclusion shall not apply to the Legal Services provided by an Insured Person in connection with the employment of any individual or any employment practice, whether such Legal Services are provided to a third party or to an Organization;""" ] .
ex:ccp-3c a wrd:Text ;
    fnd:hasIdentity ex:ccp-3c-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(c)" ; wrd:rankKey "a4" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(c) alleging, arising out of, based upon or attributable to any Wrongful Act committed or omitted prior to the Retroactive Date or any related Wrongful Act thereto, regardless of when such related Wrongful Act is committed or omitted;""" ] .
ex:ccp-3d a wrd:Text ;
    fnd:hasIdentity ex:ccp-3d-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(d)" ; wrd:rankKey "a5" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(d) alleging, arising out of, based upon or attributable to the facts alleged, or to the same or related Wrongful Act(s) alleged or contained in any claim which has been reported, or in any circumstances of which notice has been given, under any policy of which this Coverage Section is a renewal or replacement of in whole or in part or which it may succeed in time;""" ] .
ex:ccp-3e a wrd:Text ;
    fnd:hasIdentity ex:ccp-3e-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(e)" ; wrd:rankKey "a6" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(e) alleging, arising out of, based upon or attributable to, as of the Continuity Date, any pending or prior: (i) litigation; or (ii) administrative or regulatory proceeding or investigation of which an Insured had notice, or alleging any Wrongful Act which is the same or related Wrongful Act(s) to that alleged in such pending or prior litigation or administrative or regulatory proceeding or investigation;""" ] .
ex:ccp-3f a wrd:Text ;
    fnd:hasIdentity ex:ccp-3f-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(f)" ; wrd:rankKey "a7" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(f) alleging, arising out of, based upon or attributable to any bodily injury, sickness, disease or death of any person, or damage to, loss of use of or destruction of any tangible property;""" ] .
ex:ccp-3g a wrd:Text ;
    fnd:hasIdentity ex:ccp-3g-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(g)" ; wrd:rankKey "a8" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(g) against an Insured Person that is brought, directly or indirectly, by or on behalf an Organization; provided, however, this exclusion shall not apply to Defense Costs incurred in connection with such Claim;""" ] .
ex:ccp-3h a wrd:Text ;
    fnd:hasIdentity ex:ccp-3h-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(h)" ; wrd:rankKey "a9" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(h) that is brought by a security holder or member of an Organization, whether directly or derivatively, unless such security holder or member Claim is instigated and continued totally independent of, and totally without the solicitation of, or assistance of, or active participation of, or intervention of an Insured Person, an Organization or any Executive of an Organization; provided, however, this exclusion shall not apply to: (i) any Claim brought by any past Executive of an Organization who has not served as a duly elected or appointed director, officer, trustee, governor, management committee member, member of the management board, General Counsel or Risk Manager (or equivalent position) of or consultant for an Organization for at least four (4) years prior to such Claim being first made against any person; or (ii) any Claim brought by an Executive of an Organization formed and operating in a Foreign Jurisdiction against such Organization or any Executive thereof, provided that such Claim is brought and maintained outside the United States of America, Canada or any other common law country (including any territories thereof);""" ] .
ex:ccp-3i a wrd:Text ;
    fnd:hasIdentity ex:ccp-3i-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(i)" ; wrd:rankKey "b0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(i) for any violation of responsibilities, obligations or duties imposed by the Employee Retirement Income Security Act of 1974 (ERISA), as amended, or any similar provisions of any state, local or foreign statutory or common law; provided, however, this exclusion shall not apply to Claims arising out of a Corporate Counsel providing Legal Services to an ERISA fiduciary;""" ] .
ex:ccp-3j a wrd:Text ;
    fnd:hasIdentity ex:ccp-3j-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(j)" ; wrd:rankKey "b1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(j) for violation(s) of any of the responsibilities, obligations or duties imposed by the Fair Labor Standards Act (except the Equal Pay Act), the National Labor Relations Act, the Worker Adjustment and Retraining Notification Act, the Consolidated Omnibus Budget Reconciliation Act, the Occupational Safety and Health Act, any rules or regulations of the foregoing promulgated thereunder, and amendments thereto or any similar federal, state, local or foreign statutory law or common law;""" ] .
ex:ccp-3wage a wrd:Text ;
    fnd:hasIdentity ex:ccp-3wage-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3 (j) wage and hour" ; wrd:rankKey "b2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """It is further understood and agreed that the Insurer shall not be liable to make any payment for Loss in connection with a Claim made against an Insured Person alleging, arising out of, based upon, attributable to or in any way relating to: (i) the refusal, failure or inability of any Insured Person(s), Employee, Executive of the Organization or Organization to pay wages or overtime pay (or amounts representing such wages or overtime pay) for services rendered (as opposed to tort-based back pay or front pay damages for torts other than conversion); (ii) improper payroll deductions taken by any Insured Person(s), Employee, Executive of the Organization or Organization from any Employee(s) or purported Employee(s); or (iii) the failure to provide or enforce legally required meal or rest break periods;""" ] .
ex:ccp-3k a wrd:Text ;
    fnd:hasIdentity ex:ccp-3k-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(k)" ; wrd:rankKey "b3" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(k) alleging, arising out of, based upon or attributable to any actual or alleged breach of duty, neglect, error, misstatement, misleading statement or omission by an Insured Person in any capacity other than when providing Legal Services;""" ] .
ex:ccp-3l a wrd:Text ;
    fnd:hasIdentity ex:ccp-3l-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(l)" ; wrd:rankKey "b4" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(l) alleging, arising out of, based upon or attributable to; (i) any actual or threatened discharge, dispersal, release or escape of Pollutants; or (ii) any direction or request to test for, monitor, clean up, remove, contain, treat, detoxify or neutralize Pollutants; provided, however, this exclusion shall not apply to Claims alleging any of the foregoing where the underlying Legal Services performed by an Insured Person giving rise to such Claim were not the direct immediate cause of the foregoing;""" ] .
ex:ccp-3m a wrd:Text ;
    fnd:hasIdentity ex:ccp-3m-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(m)" ; wrd:rankKey "b5" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(m) alleging, arising out of, based upon or attributable to any misappropriation of a trade secret;""" ] .
ex:ccp-3n a wrd:Text ;
    fnd:hasIdentity ex:ccp-3n-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(n)" ; wrd:rankKey "b6" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(n) alleging, arising out of, based upon or attributable to any services performed by any contract, seasonal, part-time or leased lawyer other than Legal Services provided for the Organization at the direction of Corporate Counsel;""" ] .
ex:ccp-3o a wrd:Text ;
    fnd:hasIdentity ex:ccp-3o-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(o)" ; wrd:rankKey "b7" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(o) alleging, arising out of, based upon or attributable to any Insured Person notarizing, certifying or acknowledging any signature not signed by such Insured Person at the time of such notarization, certification or acknowledgment;""" ] .
ex:ccp-3p a wrd:Text ;
    fnd:hasIdentity ex:ccp-3p-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(p)" ; wrd:rankKey "b8" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(p) alleging, arising out of, based upon or attributable to the return or restitution of fees, expenses or costs, or other disgorgement;""" ] .
ex:ccp-3q a wrd:Text ;
    fnd:hasIdentity ex:ccp-3q-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(q)" ; wrd:rankKey "b9" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(q) alleging, arising out of, based upon or attributable to the price or consideration paid or proposed to be paid for the acquisition or completion of the acquisition of all or substantially all of the ownership interest in or assets of any entity is inadequate; provided, however, this exclusion shall not apply to Defense Costs or to any Non-Indemnifiable Loss in connection therewith; or""" ] .
ex:ccp-3r a wrd:Text ;
    fnd:hasIdentity ex:ccp-3r-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 3(r)" ; wrd:rankKey "c0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """(r) for compensation, salary, wages, fees, benefits, overhead, charges or expenses of any: (i) Insured Person; (ii) Employee; (iii) Executive of the Organization; or (iv) Organization.""" ] .
ex:ccp-4 a wrd:Text ;
    fnd:hasIdentity ex:ccp-4-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 4" ; wrd:rankKey "a5" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Retention. In addition to the provisions of Clause 2. RETENTION of the General Terms and Conditions, in no event shall a Retention be applied to: (i) Non-Indemnifiable Loss; or (ii) Securities Claims to which, pursuant to Clause 6. OTHER INSURANCE, this Coverage Section applies only as excess.""" ] .
ex:ccp-5 a wrd:Element ;
    fnd:hasIdentity ex:ccp-5-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 5" ; wrd:rankKey "a6" ;
    wrd:directlyComprises ex:ccp-5-intro , ex:ccp-5a , ex:ccp-5b , ex:ccp-5c .
ex:ccp-5-intro a wrd:Text ;
    fnd:hasIdentity ex:ccp-5-intro-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 5 intro" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Notice and Reporting. Notice hereunder shall be given in writing to the Insurer at the Claims Address indicated in the Declarations. If mailed or transmitted by electronic mail, the date of such mailing or transmission shall constitute the date that such notice was given and proof of mailing or transmission shall be sufficient proof of notice.""" ] .
ex:ccp-5a a wrd:Text ;
    fnd:hasIdentity ex:ccp-5a-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 5(a)" ; wrd:rankKey "a1" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Reporting a Claim. An Organization or an Insured shall, as a condition precedent to the obligations of the Insurer under this policy notify the Insurer in writing of a Claim made against an Insured as soon as practicable after the Named Entity's Risk Manager or General Counsel (or equivalent position) first becomes aware of the Claim. In all such events, notification must be provided no later than 90 days after the end of the Policy Period or the Discovery Period (if applicable).""" ] .
ex:ccp-5b a wrd:Text ;
    fnd:hasIdentity ex:ccp-5b-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 5(b)" ; wrd:rankKey "a2" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Relation Back to the First Reported Claim. Solely for the purpose of establishing whether any subsequent Related Claim was first made during the Policy Period or Discovery Period (if applicable), if during any such period a Claim was first made and reported in accordance with Clause 5(a) above, then any Related Claim that is subsequently made against an Insured and that is reported in accordance with Clause 5(a) above shall be deemed to have been first made at the time that such previously reported Claim was first made. With respect to any subsequent Related Claim, this policy shall not cover Loss incurred before such subsequent Related Claim is actually made against an Insured.""" ] .
ex:ccp-5c a wrd:Text ;
    fnd:hasIdentity ex:ccp-5c-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "CPL 5(c)" ; wrd:rankKey "a3" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText """Relation Back to Reported Circumstances Which May Give Rise to a Claim. If during the Policy Period or Discovery Period (if applicable) an Organization or an Insured Person becomes aware of and notifies the Insurer in writing of circumstances that may give rise to a Claim being made against an Insured and provides details as required below, then any Claim that is subsequently made against an Insured that arises from such circumstances and that is reported in accordance with Clause 5(a) above shall be deemed to have been first made at the time of the notification of circumstances for the purpose of establishing whether such subsequent Claim was first made during the Policy Period or during the Discovery Period (if applicable). Coverage for Loss arising from any such subsequent Claim shall only apply to Loss incurred after that subsequent Claim is actually made against an Insured. In order to be effective, notification of circumstances must specify the facts, circumstances, nature of the alleged Wrongful Act anticipated and reasons for anticipating such Claim, with full particulars as to dates, persons and entities involved; however, notification that includes a copy of an agreement to toll a statute of limitations shall be presumed sufficiently specific as to the potential Claims described within that agreement.""" ] .

# ==== The deployment's vocabulary =============================================
#
# Instrument's baseline activities lack most insurance acts. Its activity
# contract binds its own scheme (voc:boundScheme ins-voc:Activities), so a
# deployment has no governed way to add these. They are the example's own.

ex:insurance-activities a voc:ConceptScheme ;
    fnd:hasIdentity ex:insurance-activities-identity ; fnd:hasGovernanceState fnd:Active ;
    skos:prefLabel "Insurance activities (the example's own)"@en .
ex:Defend a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "defend a Claim"@en .
ex:Cooperate a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "cooperate"@en .
ex:RecordClaim a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "record a Claim's specifics"@en .
ex:SettleOrAdmit a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "admit liability, settle, assume an obligation or pay money"@en .
ex:PermitAssociation a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "let the Insurer associate in the defence"@en .
ex:SelectCounsel a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "select defence counsel"@en .
ex:WithholdConsent a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "withhold consent"@en .
ex:PrejudiceInsurer a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "act, or fail to act, so as to prejudice the Insurer's rights"@en .
ex:Assign a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "assign the policy or rights under it"@en .
ex:BringAction a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "bring an action against the Insurer"@en .
ex:ElectDiscovery a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "elect and purchase a Discovery Period"@en .
ex:RequestOffer a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "request an offer"@en .
ex:OfferTerms a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "offer terms"@en .
ex:Waive a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "waive by endorsement"@en .
ex:RequestInformation a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "request documents or information"@en .
ex:AmendPanel a skos:Concept ; skos:inScheme ex:insurance-activities ; skos:prefLabel "amend the Panel Counsel list"@en .

# Term classes are a legal system's (C7c-Q6). This deployment binds one.
ex:term-classes a voc:ConceptScheme ;
    fnd:hasIdentity ex:term-classes-identity ; fnd:hasGovernanceState fnd:Active ;
    skos:prefLabel "US insurance term classes"@en .
ex:condition-precedent a skos:Concept ; skos:inScheme ex:term-classes ;
    skos:prefLabel "condition precedent"@en ;
    skos:definition "A term whose performance must come before the Insurer's obligations, or the right named, arise."@en .
ex:term-classes-binding a voc:SchemeBinding ;
    voc:forContract ins-voc:TermClassificationContract ;
    voc:bindsScheme ex:term-classes ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2024-01-01T00:00:00Z"^^xsd:dateTime ] .

# Dates the wording defines, as roles of the deployment's own (HQ-4: unbound,
# as in lease-expiry). Their values are the Item 2 variables', but nothing
# links a context role to a variable yet.
ex:policy-dates a voc:ConceptScheme ;
    fnd:hasIdentity ex:policy-dates-identity ; fnd:hasGovernanceState fnd:Active ;
    skos:prefLabel "Policy dates"@en .
ex:InceptionDateRole a skos:Concept ; skos:inScheme ex:policy-dates ; skos:prefLabel "the Inception Date"@en .
ex:ExpirationDateRole a skos:Concept ; skos:inScheme ex:policy-dates ; skos:prefLabel "the Expiration Date"@en .

# ==== Spaces, units, context values, ranges ===================================

ex:time a qnt:ValueSpace ;
    qnt:spaceKey "calendar-time" ; qnt:orderKind qnt:TotalOrder ; qnt:densityKind qnt:Dense ;
    qnt:valueDatatype xsd:dateTime ; qnt:spaceHash "calendar-time-v1" .
ex:durations a qnt:ValueSpace ;
    qnt:spaceKey "durations" ; qnt:orderKind qnt:TotalOrder ; qnt:densityKind qnt:Discrete ;
    qnt:spaceHash "durations-v1" .
ex:usd-space a qnt:ValueSpace ;
    qnt:spaceKey "us-dollars" ; qnt:orderKind qnt:TotalOrder ; qnt:densityKind qnt:Dense ;
    qnt:spaceHash "us-dollars-v1" .
ex:usd a qnt:Unit ; rdfs:label "US dollar" .
ex:day a qnt:Unit ; rdfs:label "day" .

ex:inception-at a qnt:ContextValue ; qnt:onSpace ex:time ; qnt:contextRole ex:InceptionDateRole .
ex:expiration-at a qnt:ContextValue ; qnt:onSpace ex:time ; qnt:contextRole ex:ExpirationDateRole .
ex:ending a qnt:ContextValue ; qnt:onSpace ex:time ; qnt:contextRole ins-voc:Ending .
ex:arising a qnt:ContextValue ; qnt:onSpace ex:time ; qnt:contextRole ins-voc:Arising .

ex:within-30-days-of-ending a qnt:Range ;
    qnt:onSpace ex:time ;
    qnt:relativeToAnchor [ a qnt:AnchorBinding ;
        qnt:anchorValue ex:ending ; qnt:offsetKind qnt:Absolute ;
        qnt:lowerOffsetBy [ a qnt:Quantity ; qnt:onSpace ex:durations ; qnt:numericValue "0"^^xsd:decimal ; qnt:inUnit ex:day ] ;
        qnt:upperOffsetBy [ a qnt:Quantity ; qnt:onSpace ex:durations ; qnt:numericValue "30"^^xsd:decimal ; qnt:inUnit ex:day ] ] .
ex:within-30-days-of-arising a qnt:Range ;
    qnt:onSpace ex:time ;
    qnt:relativeToAnchor [ a qnt:AnchorBinding ;
        qnt:anchorValue ex:arising ; qnt:offsetKind qnt:Absolute ;
        qnt:lowerOffsetBy [ a qnt:Quantity ; qnt:onSpace ex:durations ; qnt:numericValue "0"^^xsd:decimal ; qnt:inUnit ex:day ] ;
        qnt:upperOffsetBy [ a qnt:Quantity ; qnt:onSpace ex:durations ; qnt:numericValue "30"^^xsd:decimal ; qnt:inUnit ex:day ] ] .
# CPL 5(a)'s outer limit only. "As soon as practicable" has no range (§13.2).
ex:by-90-days-after-ending a qnt:Range ;
    qnt:onSpace ex:time ;
    qnt:relativeToAnchor [ a qnt:AnchorBinding ;
        qnt:anchorValue ex:ending ; qnt:offsetKind qnt:Absolute ;
        qnt:upperOffsetBy [ a qnt:Quantity ; qnt:onSpace ex:durations ; qnt:numericValue "90"^^xsd:decimal ; qnt:inUnit ex:day ] ] .

# ==== Roles and words =========================================================

ex:Insurer a pty:Role ; rdfs:label "the Insurer" .
ex:NamedEntity a pty:Role ; rdfs:label "the Named Entity" .              # a party word, from Item 1
ex:Subsidiary a pty:Role ; rdfs:label "a Subsidiary" .
ex:DebtorInPossession a pty:Role ; rdfs:label "a debtor-in-possession" .
ex:Organization a pty:Role ; rdfs:label "the Organization" .              # a party word, GTC 16(c)
ex:InsuredPerson a pty:Role ; rdfs:label "the Insured Person" .          # resolved per Claim
ex:IndemnifyingOrganization a pty:Role ; rdfs:label "the Organization that indemnified" .
ex:SpouseOrRepresentative a pty:Role ; rdfs:label "the spouse, partner, estate or legal representative" .

# Value words: each a concept that a definition gives a value (C7c-Q7).
ex:InceptionDate a skos:Concept ; rdfs:label "Inception Date" .
ex:ExpirationDate a skos:Concept ; rdfs:label "Expiration Date" .
ex:Premium a skos:Concept ; rdfs:label "Premium" .
ex:PolicyAggregate a skos:Concept ; rdfs:label "Policy Aggregate" .
ex:SharedLimit a skos:Concept ; rdfs:label "Shared Limit of Liability" .
ex:SeparateLimit a skos:Concept ; rdfs:label "Separate Limit of Liability" .
ex:ExcessLimitForExecutives a skos:Concept ; rdfs:label "Excess Limit for Executives" .
ex:Retention a skos:Concept ; rdfs:label "Retention" .
ex:ClassActionRetention a skos:Concept ; rdfs:label "Class Action Retention" .
ex:ThirdPartyRetention a skos:Concept ; rdfs:label "Third Party Retention" .
ex:SecuritiesRetention a skos:Concept ; rdfs:label "Securities Retention" .
ex:ContinuityDate a skos:Concept ; rdfs:label "Continuity Date" .
ex:RetroactiveDate a skos:Concept ; rdfs:label "Retroactive Date" .
ex:CoverageSectionPremium a skos:Concept ; rdfs:label "Coverage Section Premium" .
ex:TRIAPremium a skos:Concept ; rdfs:label "TRIA Premium" .

# Condition words, GTC 16(c).
ex:Transaction a skos:Concept ; rdfs:label "Transaction" .
ex:PolicyPeriod a skos:Concept ; rdfs:label "Policy Period" .
ex:EConsultantFirm a skos:Concept ; rdfs:label "E-Consultant Firm" .
ex:EDiscovery a skos:Concept ; rdfs:label "E-Discovery" .
ex:EDiscoveryServices a skos:Concept ; rdfs:label "E-Discovery Consultant Services" .
ex:EnforcementBody a skos:Concept ; rdfs:label "Enforcement Body" .
ex:ForeignJurisdiction a skos:Concept ; rdfs:label "Foreign Jurisdiction" .

# ==== The case: the insurer's claims file, as the applied ontology ===========
#
# LATTICE does not define claims. The paths below read the claims file.

ex:Claim a owl:Class ; rdfs:label "Claim" .
ex:WrongfulAct a owl:Class ; rdfs:label "Wrongful Act" .
ex:Proceeding a owl:Class ; rdfs:label "litigation or proceeding" .
ex:madeAgainst a owl:ObjectProperty ; rdfs:comment "Subject: a Claim. Value: an actor it is made against." .
ex:indemnifiedBy a owl:ObjectProperty ; rdfs:comment "Subject: a Claim. Value: an actor that indemnified the Insured Person for its Loss." .
ex:alleges a owl:ObjectProperty ; rdfs:comment "Subject: a Claim. Value: a Wrongful Act it alleges." .
ex:committedOn a owl:DatatypeProperty ; rdfs:comment "Subject: a Wrongful Act. Value: when it was committed or omitted." .
ex:arisesFrom a owl:ObjectProperty ; rdfs:comment "Subject: a Claim. Value: a proceeding it arises from." .
ex:commencedOn a owl:DatatypeProperty ; rdfs:comment "Subject: a proceeding. Value: when it began." .

# ==== Conditions with placeholders ============================================
#
# Interval conditions over dates the Item 6 rows give per section. Each
# bound's value is a placeholder naming the date word, which binding resolves
# through the definition applying in the section (C8-Q1, D12).

# CPL 3(c): a Wrongful Act before the Retroactive Date.
ex:act-before-retro-date a elg:IntervalCondition ;
    elg:conditionKey "wrongful-act-before-retroactive-date" ;
    elg:matchStrategy elg:IntervalContainment ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredRangeSet [ a qnt:RangeSet ; qnt:onSpace ex:time ;
        qnt:hasRange [ a qnt:Range ; qnt:onSpace ex:time ;
            qnt:upperBound ex:retro-bound ; qnt:hasBound ex:retro-bound ] ] .
ex:retro-bound a qnt:Bound ; qnt:onSpace ex:time ;
    qnt:boundSense qnt:Upper ; qnt:boundClosure qnt:Open ;
    qnt:boundValue [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:RetroactiveDate ] .
ex:act-before-retro-date-binding a elg:EvidenceBinding ;
    elg:bindsCondition ex:act-before-retro-date ;
    elg:subjectClass ex:Claim ;
    elg:singleValued false ;
    elg:evidenceStep [ a elg:EvidenceStep ; elg:stepIndex 0 ; elg:stepProperty ex:alleges ; elg:stepDirection elg:Forward ] ,
                     [ a elg:EvidenceStep ; elg:stepIndex 1 ; elg:stepProperty ex:committedOn ; elg:stepDirection elg:Forward ] .

# CPL 3(e)(i): litigation pending or prior as of the Continuity Date.
ex:litigation-by-continuity a elg:IntervalCondition ;
    elg:conditionKey "litigation-commenced-by-continuity-date" ;
    elg:matchStrategy elg:IntervalContainment ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredRangeSet [ a qnt:RangeSet ; qnt:onSpace ex:time ;
        qnt:hasRange [ a qnt:Range ; qnt:onSpace ex:time ;
            qnt:upperBound ex:continuity-bound ; qnt:hasBound ex:continuity-bound ] ] .
ex:continuity-bound a qnt:Bound ; qnt:onSpace ex:time ;
    qnt:boundSense qnt:Upper ; qnt:boundClosure qnt:Closed ;
    qnt:boundValue [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:ContinuityDate ] .
ex:litigation-by-continuity-binding a elg:EvidenceBinding ;
    elg:bindsCondition ex:litigation-by-continuity ;
    elg:subjectClass ex:Claim ;
    elg:singleValued false ;
    elg:evidenceStep [ a elg:EvidenceStep ; elg:stepIndex 0 ; elg:stepProperty ex:arisesFrom ; elg:stepDirection elg:Forward ] ,
                     [ a elg:EvidenceStep ; elg:stepIndex 1 ; elg:stepProperty ex:commencedOn ; elg:stepDirection elg:Forward ] .

# GTC 16(c) "Policy Period": from the Inception Date, up to the Expiration
# Date. "The earlier of the Expiration Date or the effective date of
# cancellation" needs a minimum of a word and the regime's ending, which no
# bound can state. The regime below carries the cancellation.
ex:policy-period-span a elg:IntervalCondition ;
    elg:conditionKey "within-the-policy-period" ;
    elg:matchStrategy elg:IntervalContainment ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredRangeSet [ a qnt:RangeSet ; qnt:onSpace ex:time ;
        qnt:hasRange [ a qnt:Range ; qnt:onSpace ex:time ;
            qnt:lowerBound ex:period-from ; qnt:upperBound ex:period-to ;
            qnt:hasBound ex:period-from , ex:period-to ] ] .
ex:period-from a qnt:Bound ; qnt:onSpace ex:time ;
    qnt:boundSense qnt:Lower ; qnt:boundClosure qnt:Closed ;
    qnt:boundValue [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:InceptionDate ] .
ex:period-to a qnt:Bound ; qnt:onSpace ex:time ;
    qnt:boundSense qnt:Upper ; qnt:boundClosure qnt:Open ;
    qnt:boundValue [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:ExpirationDate ] .

# ==== Stated meaning: the declarations ========================================
#
# Each row's definition gives a word the row's value. Item 6 rows apply
# within their own section (ins:appliesWithin), so "Retention" or
# "Continuity Date" has one value per section, resolved where it is read.

tmpl:term-item-1 a ins:Term , ins:Template ; ins:expressedIn ex:item-1 .
tmpl:def-named-entity a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-item-1 ;
    ins:defines ex:NamedEntity ;
    ins:means [ a pty:Role ; ins:valueFrom ex:var-named-entity-identity ] .

tmpl:term-item-2 a ins:Term , ins:Template ; ins:expressedIn ex:item-2 .
tmpl:def-inception a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-item-2 ;
    ins:defines ex:InceptionDate ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:var-inception-identity ] .
tmpl:def-expiration a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-item-2 ;
    ins:defines ex:ExpirationDate ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:var-expiration-identity ] .

tmpl:term-item-3 a ins:Term , ins:Template ; ins:expressedIn ex:item-3 .
tmpl:def-premium a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-item-3 ;
    ins:defines ex:Premium ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-premium-identity ] .

tmpl:term-item-5 a ins:Term , ins:Template ; ins:expressedIn ex:item-5 .
tmpl:def-aggregate a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-item-5 ;
    ins:defines ex:PolicyAggregate ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-aggregate-identity ] .

tmpl:term-do-limit a ins:Term , ins:Template ; ins:expressedIn ex:do-limit ; ins:appliesWithin ex:do-identity .
tmpl:def-do-shared-limit a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-do-limit ; ins:defines ex:SharedLimit ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-do-shared-limit-identity ] .
tmpl:term-do-excess a ins:Term , ins:Template ; ins:expressedIn ex:do-excess ; ins:appliesWithin ex:do-identity .
tmpl:def-do-excess a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-do-excess ; ins:defines ex:ExcessLimitForExecutives ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-do-excess-identity ] .
tmpl:term-do-retention a ins:Term , ins:Template ; ins:expressedIn ex:do-retention ; ins:appliesWithin ex:do-identity .
tmpl:def-do-retention a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-do-retention ; ins:defines ex:Retention ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-do-retention-identity ] .
# "All other" only. The Outside Entity Executive date is each case's own.
tmpl:term-do-continuity a ins:Term , ins:Template ; ins:expressedIn ex:do-continuity ; ins:appliesWithin ex:do-identity .
tmpl:def-do-continuity a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-do-continuity ; ins:defines ex:ContinuityDate ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:var-do-continuity-identity ] .
tmpl:term-do-premium a ins:Term , ins:Template ; ins:expressedIn ex:do-premium ; ins:appliesWithin ex:do-identity .
tmpl:def-do-premium a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-do-premium ; ins:defines ex:CoverageSectionPremium ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-do-premium-identity ] .

tmpl:term-epl-limit a ins:Term , ins:Template ; ins:expressedIn ex:epl-limit ; ins:appliesWithin ex:epl-identity .
tmpl:def-epl-shared-limit a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-epl-limit ; ins:defines ex:SharedLimit ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-epl-shared-limit-identity ] .
tmpl:term-epl-retention a ins:Term , ins:Template ; ins:expressedIn ex:epl-retention ; ins:appliesWithin ex:epl-identity .
tmpl:def-epl-retention-class a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-epl-retention ; ins:defines ex:ClassActionRetention ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-epl-retention-class-identity ] .
tmpl:def-epl-retention-third a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-epl-retention ; ins:defines ex:ThirdPartyRetention ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-epl-retention-third-identity ] .
tmpl:def-epl-retention-other a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-epl-retention ; ins:defines ex:Retention ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-epl-retention-other-identity ] .
tmpl:term-epl-continuity a ins:Term , ins:Template ; ins:expressedIn ex:epl-continuity ; ins:appliesWithin ex:epl-identity .
tmpl:def-epl-continuity a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-epl-continuity ; ins:defines ex:ContinuityDate ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:var-epl-continuity-identity ] .
tmpl:term-epl-premium a ins:Term , ins:Template ; ins:expressedIn ex:epl-premium ; ins:appliesWithin ex:epl-identity .
tmpl:def-epl-premium a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-epl-premium ; ins:defines ex:CoverageSectionPremium ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-epl-premium-identity ] .

tmpl:term-fid-limit a ins:Term , ins:Template ; ins:expressedIn ex:fid-limit ; ins:appliesWithin ex:fid-identity .
tmpl:def-fid-separate-limit a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-fid-limit ; ins:defines ex:SeparateLimit ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-fid-separate-limit-identity ] .
tmpl:term-fid-retention a ins:Term , ins:Template ; ins:expressedIn ex:fid-retention ; ins:appliesWithin ex:fid-identity .
tmpl:def-fid-retention-securities a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-fid-retention ; ins:defines ex:SecuritiesRetention ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-fid-retention-securities-identity ] .
tmpl:def-fid-retention-other a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-fid-retention ; ins:defines ex:Retention ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-fid-retention-other-identity ] .
tmpl:term-fid-continuity a ins:Term , ins:Template ; ins:expressedIn ex:fid-continuity ; ins:appliesWithin ex:fid-identity .
tmpl:def-fid-continuity a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-fid-continuity ; ins:defines ex:ContinuityDate ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:var-fid-continuity-identity ] .
tmpl:term-fid-premium a ins:Term , ins:Template ; ins:expressedIn ex:fid-premium ; ins:appliesWithin ex:fid-identity .
tmpl:def-fid-premium a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-fid-premium ; ins:defines ex:CoverageSectionPremium ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-fid-premium-identity ] .

tmpl:term-cpl-limit a ins:Term , ins:Template ; ins:expressedIn ex:cpl-limit ; ins:appliesWithin ex:cpl-identity .
tmpl:def-cpl-separate-limit a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-cpl-limit ; ins:defines ex:SeparateLimit ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-cpl-separate-limit-identity ] .
tmpl:term-cpl-retention a ins:Term , ins:Template ; ins:expressedIn ex:cpl-retention ; ins:appliesWithin ex:cpl-identity .
tmpl:def-cpl-retention a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-cpl-retention ; ins:defines ex:Retention ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-cpl-retention-identity ] .
tmpl:term-cpl-continuity a ins:Term , ins:Template ; ins:expressedIn ex:cpl-continuity ; ins:appliesWithin ex:cpl-identity .
tmpl:def-cpl-continuity a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-cpl-continuity ; ins:defines ex:ContinuityDate ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:var-cpl-continuity-identity ] .
tmpl:term-cpl-retro a ins:Term , ins:Template ; ins:expressedIn ex:cpl-retro ; ins:appliesWithin ex:cpl-identity .
tmpl:def-cpl-retro a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-cpl-retro ; ins:defines ex:RetroactiveDate ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:time ; ins:valueFrom ex:var-cpl-retro-identity ] .
tmpl:term-cpl-premium a ins:Term , ins:Template ; ins:expressedIn ex:cpl-premium ; ins:appliesWithin ex:cpl-identity .
tmpl:def-cpl-premium a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-cpl-premium ; ins:defines ex:CoverageSectionPremium ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-cpl-premium-identity ] .

tmpl:term-item-8 a ins:Term , ins:Template ; ins:expressedIn ex:item-8 .
tmpl:def-tria-premium a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-item-8 ; ins:defines ex:TRIAPremium ;
    ins:means [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:inUnit ex:usd ; ins:valueFrom ex:var-tria-premium-identity ] .

# ==== Stated meaning: General Terms and Conditions ============================

# The recital: the consideration. No due date in the fragment.
tmpl:term-gtc-recital a ins:Term , ins:Template ; ins:expressedIn ex:gtc-recital .
tmpl:pay-premium a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-recital ;
    ins:obligor ex:NamedEntity ; ins:obligee ex:Insurer ;
    ins:activity ins-voc:Pay .

# GTC 1: four sections. The GTC are the general part, no section, so they
# govern every section. Each section's own words apply only within it.
tmpl:term-gtc-1 a ins:Term , ins:Template ; ins:expressedIn ex:gtc-1 .
tmpl:coverage-sections a ins:Sectioning , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-1 ;
    ins:section ex:do-identity , ex:epl-identity , ex:fid-identity , ex:cpl-identity .

# GTC 2, first sentence only: the Retention, its amount the word each
# section's Item 6 row defines. A stated qualifier qualifies one term or
# relation (§16.5), so it names the CPL insuring term, the only one here.
tmpl:term-gtc-2 a ins:Term , ins:Template ; ins:expressedIn ex:gtc-2 .
tmpl:retention a ins:Qualifier , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-2 ;
    ins:qualifies tmpl:term-ccp-1 .

# GTC 3: the Policy Aggregate, and the Separate Limit as it applies to the
# CPL section. Both should also qualify the defence costs of CPL 2 and every
# other section's insuring term, which one stated qualifier cannot.
tmpl:term-gtc-3 a ins:Term , ins:Template ; ins:expressedIn ex:gtc-3 .
tmpl:policy-aggregate a ins:Qualifier , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-3 ;
    ins:qualifies tmpl:term-ccp-1 .
tmpl:separate-limit a ins:Qualifier , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-3 ;
    ins:qualifies tmpl:term-ccp-1 .

# GTC 4: the Discovery Period. It arises on the Named Entity's cancellation
# or either party's nonrenewal (alternatives), never on the Insurer's
# cancellation for non-payment. Its window runs from the ending.
tmpl:term-gtc-4 a ins:Term , ins:Template ; ins:expressedIn ex:gtc-4 .
tmpl:on-nonrenewal-by-named-entity a ins:OnAct , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:ExternalStimulus ;
    ins:activity ins-voc:DeclineRenewal ; ins:by ex:NamedEntity .
tmpl:on-nonrenewal-by-insurer a ins:OnAct , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:ExternalStimulus ;
    ins:activity ins-voc:DeclineRenewal ; ins:by ex:Insurer .
tmpl:elect-discovery a ins:Power , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-4 ;
    ins:holder ex:NamedEntity ; ins:counterparty ex:Insurer ;
    ins:activity ex:ElectDiscovery ;
    ins:arisesOn tmpl:on-cancel-by-named-entity , tmpl:on-nonrenewal-by-named-entity , tmpl:on-nonrenewal-by-insurer ;
    ins:window ex:within-30-days-of-ending .
tmpl:pay-discovery-premium a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-4 ;
    ins:obligor ex:NamedEntity ; ins:obligee ex:Insurer ;
    ins:activity ins-voc:Pay ;
    ins:arisesOnExerciseOf tmpl:elect-discovery .
# On a Transaction: a right to ask, and a duty to offer on terms the Insurer
# "may reasonably decide", which nothing here can state.
tmpl:request-discovery-offer a ins:Power , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-4 ;
    ins:holder ex:NamedEntity ; ins:counterparty ex:Insurer ;
    ins:activity ex:RequestOffer ;
    ins:arisesOn tmpl:on-transaction ;
    ins:window ex:within-30-days-of-arising .
tmpl:offer-discovery a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-4 ;
    ins:obligor ex:Insurer ; ins:obligee ex:NamedEntity ;
    ins:activity ex:OfferTerms ;
    ins:arisesOnExerciseOf tmpl:request-discovery-offer .

# GTC 5: the Transaction. Its run-off and the bar on cancellation are the
# regime's (below). The waiver is a power whose exercise is an endorsement,
# an amendment (C9a).
tmpl:term-gtc-5 a ins:Term , ins:Template ; ins:expressedIn ex:gtc-5 .
tmpl:waive-transaction a ins:Power , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-5 ;
    ins:holder ex:Insurer ; ins:counterparty ex:NamedEntity ;
    ins:activity ex:Waive ;
    ins:scope ex:particulars-in-30-days ;
    ins:appliesInState tmpl:run-off .
# "No portion of the premium shall be refundable": no transition leaves
# run-off for cancelled, so tmpl:return-premium cannot arise. This exclusion
# restates what the regime already gives.
tmpl:no-refund-after-transaction a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-5 ;
    ins:holder ex:Insurer ; ins:counterparty ex:NamedEntity ;
    ins:excepts tmpl:return-premium ;
    ins:appliesInState tmpl:run-off .

# GTC 6(c): the spousal and legal representative extension.
tmpl:term-gtc-6c a ins:Term , ins:Template ; ins:expressedIn ex:gtc-6c .
tmpl:pay-spouse a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-6c ;
    ins:obligor ex:Insurer ; ins:obligee ex:SpouseOrRepresentative ;
    ins:activity ins-voc:Indemnify ;
    ins:arisesOn tmpl:on-covered-claim ;
    ins:scope ex:spousal-scope .

# GTC 7: cancellation. The Named Entity's is any time in force, or in the
# Insurer's notice period. The Insurer's only for non-payment. Neither after
# a Transaction, since neither applies in run-off.
tmpl:term-gtc-7a a ins:Term , ins:Template ; ins:expressedIn ex:gtc-7a .
tmpl:cancel-by-named-entity a ins:Power , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-7a ;
    ins:holder ex:NamedEntity ; ins:counterparty ex:Insurer ;
    ins:activity ins-voc:Terminate ;
    ins:appliesInState tmpl:in-force , tmpl:cancellation-notice .
tmpl:term-gtc-7b a ins:Term , ins:Template ; ins:expressedIn ex:gtc-7b .
tmpl:cancel-by-insurer a ins:Power , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-7b ;
    ins:holder ex:Insurer ; ins:counterparty ex:NamedEntity ;
    ins:activity ins-voc:Terminate ;
    ins:scope ex:premium-unpaid ;
    ins:appliesInState tmpl:in-force .
tmpl:term-gtc-7c a ins:Term , ins:Template ; ins:expressedIn ex:gtc-7c .
tmpl:on-cancelled a ins:OnEntry , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:DerivedTrigger ;
    ins:ofState tmpl:cancelled .
tmpl:return-premium a ins:Obligation , ins:Template ;       # the pro rata amount is not stated
    ins:arisesUnder tmpl:term-gtc-7c ;
    ins:obligor ex:Insurer ; ins:obligee ex:NamedEntity ;
    ins:activity ins-voc:Pay ;
    ins:arisesOn tmpl:on-cancelled .

# GTC 10: assignment needs consent.
tmpl:term-gtc-10 a ins:Term , ins:Template ; ins:expressedIn ex:gtc-10 .
tmpl:no-assignment a ins:Prohibition , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-10 ;
    ins:obligor ex:NamedEntity ; ins:obligee ex:Insurer ;
    ins:activity ex:Assign .
tmpl:assignment-with-consent a ins:Permission , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-10 ;
    ins:holder ex:NamedEntity ; ins:counterparty ex:Insurer ;
    ins:activity ex:Assign ;
    ins:excepts tmpl:no-assignment ;
    ins:scope ex:insurer-consented .

# GTC 11, first sentence: no action until compliance and a final amount.
tmpl:term-gtc-11 a ins:Term , ins:Template ; ins:expressedIn ex:gtc-11 ;
    ins:classification ex:condition-precedent .
tmpl:no-premature-action a ins:Prohibition , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-11 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ex:BringAction ;
    ins:scope ex:action-not-ripe .

# GTC 12, second sentence: cooperation on insolvency, each way.
tmpl:term-gtc-12 a ins:Term , ins:Template ; ins:expressedIn ex:gtc-12 .
tmpl:on-insolvency a ins:OnCondition , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:DerivedTrigger ;
    ins:condition ex:insolvency .
tmpl:insurer-cooperates a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-12 ;
    ins:obligor ex:Insurer ; ins:obligee ex:InsuredPerson ;
    ins:activity ex:Cooperate ;
    ins:arisesOn tmpl:on-insolvency .
tmpl:insured-cooperates a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-gtc-12 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ex:Cooperate ;
    ins:arisesOn tmpl:on-insolvency .

# ---- GTC 16(c): definitions of general applicability -------------------------

tmpl:term-def-e-consultant a ins:Term , ins:Template ; ins:expressedIn ex:def-e-consultant .
tmpl:def-e-consultant a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-def-e-consultant ; ins:defines ex:EConsultantFirm ; ins:means ex:is-e-consultant-firm .
tmpl:term-def-e-discovery a ins:Term , ins:Template ; ins:expressedIn ex:def-e-discovery .
tmpl:def-e-discovery a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-def-e-discovery ; ins:defines ex:EDiscovery ; ins:means ex:is-e-discovery .
tmpl:term-def-e-services a ins:Term , ins:Template ; ins:expressedIn ex:def-e-services .
tmpl:def-e-services a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-def-e-services ; ins:defines ex:EDiscoveryServices ; ins:means ex:is-e-discovery-services .
tmpl:term-def-enforcement-body a ins:Term , ins:Template ; ins:expressedIn ex:def-enforcement-body .
tmpl:def-enforcement-body a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-def-enforcement-body ; ins:defines ex:EnforcementBody ; ins:means ex:is-enforcement-body .
tmpl:term-def-foreign-jurisdiction a ins:Term , ins:Template ; ins:expressedIn ex:def-foreign-jurisdiction .
tmpl:def-foreign-jurisdiction a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-def-foreign-jurisdiction ; ins:defines ex:ForeignJurisdiction ; ins:means ex:is-foreign-jurisdiction .

# Several parties, with no acting rule: the policy never says how they act
# together, so a relation reaching the word is Undetermined (CC-D10).
tmpl:term-def-organization a ins:Term , ins:Template ; ins:expressedIn ex:def-organization .
tmpl:def-organization a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-def-organization ;
    ins:defines ex:Organization ;
    ins:means ex:NamedEntity , ex:Subsidiary , ex:DebtorInPossession .

tmpl:term-def-transaction a ins:Term , ins:Template ; ins:expressedIn ex:def-transaction .
tmpl:def-transaction a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-def-transaction ; ins:defines ex:Transaction ; ins:means ex:transaction-meaning .

# "Policy Period": the word, and the regime it implies. One term owns the
# regime, although Item 2, the attestation, GTC 5 and GTC 7 each state a part.
tmpl:term-def-policy-period a ins:Term , ins:Template ; ins:expressedIn ex:def-policy-period .
tmpl:def-policy-period a ins:Definition , ins:Template ;
    ins:arisesUnder tmpl:term-def-policy-period ; ins:defines ex:PolicyPeriod ; ins:means ex:policy-period-span .

tmpl:policy-regime a ins:Regime , bhv:StateSpace , ins:Template ;
    fnd:hasIdentity tmpl:policy-regime-identity ;
    ins:arisesUnder tmpl:term-def-policy-period ;
    bhv:initialState tmpl:unsigned .

tmpl:unsigned a bhv:State ;
    bhv:inStateSpace tmpl:policy-regime ; ins:stateKind ins-voc:Conditional .
tmpl:issued a bhv:State ;                                   # signed, before the Inception Date
    bhv:inStateSpace tmpl:policy-regime ; ins:stateKind ins-voc:Conditional .
tmpl:in-force a bhv:State ;
    bhv:inStateSpace tmpl:policy-regime ; ins:stateKind ins-voc:InForce ;
    ins:begins ins-voc:TheInstrument .
tmpl:cancellation-notice a bhv:State ;
    bhv:inStateSpace tmpl:policy-regime ; ins:stateKind ins-voc:NoticePeriod .
tmpl:run-off a bhv:State ;                                  # after a Transaction: no state kind fits
    bhv:inStateSpace tmpl:policy-regime ; ins:stateKind ins-voc:InForce .
tmpl:expired a bhv:State ;
    bhv:inStateSpace tmpl:policy-regime ; ins:stateKind ins-voc:Expired ;
    ins:ends ins-voc:TheInstrument .
tmpl:cancelled a bhv:State ;
    bhv:inStateSpace tmpl:policy-regime ; ins:stateKind ins-voc:Terminated ;
    ins:ends ins-voc:TheInstrument .

# The attestation: valid only once signed for the Insurer.
tmpl:on-signed a ins:OnAcceptance , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:DerivedTrigger ;
    ins:by ex:Insurer .
tmpl:on-inception a ins:OnExpiry , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:ScheduledTrigger ;
    ins:at ex:inception-at .
tmpl:on-expiration a ins:OnExpiry , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:ScheduledTrigger ;
    ins:at ex:expiration-at .
tmpl:on-cancel-by-named-entity a ins:OnExercise , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:ExternalStimulus ;
    ins:ofPower tmpl:cancel-by-named-entity .
tmpl:on-cancel-by-insurer a ins:OnExercise , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:ExternalStimulus ;
    ins:ofPower tmpl:cancel-by-insurer .
# "Not less than fifteen days": the notice names the date. The minimum only.
tmpl:on-notice-runs-out a ins:OnExpiry , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:ScheduledTrigger ;
    ins:after [ a qnt:Quantity ; qnt:onSpace ex:durations ; qnt:numericValue "15"^^xsd:decimal ; qnt:inUnit ex:day ] .
tmpl:on-transaction a ins:OnCondition , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:DerivedTrigger ;
    ins:condition ex:Transaction .                          # the word
tmpl:on-waiver a ins:OnExercise , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:ExternalStimulus ;
    ins:ofPower tmpl:waive-transaction .

tmpl:sign a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:unsigned ; bhv:toState tmpl:issued ;
    bhv:hasTrigger tmpl:on-signed ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:incept a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:issued ; bhv:toState tmpl:in-force ;
    bhv:hasTrigger tmpl:on-inception ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:expire a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:in-force ; bhv:toState tmpl:expired ;
    bhv:hasTrigger tmpl:on-expiration ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:expire-in-notice a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:cancellation-notice ; bhv:toState tmpl:expired ;
    bhv:hasTrigger tmpl:on-expiration ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:expire-in-run-off a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:run-off ; bhv:toState tmpl:expired ;
    bhv:hasTrigger tmpl:on-expiration ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:cancel-now a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:in-force ; bhv:toState tmpl:cancelled ;
    bhv:hasTrigger tmpl:on-cancel-by-named-entity ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:cancel-during-notice a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:cancellation-notice ; bhv:toState tmpl:cancelled ;
    bhv:hasTrigger tmpl:on-cancel-by-named-entity ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:give-cancellation-notice a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:in-force ; bhv:toState tmpl:cancellation-notice ;
    bhv:hasTrigger tmpl:on-cancel-by-insurer ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:notice-runs-out a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:cancellation-notice ; bhv:toState tmpl:cancelled ;
    bhv:hasTrigger tmpl:on-notice-runs-out ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:enter-run-off a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:in-force ; bhv:toState tmpl:run-off ;
    bhv:hasTrigger tmpl:on-transaction ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .
tmpl:waive-run-off a ins:RegimeTransition , bhv:TransitionDefinition ;
    bhv:fromState tmpl:run-off ; bhv:toState tmpl:in-force ;
    bhv:hasTrigger tmpl:on-waiver ;
    bhv:selectionPolicy bhv:SingleMatch ; bhv:activationPolicy bhv:ImmediateActivation .

# ==== Stated meaning: the CPL section =========================================

# CPL 1: one trigger for both insuring agreements, one occasion per Claim.
# A and B split the Loss by whether the Organization indemnified.
tmpl:term-ccp-1 a ins:Term , ins:Template ; ins:expressedIn ex:ccp-1 .
tmpl:on-covered-claim a ins:OnCondition , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:DerivedTrigger ;
    ins:condition ex:covered-claim .
tmpl:pay-a a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-1 ;
    ins:obligor ex:Insurer ; ins:obligee ex:InsuredPerson ;
    ins:activity ins-voc:Indemnify ;
    ins:arisesOn tmpl:on-covered-claim ;
    ins:scope ex:not-indemnified .
tmpl:pay-b a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-1 ;
    ins:obligor ex:Insurer ; ins:obligee ex:IndemnifyingOrganization ;
    ins:activity ins-voc:Indemnify ;
    ins:arisesOn tmpl:on-covered-claim ;
    ins:scope ex:indemnified .

# CPL 2(a), with 2(c)'s endings. The right to defend is the duty's other
# side here: nothing in the fragment lets an Insured refuse the defence.
tmpl:term-ccp-2a a ins:Term , ins:Template ; ins:expressedIn ex:ccp-2a .
tmpl:on-limits-exhausted a ins:OnCondition , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:DerivedTrigger ;
    ins:condition ex:limits-exhausted .
tmpl:on-settlement-refused a ins:OnCondition , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:DerivedTrigger ;
    ins:condition ex:hammer-applies .
tmpl:defend a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2a ;
    ins:obligor ex:Insurer ; ins:obligee ex:InsuredPerson ;
    ins:activity ex:Defend ;
    ins:arisesOn tmpl:on-covered-claim ;
    ins:endsOn tmpl:on-limits-exhausted , tmpl:on-settlement-refused .
tmpl:pay-defense-costs a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2a ;
    ins:obligor ex:Insurer ; ins:obligee ex:InsuredPerson ;
    ins:activity ins-voc:Pay ;
    ins:arisesOn tmpl:on-covered-claim ;
    ins:endsOn tmpl:on-limits-exhausted .
tmpl:no-defence-of-do-or-securities a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2a ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:defend ;
    ins:scope ex:do-or-securities .

# CPL 2(b): consented defence costs where there is no duty to defend.
tmpl:term-ccp-2b a ins:Term , ins:Template ; ins:expressedIn ex:ccp-2b .
tmpl:indemnify-defense-costs a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2b ;
    ins:obligor ex:Insurer ; ins:obligee ex:InsuredPerson ;
    ins:activity ins-voc:Indemnify ;
    ins:arisesOn tmpl:on-covered-claim ;
    ins:scope ex:consented-costs-scope .

# CPL 2(c): its endings are on tmpl:defend. What it adds is the hammer: a
# cap of the refused settlement, plus earlier costs, plus 70% of later ones.
tmpl:term-ccp-2c a ins:Term , ins:Template ; ins:expressedIn ex:ccp-2c .
tmpl:hammer-cap a ins:Qualifier , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2c ;
    ins:qualifies tmpl:term-ccp-1 .

# CPL 2(d)(1): duties on each Claim. "As soon as practicable" and
# "immediately" have no range. The request is the Insurer's power.
tmpl:term-ccp-2d1 a ins:Term , ins:Template ; ins:expressedIn ex:ccp-2d1 .
tmpl:on-claim a ins:OnCondition , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:DerivedTrigger ;
    ins:condition ex:claim-made .
tmpl:send-copies a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d1 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ins-voc:Report ;
    ins:arisesOn tmpl:on-claim .
tmpl:record-claim a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d1 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ex:RecordClaim ;
    ins:arisesOn tmpl:on-claim .
tmpl:request-documents a ins:Power , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d1 ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:activity ex:RequestInformation ;
    ins:arisesOn tmpl:on-claim .
tmpl:furnish-documents a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d1 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ins-voc:Disclose ;
    ins:arisesOnExerciseOf tmpl:request-documents .
tmpl:cooperate a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d1 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ex:Cooperate ;
    ins:arisesOn tmpl:on-claim .

# CPL 2(d)(2): no settlement without consent, and its effect stated as
# relations (law I12): what is paid without consent is not covered. That
# it does not erode the Retention is a qualifier's business, unstated.
tmpl:term-ccp-2d2 a ins:Term , ins:Template ; ins:expressedIn ex:ccp-2d2 .
tmpl:no-settlement a ins:Prohibition , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d2 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ex:SettleOrAdmit .
tmpl:settlement-with-consent a ins:Permission , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d2 ;
    ins:holder ex:InsuredPerson ; ins:counterparty ex:Insurer ;
    ins:activity ex:SettleOrAdmit ;
    ins:excepts tmpl:no-settlement ;
    ins:scope ex:insurer-consented .
tmpl:unconsented-not-covered-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d2 ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ; ins:scope ex:unconsented-settlement .
tmpl:unconsented-not-covered-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d2 ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ; ins:scope ex:unconsented-settlement .

# CPL 2(d)(3): a right with no prohibition to except, so its correlative duty.
tmpl:term-ccp-2d3 a ins:Term , ins:Template ; ins:expressedIn ex:ccp-2d3 .
tmpl:permit-association a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d3 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ex:PermitAssociation ;
    ins:arisesOn tmpl:on-claim .

# CPL 2(d)(4): the entity's own liability. Its second and third sentences
# hold by construction: no Organization is an obligee of A or of CPL 2.
tmpl:term-ccp-2d4 a ins:Term , ins:Template ; ins:expressedIn ex:ccp-2d4 .
tmpl:entity-liability-excluded a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d4 ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ; ins:scope ex:entity-own-liability .

# CPL 2(d)(5): panel counsel, in part.
tmpl:term-ccp-2d5 a ins:Term , ins:Template ; ins:expressedIn ex:ccp-2d5 .
tmpl:select-panel-counsel a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d5 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ex:SelectCounsel ;
    ins:arisesOn tmpl:on-claim ;
    ins:scope ex:securities-claim-without-do .
tmpl:amend-panel a ins:Power , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d5 ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:activity ex:AmendPanel .
tmpl:no-unreasonable-refusal a ins:Prohibition , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d5 ;
    ins:obligor ex:Insurer ; ins:obligee ex:InsuredPerson ;
    ins:activity ex:WithholdConsent ;
    ins:scope ex:refusal-unreasonable .

# CPL 2(d)(6).
tmpl:term-ccp-2d6 a ins:Term , ins:Template ; ins:expressedIn ex:ccp-2d6 .
tmpl:no-prejudice a ins:Prohibition , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-2d6 ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ex:PrejudiceInsurer ;
    ins:scope ex:intentional .

# CPL 3(a)'s proviso: defence until adjudication, then reimbursement.
tmpl:on-conduct-adjudicated a ins:OnCondition , bhv:TriggerDefinition ;
    bhv:triggerKind bhv:DerivedTrigger ;
    ins:condition ex:conduct-adjudicated .
tmpl:reimburse-defense-costs a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3a ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ins-voc:Repay ;
    ins:arisesOn tmpl:on-conduct-adjudicated .


# ---- CPL 3: exclusions --------------------------------------------------------
#
# Each excludes Loss under both insuring agreements. An exclusion excepts one
# relation (ins:excepts is functional), so each clause's term has two: one
# excepting A, owed to the Insured Person, one excepting B, owed to the
# indemnifying Organization. The holder is the excepted obligation's obligor
# (law I8). Carve-backs are negated members of the scope (ADR-A103).

tmpl:term-ccp-3a a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3a .
tmpl:excl-3a-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3a ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:conduct-adjudicated .
tmpl:excl-3a-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3a ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:conduct-adjudicated .

tmpl:term-ccp-3b a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3b .
tmpl:excl-3b-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3b ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:employment-not-legal-services .
tmpl:excl-3b-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3b ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:employment-not-legal-services .

tmpl:term-ccp-3c a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3c .
tmpl:excl-3c-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3c ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:act-before-retro-date .
tmpl:excl-3c-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3c ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:act-before-retro-date .

tmpl:term-ccp-3d a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3d .
tmpl:excl-3d-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3d ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:noticed-under-prior-policy .
tmpl:excl-3d-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3d ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:noticed-under-prior-policy .

tmpl:term-ccp-3e a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3e .
tmpl:excl-3e-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3e ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:pending-or-prior-as-of-continuity .
tmpl:excl-3e-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3e ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:pending-or-prior-as-of-continuity .

tmpl:term-ccp-3f a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3f .
tmpl:excl-3f-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3f ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:bodily-injury-property-damage .
tmpl:excl-3f-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3f ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:bodily-injury-property-damage .

tmpl:term-ccp-3g a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3g .
tmpl:excl-3g-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3g ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:brought-by-organization-not-defense-costs .
tmpl:excl-3g-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3g ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:brought-by-organization-not-defense-costs .

tmpl:term-ccp-3h a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3h .
tmpl:excl-3h-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3h ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:security-holder-claim-not-carved-back .
tmpl:excl-3h-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3h ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:security-holder-claim-not-carved-back .

tmpl:term-ccp-3i a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3i .
tmpl:excl-3i-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3i ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:erisa-not-counsel-to-fiduciary .
tmpl:excl-3i-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3i ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:erisa-not-counsel-to-fiduciary .

tmpl:term-ccp-3j a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3j .
tmpl:excl-3j-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3j ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:labour-statutes .
tmpl:excl-3j-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3j ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:labour-statutes .

tmpl:term-ccp-3wage a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3wage .
tmpl:excl-3wage-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3wage ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:wage-and-hour .
tmpl:excl-3wage-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3wage ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:wage-and-hour .

tmpl:term-ccp-3k a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3k .
tmpl:excl-3k-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3k ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:capacity-other-than-legal-services .
tmpl:excl-3k-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3k ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ;
    ins:scope ex:capacity-other-than-legal-services .

tmpl:term-ccp-3l a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3l .
tmpl:excl-3l-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3l ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:pollution-not-carved-back .
tmpl:excl-3l-b a ins:Exclusion , ins:Template ;
