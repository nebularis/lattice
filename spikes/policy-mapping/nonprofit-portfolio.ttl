ex:nonsecurities-conduct a elg:Condition ;
    elg:conditionKey "nonsecurities-conduct" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AnySufficient ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:hasCondition ex:conduct-dishonest , ex:conduct-violation , ex:illegal-profit , ex:conduct-commingling .
ex:securities-conduct a elg:Condition ;
    elg:conditionKey "securities-conduct" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AnySufficient ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:hasCondition ex:deliberate-criminal-fraud , ex:illegal-profit .
ex:nonsecurities-adjudicated a elg:Condition ;
    elg:conditionKey "nonsecurities-adjudicated" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
