tmpl:term-ccp-3m a ins:Term , ins:Template ; ins:expressedIn ex:ccp-3m .
tmpl:excl-3m-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-3m ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ;
    ins:scope ex:trade-secret .
tmpl:excl-3m-b a ins:Exclusion , ins:Template ;
