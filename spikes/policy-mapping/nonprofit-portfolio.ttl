ex:spousal-scope a elg:Condition ;
    elg:conditionKey "spousal-scope" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:hasCondition ex:spouse-claim , ex:not-spouse-own-acts .

# ==== The instance: what the policy stores (D1) ===============================

ex:policy-wording-v1 a wrd:AssembledWording ;
    fnd:hasIdentity ex:policy-wording-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:assembledFrom ex:form ;
    wrd:includes ex:policyholder-notice , ex:front-notice , ex:declarations , ex:item-1 , ex:item-2 , ex:item-3 ,
                 ex:item-4 , ex:item-5 , ex:item-6 , ex:item-6-do , ex:do-limit , ex:do-excess ,
                 ex:do-retention , ex:do-continuity , ex:do-premium , ex:item-6-epl , ex:epl-limit , ex:epl-retention ,
                 ex:epl-continuity , ex:epl-premium , ex:item-6-fid , ex:fid-limit , ex:fid-retention , ex:fid-continuity ,
                 ex:fid-premium , ex:item-6-cpl , ex:cpl-limit , ex:cpl-retention , ex:cpl-continuity , ex:cpl-retro ,
                 ex:cpl-premium , ex:item-7 , ex:item-8 , ex:attestation , ex:tria-disclosure , ex:gtc ,
                 ex:gtc-recital , ex:gtc-1 , ex:gtc-2 , ex:gtc-3 , ex:gtc-4 , ex:gtc-5 ,
                 ex:gtc-6 , ex:gtc-6a , ex:gtc-6b , ex:gtc-6c , ex:gtc-7 , ex:gtc-7a ,
                 ex:gtc-7b , ex:gtc-7c , ex:gtc-8 , ex:gtc-9 , ex:gtc-10 , ex:gtc-11 ,
                 ex:gtc-12 , ex:gtc-13 , ex:gtc-14 , ex:gtc-15 , ex:gtc-16 , ex:gtc-16a ,
                 ex:gtc-16b , ex:gtc-16c , ex:def-continuity , ex:def-coverage-section , ex:def-e-consultant , ex:def-e-discovery ,
                 ex:def-e-services , ex:def-enforcement-body , ex:def-foreign-jurisdiction , ex:def-organization , ex:def-policy-period , ex:def-retroactive ,
                 ex:def-separate-limit , ex:def-shared-limit , ex:def-transaction , ex:do , ex:epl , ex:fid ,
                 ex:cpl , ex:cpl-notice , ex:cpl-recital , ex:ccp-1 , ex:ccp-2 , ex:ccp-2a ,
                 ex:ccp-2b , ex:ccp-2c , ex:ccp-2d , ex:ccp-2d1 , ex:ccp-2d2 , ex:ccp-2d3 ,
                 ex:ccp-2d4 , ex:ccp-2d5 , ex:ccp-2d6 , ex:ccp-3 , ex:ccp-3-intro , ex:ccp-3a ,
                 ex:ccp-3a-imputation , ex:ccp-3b , ex:ccp-3c , ex:ccp-3d , ex:ccp-3e , ex:ccp-3f ,
                 ex:ccp-3g , ex:ccp-3h , ex:ccp-3i , ex:ccp-3j , ex:ccp-3wage , ex:ccp-3k ,
                 ex:ccp-3l , ex:ccp-3m , ex:ccp-3n , ex:ccp-3o , ex:ccp-3p , ex:ccp-3q ,
                 ex:ccp-3r , ex:ccp-4 , ex:ccp-5 , ex:ccp-5-intro , ex:ccp-5a , ex:ccp-5b ,
                 ex:ccp-5c ;
    wrd:hasValue ex:v-named-entity ,
                 ex:v-ne-address ,
                 ex:v-ne-state ,
                 ex:v-inception ,
                 ex:v-expiration ,
                 ex:v-premium ,
                 ex:v-insurer-address ,
                 ex:v-claims-address ,
                 ex:v-claims-email ,
                 ex:v-aggregate ,
                 ex:v-do-shared-limit ,
                 ex:v-do-excess ,
                 ex:v-do-retention ,
                 ex:v-do-continuity ,
                 ex:v-do-premium ,
                 ex:v-epl-shared-limit ,
                 ex:v-epl-retention-class ,
                 ex:v-epl-retention-third ,
                 ex:v-epl-retention-other ,
                 ex:v-epl-continuity ,
                 ex:v-epl-premium ,
                 ex:v-fid-separate-limit ,
                 ex:v-fid-retention-securities ,
                 ex:v-fid-retention-other ,
                 ex:v-fid-continuity ,
                 ex:v-fid-premium ,
                 ex:v-cpl-separate-limit ,
                 ex:v-cpl-retention ,
                 ex:v-cpl-continuity ,
                 ex:v-cpl-retro ,
                 ex:v-cpl-premium ,
                 ex:v-tria-premium .

ex:v-named-entity a wrd:VariableValue ; wrd:forVariable ex:var-named-entity ;
    wrd:value ex:named-entity-occ .
ex:v-ne-address a wrd:VariableValue ; wrd:forVariable ex:var-ne-address ;
    wrd:literalValue "[Named Entity Address, withheld]" .
ex:v-ne-state a wrd:VariableValue ; wrd:forVariable ex:var-ne-state ;
    wrd:literalValue "[withheld]" .
ex:v-inception a wrd:VariableValue ; wrd:forVariable ex:var-inception ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:time ; qnt:numericValue "2024-06-01T00:01:00-04:00"^^xsd:dateTime ] .
ex:v-expiration a wrd:VariableValue ; wrd:forVariable ex:var-expiration ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:time ; qnt:numericValue "2025-06-01T00:01:00-04:00"^^xsd:dateTime ] .
ex:v-premium a wrd:VariableValue ; wrd:forVariable ex:var-premium ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "71447"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-insurer-address a wrd:VariableValue ; wrd:forVariable ex:var-insurer-address ;
    wrd:literalValue "[Insurer Address, withheld]" .
ex:v-claims-address a wrd:VariableValue ; wrd:forVariable ex:var-claims-address ;
    wrd:literalValue "[Claims Address, withheld]" .
ex:v-claims-email a wrd:VariableValue ; wrd:forVariable ex:var-claims-email ;
    wrd:literalValue "[claims e-mail, withheld]" .
ex:v-aggregate a wrd:VariableValue ; wrd:forVariable ex:var-aggregate ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "6000000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-do-shared-limit a wrd:VariableValue ; wrd:forVariable ex:var-do-shared-limit ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "4000000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-do-excess a wrd:VariableValue ; wrd:forVariable ex:var-do-excess ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "500000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-do-retention a wrd:VariableValue ; wrd:forVariable ex:var-do-retention ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "50000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-do-continuity a wrd:VariableValue ; wrd:forVariable ex:var-do-continuity ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:time ; qnt:numericValue "2007-04-26T00:00:00Z"^^xsd:dateTime ] .
ex:v-do-premium a wrd:VariableValue ; wrd:forVariable ex:var-do-premium ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "32570"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-epl-shared-limit a wrd:VariableValue ; wrd:forVariable ex:var-epl-shared-limit ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "4000000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-epl-retention-class a wrd:VariableValue ; wrd:forVariable ex:var-epl-retention-class ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "250000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-epl-retention-third a wrd:VariableValue ; wrd:forVariable ex:var-epl-retention-third ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "50000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-epl-retention-other a wrd:VariableValue ; wrd:forVariable ex:var-epl-retention-other ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "50000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-epl-continuity a wrd:VariableValue ; wrd:forVariable ex:var-epl-continuity ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:time ; qnt:numericValue "2007-04-26T00:00:00Z"^^xsd:dateTime ] .
ex:v-epl-premium a wrd:VariableValue ; wrd:forVariable ex:var-epl-premium ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "33590"^^xsd:decimal ; qnt:inUnit ex:usd ] .
ex:v-fid-separate-limit a wrd:VariableValue ; wrd:forVariable ex:var-fid-separate-limit ;
    wrd:value [ a qnt:Quantity ; qnt:onSpace ex:usd-space ; qnt:numericValue "1000000"^^xsd:decimal ; qnt:inUnit ex:usd ] .
