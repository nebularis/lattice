# ---- CPL 5: notice and reporting ----------------------------------------------

# The mailbox rule: a mailed or e-mailed notice is given when sent.
tmpl:term-ccp-5-intro a ins:Term , ins:Template ; ins:expressedIn ex:ccp-5-intro .
tmpl:mailed-is-given a ins:Deeming , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-5-intro ;
    ins:deems ex:notice-given ;
    ins:when ex:notice-sent ;
    ins:conclusive true ;
    ins:forPurposeOf tmpl:notify-claim .

# The condition precedent. Its effect is already in tmpl:on-covered-claim,
# whose condition requires the Claim reported as 5(a) requires (law I12).
tmpl:term-ccp-5a a ins:Term , ins:Template ; ins:expressedIn ex:ccp-5a ;
    ins:classification ex:condition-precedent .
tmpl:notify-claim a ins:Obligation , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-5a ;
    ins:obligor ex:InsuredPerson ; ins:obligee ex:Insurer ;
    ins:activity ins-voc:Report ;
    ins:arisesOn tmpl:on-claim ;
    ins:due ex:by-90-days-after-ending .

# Relation back. "Solely for the purpose of establishing whether [the Claim]
# was first made during the Policy Period": a purpose stated as a question,
# which ins:forPurposeOf can only name as the relations reading it.
tmpl:term-ccp-5b a ins:Term , ins:Template ; ins:expressedIn ex:ccp-5b .
tmpl:related-claim-relates-back a ins:Deeming , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-5b ;
    ins:deems ex:first-made-in-period ;
    ins:when ex:related-to-reported-claim ;
    ins:conclusive true ;
    ins:forPurposeOf tmpl:pay-a , tmpl:pay-b , tmpl:defend , tmpl:pay-defense-costs .
tmpl:early-loss-5b-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-5b ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ; ins:scope ex:loss-before-actual-claim .
tmpl:early-loss-5b-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-5b ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ; ins:scope ex:loss-before-actual-claim .

tmpl:term-ccp-5c a ins:Term , ins:Template ; ins:expressedIn ex:ccp-5c .
tmpl:circumstances-relate-back a ins:Deeming , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-5c ;
    ins:deems ex:first-made-in-period ;
    ins:when ex:arises-from-notified-circumstances ;
    ins:conclusive true ;
    ins:forPurposeOf tmpl:pay-a , tmpl:pay-b , tmpl:defend , tmpl:pay-defense-costs .
# "Shall be presumed": rebuttable (S25).
tmpl:tolling-is-specific a ins:Deeming , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-5c ;
    ins:deems ex:circumstances-specific ;
    ins:when ex:tolling-agreement-attached ;
    ins:conclusive false .
tmpl:early-loss-5c-a a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-5c ;
    ins:holder ex:Insurer ; ins:counterparty ex:InsuredPerson ;
    ins:excepts tmpl:pay-a ; ins:scope ex:loss-before-actual-claim .
tmpl:early-loss-5c-b a ins:Exclusion , ins:Template ;
    ins:arisesUnder tmpl:term-ccp-5c ;
    ins:holder ex:Insurer ; ins:counterparty ex:IndemnifyingOrganization ;
    ins:excepts tmpl:pay-b ; ins:scope ex:loss-before-actual-claim .


# ---- conditions: stated, not yet evaluable (C13) ------------------------------
#
# Facts of the claims file, each a concept the case either shows or does not.
# Carve-backs are the same concept, negated (ADR-A103). Composites state the
# clause's logic, with AnySufficient for its "or".

ex:claim-facts a voc:ConceptScheme ;
    fnd:hasIdentity ex:claim-facts-identity ; fnd:hasGovernanceState fnd:Active ;
    skos:prefLabel "Claim facts"@en .
ex:first-made-in-period-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the Claim was first made against an Insured during the Policy Period or an applicable Discovery Period""" .
ex:first-made-in-period a elg:Condition ;
    elg:conditionKey "first-made-in-period" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:first-made-in-period-fact .
ex:reported-as-required-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the Claim was reported to the Insurer as CPL 5 requires""" .
ex:reported-as-required a elg:Condition ;
    elg:conditionKey "reported-as-required" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:reported-as-required-fact .
ex:for-wrongful-acts-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the Claim is made against an Insured Person for Wrongful Acts""" .
ex:for-wrongful-acts a elg:Condition ;
    elg:conditionKey "for-wrongful-acts" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:for-wrongful-acts-fact .
ex:claim-made-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """a Claim has been made against an Insured Person""" .
ex:claim-made a elg:Condition ;
    elg:conditionKey "claim-made" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:claim-made-fact .
ex:indemnified-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the Organization has indemnified the Insured Person for the Loss""" .
ex:indemnified a elg:Condition ;
    elg:conditionKey "indemnified" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:indemnified-fact .
ex:securities-claim-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the Claim is a Securities Claim""" .
ex:securities-claim a elg:Condition ;
    elg:conditionKey "securities-claim" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:securities-claim-fact .
ex:insured-by-do-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the Claim is insured by D&O Coverage""" .
ex:insured-by-do a elg:Condition ;
    elg:conditionKey "insured-by-do" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:insured-by-do-fact .
ex:excess-of-do-fact a skos:Concept ; skos:inScheme ex:claim-facts ; rdfs:label """the coverage of the CPL section is excess of D&O Coverage""" .
ex:excess-of-do a elg:Condition ;
    elg:conditionKey "excess-of-do" ;
    elg:matchStrategy elg:ExactMatch ; elg:compatibilityOperation elg:AllRequired ;
