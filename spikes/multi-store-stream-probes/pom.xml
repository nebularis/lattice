<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.nebularis.lattice.spikes</groupId>
  <artifactId>msa-i9-stream-probes</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <description>Probes of a RabbitMQ super stream under failover and partition, as the Configuration Studio's store writer uses it (MSA-I9).</description>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The versions of platform/config-studio-writer/pom.xml and platform/config-studio-core/pom.xml, so the probes run what the studio runs. -->
    <studio.stream.version>1.12.0</studio.stream.version>
    <studio.amqp.version>5.37.0</studio.amqp.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.20</version></dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency><groupId>com.rabbitmq</groupId><artifactId>stream-client</artifactId><version>${studio.stream.version}</version></dependency>
    <dependency><groupId>com.rabbitmq</groupId><artifactId>amqp-client</artifactId><version>${studio.amqp.version}</version></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>2.0.20</version></dependency>
    <!-- The studio's writer itself, for the probe's writer mode of storing offsets (MSA-F1). Installed into the local
         repository first with the platform build's install of config-studio-writer, as the README says. -->
    <dependency><groupId>org.nebularis.lattice</groupId><artifactId>config-studio-writer</artifactId><version>0.1.0-SNAPSHOT</version></dependency>
  </dependencies>
  <build>
    <finalName>probes</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.nebularis.lattice.probes.msa.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
