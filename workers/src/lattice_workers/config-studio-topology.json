{
  "exchange": "lattice.studio",
  "deadLetterExchange": "lattice.studio.dlx",
  "queues": [
    {
      "name": "lattice.studio.jobs",
      "routingKey": "lattice.studio.jobs",
      "deadLetter": true
    },
    {
      "name": "lattice.studio.dead",
      "routingKey": "#",
      "deadLetter": false
    }
  ],
  "writes": {
    "superStream": "lattice.studio.writes",
    "exchangeType": "direct",
    "exchangeArguments": {
      "x-super-stream": true
    },
    "partitions": 8,
    "partitionStream": "lattice.studio.writes-{i}",
    "bindingKey": "{i}",
    "bindingArguments": {
      "x-stream-partition-order": "{i}"
    },
    "partitionArguments": {
      "x-queue-type": "stream",
      "x-max-age": "7D",
      "x-max-length-bytes": 1073741824
    },
    "routingKey": "the first 8 hex digits of the workspace id, as an unsigned number, modulo partitions",
    "consumerGroup": "lattice.studio.writers"
  }
}
