@prefix srf: <https://www.nebularis.org/neuro-semantic/lattice/surface#> .
@prefix ex: <https://example.org/lattice/surface/defect#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:profile a srf:SurfaceProfile ;
    srf:generatorVersion "test" ;
    srf:canonicalisationVersion "srf-canon/2" ;
    srf:entailmentRegime srf:NoEntailment ;
    srf:namingNormalisation srf:SanitisedLocalName ;
    srf:symbolMode srf:PunnedSymbols ;
    srf:permittedStackDepth 0 .

ex:bad a srf:PromotionContract ;
    srf:contractKey "lossy-promotion" ;
    srf:carrier ex:Carrier ;
    srf:readProperty ex:sourceValue ;
    srf:promotesTo ex:authoredProperty ;
    srf:viaMatchRelation ex:inexactMatch ;
    srf:sourceFidelity srf:CrosswalkInexact ;
    srf:realisationMode srf:Materialised ;
    srf:targetNamespace "https://example.org/lattice/surface/defect/generated#"^^xsd:anyURI ;
    srf:surfaceProfile ex:profile .
