# SPDX-License-Identifier: CC-BY-SA-4.0
# Decoded from the MCN of MTP's cassette remedy-on-breach, so the cassette and this file are isomorphic.
@prefix ins: <https://www.nebularis.org/neuro-semantic/lattice/instrument#> .
@prefix mork: <http://www.nebularis.org/ontologies/Mork#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pty: <https://www.nebularis.org/neuro-semantic/lattice/party#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix src: <https://example.org/lattice/mtp/source#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Remedy_Activity> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Remedy> ;
    mork:dataRef "src:act" ;
    mork:exactRBoxMatch ins:activity ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Remedy_Obligee> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Remedy> ;
    mork:inverseRBoxMatch ins:obligee ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/remedy-on-breach#ToConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> ;
    mork:templateMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Role_T> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Remedy_Obligor> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Remedy> ;
    mork:inverseRBoxMatch ins:obligor ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/remedy-on-breach#ByConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> ;
    mork:templateMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Role_T> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Remedy_Term> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Remedy> ;
    mork:conceptName "remedy-term" ;
    mork:exactTBoxMatch ins:Template,
        ins:Term ;
    mork:inverseRBoxMatch ins:arisesUnder ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Role_T_Label> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Role_T> ;
    mork:dataRef "src:name" ;
    mork:exactRBoxMatch rdfs:label ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking_Activity> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking_Relation> ;
    mork:dataRef "src:act" ;
    mork:exactRBoxMatch ins:activity ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking_Obligee> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking_Relation> ;
    mork:inverseRBoxMatch ins:obligee ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/remedy-on-breach#ToConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> ;
    mork:templateMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Role_T> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking_Obligor> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking_Relation> ;
    mork:inverseRBoxMatch ins:obligor ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/remedy-on-breach#ByConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> ;
    mork:templateMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Role_T> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#RemedyConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Concepts> ;
    mork:path "src:remedy" .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme_sdl1> a owl:NamedIndividual,
        sh:PrefixDeclaration ;
    sh:namespace "https://example.org/lattice/mtp/source#"^^xsd:anyURI ;
    sh:prefix "src" .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Source> a mork:RepresentationScheme,
        owl:NamedIndividual ;
    rdfs:label "undertakings between named parties" ;
    mork:format mork:RDF .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking> a mork:Datum,
        owl:NamedIndividual ;
    mork:conceptName "term" ;
    mork:exactTBoxMatch ins:Template,
        ins:Term ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/remedy-on-breach#UndertakingConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#UndertakingConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Concepts> ;
    mork:representedAs src:Undertaking .

src:Undertaking a mork:Entity,
        owl:NamedIndividual .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#ByConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Concepts> ;
    mork:path "src:by" .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#ToConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Concepts> ;
    mork:path "src:to" .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Concepts> a mork:TaxonomyScheme,
        owl:NamedIndividual ;
    skos:inScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Source> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Remedy> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking_Relation> ;
    mork:conceptName "remedy" ;
    mork:exactRBoxMatch ins:arisesOnBreachOf ;
    mork:exactTBoxMatch ins:Obligation,
        ins:Template ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/remedy-on-breach#RemedyConcept> ;
    mork:mappingNote "A remedy is an obligation that arises on the breach of the one it remedies, never a node of another kind." ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking_Relation> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/remedy-on-breach#Undertaking> ;
    mork:conceptName "relation" ;
    mork:exactRBoxMatch ins:arisesUnder ;
    mork:exactTBoxMatch ins:Obligation,
        ins:Template ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Role_T> a mork:Datum,
        owl:NamedIndividual ;
    mork:conceptName "role" ;
    mork:exactTBoxMatch pty:Role ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> .

<https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme> a mork:MappingScheme,
        owl:NamedIndividual ;
    rdfs:label "an undertaking and the remedy that arises on its breach" ;
    mork:compilationMode mork:ReviewMode ;
    sh:declare <https://example.org/lattice/mtp/patterns/remedy-on-breach#Scheme_sdl1> .

