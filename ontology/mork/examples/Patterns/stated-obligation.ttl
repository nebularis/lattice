# SPDX-License-Identifier: CC-BY-SA-4.0
# Decoded from the MCN of MTP's cassette stated-obligation, so the cassette and this file are isomorphic.
@prefix ins: <https://www.nebularis.org/neuro-semantic/lattice/instrument#> .
@prefix mork: <http://www.nebularis.org/ontologies/Mork#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pty: <https://www.nebularis.org/neuro-semantic/lattice/party#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix src: <https://example.org/lattice/mtp/source#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/lattice/mtp/patterns/stated-obligation#Role_T_Label> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/stated-obligation#Role_T> ;
    mork:dataRef "src:name" ;
    mork:exactRBoxMatch rdfs:label ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Scheme> .

<https://example.org/lattice/mtp/patterns/stated-obligation#Undertaking_Activity> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/stated-obligation#Undertaking_Relation> ;
    mork:dataRef "src:act" ;
    mork:exactRBoxMatch ins:activity ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Scheme> .

<https://example.org/lattice/mtp/patterns/stated-obligation#Undertaking_Obligee> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/stated-obligation#Undertaking_Relation> ;
    mork:inverseRBoxMatch ins:obligee ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/stated-obligation#ToConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Scheme> ;
    mork:templateMapping <https://example.org/lattice/mtp/patterns/stated-obligation#Role_T> .

<https://example.org/lattice/mtp/patterns/stated-obligation#Undertaking_Obligor> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/stated-obligation#Undertaking_Relation> ;
    mork:inverseRBoxMatch ins:obligor ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/stated-obligation#ByConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Scheme> ;
    mork:templateMapping <https://example.org/lattice/mtp/patterns/stated-obligation#Role_T> .

<https://example.org/lattice/mtp/patterns/stated-obligation#ByConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Concepts> ;
    mork:path "src:by" .

<https://example.org/lattice/mtp/patterns/stated-obligation#Scheme_sdl1> a owl:NamedIndividual,
        sh:PrefixDeclaration ;
    sh:namespace "https://example.org/lattice/mtp/source#"^^xsd:anyURI ;
    sh:prefix "src" .

<https://example.org/lattice/mtp/patterns/stated-obligation#Source> a mork:RepresentationScheme,
        owl:NamedIndividual ;
    rdfs:label "undertakings between named parties" ;
    mork:format mork:RDF .

<https://example.org/lattice/mtp/patterns/stated-obligation#ToConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Concepts> ;
    mork:path "src:to" .

<https://example.org/lattice/mtp/patterns/stated-obligation#Undertaking> a mork:Datum,
        owl:NamedIndividual ;
    mork:conceptName "term" ;
    mork:exactTBoxMatch ins:Template,
        ins:Term ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/stated-obligation#UndertakingConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Scheme> .

<https://example.org/lattice/mtp/patterns/stated-obligation#UndertakingConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Concepts> ;
    mork:representedAs src:Undertaking .

src:Undertaking a mork:Entity,
        owl:NamedIndividual .

<https://example.org/lattice/mtp/patterns/stated-obligation#Concepts> a mork:TaxonomyScheme,
        owl:NamedIndividual ;
    skos:inScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Source> .

<https://example.org/lattice/mtp/patterns/stated-obligation#Role_T> a mork:Datum,
        owl:NamedIndividual ;
    mork:conceptName "role" ;
    mork:exactTBoxMatch pty:Role ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Scheme> .

<https://example.org/lattice/mtp/patterns/stated-obligation#Undertaking_Relation> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/stated-obligation#Undertaking> ;
    mork:conceptName "relation" ;
    mork:exactRBoxMatch ins:arisesUnder ;
    mork:exactTBoxMatch ins:Obligation,
        ins:Template ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/stated-obligation#Scheme> .

<https://example.org/lattice/mtp/patterns/stated-obligation#Scheme> a mork:MappingScheme,
        owl:NamedIndividual ;
    rdfs:label "an undertaking to a stated obligation" ;
    mork:compilationMode mork:ReviewMode ;
    sh:declare <https://example.org/lattice/mtp/patterns/stated-obligation#Scheme_sdl1> .

