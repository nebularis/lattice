# SPDX-License-Identifier: CC-BY-SA-4.0
# Decoded from the MCN of MTP's cassette concept-condition, so the cassette and this file are isomorphic.
@prefix elg: <https://www.nebularis.org/neuro-semantic/lattice/eligibility#> .
@prefix ins: <https://www.nebularis.org/neuro-semantic/lattice/instrument#> .
@prefix mork: <http://www.nebularis.org/ontologies/Mork#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pty: <https://www.nebularis.org/neuro-semantic/lattice/party#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix src: <https://example.org/lattice/mtp/source#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/lattice/mtp/patterns/concept-condition#Role_T_Label> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Role_T> ;
    mork:dataRef "src:name" ;
    mork:exactRBoxMatch rdfs:label ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Activity> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Relation> ;
    mork:dataRef "src:act" ;
    mork:exactRBoxMatch ins:activity ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Obligee> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Relation> ;
    mork:inverseRBoxMatch ins:obligee ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/concept-condition#ToConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> ;
    mork:templateMapping <https://example.org/lattice/mtp/patterns/concept-condition#Role_T> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Obligor> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Relation> ;
    mork:inverseRBoxMatch ins:obligor ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/concept-condition#ByConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> ;
    mork:templateMapping <https://example.org/lattice/mtp/patterns/concept-condition#Role_T> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Place_Key> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Place> ;
    mork:dataInline "delivery-place" ;
    mork:exactRBoxMatch elg:conditionKey ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Place_Required> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Place> ;
    mork:dataRef "src:at" ;
    mork:exactRBoxMatch elg:requiredConcept ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Place_Strategy> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Place> ;
    mork:exactABoxMatch elg:ExactMatch ;
    mork:exactRBoxMatch elg:matchStrategy ;
    mork:mappingNote "A condition's kind is chosen by its match strategy, an individual, never by a subclass." ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Place_Wildcard> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Place> ;
    mork:exactABoxMatch elg:NoWildcard ;
    mork:exactRBoxMatch elg:wildcardSemantics ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Scope_Key> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Scope> ;
    mork:dataInline "undertaking-scope" ;
    mork:exactRBoxMatch elg:conditionKey ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Scope_Operation> a mork:DataMapping,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Scope> ;
    mork:exactABoxMatch elg:AllRequired ;
    mork:exactRBoxMatch elg:compositionOperation ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#ByConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/concept-condition#Concepts> ;
    mork:path "src:by" .

<https://example.org/lattice/mtp/patterns/concept-condition#Scheme_sdl1> a owl:NamedIndividual,
        sh:PrefixDeclaration ;
    sh:namespace "https://example.org/lattice/mtp/source#"^^xsd:anyURI ;
    sh:prefix "src" .

<https://example.org/lattice/mtp/patterns/concept-condition#Source> a mork:RepresentationScheme,
        owl:NamedIndividual ;
    rdfs:label "undertakings between named parties" ;
    mork:format mork:RDF .

<https://example.org/lattice/mtp/patterns/concept-condition#ToConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/concept-condition#Concepts> ;
    mork:path "src:to" .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking> a mork:Datum,
        owl:NamedIndividual ;
    mork:conceptName "term" ;
    mork:exactTBoxMatch ins:Template,
        ins:Term ;
    mork:mappingFor <https://example.org/lattice/mtp/patterns/concept-condition#UndertakingConcept> ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#UndertakingConcept> a mork:DataConcept,
        owl:NamedIndividual ;
    mork:conceptScheme <https://example.org/lattice/mtp/patterns/concept-condition#Concepts> ;
    mork:representedAs src:Undertaking .

src:Undertaking a mork:Entity,
        owl:NamedIndividual .

<https://example.org/lattice/mtp/patterns/concept-condition#Concepts> a mork:TaxonomyScheme,
        owl:NamedIndividual ;
    skos:inScheme <https://example.org/lattice/mtp/patterns/concept-condition#Source> .

<https://example.org/lattice/mtp/patterns/concept-condition#Role_T> a mork:Datum,
        owl:NamedIndividual ;
    mork:conceptName "role" ;
    mork:exactTBoxMatch pty:Role ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Scope> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Relation> ;
    mork:conceptName "scope" ;
    mork:exactTBoxMatch elg:AdmissionProfile ;
    mork:inverseRBoxMatch ins:scope ;
    mork:mappingNote "A relation's scope is one admission profile that composes its conditions." ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Place> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Scope> ;
    mork:conceptName "place-condition" ;
    mork:exactTBoxMatch elg:ExactCondition ;
    mork:inverseRBoxMatch elg:hasCondition ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Undertaking_Relation> a mork:Datum,
        owl:NamedIndividual ;
    mork:compositeBroaderMapping <https://example.org/lattice/mtp/patterns/concept-condition#Undertaking> ;
    mork:conceptName "relation" ;
    mork:exactRBoxMatch ins:arisesUnder ;
    mork:exactTBoxMatch ins:Obligation,
        ins:Template ;
    mork:mappingScheme <https://example.org/lattice/mtp/patterns/concept-condition#Scheme> .

<https://example.org/lattice/mtp/patterns/concept-condition#Scheme> a mork:MappingScheme,
        owl:NamedIndividual ;
    rdfs:label "an undertaking to an obligation scoped by a concept condition" ;
    mork:compilationMode mork:ReviewMode ;
    sh:declare <https://example.org/lattice/mtp/patterns/concept-condition#Scheme_sdl1> .

