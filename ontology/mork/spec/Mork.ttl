# SPDX-License-Identifier: MPL-2.0

@prefix dct: <http://purl.org/dc/terms/> .
@prefix elg: <https://www.nebularis.org/neuro-semantic/lattice/eligibility#> .
@prefix exe: <https://www.nebularis.org/neuro-semantic/lattice/executable#> .
@prefix fnd: <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix mork: <http://www.nebularis.org/ontologies/Mork#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.nebularis.org/ontologies/Mork> a owl:Ontology ;
    owl:versionIRI <http://www.nebularis.org/ontologies/Mork/0.19.0> ;
    owl:imports <http://www.w3.org/2003/11/swrl>, <http://www.w3.org/2004/02/skos/core>, <http://www.w3.org/ns/shacl>, <https://www.nebularis.org/neuro-semantic/lattice/foundation/0.19.0> ;
    dct:description """MORK states a mapping between a source and a target ontology as data. A mapping is a node in a graph that says which source element corresponds to which target element, in which stratum of the target (its classes, its properties or its individuals), how closely, how confidently and under what governance. Mappings compose into a directed acyclic graph, so that the order in which they must run is derived and never written down.

A compiler reads the mapping graph and writes executable artefacts, such as RML mappings, SPARQL queries, SHACL shapes and SWRL rules. A language model may propose the graph, and a validator and a person then check it before anything compiles. The module also holds Executable, the vocabulary for the plans, artefacts and diagnostics that MORK's Eligibility backends produce.""" ;
    dct:creator <https://github.com/nebularis> .

dct:creator a owl:AnnotationProperty .

dct:description a owl:AnnotationProperty .

mork:Accepted a mork:ReviewDecision, owl:NamedIndividual ;
    rdfs:label "accepted" ;
    rdfs:comment "The proposed mapping is right as proposed." .

mork:AnonymousElement a owl:Class ;
    rdfs:label "anonymous entity" ;
    rdfs:comment "Used to describe the Representation of an Entity that has no identifier, e.g., that is defined anonymously, such as an object within an array." ;
    rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( mork:CollectionElement [ a owl:Restriction ; owl:onProperty mork:identifier ; owl:hasValue "" ] ) ], mork:CollectionElement .

mork:Array a owl:Class ;
    rdfs:label "array" ;
    rdfs:comment "Used to represent an Array, which is an unordered collection of elements. Elements can be associated with the array via the elementType object property." ;
    rdfs:subClassOf mork:UnorderedCollection .

mork:Association a owl:Class ;
    rdfs:label "association" ;
    rdfs:comment "Represents an association between two data Representations. This mirrors the role of Objectification in the subClass hierarchy of DataConcept." ;
    skos:scopeNote "By convention, mork:Association does not collect individual members, but acts as a structural component." ;
    rdfs:subClassOf mork:Representation ;
    owl:disjointWith mork:Entity .

mork:Attribute a owl:Class ;
    rdfs:label "attribute (representation)" ;
    rdfs:comment "is used to denote an attribute in a representation scheme" ;
    rdfs:subClassOf mork:IdentifiableElement .

mork:AxiomForm a owl:Class ;
    rdfs:label "axiom form" ;
    rdfs:comment "Which form of T-Box axiom axiomForm names. Named individuals are GlobalAxioms, UniversalRestriction, ExistentialRestriction and DefiningRestriction." .

mork:Bottom a mork:OwlAxiom, owl:NamedIndividual .

mork:CastComparison a mork:LookupComparison, owl:NamedIndividual ;
    rdfs:label "cast comparison" ;
    rdfs:comment "The value read is cast to the lookupDatatype, then matched as the same RDF term, which an index can serve. Without a lookupDatatype it is compared as LexicalComparison is. An IRI is matched as it is. The default." .

mork:Chaining a owl:Class ;
    rdfs:comment "A Composition that does not collect like elements. It is disjoint with Collection." ;
    rdfs:subClassOf mork:Composition ;
    owl:disjointWith mork:Collection .

mork:ClassCombination a owl:Class ;
    rdfs:label "class combination" ;
    rdfs:comment "Which combination of several classes classCombination names. Named individuals are UnionOfClasses and IntersectionOfClasses." .

mork:Collection a owl:Class ;
    rdfs:label "collection" ;
    rdfs:comment "Used to represent a collection of elements, such as a list or array." ;
    rdfs:subClassOf mork:Composition .

mork:CollectionElement a owl:Class ;
    rdfs:label "collection element" ;
    rdfs:comment "Used to describe the membership of elements within a collection." ;
    rdfs:subClassOf mork:Membership .

mork:CommunityMatch a owl:Class ;
    rdfs:label "community match" ;
    rdfs:comment "The best-matching semantic community for the concepts observed in one section, with its score and confidence." .

mork:CommunityMembership a owl:Class ;
    rdfs:label "community membership" ;
    rdfs:comment "A concept's membership of a semantic community, with its weight in it." .

mork:CommunityScheme a owl:Class ;
    rdfs:label "community scheme" ;
    rdfs:comment "One discovery of semantic communities, over the section observations it was discovered from, with the algorithm and resolution it used." .

mork:CompilationMode a owl:Class ;
    rdfs:label "compilation mode" ;
    rdfs:comment "Which of draft, review, or production compilation a MappingScheme's compilationMode names. Named individuals are DraftMode, ReviewMode, and ProductionMode." .

mork:CompileFinding a owl:Class ;
    rdfs:label "compile finding" ;
    rdfs:comment "One thing a compiler found while compiling a mapping scheme, with its code, its severity and the mapping it is about." .

mork:CompiledMapping a owl:Class ;
    rdfs:label "compiled mapping" ;
    rdfs:comment "A mapping scheme as a compiler compiled it, at one instant, against one base, with its queries, its findings and its mappings' effective confidences. It is named by the digest of its compiled text, so one compilation always has one name, and is typed prov:Entity beside this class." .

mork:CompiledQuery a owl:Class ;
    rdfs:label "compiled query" ;
    rdfs:comment "One query of a compiled mapping, a CONSTRUCT that writes a mapping's triples, a check SELECT that reports where it could not, or a closure SELECT that gathers the members of a class combination once the mappings that create them have run." .

mork:Composition a owl:Class ;
    rdfs:label "composition" ;
    rdfs:comment "Is used to represent a compositional association between two Representation elements. This carries the semantics that the object in a subject-predicate-object triple, should not be present in an object graph without the presence of a corresponding element representing the subject." ;
    rdfs:subClassOf mork:Association .

mork:ConcatExpression a owl:Class ;
    rdfs:label "concat expression" ;
    rdfs:comment "A concatenation of two template expressions. Evaluates to the string concatenation of its left and right operands. Concatenation is associative with Literal(\"\") as identity." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:concatLeft ; owl:someValuesFrom mork:TemplateExpression ], [ a owl:Restriction ; owl:onProperty mork:concatRight ; owl:someValuesFrom mork:TemplateExpression ], mork:TemplateExpression .

mork:ConstraintProvenance a owl:Class ;
    rdfs:label "constraint provenance" ;
    rdfs:comment "Records the origin and review chain of generated constraints, including LLM model ID, confidence, review status, jurisdiction, and effective period." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:provenanceCreated ; owl:someValuesFrom xsd:dateTime ], [ a owl:Restriction ; owl:onProperty mork:provenanceCreator ; owl:someValuesFrom xsd:string ], skos:Concept .

mork:ConstraintScheme a owl:Class ;
    rdfs:label "constraint scheme" ;
    rdfs:comment "A container for a coherent set of SHACL shapes, versionable and scoped to a jurisdiction and effective period." ;
    rdfs:subClassOf skos:ConceptScheme .

mork:Corrected a mork:ReviewDecision, owl:NamedIndividual ;
    rdfs:label "corrected" ;
    rdfs:comment "The proposed mapping is replaced by the mapping the review names with correctedBy." .

mork:DAGTemplate a owl:Class ;
    rdfs:label "DAG template" ;
    rdfs:comment "A shape of mapping DAG, a root class and its property projections, that a community's mappings have taken often enough to map a new section of it without a language model." .

mork:DataConcept a owl:Class ;
    rdfs:label "data concept" ;
    rdfs:comment "An abstract description of a concept, representing a concept to be mapped to a representation and/or ontology scheme." ;
    skos:scopeNote "DataConcepts are derived from a representation scheme and mapped to an ontological scheme. An individual can be both a Representation and a DataConcept." ;
    rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( skos:Concept [ a owl:Restriction ; owl:onProperty mork:conceptScheme ; owl:someValuesFrom mork:TaxonomyScheme ] ) ], skos:Concept .

mork:DataMapping a owl:Class ;
    rdfs:label "data mapping" ;
    rdfs:comment "is used to capture a mapping between concepts from a representation and/or concept scheme to an ontological scheme" ;
    rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( skos:Concept [ a owl:Restriction ; owl:onProperty mork:mappingScheme ; owl:someValuesFrom mork:MappingScheme ] ) ], skos:Concept .

mork:Datum a owl:Class ;
    rdfs:label "datum mapping" ;
    rdfs:comment "defines a mapping that explicitly states a datum must be individuated in a target OntologicalScheme" ;
    rdfs:subClassOf mork:DataMapping ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty mork:deferredMapping ; owl:someValuesFrom mork:DataMapping ] .

mork:Deferred a mork:ReviewDecision, owl:NamedIndividual ;
    rdfs:label "deferred" ;
    rdfs:comment "The decision on the proposed mapping waits." .

mork:DeferredABoxReference a mork:DeferredContext, owl:NamedIndividual ;
    rdfs:comment "Used as a placeholder for referencing the A-Box object in a triple that a DataMapping with an RBox-match refers to." .

mork:DeferredClassDefinition a mork:OwlClass, owl:NamedIndividual .

mork:DeferredConceptIRI a owl:Class ;
    rdfs:label "deferred concept iri" ;
    rdfs:comment "Used to indicate that the axiom a mapping property is referring to shall be obtained once it is created, referencing the conceptName, conceptIRI, or conceptNameTemplate on the mapping which declares the relationship to obtain (i.e., locate) the axiom in question." ;
    rdfs:subClassOf mork:OwlAxiom .

mork:DeferredContext a owl:Class ;
    rdfs:label "deferred context" ;
    rdfs:comment "Used to act as a placeholder for an axiom that some DataMapping proposes the creation of, which must be referenced by an object property in a related DataMapping." ;
    rdfs:subClassOf mork:DataMapping .

mork:DeferredDataPropertyDefinition a mork:OwlDataProperty, owl:NamedIndividual .

mork:DeferredIndividualDefinition a mork:OwlAxiom, owl:NamedIndividual .

mork:DeferredObjectPropertyDefinition a mork:OwlObjectProperty, owl:NamedIndividual .

mork:DefiningRestriction a mork:AxiomForm, owl:NamedIndividual ;
    rdfs:label "defining restriction" ;
    rdfs:comment "Each domain class D is equivalent to the restriction that some value of the property is in the range R, D ≡ ∃p.R, so anything with such a value is classified as a member of D." .

mork:Digraph a owl:Class ;
    rdfs:comment "A concept that a digraph match relates to an axiom. Deprecated in favour of the composite mappings." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:digraphMatch ; owl:someValuesFrom mork:OwlAxiom ], skos:Concept .

mork:DraftMode a mork:CompilationMode, owl:NamedIndividual ;
    rdfs:label "draft mode" ;
    rdfs:comment "Governance state and version identity are not required on member mappings. The default where compilationMode is unset." .

mork:Entity a owl:Class ;
    rdfs:label "entity (representation)" ;
    rdfs:comment "Is used to denote an entity in a representation scheme. An Entity will usually be marked with its identity in some originating representation scheme using the identifier datatype property." ;
    rdfs:subClassOf mork:IdentifiableElement .

mork:ErrorFinding a mork:FindingSeverity, owl:NamedIndividual ;
    rdfs:label "error finding" ;
    rdfs:comment "A mapping not compiled. In production mode any error refuses the compilation." .

mork:ExclusionIntent a owl:Class ;
    rdfs:label "exclusion intent" ;
    rdfs:comment "An intent node representing an exclusion (e.g., 'exclude nation-state attacks')." ;
    rdfs:subClassOf mork:IntentNode .

mork:ExistentialRestriction a mork:AxiomForm, owl:NamedIndividual ;
    rdfs:label "existential restriction" ;
    rdfs:comment "Each domain class D is a subclass of the restriction that some value of the property is in the range R, D ⊑ ∃p.R, so every member of D has such a value." .

mork:FindingSeverity a owl:Class ;
    rdfs:label "finding severity" ;
    rdfs:comment "How severe a compile finding is. Named individuals are ErrorFinding, WarningFinding and InfoFinding." .

mork:GenerativeMapping a owl:Class ;
    rdfs:label "generative mapping" ;
    rdfs:comment "The class of all DataMapping individuals whose evaluation produces a constraint, inference, transformation, or projection artefact (SHACL shape, SWRL rule, RML triples map, projection mapping records, or future artefact types). Serves as the common superclass for ShapeMapping, RuleMapping, TransformMapping, and ProjectionMapping, and as the domain for shared properties (hasParameterBinding, hasTargetingSpec, dependsOnMapping)." ;
    skos:scopeNote "GenerativeMapping is not an equivalence class — it has no structural characterisation that would allow automatic classification. Membership is inferred via subclass relationships from ShapeMapping, RuleMapping, TransformMapping, or ProjectionMapping. Foundation alignment: subclassing fnd:Governable and fnd:Versioned requires exactly one fnd:hasGovernanceState and one fnd:hasIdentity per instance at the OWL level, matching the pattern srf:SurfaceContract already uses. This is additive to, not a replacement for, the pre-existing reviewStatus (on *Provenance individuals), supersedes, mappingVersion, and deprecationReason properties, which remain valid and are unchanged. Production-mode compilation gating on governance state is a SHACL-level, mode-conditional check (mork:GenerativeMappingProductionGovernanceShape: beyond Draft, plus identity), not an unconditional OWL requirement — a draft-mode mapping with no governance state asserted yet is incomplete, not inconsistent." ;
    rdfs:subClassOf fnd:Governable, fnd:Versioned, mork:DataMapping .

mork:GlobalAxioms a mork:AxiomForm, owl:NamedIndividual ;
    rdfs:label "global axioms" ;
    rdfs:comment "The property's rdfs:domain and rdfs:range, which hold for every use of it. The default." .

mork:Hypothesis a owl:Class ;
    rdfs:comment "A data mapping that another mapping uses as a hypothesis in support of its postulated match." ;
    rdfs:subClassOf mork:DataMapping .

mork:IdentifiableElement a owl:Class ;
    rdfs:comment "A Representation that carries an identifier used by some external scheme or schema. Entity and Attribute are identifiable elements." ;
    rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( mork:Representation [ a owl:Restriction ; owl:onProperty mork:identifier ; owl:someValuesFrom xsd:string ] ) ], mork:Representation .

mork:InclusionIntent a owl:Class ;
    rdfs:label "inclusion intent" ;
    rdfs:comment "An intent node representing an explicit inclusion (e.g., 'including sub-limits')." ;
    rdfs:subClassOf mork:IntentNode .

mork:IndexedMapping a owl:Class ;
    rdfs:comment "A data mapping that occurs at a position in a collection of mappings, which mork:mappingIndex records." ;
    rdfs:subClassOf mork:DataMapping .

mork:InfoFinding a mork:FindingSeverity, owl:NamedIndividual ;
    rdfs:label "info finding" ;
    rdfs:comment "Nothing lost, for example a mapping left to another backend." .

mork:InstanceOutput a mork:OutputBox, owl:NamedIndividual ;
    rdfs:label "instance output" ;
    rdfs:comment "The instance data a compiled query writes, its target graph." .

mork:IntentNode a owl:Class ;
    rdfs:label "intent node" ;
    rdfs:comment "The base class for structured intent representations. IntentNode individuals form a bounded join-semilattice under :refinesIntent.\n\nSubtypes capture the principal categories of insurance product and eligibility criteria: QualitativeIntent, QuantitativeConstraint, SpatialScope, TemporalScope, ExclusionIntent, InclusionIntent. These subtypes are not mutually disjoint."^^xsd:string ;
    skos:scopeNote "IntentNode properties reference only SKOS concept schemes, xsd datatypes, and the natural language source. None reference the target ontology's classes or properties, ensuring stability under ontology evolution (Foundations §3.8.4, Proposition 3.8.4)." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:intentScheme ; owl:someValuesFrom mork:IntentScheme ], skos:Concept .

mork:IntentScheme a owl:Class ;
    rdfs:label "intent scheme" ;
    rdfs:comment "A container for intent nodes extracted from natural language specifications. It carries jurisdiction, effective period, and provenance metadata.\n\nThe IntentScheme occupies a position between natural language and ontological commitment. It captures what the user means without committing to how that meaning is realised in a target ontology."^^xsd:string ;
    rdfs:subClassOf skos:ConceptScheme .

mork:Interpolation a owl:Class ;
    rdfs:label "interpolation template" ;
    rdfs:comment "Used to collect two or more mappings that require interpolation against a template. The syntax for referencing the mappings is simply $1, $2, $3, according to their position within the underlying OrderedCollection." ;
    rdfs:subClassOf skos:OrderedCollection ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty mork:interpolationComponent ; owl:someValuesFrom mork:DataMapping ] [ a owl:Restriction ; owl:onProperty mork:interpolationTemplate ; owl:someValuesFrom xsd:string ] ) ] .

mork:InterpolationExpression a owl:Class ;
    rdfs:label "interpolation expression" ;
    rdfs:comment "A template interpolation with placeholder bindings. Evaluates by substituting each placeholder in the templateString with the evaluated value of its corresponding TemplateBinding." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:templateString ; owl:someValuesFrom xsd:string ], mork:TemplateExpression .

mork:IntersectionOfClasses a mork:ClassCombination, owl:NamedIndividual ;
    rdfs:label "intersection of classes" ;
    rdfs:comment "Several classes are combined with owl:intersectionOf." .

mork:JSON a mork:SerializationFormat, owl:NamedIndividual .

mork:LexicalComparison a mork:LookupComparison, owl:NamedIndividual ;
    rdfs:label "lexical comparison" ;
    rdfs:comment "The value read and the reference value match when their lexical forms are equal, whatever their datatypes. No index can serve it, so each value read is compared with each reference value." .

mork:LiteralExpression a owl:Class ;
    rdfs:label "literal expression" ;
    rdfs:comment "A constant string value in the template expression algebra. Evaluates to its dataInline value." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:dataInline ; owl:someValuesFrom xsd:string ], mork:TemplateExpression .

mork:Lookup a owl:Class ;
    rdfs:label "lookup" ;
    rdfs:comment "Defines a \"lookup\", from some base data to a named individual" ;
    skos:scopeNote "- dataRef value points to a \"path\" in the source data where the lookup (code or indicator) resides\n- t-box match indicates the class to which the identified individual must belong\n- r-box match indicates the relationship between the mapping subject and the identified individual (object)"^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( mork:DataMapping [ a owl:Restriction ; owl:onProperty mork:dataRef ; owl:someValuesFrom xsd:string ] ) ], mork:DataMapping .

mork:LookupComparison a owl:Class ;
    rdfs:label "lookup comparison" ;
    rdfs:comment "Which comparison lookupComparison names. Named individuals are CastComparison, LexicalComparison and TermComparison." .

mork:LookupExpression a owl:Class ;
    rdfs:label "lookup expression" ;
    rdfs:comment "Resolves a value against a concept scheme by matching on a specified datatype property. Evaluates by finding the concept in lookupScheme whose lookupProperty value equals the evaluated lookupSource." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:lookupScheme ; owl:someValuesFrom skos:ConceptScheme ], [ a owl:Restriction ; owl:onProperty mork:lookupSource ; owl:someValuesFrom mork:TemplateExpression ], mork:TemplateExpression .

mork:MappingReview a owl:Class ;
    rdfs:label "mapping review" ;
    rdfs:comment "A person's or a reference's decision on one proposed mapping. It is also a prov:Activity, its reviewer named with prov:wasAssociatedWith and its time with prov:endedAtTime." .

mork:MappingScheme a owl:Class ;
    rdfs:label "mapping scheme" ;
    rdfs:comment "a scheme that captures mappings between concepts, from a RepresentationScheme to an OntologicalScheme" ;
    rdfs:subClassOf skos:ConceptScheme .

mork:Membership a owl:Class ;
    rdfs:label "membership" ;
    rdfs:comment "Conceptual representation of the notion of \"membership\" within some containing Representation element." ;
    skos:scopeNote "By convention, individuals should not made direct members of this class, but rather belong to its subclasses." ;
    rdfs:subClassOf mork:Representation .

mork:MorkOntologyScheme a mork:OntologicalScheme, owl:NamedIndividual .

mork:NormativeReferenceItent a owl:Class ;
    rdfs:label "normative reference intent" ;
    rdfs:comment "An intent node referencing an external standard, authority, or published form by identifier, without committing to its domain semantics." ;
    rdfs:subClassOf mork:IntentNode .

mork:Objectification a owl:Class ;
    rdfs:comment "Represents an \"objectified fact\" relating two DataConcepts to one another with a specific set of roles in mind." ;
    rdfs:subClassOf mork:DataConcept ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( [ a owl:Restriction ; owl:onProperty mork:broadConceptRole ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass skos:Concept ] [ a owl:Restriction ; owl:onProperty mork:narrowConceptRole ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass skos:Concept ] ) ] .

mork:OntologicalProjection a owl:Class ;
    rdfs:label "ontological projection" ;
    rdfs:comment "What the mappings of a semantic community's concepts have most often targeted in one target ontology, the class and the properties beneath it." .

mork:OntologicalScheme a owl:Class ;
    rdfs:label "ontological scheme" ;
    rdfs:comment "A concept scheme that holds the terms of a target ontology. A mapping scheme maps concepts from a representation scheme to one." ;
    rdfs:subClassOf skos:ConceptScheme .

mork:OrderedCollection a owl:Class ;
    rdfs:comment "A Collection whose items are ordered, that is a collection for which mork:orderedItems is true." ;
    rdfs:subClassOf mork:Collection ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty mork:orderedItems ; owl:hasValue "true"^^xsd:boolean ] .

mork:OutputBox a owl:Class ;
    rdfs:label "output box" ;
    rdfs:comment "Which output a compiled query writes to. Named individuals are InstanceOutput and TerminologyOutput." .

mork:OwlAxiom a owl:Class ;
    rdfs:label "owl axiom" ;
    rdfs:comment "used to denote an axiom in an OWL ontology" ;
    skos:scopeNote "The OwlAxiom members of an OntologicalScheme are not interrelated using skos notation, since that information is already present in the ontology itself.\n\nRather, the behaviour when mapping data into (and out of) an OntologicalScheme is captured by each DataMapping such that ?mapping skos:inScheme :MappingScheme"^^xsd:string ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( skos:Concept [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:someValuesFrom mork:OntologicalScheme ] ) ] .

mork:OwlClass a owl:Class ;
    rdfs:label "owl class" ;
    rdfs:comment "Represents an OWL Class." ;
    rdfs:subClassOf mork:OwlAxiom .

mork:OwlDataProperty a owl:Class ;
    rdfs:label "owl data property" ;
    rdfs:comment "Represents an OWL DataProperty" ;
    rdfs:subClassOf mork:OwlAxiom .

mork:OwlNothing a mork:OwlAxiom, owl:NamedIndividual .

mork:OwlObjectProperty a owl:Class ;
    rdfs:label "owl object property" ;
    rdfs:comment "Represents an OWL ObjectProperty" ;
    rdfs:subClassOf mork:OwlAxiom .

mork:ParameterBinding a owl:Class ;
    rdfs:label "parameter binding" ;
    rdfs:comment "A reified binding with type metadata: paramName, paramType (Numeric, Concept, Path, String, Duration), and paramValue." .

mork:ProductionMode a mork:CompilationMode, owl:NamedIndividual ;
    rdfs:label "production mode" ;
    rdfs:comment "Every GenerativeMapping in the scheme must have progressed beyond fnd:Draft governance state (Reviewed, Active, or Superseded) and declare fnd:hasIdentity before it compiles. It is enforced by mork:GenerativeMappingProductionGovernanceShape." .

mork:ProjectionMapping a owl:Class ;
    rdfs:label "projection mapping" ;
    rdfs:comment "A generative mapping that, when compiled, produces lookup-surface class definitions as first-class RDF graph objects and records the generated symbols against the mapping." ;
    skos:scopeNote "Classification as ProjectionMapping is inferred from the presence of the generatesClassDefinition property pointing to an OwlClass, following the same definitional pattern as ShapeMapping, RuleMapping, and TransformMapping." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:generatesClassDefinition ; owl:someValuesFrom mork:OwlClass ], [ a owl:Restriction ; owl:onProperty mork:hasParameterBinding ; owl:minCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty mork:hasProjectionProvenance ; owl:someValuesFrom mork:ProjectionProvenance ], [ a owl:Restriction ; owl:onProperty mork:hasTargetingSpec ; owl:someValuesFrom mork:TargetingSpec ], mork:GenerativeMapping ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( mork:DataMapping [ a owl:Restriction ; owl:onProperty mork:generatesClassDefinition ; owl:someValuesFrom mork:OwlClass ] ) ] .

mork:ProjectionProvenance a owl:Class ;
    rdfs:label "projection provenance" ;
    rdfs:comment "Records the origin and review chain of generated projection mappings, including profile, read-set identity, review status, and generation timestamps." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:provenanceCreated ; owl:someValuesFrom xsd:dateTime ], [ a owl:Restriction ; owl:onProperty mork:provenanceCreator ; owl:someValuesFrom xsd:string ], skos:Concept .

mork:PropertyProjection a owl:Class ;
    rdfs:label "property projection" ;
    rdfs:comment "One concept of a community and the property it has most often been mapped to, beneath the projected class, with how often and how confidently." .

mork:ProposalRun a owl:Class ;
    rdfs:label "proposal run" ;
    rdfs:comment "One run in which a proposer, such as a language model given a teaching pack, proposed mappings for a source. It is also a prov:Activity, and each mapping it proposed names it with prov:wasGeneratedBy." .

mork:QualitativeIntent a owl:Class ;
    rdfs:label "qualitative intent" ;
    rdfs:comment "An intent node representing domain-bearing tokens and nominative signals (e.g., concepts, labels, codes), whose meanings must be inferred via a knowledge base." ;
    rdfs:subClassOf mork:IntentNode .

mork:QuantitativeConstraint a owl:Class ;
    rdfs:label "quantitative constraint" ;
    rdfs:comment "An intent node representing a numeric bound or comparison (e.g., 'up to $25M', 'revenue between $10M and $100M')." ;
    rdfs:subClassOf mork:IntentNode .

mork:QueryTemplate a owl:Class ;
    rdfs:label "query template" ;
    rdfs:comment "A reusable, parameterised query template (SPARQL or Cypher) with parameter placeholders." ;
    rdfs:subClassOf skos:Concept .

mork:RDF a mork:SerializationFormat, owl:NamedIndividual ;
    skos:scopeNote "A source in RDF is read as a graph, whatever syntax carried it. Its representations are its own vocabulary's terms, a path is a SPARQL 1.1 property path, and the prefixes a path uses are declared with sh:declare." .

mork:RefExpression a owl:Class ;
    rdfs:label "ref expression" ;
    rdfs:comment "A reference to source data at a path in the template expression algebra. Evaluates by extracting the value at the dataRef path from the input." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:dataRef ; owl:someValuesFrom xsd:string ], mork:TemplateExpression .

mork:Referencing a owl:Class ;
    rdfs:comment "An Association in which one representation element refers to another and does not contain it." ;
    rdfs:subClassOf mork:Association .

mork:Rejected a mork:ReviewDecision, owl:NamedIndividual ;
    rdfs:label "rejected" ;
    rdfs:comment "The proposed mapping is wrong, and nothing replaces it." .

mork:Representation a owl:Class ;
    rdfs:label "representation" ;
    rdfs:comment "Is used to describe the representation of a DataConcept. Some individuals may be both DataConcept and Representation." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty skos:inScheme ; owl:someValuesFrom mork:RepresentationScheme ], skos:Concept .

mork:RepresentationScheme a owl:Class ;
    rdfs:label "representation scheme" ;
    rdfs:comment "a scheme that maps concepts to their representation" ;
    rdfs:subClassOf [ a owl:Class ; owl:intersectionOf ( skos:ConceptScheme [ a owl:Restriction ; owl:onProperty mork:format ; owl:someValuesFrom mork:SerializationFormat ] ) ], skos:ConceptScheme .

mork:ReviewDecision a owl:Class ;
    rdfs:label "review decision" ;
    rdfs:comment "Which decision a mapping review made. Named individuals are Accepted, Corrected, Rejected and Deferred." .

mork:ReviewMode a mork:CompilationMode, owl:NamedIndividual ;
    rdfs:label "review mode" ;
    rdfs:comment "Governance state and version identity are recommended but not enforced by mork:GenerativeMappingProductionGovernanceShape on member mappings." .

mork:RuleMapping a owl:Class ;
    rdfs:label "rule mapping" ;
    rdfs:comment "A generative mapping that, when compiled, produces SWRL rules as first-class RDF graph objects (swrl:Imp individuals with structured antecedent/consequent atom lists).\n\nClassification as RuleMapping is inferred from the presence of the generatesRuleDefinition property pointing to a swrl:Imp individual. The canonical representation is the structured RDF graph, not a serialised string.\n\nThe optional swrlCompactSyntax annotation provides a human-readable rendering with no logical role."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:generatesRuleDefinition ; owl:someValuesFrom swrl:Imp ], [ a owl:Restriction ; owl:onProperty mork:hasParameterBinding ; owl:minCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty mork:hasRuleProvenance ; owl:someValuesFrom mork:RuleProvenance ], [ a owl:Restriction ; owl:onProperty mork:hasTargetingSpec ; owl:someValuesFrom mork:TargetingSpec ], mork:GenerativeMapping ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( mork:DataMapping [ a owl:Restriction ; owl:onProperty mork:generatesRuleDefinition ; owl:someValuesFrom swrl:Imp ] ) ] .

mork:RuleProvenance a owl:Class ;
    rdfs:label "rule provenance" ;
    rdfs:comment "Records the origin and review chain of generated SWRL rules, including LLM model ID, confidence, review status, jurisdiction, effective period, and impact scope (advisory, enforcement, annotation)." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:provenanceCreated ; owl:someValuesFrom xsd:dateTime ], [ a owl:Restriction ; owl:onProperty mork:provenanceCreator ; owl:someValuesFrom xsd:string ], skos:Concept .

mork:RuleScheme a owl:Class ;
    rdfs:label "rule scheme" ;
    rdfs:comment "A container for a cohesive set of SWRL rules, versionable and scoped to a jurisdiction and effective period." ;
    rdfs:subClassOf skos:ConceptScheme .

mork:RuleTemplate a owl:Class ;
    rdfs:label "rule template" ;
    rdfs:comment "A parameterisable SWRL rule pattern with typed variables and atoms for antecedent/consequent. RuleTemplates serve as curated, reusable patterns that the LLM can instantiate." ;
    rdfs:subClassOf skos:Concept .

mork:ScalarValueElement a owl:Class ;
    rdfs:label "scalar value" ;
    rdfs:comment "Used to describe scalar (atomic) values as members of a collection, such as an Array." ;
    rdfs:subClassOf mork:AnonymousElement .

mork:SectionObservation a owl:Class ;
    rdfs:label "section observation" ;
    rdfs:comment "A record that a set of concepts occurred together in one section of a representation scheme, made when a mapping run over that scheme is accepted." .

mork:SemanticCommunity a owl:Class ;
    rdfs:label "semantic community" ;
    rdfs:comment "A cluster of concepts that tend to occur together in sections of a domain's representation schemes, found by community detection over section observations." .

mork:SerializationFormat a owl:Class ;
    rdfs:comment "A format in which a representation scheme's source is serialised. The individuals JSON, XML, YAML and RDF are the formats MORK names, and mork:format relates a scheme to one." .

mork:SetListing a owl:Class ;
    rdfs:comment "A Collection whose items are unique, that is a collection for which mork:uniqueItems is true." ;
    rdfs:subClassOf mork:Collection ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty mork:uniqueItems ; owl:hasValue "true"^^xsd:boolean ] .

mork:ShapeMapping a owl:Class ;
    rdfs:label "shape mapping" ;
    rdfs:comment "A generative mapping that, when compiled by the Compiler-Agent, instantiates SHACL shapes as first-class RDF graph objects.\n\nClassification as ShapeMapping is inferred from the presence of the generatesShapeDefinition property pointing to an sh:Shape individual, following the same definitional pattern as Datum (≡ ∃deferredMapping.DataMapping) and RuleMapping (≡ DataMapping ⊓ ∃generatesRuleDefinition.swrl:Imp).\n\nThe generated shape is structured RDF — not a serialised string. Its internal structure is fully traversable, queryable, and validatable within the RDF graph."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:generatesShapeDefinition ; owl:someValuesFrom sh:Shape ], [ a owl:Restriction ; owl:onProperty mork:hasConstraintProvenance ; owl:someValuesFrom mork:ConstraintProvenance ], [ a owl:Restriction ; owl:onProperty mork:hasParameterBinding ; owl:minCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty mork:hasTargetingSpec ; owl:someValuesFrom mork:TargetingSpec ], mork:GenerativeMapping ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( mork:DataMapping [ a owl:Restriction ; owl:onProperty mork:generatesShapeDefinition ; owl:someValuesFrom sh:Shape ] ) ] .

mork:ShapeTemplate a owl:Class ;
    rdfs:label "shape template" ;
    rdfs:comment "A parameterisable blueprint for one SHACL NodeShape or PropertyShape. ShapeTemplates serve as curated, reusable patterns that the LLM can instantiate, reducing scope for hallucination and model drift." ;
    rdfs:subClassOf skos:Concept .

mork:SpatialScope a owl:Class ;
    rdfs:label "spatial scope" ;
    rdfs:comment "An intent node representing a geographic scope (e.g., 'in US states', 'excluding EU')." ;
    rdfs:subClassOf mork:IntentNode .

mork:TargetingSpec a owl:Class ;
    rdfs:label "targeting spec" ;
    rdfs:comment "Binds a GenerativeMapping (ShapeMapping, RuleMapping, TransformMapping, or ProjectionMapping) to its target scope within the target ontology. Supports four targeting modes from the SHACL vocabulary:\n\n- sh:targetClass: the shape/rule applies to all instances of the specified class\n- sh:targetObjectsOf: applies to all objects of the specified property\n- sh:targetSubjectsOf: applies to all subjects of the specified property\n- sh:targetNode: applies to a specific named individual\n\nAlso supports optional jurisdiction scoping (appliesInJurisdiction) and effective date range (effectiveFrom, effectiveUntil). At least one targeting mode must be declared (enforced by GCI 5.6h-i and SHACL Shape M8)."^^xsd:string ;
    rdfs:subClassOf [ a owl:Class ; owl:unionOf ( [ a owl:Restriction ; owl:onProperty sh:targetClass ; owl:someValuesFrom owl:Class ] [ a owl:Restriction ; owl:onProperty sh:targetObjectsOf ; owl:someValuesFrom rdf:Property ] [ a owl:Restriction ; owl:onProperty sh:targetSubjectsOf ; owl:someValuesFrom rdf:Property ] [ a owl:Restriction ; owl:onProperty sh:targetNode ; owl:someValuesFrom owl:Thing ] ) ] .

mork:TaxonomyScheme a owl:Class ;
    rdfs:comment "A concept scheme that arranges its concepts as a taxonomy." ;
    rdfs:subClassOf skos:ConceptScheme .

mork:TemplateBinding a owl:Class ;
    rdfs:label "template binding" ;
    rdfs:comment "A binding of a placeholder name to a template expression. Used within InterpolationExpression to provide values for template placeholders." .

mork:TemplateExpression a owl:Class ;
    rdfs:label "template expression" ;
    rdfs:comment "Base class for the formal template expression language (Foundations §3.9). \nRepresents a node in the expression algebra used for IRI formation, name generation, and value interpolation.\nThe expressions form a monoid (TemplateExpression, Concat, Literal(\"\")) over string-valued expressions."^^xsd:string ;
    rdfs:subClassOf skos:Concept .

mork:TemporalScope a owl:Class ;
    rdfs:label "temporal scope" ;
    rdfs:comment "An intent node representing a temporal scope or duration (e.g., '12 months', 'annual')." ;
    rdfs:subClassOf mork:IntentNode .

mork:TermComparison a mork:LookupComparison, owl:NamedIndividual ;
    rdfs:label "term comparison" ;
    rdfs:comment "The value read matches only the same RDF term, with no cast. A value whose datatype differs from the reference data's is reported unresolved, which the author has chosen." .

mork:TerminologyOutput a mork:OutputBox, owl:NamedIndividual ;
    rdfs:label "terminology output" ;
    rdfs:comment "The classes, properties and axioms a compiled query writes, its T-Box graph." .

mork:TransformMapping a owl:Class ;
    rdfs:label "transform mapping" ;
    rdfs:comment "A generative mapping that, when compiled, produces an RML/R2RML triples map as a first-class RDF graph object (an rr:TriplesMap individual with structured subject map, predicate-object maps, and logical source).\n\nClassification as TransformMapping is inferred from the presence of the generatesTransformDefinition property pointing to an rr:TriplesMap individual, following the same definitional pattern as ShapeMapping (≡ DataMapping ⊓ ∃generatesShapeDefinition.sh:Shape) and RuleMapping (≡ DataMapping ⊓ ∃generatesRuleDefinition.swrl:Imp).\n\nThe generated triples map is structured RDF — not a serialised mapping file. Its internal structure (logical source, subject map, predicate-object maps, referencing object maps and join conditions) is fully traversable and queryable within the RDF graph."^^xsd:string ;
    skos:scopeNote "Unlike ShapeMapping and RuleMapping, an ordinary (non-generative) DataMapping is already RML-compilable in the ingress direction — a compiler may walk any Datum, Lookup, or R-Box assertion node and emit a triples map without that node ever being asserted as a TransformMapping. TransformMapping exists to make that compiled artefact a first-class, queryable, provenance-bearing graph object exactly where a deployment needs to trace \"which mapping produced this triples map\" — the same governance guarantee ShapeMapping and RuleMapping already give SHACL shapes and SWRL rules.\n\nTransformMapping is also the natural target for the reverse (egress) direction: a DataMapping whose source is itself part of the ontology (e.g. a qnt:Quantity or qnt:Range chain) and whose rr:TriplesMap projects that chain out to a flatter, deployment-specific representation. egressProjection (§ DataMapping) names the target Representation. generatesTransformDefinition names the compiled artefact that performs the projection."^^xsd:string ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:generatesTransformDefinition ; owl:someValuesFrom rr:TriplesMap ], [ a owl:Restriction ; owl:onProperty mork:hasTransformProvenance ; owl:someValuesFrom mork:TransformProvenance ], mork:GenerativeMapping ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( mork:DataMapping [ a owl:Restriction ; owl:onProperty mork:generatesTransformDefinition ; owl:someValuesFrom rr:TriplesMap ] ) ] .

mork:TransformProvenance a owl:Class ;
    rdfs:label "transform provenance" ;
    rdfs:comment "Records the origin and review chain of a generated RML triples map, including LLM model ID, confidence, review status, and the direction of transformation (ingress: external source to ontology, or egress: ontology to a flatter target representation)." ;
    rdfs:subClassOf skos:Concept .

mork:UncertainMapping a owl:Class ;
    rdfs:label "uncertain mapping" ;
    rdfs:comment "Individuals belonging to this class, represent mapping where the ontological target is missing, incomplete, uncertain, or undefined. Members of this class SHOULD also be members of DataMapping or one of its (other) subclasses." ;
    rdfs:subClassOf mork:DataMapping ;
    owl:equivalentClass [ a owl:Class ; owl:unionOf ( [ a owl:Restriction ; owl:onProperty mork:hypothesisMapping ; owl:someValuesFrom mork:DataMapping ] [ a owl:Restriction ; owl:onProperty mork:mappingRecommendation ; owl:someValuesFrom xsd:string ] ) ] .

mork:UnionOfClasses a mork:ClassCombination, owl:NamedIndividual ;
    rdfs:label "union of classes" ;
    rdfs:comment "Several classes are combined with owl:unionOf. The default." .

mork:UniversalRestriction a mork:AxiomForm, owl:NamedIndividual ;
    rdfs:label "universal restriction" ;
    rdfs:comment "Each domain class D is a subclass of the restriction that every value of the property is in the range R, D ⊑ ∀p.R. It holds only for members of D." .

mork:UnorderedCollection a owl:Class ;
    rdfs:comment "A Collection whose items are not ordered, that is a collection for which mork:orderedItems is false." ;
    rdfs:subClassOf mork:Collection ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty mork:orderedItems ; owl:hasValue "false"^^xsd:boolean ] .

mork:WarningFinding a mork:FindingSeverity, owl:NamedIndividual ;
    rdfs:label "warning finding" ;
    rdfs:comment "Something compiled that a reviewer should know about, for example a broad match." .

mork:WeightedMatch a owl:Class ;
    rdfs:label "weighted match" ;
    rdfs:comment "is used to score a potential match (between concept taxa and ontological facts)" ;
    skos:scopeNote "each member of this class may carry skos:note and rdfs:seeAlso that explain the rules used to arrive at the match" ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty mork:weighting ; owl:someValuesFrom xsd:integer ], mork:DataMapping .

mork:XML a mork:SerializationFormat, owl:NamedIndividual .

mork:YAML a mork:SerializationFormat, owl:NamedIndividual .

mork:appliesInJurisdiction a owl:ObjectProperty ;
    rdfs:label "applies in jurisdiction" ;
    rdfs:comment "References a SKOS concept from a jurisdiction concept scheme, scoping the GenerativeMapping to a specific jurisdiction." ;
    rdfs:domain mork:GenerativeMapping ;
    rdfs:range skos:Concept .

mork:appliesWhen a owl:ObjectProperty ;
    rdfs:label "applies when" ;
    rdfs:comment "A SHACL node shape the nodes a mapping applies to must conform to. The mapping, and the mappings beneath it in its context, apply only to the nodes its path reaches that conform to the shape." ;
    skos:scopeNote "A guard tests the source, never the target. Several guarded mappings on one path divide its nodes among them, and a node no guard admits is mapped by none." ;
    rdfs:range sh:NodeShape .

mork:assertsPropertyDomains a owl:ObjectProperty ;
    rdfs:label "asserts property domains" ;
    rdfs:comment "Used to indicate that a mapping to an object property should provide assertions about the domain(s) of that property. Intended for use with deferred mappings (i.e., where the axiom to which the domain property shall refer does not exist at the time the mapping is defined)." ;
    rdfs:subPropertyOf mork:propertyMappingAssertions .

mork:assertsPropertyRanges a owl:ObjectProperty ;
    rdfs:label "asserts property ranges" ;
    rdfs:comment "Used to indicate that a mapping to an object property should provide assertions about the range(s) of that property. Intended for use with deferred mappings (i.e., where the axiom to which the rdfs:range property shall refer does not exist at the time the mapping is defined)." ;
    rdfs:subPropertyOf mork:propertyMappingAssertions .

mork:associativeBroader a owl:ObjectProperty ;
    rdfs:label "associative broader" ;
    rdfs:comment "extends skos:broader with the concept of associativity" ;
    skos:scopeNote "By convention, associativeBroader is not used to make assertions. Rather, its subProperties should be used, however the superProperty exists in order to draw inferences about the transitive closure of a hierarchical relation." ;
    rdfs:subPropertyOf skos:broader ;
    owl:inverseOf mork:associativeNarrower .

mork:associativeNarrower a owl:ObjectProperty ;
    rdfs:label "associative narrower" ;
    rdfs:comment "extends skos:narrower with the concept of associativity" ;
    skos:scopeNote "By convention, associativeNarrower is not used to make assertions. Rather, its subProperties should be used, however the superProperty exists in order to draw inferences about the transitive closure of a hierarchical relation." ;
    rdfs:subPropertyOf skos:narrower .

mork:axiomForm a owl:ObjectProperty ;
    rdfs:label "axiom form" ;
    rdfs:comment "The form of the T-Box axioms a mapping's assertsPropertyDomains and assertsPropertyRanges produce. It may be given more than once, and each form named is produced. Unset is equivalent to GlobalAxioms." ;
    skos:scopeNote "Under OWL's open-world semantics every form entails and none constrains. A closed-world check that data observes a domain or range is a shape, produced by a ShapeMapping. The forms differ in scope: a global axiom holds for every use of the property, a restriction only for the members of the domain classes." ;
    rdfs:range mork:AxiomForm .

mork:bindsToCriteria a owl:ObjectProperty ;
    rdfs:label "binds to criteria" ;
    rdfs:comment "Links a QueryTemplate to the product criteria or CriteriaShape that generated the query." ;
    rdfs:domain mork:QueryTemplate .

mork:broadABoxCategoryMatch a owl:ObjectProperty ;
    rdfs:label "has broad a-box category match" ;
    rdfs:comment "Used to state a mapping link where the subject maps to a broader category via object-property link to an individual that represents the Hyperonym (i.e., the more specific thing in the A-Box of the mapped concept scheme).\n\nThe A-Box (or Assertional Box) contains assertions (or facts) about individuals within the domain."^^xsd:string ;
    skos:scopeNote "An ABox category match may apply either before or after a datum is to be individuated. In either case, the operation is implied to be idempotent.\n\nAn ABox category match implies the presence of both a RBox match (to the object property over which the relationship is to be defined) and a skos:mappingRelation to the owl:Individual in the A-box. This is not described in the domains for this property, since such constraints are better expressed as SWRL/SHACL constraints."^^xsd:string ;
    rdfs:subPropertyOf mork:broadCategoryMatch ;
    owl:inverseOf mork:narrowABoxCategoryMatch .

mork:broadCategoryMatch a owl:ObjectProperty ;
    rdfs:label "has broad category match" ;
    rdfs:comment "A broadCategoryMatch is used to state a hyperonymic, categorical mapping link between two conceptual resources in different concept schemes, where the subject is the (more specific) hyponym, and the object is the (more general) hyperonym." ;
    rdfs:subPropertyOf skos:broadMatch ;
    owl:inverseOf mork:narrowCategoryMatch .

mork:broadConceptRole a owl:ObjectProperty ;
    rdfs:label "has objectified broad concept role" ;
    rdfs:comment "Used to model the subject in an Objectification, i.e., a relationship between concepts that must be \"reified\" in order to annotate it, or create associations between the relationship and other concepts." ;
    skos:scopeNote "This property is NOT marked as the inverse of narrowConceptRole, since doing so would cause the reasoner to assume that the participants in an Objectification are members of that class.\n\nFor situations where such extended reasoning is desireable, broadNavigableConceptRole and its inverse narrowNavigableConceptRole can be used."^^xsd:string ;
    rdfs:subPropertyOf mork:associativeBroader ;
    rdfs:range skos:Concept .

mork:broadNavigableConceptRole a owl:ObjectProperty ;
    rdfs:label "has navigable objectified broad concept role" ;
    rdfs:comment "Extends broadConceptRole to model the subject in an Objectification where the participating concepts can be inferred to be members of the Objectification class" ;
    skos:scopeNote "This property is the inverse of narrowNavigableConceptRole. The reasoner will assume Individuals related via this property are members of the class Objectification.\n\nFor situations where such reasoning is not desireable, use the superProperty broadConceptRole instead."^^xsd:string ;
    rdfs:subPropertyOf mork:broadConceptRole ;
    owl:inverseOf mork:narrowNavigableConceptRole .

mork:broadRBoxCategoryMatch a owl:ObjectProperty ;
    rdfs:label "has broad r-box category match" ;
    rdfs:comment "Used to state a mapping link where the subject maps to a broader category of relationship (i.e., the more specific relation in the R-Box of the mapped concept scheme). This property is intended for use with members of the Objectification class, however no domain or range assertions are made in order to avoid having the reasoner incorrectly assign individuals to said class.\n\nThe R-Box (or Relational Box) defines the properties or roles that can be used to relate individuals, and their characteristics, such as whether they are symmetric, transitive, or functional."^^xsd:string ;
    skos:scopeNote "Assertions made with this property are intended for use alongside matches to individuals in the A-Box of a target ontology." ;
    rdfs:subPropertyOf mork:broadCategoryMatch ;
    owl:inverseOf mork:narrowRBoxCategoryMatch .

mork:broadTBoxCategoryMatch a owl:ObjectProperty ;
    rdfs:label "has broad t-box category match" ;
    rdfs:comment "Used to define a hyperonymic, categorical relationship between concepts in different concept schemes, specifically modelling the subject as being in an owl:subclassOf relationship with the object.\n\nThe T-Box (or Terminological Box) defines the vocabulary of the domain by describing concepts (such as Classes) and roles (relationships that can be defined between objects)."^^xsd:string ;
    skos:scopeNote "A TBox category must be applied before a datum can be individuated, since it implies the existence of an owl:Class not originally present in an OntologicalScheme. The implication here is that the operation resulting from this axiom is idempotent." ;
    rdfs:subPropertyOf mork:broadCategoryMatch ;
    owl:inverseOf mork:narrowTBoxCategoryMatch .

mork:broaderApplicative a owl:ObjectProperty ;
    rdfs:label "has broader applicative mapping" ;
    rdfs:comment "Models contextual (Kleisli) composition for the context monad. This causes any compositeNarrowerMapping to be applied within the context (i.e., mapping outcome) of the object, rather than the subject.\n\nUsed when a mapping needs to interact with the outcome of a prior mapping, for example a compositeBroader or hypothesisMapping. Please read the skos:scopeNote for the expected behaviours."^^xsd:string ;
    skos:scopeNote "All compositeNarrowerMappings will be applied to the context (i.e., the axioms resulting as the *outcome* of the broaderApplicative object mapping). This implies the following rules:\n\n- The broaderApplicative object must be a DataMapping or subclass thereof.\n- An exactRBoxMatch or inverseRBoxMatch MUST be provided to indicate the relationship between the subject (outcome of this mapping) and the object (on the other end of the relationship).\n\nSpecifically, this instruction means:\n\n- Consider the context/outcome axiom of this (subject) mapping, refer to it as the \"child\"\n- Look up the broaderApplicative mapping, refer to it as the \"parent\"\n- Find the axiom (or entry point into a digraph of axioms) created by the \"parent\" mapping, that is related to the \"child\" axiom along the relationship defined by the exactRBoxMatch\n- Apply the compositeNarrowerMappings of the subject (mapping) to the parent's axiom(s) and not to the child's\n\nFormally, this is modelled as Kleisli composition for a context monad (see Foundations §2.4). The co-occurrence constraint requiring an exactRBoxMatch is enforced by GCI Axiom 2.14a."^^xsd:string ;
    rdfs:subPropertyOf mork:broaderMapping .

mork:broaderMapping a owl:ObjectProperty ;
    rdfs:label "has broader mapping" ;
    rdfs:comment "Relates a mapping to a mapping that is more general (less specific)" ;
    rdfs:subPropertyOf mork:relatedMapping ;
    owl:inverseOf mork:narrowerMapping ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( mork:DataMapping [ a owl:Class ; owl:intersectionOf ( skos:OrderedCollection [ a owl:Restriction ; owl:onProperty skos:member ; owl:someValuesFrom mork:DataMapping ] ) ] ) ] ;
    rdfs:range mork:DataMapping .

mork:checkCode a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "check code" ;
    rdfs:comment "The finding code each row of a check query reports." ;
    rdfs:domain mork:CompiledQuery ;
    rdfs:range xsd:string .

mork:classCombination a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "class combination" ;
    rdfs:comment "How the classes a mapping names with assertsPropertyDomains, or with assertsPropertyRanges, are combined when there are several. Unset is equivalent to UnionOfClasses." ;
    skos:scopeNote "A combination over classes created from source data is known only once the mappings that create them have run. It is produced at the closure of the mapping DAG, after every mapping it depends on." ;
    rdfs:range mork:ClassCombination .

mork:closeMapping a owl:ObjectProperty ;
    rdfs:label "has close mapping" ;
    rdfs:comment "used to link two mappings that are sufficiently similar that they can be used interchangeably in some applications." ;
    rdfs:subPropertyOf mork:relatedMapping .

mork:closureAxiom a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "closure axiom" ;
    rdfs:comment "The axiom a closure query writes, rdfs:domain or rdfs:range, named by the property that states it." ;
    rdfs:domain mork:CompiledQuery .

mork:closureCombination a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "closure combination" ;
    rdfs:comment "How a closure query combines its members, owl:unionOf or owl:intersectionOf, named by the property that states it." ;
    rdfs:domain mork:CompiledQuery .

mork:closureProperty a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "closure property" ;
    rdfs:comment "The property a closure query writes an axiom about." ;
    rdfs:domain mork:CompiledQuery .

mork:collectionElementScalarValue a owl:DatatypeProperty ;
    rdfs:comment "A placeholder super-property of the datatype properties generated to hold the range of individuals of Attribute and ScalarValueElement." ;
    skos:scopeNote "Not for external use. This datatype property is used as a placeholder super-property for generated owl:DataTypeProperty axioms which are used to hold the rdfs/xsd range for individuals in the Attribute and ScalarValueElement classes.\n\nThis specific property is exclusively used to manage Objectification."^^xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

mork:communityCoherence a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "communityCoherence" ;
    rdfs:comment "How tightly a semantic community's concepts occur together, from 0 to 1." ;
    rdfs:domain mork:SemanticCommunity ;
    rdfs:range xsd:decimal .

mork:communityMemberWeight a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "communityMemberWeight" ;
    rdfs:comment "How strongly a concept belongs to its community, from 0 to 1." ;
    rdfs:domain mork:CommunityMembership ;
    rdfs:range xsd:decimal .

mork:communityObservationCount a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "communityObservationCount" ;
    rdfs:comment "How many section observations a semantic community was found in." ;
    rdfs:domain mork:SemanticCommunity ;
    rdfs:range xsd:integer .

mork:communityScheme a owl:ObjectProperty ;
    rdfs:label "communityScheme" ;
    rdfs:comment "The community scheme a semantic community belongs to." ;
    rdfs:domain mork:SemanticCommunity ;
    rdfs:range mork:CommunityScheme .

mork:communitySchemeVersion a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "communitySchemeVersion" ;
    rdfs:comment "A community scheme's version." ;
    rdfs:domain mork:CommunityScheme ;
    rdfs:range xsd:string .

mork:communitySize a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "communitySize" ;
    rdfs:comment "How many concepts a semantic community has." ;
    rdfs:domain mork:SemanticCommunity ;
    rdfs:range xsd:integer .

mork:compilationMode a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "compilation mode" ;
    rdfs:comment "The compilation mode a MappingScheme's member mappings are compiled under: DraftMode, ReviewMode, or ProductionMode (Foundations §5.10b). Unset is equivalent to DraftMode. Only ProductionMode brings the governance-state and version-identity SHACL gate (mork:GenerativeMappingProductionGovernanceShape) into force for that scheme's mappings. A mapping compiled under DraftMode or ReviewMode is unaffected by it." ;
    rdfs:domain mork:MappingScheme ;
    rdfs:range mork:CompilationMode .

mork:compiledBase a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "compiled base" ;
    rdfs:comment "The namespace under which a compiled mapping mints IRIs." ;
    rdfs:domain mork:CompiledMapping ;
    rdfs:range xsd:anyURI .

mork:compiledFrom a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "compiled from" ;
    rdfs:comment "The mapping node a compiled query comes from." ;
    rdfs:domain mork:CompiledQuery .

mork:compiledInMode a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "compiled in mode" ;
    rdfs:comment "The compilation mode a compiled mapping was compiled under." ;
    rdfs:domain mork:CompiledMapping ;
    rdfs:range mork:CompilationMode .

mork:compiler a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "compiler" ;
    rdfs:comment "The compiler and its version that made a compiled mapping." ;
    rdfs:domain mork:CompiledMapping ;
    rdfs:range xsd:string .

mork:compositeBroader a owl:ObjectProperty ;
    rdfs:label "composite broader" ;
    rdfs:comment "Extends associativeBroader with the concept of composition, wherein the object's existence is semantically conditional upon the subject's. This property is the inverse of compositeNarrower." ;
    rdfs:subPropertyOf mork:associativeBroader ;
    owl:inverseOf mork:compositeNarrower .

mork:compositeBroaderMapping a owl:ObjectProperty ;
    rdfs:label "has composite broader mapping" ;
    rdfs:comment "compositeBroaderMapping is used to compose mappings into a directed acyclic graph. The subject mapping is the component part of the object mapping. This is the inverse of compositeNarrowerMapping." ;
    rdfs:subPropertyOf mork:broaderMapping ;
    owl:inverseOf mork:compositeNarrowerMapping .

mork:compositeBroaderTemplate a owl:ObjectProperty ;
    rdfs:label "has composite broader template" ;
    rdfs:comment "Version of 'composite broader mapping' for use in templates. This property is the inverse of compositeNarrowerTemplate." ;
    rdfs:subPropertyOf mork:compositeBroaderMapping ;
    owl:inverseOf mork:compositeNarrowerTemplate .

mork:compositeNarrower a owl:ObjectProperty ;
    rdfs:label "composite narrower" ;
    rdfs:comment "Extends associativeNarrower with the concept of composition, wherein the subject's existence is semantically conditional upon the object's. This property is the inverse of compositeBroader." ;
    rdfs:subPropertyOf mork:associativeNarrower .

mork:compositeNarrowerMapping a owl:ObjectProperty ;
    rdfs:label "has composite narrower mapping" ;
    rdfs:comment "compositeNarrowerMapping is used to compose mappings into a directed acyclic graph. The object mapping is the component part of the subject mapping. This is the inverse of compositeBroaderMapping." ;
    rdfs:subPropertyOf mork:narrowerMapping .

mork:compositeNarrowerTemplate a owl:ObjectProperty ;
    rdfs:label "has composite narrower template" ;
    rdfs:comment "Version of 'composite narrower mapping' for use in templates." ;
    rdfs:subPropertyOf mork:compositeNarrowerMapping .

mork:concatLeft a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "concat left" ;
    rdfs:comment "The left operand of a concatenation expression." ;
    rdfs:domain mork:ConcatExpression ;
    rdfs:range mork:TemplateExpression .

mork:concatRight a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "concat right" ;
    rdfs:comment "The right operand of a concatenation expression." ;
    rdfs:domain mork:ConcatExpression ;
    rdfs:range mork:TemplateExpression .

mork:concatenation a owl:ObjectProperty ;
    rdfs:label "concatenation" ;
    rdfs:comment "Used to indicate that a placeholderMapping is being used for the purposes of concatenating values" ;
    rdfs:subPropertyOf mork:placeholderMapping .

mork:conceptFQNameTemplate a owl:DatatypeProperty ;
    rdfs:comment "A template for the fully qualified name of the concept a mapping creates." ;
    rdfs:subPropertyOf mork:conceptNameTemplate .

mork:conceptIRI a owl:DatatypeProperty ;
    rdfs:comment "The IRI of the concept a mapping creates or refers to." ;
    rdfs:subPropertyOf mork:conceptName ;
    rdfs:range xsd:anyURI .

mork:conceptId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "concept id" ;
    rdfs:comment "Specialises identifier for use in denoting the id of a DataConcept" ;
    rdfs:subPropertyOf mork:identifier, skos:notation ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:string .

mork:conceptName a owl:DatatypeProperty ;
    rdfs:comment "The name of the class, property or individual a mapping creates or refers to." ;
    rdfs:subPropertyOf mork:name .

mork:conceptNameTemplate a owl:DatatypeProperty ;
    rdfs:comment "Template for a concept name" ;
    rdfs:subPropertyOf mork:template .

mork:conceptScheme a owl:ObjectProperty ;
    rdfs:label "in concept scheme" ;
    rdfs:comment "denotes the subject's membership in the object (TaxonomyScheme)" ;
    rdfs:subPropertyOf skos:inScheme ;
    rdfs:range mork:TaxonomyScheme .

mork:conceptShortNameTemplate a owl:DatatypeProperty ;
    rdfs:comment "A template for the short name of the concept a mapping creates." ;
    rdfs:subPropertyOf mork:conceptNameTemplate .

mork:confidenceOf a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "confidence of" ;
    rdfs:comment "The mapping node an effective confidence entry is for." .

mork:constraintDimension a owl:ObjectProperty ;
    rdfs:label "constraint dimension" ;
    rdfs:comment "References a concept identifying the measured dimension a quantitative constraint applies to. The concept resides in an external scheme." ;
    rdfs:domain mork:QuantitativeConstraint ;
    rdfs:range skos:Concept .

mork:constraintOperator a owl:DatatypeProperty ;
    rdfs:label "constraint operator" ;
    rdfs:comment "The comparison operator for a quantitative constraint. Range: {\"LessThanOrEqual\", \"GreaterThanOrEqual\", \"Equal\", \"Between\", \"NotEqual\"}." ;
    rdfs:domain mork:QuantitativeConstraint ;
    rdfs:range xsd:string .

mork:constraintUnit a owl:ObjectProperty ;
    rdfs:label "constraint unit" ;
    rdfs:comment "References a concept representing the unit of measurement for a quantitative constraint (e.g., USD, GBP, metres)." ;
    rdfs:domain mork:QuantitativeConstraint ;
    rdfs:range skos:Concept .

mork:constraintUpperValue a owl:DatatypeProperty ;
    rdfs:label "constraint upper value" ;
    rdfs:comment "The upper bound numeric value, used when constraintOperator = 'Between'." ;
    rdfs:domain mork:QuantitativeConstraint ;
    rdfs:range xsd:decimal .

mork:constraintValue a owl:DatatypeProperty ;
    rdfs:label "constraint value" ;
    rdfs:comment "The numeric value for a quantitative constraint (lower bound when constraintOperator = 'Between')." ;
    rdfs:domain mork:QuantitativeConstraint ;
    rdfs:range xsd:decimal .

mork:constraintVersion a owl:DatatypeProperty ;
    rdfs:label "constraint version" ;
    rdfs:comment "Version identifier for a ConstraintScheme." ;
    rdfs:domain mork:ConstraintScheme ;
    rdfs:range xsd:string .

mork:contextPath a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "context path" ;
    rdfs:comment "The list of mapping nodes from a compiled query's root to the mapping it comes from, which is the chain of contexts its WHERE clause follows." ;
    rdfs:domain mork:CompiledQuery ;
    rdfs:range rdf:List .

mork:correctedBy a owl:ObjectProperty ;
    rdfs:label "correctedBy" ;
    rdfs:comment "The mapping that replaces a corrected proposal, for a review that decided Corrected." ;
    rdfs:domain mork:MappingReview .

mork:dagTemplateChild a owl:ObjectProperty ;
    rdfs:label "dagTemplateChild" ;
    rdfs:comment "A property projection a DAG template asserts beneath its root." ;
    rdfs:domain mork:DAGTemplate ;
    rdfs:range mork:PropertyProjection .

mork:dagTemplateFrequency a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "dagTemplateFrequency" ;
    rdfs:comment "How many of the community's mapping runs took a DAG template's shape." ;
    rdfs:domain mork:DAGTemplate ;
    rdfs:range xsd:integer .

mork:dagTemplateRoot a owl:ObjectProperty ;
    rdfs:label "dagTemplateRoot" ;
    rdfs:comment "The shadow of a DAG template's root class." ;
    rdfs:domain mork:DAGTemplate .

mork:data a owl:DatatypeProperty ;
    rdfs:comment "The data a mapping reads or carries. Its sub-properties say where the data is, and what it is." ;
    rdfs:subPropertyOf owl:topDataProperty .

mork:dataInline a owl:DatatypeProperty ;
    rdfs:comment "Data written in the mapping itself and not read from a source, for example a constant or the literal text of a template expression." ;
    rdfs:subPropertyOf mork:data .

mork:dataRef a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "A reference to the data in the source, for example a path or a column. A mapping has at most one." ;
    rdfs:subPropertyOf mork:data .

mork:deferredMapping a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "has deferred mapping" ;
    rdfs:comment "Used to defer to a mapping where the subject is dependent on the result of applying the object (mapping) and obtaining the outcome. This can be used, for example, to ensure that individuals which belong to an owl:Class are processed only after the class axiom has been asserted." ;
    rdfs:subPropertyOf mork:relatedMapping .

mork:dependentMapping a owl:ObjectProperty ;
    rdfs:label "has dependent mapping" ;
    rdfs:comment "Used to specifically indicate that the object mapping MUST be processed prior to the subject. Unlike the superProperty deferredMapping, the subject may not use the output of the object (mapping) directly (as its context)." ;
    skos:scopeNote "This property should be used when a related mapping must be executed in order to assert some axiom(s) prior to their use. The subject MUST NOT consider the target state of the object to be part of the context (of the subject's mapping), but rather must refer to it via other means, e.g., by reference to a DeferredContext that brings the asserted axioms into scope via mork:yieldConcept." ;
    rdfs:subPropertyOf mork:deferredMapping .

mork:dependsOnMapping a owl:ObjectProperty ;
    rdfs:label "depends on mapping" ;
    rdfs:comment "Compositional dependency ensuring that target concepts exist before the GenerativeMapping (ShapeMapping, RuleMapping, TransformMapping, or ProjectionMapping) is compiled." ;
    rdfs:domain mork:GenerativeMapping ;
    rdfs:range mork:DataMapping .

mork:deprecationReason a owl:DatatypeProperty ;
    rdfs:label "deprecation reason" ;
    rdfs:comment "A textual explanation of why a mapping was deprecated." ;
    rdfs:domain mork:DataMapping ;
    rdfs:range xsd:string .

mork:detectionAlgorithm a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "detectionAlgorithm" ;
    rdfs:comment "The community detection algorithm a community scheme used, for example leiden or louvain." ;
    rdfs:domain mork:CommunityScheme ;
    rdfs:range xsd:string .

mork:detectionResolution a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "detectionResolution" ;
    rdfs:comment "The resolution a community scheme's detection used, which sets how large its communities are." ;
    rdfs:domain mork:CommunityScheme ;
    rdfs:range xsd:decimal .

mork:digraphMatch a owl:ObjectProperty ;
    rdfs:label "has digraph match" ;
    rdfs:comment "is used to state a hierarchical mapping link between conceptual resources in different concept schemes, where one concept is mapped to a directed (sub-)graph of related concepts." ;
    rdfs:subPropertyOf skos:broadMatch ;
    owl:inverseOf mork:digraphOf ;
    rdfs:range mork:Digraph .

mork:digraphOf a owl:ObjectProperty ;
    rdfs:label "is digraph match from" ;
    rdfs:comment "digraphFrom is used to state a hierarchical mapping link between conceptual resources in different concept schemes, where concepts belong to a directed (sub-)graph that relates back to some parent concept (in another scheme)." ;
    rdfs:subPropertyOf skos:narrowMatch ;
    rdfs:domain mork:Digraph .

mork:discoveredFrom a owl:ObjectProperty ;
    rdfs:label "discoveredFrom" ;
    rdfs:comment "A section observation a community scheme was discovered from." ;
    rdfs:domain mork:CommunityScheme ;
    rdfs:range mork:SectionObservation .

mork:effectiveConfidence a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "effective confidence" ;
    rdfs:comment "A mapping's effective confidence, from 0 to 1, its own weighting times the least of its children's." ;
    rdfs:range xsd:double .

mork:effectiveFrom a owl:DatatypeProperty ;
    rdfs:label "effective from" ;
    rdfs:comment "The date/time from which a mapping, constraint, or targeting specification becomes effective." ;
    rdfs:range xsd:dateTime .

mork:effectiveUntil a owl:DatatypeProperty ;
    rdfs:label "effective until" ;
    rdfs:comment "The date/time until which a mapping, constraint, or targeting specification remains effective." ;
    rdfs:range xsd:dateTime .

mork:egressProjection a owl:ObjectProperty ;
    rdfs:label "egress projection" ;
    rdfs:comment "Links a DataMapping to the specific Representation element it should project to during egress. Enables the Compiler-Agent to generate both ingress transforms (forward traversal) and egress query templates (reverse traversal, SPARQL CONSTRUCT) from the mapping DAG." ;
    rdfs:domain mork:DataMapping ;
    rdfs:range mork:Representation .

mork:elementType a owl:ObjectProperty ;
    rdfs:label "element type" ;
    rdfs:comment "Specialises compositeNarrower with a particular semantics for describing the type of elements within a Collection. The domain and range for this property assertions provide an explicit hint to the reasoner as such." ;
    rdfs:subPropertyOf mork:compositeNarrower ;
    rdfs:domain mork:Collection ;
    rdfs:range mork:CollectionElement .

mork:exactABoxMatch a owl:ObjectProperty ;
    rdfs:label "exact A-Box match" ;
    rdfs:comment "Used to indicate an exact match to an element in the A-Box of an ontology (i.e., OntologicalScheme). The subject may come from any aspect of another domain (e.g., belonging to RepresentationScheme or TaxonomyScheme, coming from the T-Box, A-Box, or R-Box)." ;
    rdfs:subPropertyOf mork:intransitiveExactMatch .

mork:exactMapping a owl:ObjectProperty ;
    rdfs:label "has exact mapping" ;
    rdfs:comment "used to link two mappings, indicating a high degree of confidence that they can be used interchangeably across a wide range of applications." ;
    rdfs:subPropertyOf mork:closeMapping .

mork:exactRBoxMatch a owl:ObjectProperty ;
    rdfs:label "exact R-Box match" ;
    rdfs:comment "Used to indicate an exact match to an element in the R-Box of an ontology (i.e., OntologicalScheme). The subject may come from any aspect of another domain (e.g., belonging to RepresentationScheme or TaxonomyScheme, coming from the T-Box, A-Box, or R-Box)." ;
    rdfs:subPropertyOf mork:intransitiveExactMatch .

mork:exactTBoxMatch a owl:ObjectProperty ;
    rdfs:label "exact T-Box match" ;
    rdfs:comment "Used to indicate an exact match to an element in the T-Box of an ontology (i.e., OntologicalScheme). The subject may come from any aspect of another domain (e.g., belonging to RepresentationScheme or TaxonomyScheme, coming from the T-Box, A-Box, or R-Box).\n\nThe T-Box (or Terminological Box) defines the vocabulary of the domain by describing concepts (such as Classes) and roles (relationships that can be defined between objects)."^^xsd:string ;
    rdfs:subPropertyOf mork:intransitiveExactMatch .

mork:externalPropertyValue a owl:DatatypeProperty ;
    rdfs:comment "A placeholder super-property of the datatype properties generated to hold the range of individuals of Attribute." ;
    skos:scopeNote "Not for external use. This datatype property is used as a placeholder super-property for generated owl:DataTypeProperty axioms which are used to hold the rdfs/xsd range for individuals in the Attribute class." ;
    rdfs:subPropertyOf owl:topDataProperty .

mork:findingAbout a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "finding about" ;
    rdfs:comment "The mapping node a compile finding is about." ;
    rdfs:domain mork:CompileFinding .

mork:findingCode a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "finding code" ;
    rdfs:comment "The code of a compile finding, from the compiler's list of findings." ;
    rdfs:domain mork:CompileFinding ;
    rdfs:range xsd:string .

mork:findingIndex a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "finding index" ;
    rdfs:comment "A compile finding's position among its compiled mapping's findings." ;
    rdfs:domain mork:CompileFinding ;
    rdfs:range xsd:integer .

mork:findingMessage a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "finding message" ;
    rdfs:comment "What a compile finding says, for a reviewer." ;
    rdfs:domain mork:CompileFinding ;
    rdfs:range xsd:string .

mork:findingSeverity a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "finding severity" ;
    rdfs:comment "The severity of a compile finding." ;
    rdfs:domain mork:CompileFinding ;
    rdfs:range mork:FindingSeverity .

mork:format a owl:ObjectProperty ;
    rdfs:label "has format" ;
    rdfs:comment "denotes the SerializationFormat used by a RepresentationScheme" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    rdfs:domain mork:RepresentationScheme ;
    rdfs:range mork:SerializationFormat .

mork:generatesClassDefinition a owl:ObjectProperty ;
    rdfs:label "generates class definition" ;
    rdfs:comment "Links a ProjectionMapping to a class the surface compiler minted for it." ;
    rdfs:domain mork:ProjectionMapping ;
    rdfs:range mork:OwlClass .

mork:generatesRuleDefinition a owl:ObjectProperty ;
    rdfs:label "generates rule definition" ;
    rdfs:comment "Links a RuleMapping to the SWRL rule (swrl:Imp individual) it generates when compiled. The generated rule is structured RDF with fully traversable antecedent/consequent atom lists, class predicates, property predicates, and variable bindings." ;
    rdfs:domain mork:RuleMapping ;
    rdfs:range swrl:Imp .

mork:generatesShapeDefinition a owl:ObjectProperty ;
    rdfs:label "generates shape definition" ;
    rdfs:comment "Links a ShapeMapping to the SHACL shape (sh:Shape individual, which may be an sh:NodeShape or sh:PropertyShape) it generates when compiled. The generated shape is structured RDF — not a serialised string. Its internal structure (target declarations, property constraints, SPARQL components, severity annotations) is fully traversable, queryable, and validatable within the RDF graph." ;
    rdfs:domain mork:ShapeMapping ;
    rdfs:range sh:Shape .

mork:generatesTransformDefinition a owl:ObjectProperty ;
    rdfs:label "generates transform definition" ;
    rdfs:comment "Links a TransformMapping to the RML/R2RML triples map (rr:TriplesMap individual) it generates when compiled. The generated triples map is structured RDF — logical source, subject map, and predicate-object/referencing-object maps — fully traversable and queryable within the RDF graph, not a serialised mapping file." ;
    rdfs:domain mork:TransformMapping ;
    rdfs:range rr:TriplesMap .

mork:hasBinding a owl:ObjectProperty ;
    rdfs:label "has binding" ;
    rdfs:comment "Relates an InterpolationExpression to one of its placeholder bindings." ;
    rdfs:domain mork:InterpolationExpression ;
    rdfs:range mork:TemplateBinding .

mork:hasCommunityMembership a owl:ObjectProperty ;
    rdfs:label "hasCommunityMembership" ;
    rdfs:comment "A membership of a semantic community." ;
    rdfs:domain mork:SemanticCommunity ;
    rdfs:range mork:CommunityMembership .

mork:hasCompileFinding a owl:ObjectProperty ;
    rdfs:label "has compile finding" ;
    rdfs:comment "A finding of a compiled mapping." ;
    rdfs:domain mork:CompiledMapping ;
    rdfs:range mork:CompileFinding .

mork:hasCompiledQuery a owl:ObjectProperty ;
    rdfs:label "has compiled query" ;
    rdfs:comment "A query of a compiled mapping." ;
    rdfs:domain mork:CompiledMapping ;
    rdfs:range mork:CompiledQuery .

mork:hasConcept a owl:ObjectProperty ;
    rdfs:label "has concept" ;
    rdfs:comment "Denotes the membership of a skos:Concept in a skos:ConceptScheme. This property is the inverse of skos:inScheme" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf skos:inScheme .

mork:hasConstraintProvenance a owl:ObjectProperty ;
    rdfs:label "has constraint provenance" ;
    rdfs:comment "Links a ShapeMapping to its provenance record (origin, review chain, lifecycle metadata)." ;
    rdfs:domain mork:ShapeMapping ;
    rdfs:range mork:ConstraintProvenance .

mork:hasDAGTemplate a owl:ObjectProperty ;
    rdfs:label "hasDAGTemplate" ;
    rdfs:comment "A DAG template of an ontological projection." ;
    rdfs:domain mork:OntologicalProjection ;
    rdfs:range mork:DAGTemplate .

mork:hasEffectiveConfidence a owl:ObjectProperty ;
    rdfs:label "has effective confidence" ;
    rdfs:comment "An entry of a compiled mapping that records one mapping's effective confidence." ;
    rdfs:domain mork:CompiledMapping .

mork:hasIntentConfidence a owl:DatatypeProperty ;
    rdfs:label "has intent confidence" ;
    rdfs:comment "LLM extraction confidence score for this intent node, in the range [0, 1]." ;
    rdfs:domain mork:IntentNode ;
    rdfs:range xsd:decimal .

mork:hasMapping a owl:ObjectProperty ;
    rdfs:label "has mapping" ;
    rdfs:comment "Used to denote a mapping relation between a representation or concept scheme element and a mapping scheme element." ;
    skos:scopeNote "Whilst it is expected that concepts in a RepresentationScheme or TaxonomyScheme may directly leverage object properties in the skos:mappingRelation hierarchy, selection of a specific mapping may require intermediation via an individual in a MappingScheme. This property exists to support the latter construct." ;
    rdfs:subPropertyOf skos:relatedMatch ;
    owl:inverseOf mork:mappingFor ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( [ a owl:Restriction ; owl:onProperty mork:conceptScheme ; owl:someValuesFrom mork:TaxonomyScheme ] [ a owl:Restriction ; owl:onProperty mork:representationScheme ; owl:someValuesFrom mork:RepresentationScheme ] ) ] ;
    rdfs:range [ a owl:Restriction ; owl:onProperty mork:mappingScheme ; owl:someValuesFrom mork:MappingScheme ] .

mork:hasNaturalLanguageSource a owl:DatatypeProperty ;
    rdfs:label "has natural language source" ;
    rdfs:comment "The original natural language text fragment from which this intent node was extracted." ;
    rdfs:domain mork:IntentNode ;
    rdfs:range xsd:string .

mork:hasOntologicalProjection a owl:ObjectProperty ;
    rdfs:label "hasOntologicalProjection" ;
    rdfs:comment "An ontological projection of a semantic community." ;
    rdfs:domain mork:SemanticCommunity ;
    rdfs:range mork:OntologicalProjection .

mork:hasParameterBinding a owl:ObjectProperty ;
    rdfs:label "has parameter binding" ;
    rdfs:comment "Relates a GenerativeMapping (ShapeMapping, RuleMapping, TransformMapping, or ProjectionMapping) to one of its typed parameter bindings (paramName, paramType, paramValue). Also used by QueryTemplate via the separate paramBinding property." ;
    rdfs:domain mork:GenerativeMapping ;
    rdfs:range mork:ParameterBinding .

mork:hasProjectionProvenance a owl:ObjectProperty ;
    rdfs:label "has projection provenance" ;
    rdfs:comment "Links a ProjectionMapping to its provenance record (origin, review chain, lifecycle metadata)." ;
    rdfs:domain mork:ProjectionMapping ;
    rdfs:range mork:ProjectionProvenance .

mork:hasPropertyProjection a owl:ObjectProperty ;
    rdfs:label "hasPropertyProjection" ;
    rdfs:comment "A property projection beneath an ontological projection." ;
    rdfs:domain mork:OntologicalProjection ;
    rdfs:range mork:PropertyProjection .

mork:hasRuleProvenance a owl:ObjectProperty ;
    rdfs:label "has rule provenance" ;
    rdfs:comment "Links a RuleMapping to its provenance record (origin, review chain, lifecycle metadata)." ;
    rdfs:domain mork:RuleMapping ;
    rdfs:range mork:RuleProvenance .

mork:hasRuleTemplate a owl:ObjectProperty ;
    rdfs:label "has rule template" ;
    rdfs:comment "Links a RuleMapping to a parameterisable RuleTemplate from the curated template catalog." ;
    rdfs:domain mork:RuleMapping ;
    rdfs:range mork:RuleTemplate .

mork:hasSeverity a owl:ObjectProperty ;
    rdfs:label "has severity" ;
    rdfs:comment "The severity level for the generated SHACL shape (sh:Violation, sh:Warning, or sh:Info). May also be set directly on the generated shape." ;
    rdfs:domain mork:ShapeMapping ;
    rdfs:range sh:Severity .

mork:hasShapeTemplate a owl:ObjectProperty ;
    rdfs:label "has shape template" ;
    rdfs:comment "Links a ShapeMapping to a parameterisable ShapeTemplate from the curated template catalog. Template usage is strongly recommended as a governance mechanism but is not a necessary condition. Absence triggers a SHACL warning routing to mandatory human review." ;
    rdfs:domain mork:ShapeMapping ;
    rdfs:range mork:ShapeTemplate .

mork:hasTargetingSpec a owl:ObjectProperty ;
    rdfs:label "has targeting spec" ;
    rdfs:comment "Binds a GenerativeMapping (ShapeMapping, RuleMapping, TransformMapping, or ProjectionMapping) to its targeting specification (sh:targetClass, sh:targetObjectsOf, sh:targetSubjectsOf, or sh:targetNode, with optional jurisdiction scoping and effective date range)." ;
    rdfs:domain mork:GenerativeMapping ;
    rdfs:range mork:TargetingSpec .

mork:hasTransformProvenance a owl:ObjectProperty ;
    rdfs:label "has transform provenance" ;
    rdfs:comment "Links a TransformMapping to its provenance record (origin, review chain, lifecycle metadata)." ;
    rdfs:domain mork:TransformMapping ;
    rdfs:range mork:TransformProvenance .

mork:hypothesisMapping a owl:ObjectProperty ;
    rdfs:label "has hypothesis mapping" ;
    rdfs:comment "Used to provide a mapping (object) that is being used as a hypothesis in support of the (subject) mapping's postulated match. Can also be used to hypothesise a mapping for an UncertainMapping." ;
    rdfs:subPropertyOf mork:relatedMapping .

mork:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:comment "Is used to mark a Representation or DataConcept with an identifier used by some external scheme or schema." ;
    rdfs:subPropertyOf owl:topDataProperty .

mork:identityTemplateMapping a owl:ObjectProperty ;
    rdfs:label "has identity template mapping" ;
    rdfs:comment "Used to indicate a deferredMapping (which this is a sub-object-property of) between the subject and some object(s) upon which the identity (IRI formation) of the subject is dependent. Unlike deferredMapping, this property is not symmetric." ;
    skos:scopeNote "This property establishes that IRI formation depends on template evaluation. The precedence relation resolvesIdentityFor is derived from this property (see Foundations §2.5, Rule P8)." ;
    rdfs:subPropertyOf mork:templateMapping .

mork:impactScope a owl:DatatypeProperty ;
    rdfs:label "impact scope" ;
    rdfs:comment "The impact scope of a generated SWRL rule. Values: advisory, enforcement, annotation." ;
    rdfs:domain mork:RuleProvenance ;
    rdfs:range xsd:string .

mork:incompleteMapping a owl:DatatypeProperty ;
    rdfs:comment "True when a mapping is incomplete, so that a compiler must not treat it as decided." ;
    rdfs:subPropertyOf owl:topDataProperty ;
    rdfs:range xsd:boolean .

mork:indicativeMapping a owl:ObjectProperty ;
    rdfs:label "indicative mapping" ;
    rdfs:comment "Used to denote a potential mapping relation between a representation or concept scheme element and a mapping scheme element, suggesting that the subject may be an indicator for the existence of the object." ;
    rdfs:subPropertyOf mork:hasMapping .

mork:individualIRI a owl:DatatypeProperty ;
    rdfs:comment "The IRI of the individual a mapping creates or refers to." ;
    rdfs:subPropertyOf mork:individualName .

mork:individualName a owl:DatatypeProperty ;
    rdfs:comment "The name of the individual a mapping creates or refers to." ;
    rdfs:subPropertyOf mork:name .

mork:inputHash a owl:DatatypeProperty ;
    rdfs:label "input hash" ;
    rdfs:comment "Hash of the natural language source that produced the constraint." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( mork:ConstraintProvenance mork:RuleProvenance mork:ProjectionProvenance ) ] ;
    rdfs:range xsd:string .

mork:inputTokens a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "inputTokens" ;
    rdfs:comment "How many tokens a proposal run's proposer read, as its provider counted them, across every call of the run." ;
    rdfs:domain mork:ProposalRun ;
    rdfs:range xsd:nonNegativeInteger .

mork:intentMapping a owl:ObjectProperty ;
    rdfs:label "intent mapping" ;
    rdfs:comment "Links an intent node to the DataMapping (or ShapeMapping/RuleMapping) that realises it in terms of the target ontology." ;
    rdfs:subPropertyOf skos:mappingRelation ;
    rdfs:domain mork:IntentNode ;
    rdfs:range mork:DataMapping .

mork:intentScheme a owl:ObjectProperty ;
    rdfs:label "in intent scheme" ;
    rdfs:comment "Denotes the subject's membership in the object IntentScheme" ;
    rdfs:subPropertyOf skos:inScheme ;
    rdfs:range mork:IntentScheme .

mork:interpolationComponent a owl:ObjectProperty ;
    rdfs:label "has template component (member)" ;
    rdfs:comment "Relates an InterpolationTemplate to one of its members." ;
    rdfs:subPropertyOf skos:member ;
    rdfs:domain skos:OrderedCollection ;
    rdfs:range [ a owl:Class ; owl:unionOf ( [ a owl:Class ; owl:intersectionOf ( mork:DataMapping [ a owl:Restriction ; owl:onProperty mork:dataRef ; owl:someValuesFrom xsd:string ] ) ] [ a owl:Restriction ; owl:onProperty mork:dataInline ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

mork:interpolationTemplate a owl:DatatypeProperty ;
    rdfs:comment "Used to indicate a runtime interpolation of dataRef and/or dataInline values into a new string." ;
    skos:scopeNote "Allows the values assigned to datatype properties to be referenced for string interpolation. Referenced properties are evaluated against properties relating to the subject of the assertion.\n\nThis datatype property can be used in one of two ways:\n\n1. to combine datatype properties from the assertion context with string literals/interpolation - see the skos:example on the Interpolation class for details.\n\n2. to provide a template for interpolating placeholder data into a new value, see the skos:example on this property for details.."^^xsd:string ;
    rdfs:subPropertyOf mork:template ;
    rdfs:range xsd:string .

mork:intransitiveExactMatch a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "has (intransitive) exact match" ;
    rdfs:comment "This is an intransitive version of skos:exactMatch. It is used to indicate what we believe to be a semantically exact match between concepts in different concept schemes.\n\nPlaced under skos:closeMatch rather than skos:exactMatch to avoid inheriting transitivity, which would cause unintended inferences across chains of box matches."^^xsd:string ;
    rdfs:subPropertyOf skos:closeMatch .

mork:inverseRBoxMatch a owl:ObjectProperty ;
    rdfs:label "exact inverse R-Box match" ;
    rdfs:comment "Used to indicate an exact match to the inverse of an element in the R-Box of an ontology (i.e., OntologicalScheme). \n\nThis is required for situations where the inverse of a datatype or object property must be referenced but no explicit axiom exists for the binding.\n\nThe subject may come from any aspect of another domain (e.g., belonging to RepresentationScheme or TaxonomyScheme, coming from the T-Box, A-Box, or R-Box)."^^xsd:string ;
    skos:scopeNote "NB: This property is NOT the inverse of exactRBoxMatch, but rather it represents the same semantics when referencing the inverse of the property. Since inverseRBoxMatch is a subproperty of exactRBoxMatch, the co-occurrence GCI (Axiom 2.14a) covers both direct and inverse cases." ;
    rdfs:subPropertyOf mork:exactRBoxMatch .

mork:iri a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "identifier iri" ;
    rdfs:comment "Is used to identify a skos:Concept via a fully qualified IRI" ;
    rdfs:subPropertyOf mork:conceptId ;
    rdfs:domain mork:OwlAxiom .

mork:itemsConstrained a owl:DatatypeProperty ;
    rdfs:comment "Whether a constraint applies to the items of a Collection. Its sub-properties name the constraints, order and uniqueness." ;
    rdfs:subPropertyOf owl:topDataProperty ;
    rdfs:range xsd:boolean .

mork:jurisdiction a owl:DatatypeProperty ;
    rdfs:label "jurisdiction" ;
    rdfs:comment "The jurisdiction applicable to a ConstraintScheme, ConstraintProvenance, or TargetingSpec." ;
    rdfs:range xsd:string .

mork:lexicalMatch a owl:ObjectProperty ;
    rdfs:label "is lexical match with" ;
    rdfs:comment "Used to indicate a possible or partial lexical match, where similar terms (i.e., words) exist, but the semantics or structure are not a good match." ;
    rdfs:subPropertyOf mork:possibleMatch .

mork:llmConfidence a owl:DatatypeProperty ;
    rdfs:label "llm confidence" ;
    rdfs:comment "Confidence score from the LLM that generated the constraint." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( mork:ConstraintProvenance mork:RuleProvenance mork:ProjectionProvenance ) ] ;
    rdfs:range xsd:decimal .

mork:llmModelId a owl:DatatypeProperty ;
    rdfs:label "llm model id" ;
    rdfs:comment "Identifier of the LLM model that generated the constraint." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( mork:ConstraintProvenance mork:RuleProvenance mork:ProjectionProvenance ) ] ;
    rdfs:range xsd:string .

mork:lookupComparison a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "lookup comparison" ;
    rdfs:comment "How a Lookup compares the value its dataRef reads with the value of the reference data it matches on. Unset is equivalent to CastComparison." ;
    rdfs:range mork:LookupComparison .

mork:lookupDatatype a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "lookup datatype" ;
    rdfs:comment "The datatype of the reference data a Lookup matches on, to which a CastComparison casts the value its dataRef reads." ;
    rdfs:range rdfs:Datatype .

mork:lookupProperty a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "lookup property" ;
    rdfs:comment "The datatype property on which the lookup match is performed." ;
    rdfs:domain mork:LookupExpression ;
    rdfs:range owl:DatatypeProperty .

mork:lookupScheme a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "lookup scheme" ;
    rdfs:comment "The concept scheme against which the lookup is performed." ;
    rdfs:domain mork:LookupExpression ;
    rdfs:range skos:ConceptScheme .

mork:lookupSource a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "lookup source" ;
    rdfs:comment "The source expression whose evaluation provides the value to look up." ;
    rdfs:domain mork:LookupExpression ;
    rdfs:range mork:TemplateExpression .

mork:mappingDigest a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "mapping digest" ;
    rdfs:comment "The SHA-256 of the mapping graph's RDFC-1.0 canonical N-Quads, in lowercase hex, that a compiled mapping was compiled from." ;
    rdfs:domain mork:CompiledMapping ;
    rdfs:range xsd:string .

mork:mappingFor a owl:ObjectProperty ;
    rdfs:label "is mapping for" ;
    rdfs:comment "Indicates the Representation or DataConcept for which a DataMapping applies. This property is the inverse of hasMapping." ;
    rdfs:subPropertyOf skos:relatedMatch .

mork:mappingIndex a owl:DatatypeProperty ;
    rdfs:label "mapping index" ;
    rdfs:comment "used to denote the index of a mapping where it occurs within a collection of mappings." ;
    rdfs:subPropertyOf owl:topDataProperty .

mork:mappingRecommendation a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "A recommendation, in text, for how an uncertain mapping should be settled, for example a new class to create in the target ontology. A mapping has at most one." ;
    rdfs:subPropertyOf mork:data ;
    rdfs:range xsd:string .

mork:mappingScheme a owl:ObjectProperty ;
    rdfs:label "in mapping scheme" ;
    rdfs:comment "denotes the subject's membership in the object MappingScheme" ;
    rdfs:subPropertyOf skos:inScheme ;
    rdfs:range mork:MappingScheme .

mork:mappingVersion a owl:DatatypeProperty ;
    rdfs:label "mapping version" ;
    rdfs:comment "Version identifier for a MappingScheme." ;
    rdfs:domain mork:MappingScheme ;
    rdfs:range xsd:string .

mork:matchConfidence a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "matchConfidence" ;
    rdfs:comment "A community match's confidence, from 0 to 1." ;
    rdfs:domain mork:CommunityMatch ;
    rdfs:range xsd:decimal .

mork:matchScore a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "matchScore" ;
    rdfs:comment "A community match's score." ;
    rdfs:domain mork:CommunityMatch ;
    rdfs:range xsd:decimal .

mork:matchSection a owl:ObjectProperty ;
    rdfs:label "matchSection" ;
    rdfs:comment "The section a community match is for." ;
    rdfs:domain mork:CommunityMatch .

mork:matchedConcepts a owl:ObjectProperty ;
    rdfs:label "matchedConcepts" ;
    rdfs:comment "A concept of the section that a community match found in the community." ;
    rdfs:domain mork:CommunityMatch .

mork:matchesCommunity a owl:ObjectProperty ;
    rdfs:label "matchesCommunity" ;
    rdfs:comment "The semantic community a community match found." ;
    rdfs:domain mork:CommunityMatch ;
    rdfs:range mork:SemanticCommunity .

mork:memberConcept a owl:ObjectProperty ;
    rdfs:label "memberConcept" ;
    rdfs:comment "The concept a community membership is of." ;
    rdfs:domain mork:CommunityMembership .

mork:memberOf a owl:ObjectProperty ;
    rdfs:label "member property of" ;
    rdfs:comment "Defines the object as a component property (i.e., member) of the subject, primarily to describe Representation elements using a clear vocabulary. This property is the inverse of memberProperty." ;
    rdfs:subPropertyOf mork:compositeBroader ;
    owl:inverseOf mork:memberProperty .

mork:memberProperty a owl:ObjectProperty ;
    rdfs:label "member property" ;
    rdfs:comment "Defines the subject as a component property (i.e., member) of the object. This specialisation of compositeNarrower provides a clear vocabulary for describing member properties (i.e., associations via property) within Representation schemes.\n\nNote that memberProperty is both asymmetric and irreflexive."^^xsd:string ;
    rdfs:subPropertyOf mork:compositeNarrower .

mork:missingOrUnrelatedMatch a owl:ObjectProperty ;
    rdfs:label "missing or unrelated match" ;
    rdfs:comment "A match to a term that is missing or unrelated to the subject. Deprecated, and kept for existing data." ;
    rdfs:subPropertyOf skos:relatedMatch .

mork:name a owl:DatatypeProperty ;
    rdfs:comment "The name of something a mapping creates or refers to. Its sub-properties name concepts and individuals." ;
    rdfs:subPropertyOf owl:topDataProperty ;
    rdfs:range xsd:string .

mork:narrowABoxCategoryMatch a owl:ObjectProperty ;
    rdfs:label "has narrow a-box category match" ;
    rdfs:comment "Used to state a mapping link where the subject maps to a narrower category via object-property link to an individual that represents the Hyperonym (i.e., the more specific thing in the A-Box of the mapped concept scheme).\n\nThe A-Box (or Assertional Box) contains assertions (or facts) about individuals within the domain."^^xsd:string ;
    skos:scopeNote "An ABox category match may apply either before or after a datum is to be individuated. In either case, the operation is implied to be idempotent.\n\nAn ABox category match implies the presence of both a TBox match (to the object property over which the relationship is to be defined) and a skos:mappingRelation to the owl:Individual in the a-box, as described in the domains for this property."^^xsd:string ;
    rdfs:subPropertyOf mork:narrowCategoryMatch .

mork:narrowCategoryMatch a owl:ObjectProperty ;
    rdfs:label "has narrow category match" ;
    rdfs:comment "A narrowCategoryMatch is used to state a hyperonymic, categorical mapping link between two conceptual resources in different concept schemes, where the subject is the (more general) hyperonym and the object is the (more specific) hyponym." ;
    rdfs:subPropertyOf skos:narrowMatch .

mork:narrowConceptRole a owl:ObjectProperty ;
    rdfs:label "has objectified narrow concept role" ;
    rdfs:comment "Used to model the object in association Objectification, i.e., a relationship between concepts that must be \"reified\" in order to annotate it, or create associations between the relationship and other concepts." ;
    rdfs:subPropertyOf mork:associativeNarrower ;
    rdfs:range skos:Concept .

mork:narrowNavigableConceptRole a owl:ObjectProperty ;
    rdfs:label "has navigable objectified narrow concept role" ;
    rdfs:comment "Extends narrowConceptRole to model the object in an Objectification where the participating concepts can be inferred to be members of the Objectification class" ;
    skos:scopeNote "This property is the inverse of broadNavigableConceptRole. The reasoner will assume Individuals related via this property are members of the class Objectification.\n\nFor situations where such reasoning is not desireable, use the superProperty narrowConceptRole instead."^^xsd:string ;
    rdfs:subPropertyOf mork:narrowConceptRole .

mork:narrowRBoxCategoryMatch a owl:ObjectProperty ;
    rdfs:label "has narrow r-box category match" ;
    rdfs:comment "Used to state a mapping link where the subject maps to a narrower category of relationship (i.e., the more general relation in the R-Box of the mapped concept scheme). This property is intended for use with members of the Objectification class, however no domain or range assertions are made in order to avoid having the reasoner incorrectly assign individuals to said class.\n\nThe R-Box (or Relational Box) defines the properties or roles that can be used to relate individuals, and their characteristics, such as whether they are symmetric, transitive, or functional."^^xsd:string ;
    rdfs:subPropertyOf mork:narrowCategoryMatch .

mork:narrowTBoxCategoryMatch a owl:ObjectProperty ;
    rdfs:label "has narrow t-box match" ;
    rdfs:comment "Used to define a hyperonymic, categorical relationship between concepts in different concept schemes, specifically modelling the subject as being the superclass in an owl:subclassOf relationship with the object.\n\nThe T-Box (or Terminological Box) defines the vocabulary of the domain by describing concepts (such as Classes) and roles (relationships that can be defined between objects)."^^xsd:string ;
    skos:scopeNote "A TBox category must be applied before a datum can be individuated, since it implies the existence of an owl:Class not originally present in an OntologicalScheme. The implication here is that the operation resulting from this axiom is idempotent." ;
    rdfs:subPropertyOf mork:narrowCategoryMatch .

mork:narrowerMapping a owl:ObjectProperty ;
    rdfs:label "has narrower mapping" ;
    rdfs:comment "Relates a mapping to a mapping that is more specific" ;
    rdfs:subPropertyOf mork:relatedMapping ;
    rdfs:domain mork:DataMapping ;
    rdfs:range [ a owl:Class ; owl:unionOf ( mork:DataMapping [ a owl:Class ; owl:intersectionOf ( skos:OrderedCollection [ a owl:Restriction ; owl:onProperty skos:member ; owl:someValuesFrom mork:DataConcept ] ) ] ) ] .

mork:observationTimestamp a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "observationTimestamp" ;
    rdfs:comment "When a section observation was made." ;
    rdfs:domain mork:SectionObservation ;
    rdfs:range xsd:dateTime .

mork:observedConcept a owl:ObjectProperty ;
    rdfs:label "observedConcept" ;
    rdfs:comment "A concept a section observation saw." ;
    rdfs:domain mork:SectionObservation .

mork:observedInScheme a owl:ObjectProperty ;
    rdfs:label "observedInScheme" ;
    rdfs:comment "The representation scheme a section observation was made in." ;
    rdfs:domain mork:SectionObservation .

mork:observedInSection a owl:ObjectProperty ;
    rdfs:label "observedInSection" ;
    rdfs:comment "The section a section observation was made in." ;
    rdfs:domain mork:SectionObservation .

mork:ontologicalScheme a owl:ObjectProperty ;
    rdfs:label "in ontological scheme" ;
    rdfs:comment "Denotes the subject membership in an OntologicalScheme. Note that this is designed for use only by inference based on SWRL or SHACL constraints, and should not be used directly (since there is no hint on the Domain)" ;
    rdfs:subPropertyOf skos:inScheme ;
    rdfs:range mork:OntologicalScheme .

mork:orderedItems a owl:DatatypeProperty ;
    rdfs:comment "Whether the items of a Collection are ordered." ;
    rdfs:subPropertyOf mork:itemsConstrained .

mork:outputBox a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "output box" ;
    rdfs:comment "Whether a compiled query writes instance data or terminology." ;
    rdfs:domain mork:CompiledQuery ;
    rdfs:range mork:OutputBox .

mork:outputTokens a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "outputTokens" ;
    rdfs:comment "How many tokens a proposal run's proposer wrote, as its provider counted them, across every call of the run." ;
    rdfs:domain mork:ProposalRun ;
    rdfs:range xsd:nonNegativeInteger .

mork:paramBinding a owl:ObjectProperty ;
    rdfs:label "param binding" ;
    rdfs:comment "Links a QueryTemplate to one of its parameter bindings." ;
    rdfs:domain mork:QueryTemplate ;
    rdfs:range mork:ParameterBinding .

mork:paramName a owl:DatatypeProperty ;
    rdfs:label "param name" ;
    rdfs:comment "The name of the parameter in a ParameterBinding." ;
    rdfs:domain mork:ParameterBinding ;
    rdfs:range xsd:string .

mork:paramType a owl:DatatypeProperty ;
    rdfs:label "param type" ;
    rdfs:comment "The type of the parameter in a ParameterBinding. Values: Numeric, Concept, Path, String, Duration." ;
    rdfs:domain mork:ParameterBinding ;
    rdfs:range xsd:string .

mork:paramValue a owl:DatatypeProperty ;
    rdfs:label "param value" ;
    rdfs:comment "The value of the parameter in a ParameterBinding." ;
    rdfs:domain mork:ParameterBinding .

mork:partialMatch a owl:ObjectProperty ;
    rdfs:label "is partial match with" ;
    rdfs:comment "Synonym for possibleMatch" ;
    rdfs:subPropertyOf skos:mappingRelation .

mork:path a owl:DatatypeProperty ;
    rdfs:label "has path" ;
    rdfs:comment "Is used to denote a \"path expression\" that locates a Representation within an externally defined scheme or schema." ;
    rdfs:subPropertyOf mork:identifier .

mork:pathMatch a owl:ObjectProperty ;
    rdfs:label "matches on path" ;
    rdfs:comment "Used to associate a match with a specific path (i.e., predicate)" ;
    rdfs:subPropertyOf skos:mappingRelation .

mork:placeholderExpression a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:label "placeholder expression" ;
    rdfs:comment "The template expression that provides the value for a placeholder binding." ;
    rdfs:domain mork:TemplateBinding ;
    rdfs:range mork:TemplateExpression .

mork:placeholderMapping a owl:ObjectProperty ;
    rdfs:label "has placeholder mapping" ;
    rdfs:comment "Indicates that a mapping defers to a collection of \"placeholders\" for values that should be derived at processing time" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    rdfs:domain mork:DataMapping ;
    rdfs:range [ a owl:Class ; owl:intersectionOf ( mork:Interpolation [ a owl:Restriction ; owl:onProperty mork:interpolationComponent ; owl:someValuesFrom [ a owl:Class ; owl:unionOf ( [ a owl:Restriction ; owl:onProperty mork:dataRef ; owl:someValuesFrom xsd:string ] [ a owl:Restriction ; owl:onProperty mork:dataInline ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] ) ] ] ) ] .

mork:placeholderName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "placeholder name" ;
    rdfs:comment "The name of the placeholder in the template string that this binding provides a value for." ;
    rdfs:domain mork:TemplateBinding ;
    rdfs:range xsd:string .

mork:possibleMatch a owl:ObjectProperty ;
    rdfs:label "is possible match with" ;
    rdfs:comment "Used to indicate a possible/potential match." ;
    rdfs:subPropertyOf skos:mappingRelation .

mork:precedes a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "precedes" ;
    rdfs:comment "Materialised precedence relation: m1 :precedes m2 means m1 must be evaluated before m2 in any valid execution schedule. This is a derived relation, populated via subproperty axioms and SWRL rules (see Foundations §2.5)." ;
    skos:scopeNote "The precedence relation is the transitive closure of structural dependency relationships. \nIt is derived from: compositeBroaderMapping (inverse), broaderApplicative (inverse), dependentMapping (inverse), and templateMapping (inverse) via subproperty axioms, plus conditional rules (SWRL) for T-Box before A-Box, identity resolution, and template child correlation.\n\nA transitive property cannot also be asymmetric or irreflexive in OWL 2 DL, and neither characteristic would catch a cycle of three or more mappings. mork:PrecedenceAcyclicityShape (shapes/constraints.ttl) rejects every cycle instead, through this property and the properties it is derived from."^^xsd:string ;
    rdfs:domain mork:DataMapping ;
    rdfs:range mork:DataMapping .

mork:projectedClass a owl:ObjectProperty ;
    rdfs:label "projectedClass" ;
    rdfs:comment "The shadow of the class an ontological projection most often targets." ;
    rdfs:domain mork:OntologicalProjection .

mork:projectedClassFrequency a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "projectedClassFrequency" ;
    rdfs:comment "How many mappings of the community targeted the projected class." ;
    rdfs:domain mork:OntologicalProjection ;
    rdfs:range xsd:integer .

mork:projectedConcept a owl:ObjectProperty ;
    rdfs:label "projectedConcept" ;
    rdfs:comment "The concept a property projection is for." ;
    rdfs:domain mork:PropertyProjection .

mork:projectedParentClass a owl:ObjectProperty ;
    rdfs:label "projectedParentClass" ;
    rdfs:comment "The shadow of the class the projected property is asserted on." ;
    rdfs:domain mork:PropertyProjection .

mork:projectedProperty a owl:ObjectProperty ;
    rdfs:label "projectedProperty" ;
    rdfs:comment "The shadow of the property a property projection's concept is most often mapped to." ;
    rdfs:domain mork:PropertyProjection .

mork:projectionTargetOntology a owl:ObjectProperty ;
    rdfs:label "projectionTargetOntology" ;
    rdfs:comment "The target ontology an ontological projection is onto." ;
    rdfs:domain mork:OntologicalProjection .

mork:propertyMappingAssertions a owl:ObjectProperty ;
    rdfs:label "has property mapping assertions" ;
    rdfs:comment "Used to make assertions about proposed object or datatype property mappings" ;
    skos:scopeNote "By convention, propertyMappingAssertions is not used to make assertions, but rather its subProperties are instead." ;
    rdfs:subPropertyOf owl:topObjectProperty .

mork:propertyProjectionConfidence a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "propertyProjectionConfidence" ;
    rdfs:comment "How confident a property projection is, from 0 to 1." ;
    rdfs:domain mork:PropertyProjection ;
    rdfs:range xsd:decimal .

mork:propertyProjectionFrequency a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "propertyProjectionFrequency" ;
    rdfs:comment "How many mappings of the concept targeted the projected property." ;
    rdfs:domain mork:PropertyProjection ;
    rdfs:range xsd:integer .

mork:proposedFor a owl:ObjectProperty ;
    rdfs:label "proposedFor" ;
    rdfs:comment "The representation scheme a proposal run proposed mappings for." ;
    rdfs:domain mork:ProposalRun .

mork:proposerModel a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "proposerModel" ;
    rdfs:comment "The model or other proposer that made a proposal run's mappings." ;
    rdfs:domain mork:ProposalRun ;
    rdfs:range xsd:string .

mork:provenanceCreated a owl:DatatypeProperty ;
    rdfs:label "provenance created" ;
    rdfs:comment "The creation date of the constraint or rule. Shadows dct:created for use in OWL 2 DL restrictions." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( mork:ConstraintProvenance mork:RuleProvenance mork:ProjectionProvenance ) ] ;
    rdfs:range xsd:dateTime .

mork:provenanceCreator a owl:DatatypeProperty ;
    rdfs:label "provenance creator" ;
    rdfs:comment "The creator of the constraint or rule. Shadows dct:creator for use in OWL 2 DL restrictions." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( mork:ConstraintProvenance mork:RuleProvenance mork:ProjectionProvenance ) ] ;
    rdfs:range xsd:string .

mork:queryIndex a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "query index" ;
    rdfs:comment "A compiled query's position in its compiled mapping, the order the queries run in within a stratum." ;
    rdfs:domain mork:CompiledQuery ;
    rdfs:range xsd:integer .

mork:queryKind a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "query kind" ;
    rdfs:comment "Whether a compiled query is a construct, a check or a closure." ;
    rdfs:domain mork:CompiledQuery ;
    rdfs:range xsd:string .

mork:queryLanguage a owl:DatatypeProperty ;
    rdfs:label "query language" ;
    rdfs:comment "The query language of a QueryTemplate. Values: SPARQL, Cypher." ;
    rdfs:domain mork:QueryTemplate ;
    rdfs:range xsd:string .

mork:queryText a owl:DatatypeProperty ;
    rdfs:label "query text" ;
    rdfs:comment "The serialised query template text with parameter placeholders." ;
    rdfs:domain mork:QueryTemplate ;
    rdfs:range xsd:string .

mork:readAt a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "read at" ;
    rdfs:comment "The instant at which a compiled mapping read the mappings in force, given by its caller and never read from a clock." ;
    rdfs:domain mork:CompiledMapping ;
    rdfs:range xsd:dateTime .

mork:readsOutputOf a owl:ObjectProperty ;
    rdfs:label "reads output of" ;
    rdfs:comment "A mapping whose output a compiled query reads, so that the query runs in a later stratum than that mapping's queries." ;
    rdfs:domain mork:CompiledQuery .

mork:reference a owl:DatatypeProperty ;
    rdfs:comment "A reference to a representation element within its scheme." ;
    rdfs:subPropertyOf mork:identifier .

mork:referenceDataMapping a owl:ObjectProperty ;
    rdfs:label "has reference data mapping" ;
    rdfs:comment "Used to denote that a mapping takes a value from some input data (via dataRef), and matches it to a subject which contains an exact match on either the contents of its dataInline or the name of the individual." ;
    skos:scopeNote "If the name of the individual is to be used, then the value of the object's dataInline MUST be set to \"\"." ;
    rdfs:subPropertyOf mork:templateMapping ;
    rdfs:range [ a owl:Restriction ; owl:onProperty mork:dataRef ; owl:someValuesFrom xsd:string ] .

mork:referenceDataPath a owl:ObjectProperty ;
    rdfs:label "matches reference data on path" ;
    rdfs:comment "Used to indicate the predicate on which a Lookup is based." ;
    rdfs:subPropertyOf mork:pathMatch .

mork:referenceIdentifier a owl:DatatypeProperty ;
    rdfs:label "reference identifier" ;
    rdfs:comment "An opaque identifier for the referenced external standard or authority (e.g., a body name or form code)." ;
    rdfs:domain mork:NormativeReferenceItent ;
    rdfs:range xsd:string .

mork:refinesIntent a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "refines intent" ;
    rdfs:comment "Expresses that the subject elaborates or specialises the object. The transitive closure of :refinesIntent gives the composition structure of compound intents.\n\nThis property is the strict refinement order between distinct intent nodes, and is acyclic (mork:IntentRefinementAcyclicityShape). Its reflexive-transitive closure generates the morphisms of the preorder category Int(I) (Foundations §2.5a). The intent nodes under that closure form a bounded join-semilattice."^^xsd:string ;
    rdfs:domain mork:IntentNode ;
    rdfs:range mork:IntentNode .

mork:relatedMapping a owl:ObjectProperty ;
    rdfs:label "has related mapping" ;
    rdfs:comment "used to describe a relationships between two potential mappings" ;
    rdfs:subPropertyOf skos:related .

mork:relatedProperty a owl:ObjectProperty ;
    rdfs:label "has related property" ;
    rdfs:comment "Used to relate DataConcept or Attribute individuals to object or datatype properties." ;
    rdfs:subPropertyOf skos:related .

mork:representationOf a owl:ObjectProperty ;
    rdfs:label "is representation of" ;
    rdfs:comment "Used to indicate that a Representation can be used for a given DataConcept. NB: it is perfectly reasonable for an individual to belong to both the Representation and DataConcept classes, therefore this property can be used by an individual to refer to itself." ;
    rdfs:subPropertyOf skos:relatedMatch ;
    owl:inverseOf mork:representedAs .

mork:representationScheme a owl:ObjectProperty ;
    rdfs:label "in representation scheme" ;
    rdfs:comment "Denotes the subject's membership in the object RepresentationScheme" ;
    rdfs:subPropertyOf skos:inScheme ;
    rdfs:range mork:RepresentationScheme .

mork:representedAs a owl:ObjectProperty ;
    rdfs:label "is represented as" ;
    rdfs:comment "Used to describe one of the (potentially multiple) Representations of a DataConcept. This property is the inverse of representationOf." ;
    rdfs:subPropertyOf skos:relatedMatch .

mork:resolvesIdentityFor a owl:ObjectProperty ;
    rdfs:label "resolves identity for" ;
    rdfs:comment "m :resolvesIdentityFor d means m must complete (producing an IRI or identity) before d can be individuated. As a subproperty of :precedes, each of its edges is a :precedes edge, so it counts towards the precedence acyclicity check." ;
    rdfs:subPropertyOf mork:precedes ;
    rdfs:domain mork:DataMapping ;
    rdfs:range mork:Datum .

mork:reviewDecision a owl:ObjectProperty ;
    rdfs:label "reviewDecision" ;
    rdfs:comment "What a mapping review decided." ;
    rdfs:domain mork:MappingReview ;
    rdfs:range mork:ReviewDecision .

mork:reviewNote a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "reviewNote" ;
    rdfs:comment "Why a mapping review decided as it did, in words." ;
    rdfs:domain mork:MappingReview ;
    rdfs:range xsd:string .

mork:reviewOf a owl:ObjectProperty ;
    rdfs:label "reviewOf" ;
    rdfs:comment "The proposed mapping a mapping review decides." ;
    rdfs:domain mork:MappingReview .

mork:reviewStatus a owl:DatatypeProperty ;
    rdfs:label "review status" ;
    rdfs:comment "Review status of the constraint. Values: DRAFT, APPROVED, DEPRECATED." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( mork:ConstraintProvenance mork:RuleProvenance mork:ProjectionProvenance ) ] ;
    rdfs:range xsd:string .

mork:scopeInclusion a owl:DatatypeProperty ;
    rdfs:label "scope inclusion" ;
    rdfs:comment "Whether the spatial scope is an inclusion or exclusion. Range: {\"Include\", \"Exclude\"}." ;
    rdfs:domain mork:SpatialScope ;
    rdfs:range xsd:string .

mork:scopeType a owl:DatatypeProperty ;
    rdfs:label "scope type" ;
    rdfs:comment "The type of spatial scope. Range: {\"Country\", \"State\", \"Region\", \"Postcode\", \"Coordinate\"}." ;
    rdfs:domain mork:SpatialScope ;
    rdfs:range xsd:string .

mork:scopeValue a owl:ObjectProperty ;
    rdfs:label "scope value" ;
    rdfs:comment "References a concept in a geography concept scheme that identifies the spatial scope (e.g., a country, state, or region)." ;
    rdfs:domain mork:SpatialScope ;
    rdfs:range skos:Concept .

mork:semanticMatch a owl:ObjectProperty ;
    rdfs:label "is semantic match with" ;
    rdfs:comment "Used to indicate a partial/possible semantic match." ;
    rdfs:subPropertyOf mork:possibleMatch .

mork:shadowDomain a owl:ObjectProperty ;
    rdfs:label "shadowDomain" ;
    rdfs:comment "A shadow of a class that is a domain of a shadow's property." .

mork:shadowOf a owl:ObjectProperty ;
    rdfs:label "shadowOf" ;
    rdfs:comment "The target ontology's term a shadow individual stands for, so mapping patterns over the term can be reasoned about in OWL 2 DL." .

mork:shadowRange a owl:ObjectProperty ;
    rdfs:label "shadowRange" ;
    rdfs:comment "A shadow of a class that is a range of a shadow's property." .

mork:shadowSubClassOf a owl:ObjectProperty ;
    rdfs:label "shadowSubClassOf" ;
    rdfs:comment "That one shadow's class is a subclass of another shadow's." .

mork:shadowSubPropertyOf a owl:ObjectProperty ;
    rdfs:label "shadowSubPropertyOf" ;
    rdfs:comment "That one shadow's property is a subproperty of another shadow's." .

mork:siblingMapping a owl:ObjectProperty ;
    rdfs:comment "Used to construct a DataMapping graph that represents an rdf:List, since skos:Collection and skos:Concept are disjoint and we need a way to describe outputs that a represented as rdf:Lists." ;
    rdfs:subPropertyOf mork:relatedMapping .

mork:softPrecedes a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "soft precedes" ;
    rdfs:comment "Advisory precedence relation: m1 :softPrecedes m2 means m1 should be evaluated before m2 when possible, but m2 may proceed (with reduced confidence) if m1 is unavailable." ;
    skos:scopeNote "Acyclic, checked by mork:SoftPrecedenceAcyclicityShape independently of :precedes." ;
    rdfs:domain mork:DataMapping ;
    rdfs:range mork:DataMapping .

mork:stratum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "stratum" ;
    rdfs:comment "The step of a run a compiled query belongs to, after every stratum whose output it reads." ;
    rdfs:domain mork:CompiledQuery ;
    rdfs:range xsd:integer .

mork:structuralMatch a owl:ObjectProperty ;
    rdfs:label "is structural match with" ;
    rdfs:comment "Used to indicate a match in structure, i.e., where concepts in different concept schemes appear at the same place structurally, but may have different semantics/meanings, or have a poor lexical match." ;
    rdfs:subPropertyOf mork:possibleMatch .

mork:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes" ;
    rdfs:comment "Creates a temporal chain among mapping versions. m1 :supersedes m2 means m1 is a newer version that replaces m2." ;
    rdfs:domain mork:DataMapping ;
    rdfs:range mork:DataMapping .

mork:swrlText a owl:DatatypeProperty ;
    rdfs:label "swrl text" ;
    rdfs:comment "Serialised SWRL rule text for a RuleMapping." ;
    rdfs:domain mork:RuleMapping ;
    rdfs:range xsd:string .

mork:targetsOntology a owl:DatatypeProperty ;
    rdfs:label "targets ontology" ;
    rdfs:comment "The target ontology namespace for a RuleMapping." ;
    rdfs:domain mork:RuleMapping ;
    rdfs:range xsd:anyURI .

mork:teachingPackVersion a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "teachingPackVersion" ;
    rdfs:comment "The teaching pack and its version a proposal run's proposer was given." ;
    rdfs:domain mork:ProposalRun ;
    rdfs:range xsd:string .

mork:template a owl:DatatypeProperty ;
    rdfs:comment "used to store templates for the generation of identifiers within a merged graph" ;
    rdfs:subPropertyOf owl:topDataProperty .

mork:templateBinding a owl:ObjectProperty ;
    rdfs:label "template binding" ;
    rdfs:comment "Captures the explicit correlation between a template child and an instantiation child. Used for template child correlation precedence (Foundations §2.5.4, Rule P11)." ;
    rdfs:domain mork:DataMapping ;
    rdfs:range mork:DataMapping .

mork:templateClassMapping a owl:ObjectProperty ;
    rdfs:label "has template class mapping" ;
    rdfs:comment "Used to denote an owl:Class that should be used as a template for generating t-box assertions." ;
    rdfs:subPropertyOf mork:templateMapping .

mork:templateMapping a owl:ObjectProperty ;
    rdfs:label "has template mapping" ;
    rdfs:comment "Used to denote a deferred mapping where the subject and the object together provide partial mapping semantics and must therefore be taken as a whole by a processing engine.\n\nThis mechanism can be used to reduce the number of assertions required in order to fulfil a mapping, since the object can act as a template - providing partial mapping semantics - and leave the specific details of the mapping to the subject."^^xsd:string ;
    skos:scopeNote "When a partial mapping intended for use as a \"template\" is created, any compositeNarrowerMapping that is also a partial (rather than a complete) mapping, should be associated via compositeNarrowerTemplate.\n\nNB: where multiple composite narrower mappings exist on both the subject and object, the following semantics shall apply:\n\nIf the narrower mapping on the subject explicitly refers to a narrower mapping of the object, that assertion shall take precidence. \n\nIf the composite narrower mappings of both the subject and the object are modelled using skos:OrderedCollection, then the ordering of both collections will be respected. Should the size of the respective collections differ, the smaller of the two will be taken as the range of applicable mappings for the whole.\n\nIf the composite narrower mappings of either subject or object are members of the DataMapping class or subclasses thereof and, members (by inference) of the IndexedMapping class, then the mappingIndex shall be used to correlate the templates and non-templates together, whether via exact indexA == indexB semantics, or by linking the indexes to the ordering of an skos:OrderedCollection."^^xsd:string ;
    rdfs:subPropertyOf mork:deferredMapping .

mork:templateString a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "template string" ;
    rdfs:comment "The template string with placeholder references for an InterpolationExpression." ;
    rdfs:domain mork:InterpolationExpression ;
    rdfs:range xsd:string .

mork:temporalDuration a owl:DatatypeProperty ;
    rdfs:label "temporal duration" ;
    rdfs:comment "The duration of the temporal scope." ;
    rdfs:domain mork:TemporalScope ;
    rdfs:range xsd:dayTimeDuration .

mork:temporalUnit a owl:DatatypeProperty ;
    rdfs:label "temporal unit" ;
    rdfs:comment "The unit of the temporal scope. Range: {\"Days\", \"Months\", \"Years\"}." ;
    rdfs:domain mork:TemporalScope ;
    rdfs:range xsd:string .

mork:totalTokens a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "totalTokens" ;
    rdfs:comment "How many tokens a proposal run's proposer read and wrote together, where its provider gives only the total." ;
    rdfs:domain mork:ProposalRun ;
    rdfs:range xsd:nonNegativeInteger .

mork:uniqueItems a owl:DatatypeProperty ;
    rdfs:comment "Whether the items of a Collection are unique, as in a set." ;
    rdfs:subPropertyOf mork:itemsConstrained .

mork:weightedBroader a owl:ObjectProperty ;
    rdfs:label "has weighted broader" ;
    rdfs:comment "used to indicate that the subject has a lower weighting (and thereby is a broader match), compared to the object - this property is the inverse of weightedNarrower" ;
    rdfs:subPropertyOf mork:broaderMapping ;
    owl:inverseOf mork:weightedNarrower .

mork:weightedNarrower a owl:ObjectProperty ;
    rdfs:label "has weighted narrower" ;
    rdfs:comment "Used to indicate that the object has a higher weighting (and thereby is a narrower match), compared to the subject. Explicitly means that the object is a more likely match than the subject." ;
    rdfs:subPropertyOf mork:narrowerMapping .

mork:weighting a owl:DatatypeProperty ;
    rdfs:comment "confidence score out of 100" ;
    rdfs:subPropertyOf owl:topDataProperty ;
    rdfs:range xsd:integer .

mork:yieldConcept a owl:ObjectProperty ;
    rdfs:label "yields concept" ;
    rdfs:comment "Used to indicate that a mapping yields a particular concept to a broader scope'd mapping. In practice, this means that a compositeNarrower or deferredMapping can \"yield\" its output to another mapping, allowing generated axioms to be referenced declaratively prior to their assertion in a target ontology." ;
    rdfs:subPropertyOf owl:topObjectProperty .

[ a owl:AllDisjointClasses ; owl:members ( mork:OrderedCollection mork:SetListing mork:UnorderedCollection ) ] .

[] a owl:AllDisjointClasses ;
    rdfs:comment "A DataMapping individual cannot simultaneously generate a SHACL shape and a SWRL rule. If a business criterion requires both validation and inference, it is modelled as two separate GenerativeMapping individuals." ;
    owl:members ( mork:ShapeMapping mork:RuleMapping ) .

[] a owl:AllDisjointProperties ;
    owl:members ( mork:broaderMapping mork:closeMapping mork:deferredMapping mork:hypothesisMapping mork:narrowerMapping ) .

[] a owl:Axiom ;
    rdfs:comment "Axiom P10 (Foundations §2.5.4): Template precedes instantiation." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource [ owl:inverseOf mork:templateMapping ] ;
    owl:annotatedTarget mork:precedes .

[] a owl:Axiom ;
    rdfs:comment "Axiom P5 (Foundations §2.5.2): Hypothesis as soft precedence." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource [ owl:inverseOf mork:hypothesisMapping ] ;
    owl:annotatedTarget mork:softPrecedes .

[] a owl:Axiom ;
    rdfs:comment "Axiom P2 (Foundations §2.5.2): Applicative precedence — parent context must be established before contextual application." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource [ owl:inverseOf mork:broaderApplicative ] ;
    owl:annotatedTarget mork:precedes .

[] a owl:Axiom ;
    rdfs:comment "Axiom P1 (Foundations §2.5.2): Compositional precedence — a parent mapping precedes its composite children." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource [ owl:inverseOf mork:compositeBroaderMapping ] ;
    owl:annotatedTarget mork:precedes .

[] a owl:Axiom ;
    rdfs:comment "Axiom P3 (Foundations §2.5.2): Strict dependency precedence." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource [ owl:inverseOf mork:dependentMapping ] ;
    owl:annotatedTarget mork:precedes .

[] a owl:Axiom ;
    rdfs:comment "GCI Axiom 2.14a (Foundations §2.4.2): broaderApplicative co-occurrence. Since inverseRBoxMatch ⊑ exactRBoxMatch, this covers both direct and inverse cases." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource [ a owl:Class ;
            rdfs:subClassOf owl:Nothing ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty mork:broaderApplicative ;
                        owl:someValuesFrom mork:DataMapping ] [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty mork:exactRBoxMatch ;
                                owl:someValuesFrom owl:Thing ] ] ) ] ;
    owl:annotatedTarget owl:Nothing .

[] a owl:Axiom ;
    rdfs:comment "GCI Axiom 2.14b (Foundations §2.4.2): A mapping with broadABoxCategoryMatch in a compositional context must declare an exactRBoxMatch." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource [ a owl:Class ;
            rdfs:subClassOf owl:Nothing ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty mork:broadABoxCategoryMatch ;
                        owl:someValuesFrom owl:Thing ] [ a owl:Restriction ;
                        owl:onProperty mork:compositeBroaderMapping ;
                        owl:someValuesFrom mork:DataMapping ] [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty mork:exactRBoxMatch ;
                                owl:someValuesFrom owl:Thing ] ] ) ] ;
    owl:annotatedTarget owl:Nothing .

[] a owl:Axiom ;
    rdfs:comment "GCI Axiom 2.14d (Foundations §2.4.2): A mapping with broadRBoxCategoryMatch in a compositional context should reference an A-Box target." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource [ a owl:Class ;
            rdfs:subClassOf owl:Nothing ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty mork:broadRBoxCategoryMatch ;
                        owl:someValuesFrom owl:Thing ] [ a owl:Restriction ;
                        owl:onProperty mork:compositeBroaderMapping ;
                        owl:someValuesFrom mork:DataMapping ] [ a owl:Class ;
                        owl:complementOf [ a owl:Class ;
                                owl:unionOf ( [ a owl:Restriction ;
                                            owl:onProperty mork:exactABoxMatch ;
                                            owl:someValuesFrom owl:Thing ] [ a owl:Restriction ;
                                            owl:onProperty mork:broadABoxCategoryMatch ;
                                            owl:someValuesFrom owl:Thing ] ) ] ] ) ] ;
    owl:annotatedTarget owl:Nothing .

[] a owl:Axiom ;
    rdfs:comment "GCI Axiom 5.10a (Foundations §5.10a): Any mapping that supersedes another must have an effective-from date." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource [ a owl:Class ;
            rdfs:subClassOf owl:Nothing ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty mork:supersedes ;
                        owl:someValuesFrom mork:DataMapping ] [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty mork:effectiveFrom ;
                                owl:someValuesFrom xsd:dateTime ] ] ) ] ;
    owl:annotatedTarget owl:Nothing .

[] a owl:Axiom ;
    rdfs:comment "Shows an Array and its corresponding element type" ;
    owl:annotatedProperty skos:example ;
    owl:annotatedSource mork:ScalarValueElement ;
    owl:annotatedTarget """###  http://www.nebularis.org/hyperthunk/Mapping#Rep_CombinedLimitSymbols
:Rep_CombinedLimitSymbols rdf:type owl:NamedIndividual , 
                                    mork:Array ;
                          mork:elementType :Rep_CombinedLimitSymbols_Element2147483650 ;
                          mork:representationOf :Rep_CombinedLimitSymbols ;
                          mork:representationScheme :Mapping_Representation ;
                          mork:identifier "combinedLimitSymbols" ;
                          mork:orderedItems "false"^^xsd:boolean .

###  http://www.nebularis.org/hyperthunk/Mapping#Rep_CombinedLimitSymbols_Element2147483650
:Rep_CombinedLimitSymbols_Element2147483650 rdf:type owl:NamedIndividual , 
                                    mork:ScalarValueElement ;
                          mork:representationScheme :Mapping_Representation ;
                          mork:identifier "combinedLimitSymbols_Element2147483650" ;
                          rdfs:seeAlso :combinedLimitSymbols_Element2147483650 .""" .

[] a owl:ObjectProperty ;
    rdfs:subPropertyOf mork:precedes ;
    owl:inverseOf mork:dependentMapping .

[] a owl:ObjectProperty ;
    rdfs:subPropertyOf mork:precedes ;
    owl:inverseOf mork:templateMapping .

[] a owl:ObjectProperty ;
    rdfs:subPropertyOf mork:softPrecedes ;
    owl:inverseOf mork:hypothesisMapping .

[] a owl:ObjectProperty ;
    rdfs:subPropertyOf mork:precedes ;
    owl:inverseOf mork:broaderApplicative .

[] a owl:ObjectProperty ;
    rdfs:subPropertyOf mork:precedes ;
    owl:inverseOf mork:compositeBroaderMapping .

dct:contributor a owl:AnnotationProperty .

dct:creator a owl:AnnotationProperty .

dct:description a owl:AnnotationProperty .

dct:title a owl:AnnotationProperty .

mork:mappingNote a owl:AnnotationProperty ;
    rdfs:label "mapping note" ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "Used to provide notes about a mapping decision." .

mork:swrlCompactSyntax a owl:AnnotationProperty ;
    rdfs:label "swrl compact syntax" ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A human-readable rendering of a SWRL rule in compact syntax. This is an annotation property with no logical role in reasoning or validation. The canonical representation of the rule is the structured swrl:Imp individual linked via generatesRuleDefinition." .

mork:userDeclined a owl:AnnotationProperty ;
    rdfs:label "user declined" ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "A note explaining that a user has declined the use of a DataMapping" .

mork:AnonymousElement skos:example """### the Array contractingParties contains elements which provide firstName and lastName
### e.g., (JSON)
### { "contractingParties": [ { "firstName": "Joe", "lastName:", "Blogs" }, { "firstName": "John", "lastName": "Johns" } ] }
###

:JS_Array_ContractingParties rdf:type owl:NamedIndividual, mork:Array ;
                             mork:elementType :JS_Elem_ContractingParties ;
                             mork:identifier "contractingParties" ;
                             mork:path "contract.signatories.contractingParties" ;
                             mork:representationOf :DC_ContractingParties ;
                             mork:representationScheme :Scheme_Rep_Contracts .

:JS_Elem_ContractingParties rdf:type owl:NamedIndividual, mork:AnonymousEntity ;
                            mork:identifier "" ;
                            mork:memberProperty :JS_Attr_FirstName, :JS_Attr_LastName ;
                            mork:path "contract.signatories.contractingParties[n]" ;
                            mork:representationOf :DC_ContractingParties_Party ;
                            mork:representationScheme :Scheme_Rep_Contracts .""" .

mork:DeferredConceptIRI skos:example """:Map_FalconTypes rdf:type owl:NamedIndividual , mork:DataMapping ;
    # nb: the conceptName refers to a generated class in the target ontology
    mork:conceptName "#Species" ;
    mork:mappingFor :FalconType ;
    mork:weighting 85 ;
    mork:deferredMapping :Map_Gen_Species_Class , :Map_Gen_Bird_Class , :Map_Gen_IsSpeciesOf ;
    # yield the concept 'Species' to a broader mapping
    mork:yieldConcept mork:DeferredConceptIRI ;
    mork:mappingNote "Define a new class 'Species' and a new class 'Bird' in the target ontology." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Map_FalconTypes ;
   owl:annotatedProperty mork:weighting ;
   mork:mappingNote "Falcon is a bird, birds lay eggs, however birds are not reptiles." ;
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Map_FalconTypes ;
   owl:annotatedProperty mork:deferredMapping ;
   owl:annotatedTarget mork:DeferredClassDefinition ;
   mork:mappingNote "Not only is 'Falcon' absent from the target ontology, a Falcon is a bird, which is neither a Reptile nor a Mammal. Recommend defining a new class 'Species' and a new class 'Bird' in the target ontology, and then defining 'Falcon' as an individual of the class 'Species', and allows it to refer to the class 'Bird' via a new object property 'isSpeciesOf'." ;
 ] .

 :Map_Gen_Species_Class rdf:type owl:NamedIndividual , mork:DataMapping ;
    # we use a #<conceptName> when the generated IRI should be prefixed with the base IRI of the output ontology
    # we can also use another prefix to change this, e.g., "zoo:species"
    mork:conceptName "#Species" ; 
    mork:broadTBoxCategoryMatch owl:Thing ;  # make a new Thing called Species
    skos:mappingNote "Falcon and Platypus are both types of species of Animal." .

:Map_Gen_Bird_Class rdf:type owl:NamedIndividual , mork:DataMapping ;
    mork:conceptName "#Bird" ;
    mork:broadTBoxCategoryMatch zoo:Animal ; # make a new type of animal called Bird
    mork:mappingRecommendation "Recommend introducing a notional construct to model reproductive modes, with 'Oviparity' as a member/individual." .

:Map_Gen_IsSpeciesOf rdf:type owl:NamedIndividual , mork:DataMapping ;
    mork:conceptName "#isSpeciesOf" ;
    mork:broadRBoxCategoryMatch owl:topObjectProperty ;
    mork:assertsPropertyDomains :Map_Gen_Species_Domain ;
    mork:assertsPropertyRanges zoo:Animal ;
    mork:mappingNote "Establishes a relationship between Species and Animal" .

:Map_Gen_Species_Domain rdf:type owl:NamedIndividual , mork:DeferredContext ;
    mork:conceptName "#Species" ;
    mork:yieldConcept mork:DeferredConceptIRI ;
    mork:mappingNote "Yields the axiom <BaseIRI>#Species at processing time." .""" .

mork:Interpolation skos:example """###  http://www.nebularis.org/ontologies/Mork#CorporateName
:ConcatCorporateName rdf:type owl:NamedIndividual , mork:Interpolation ;
               :interpolationComponent :FirstName ,
                                                            :LastName ;
               :interpolationTemplate "$2, $1" ,
               skos:note "produces Lastname, Firstname, e.g., 'Vader, Darth'".

###  http://www.nebularis.org/ontologies/Mork#FirstName
:FirstName rdf:type owl:NamedIndividual , mork:DataMapping ;
           :dataRef "path.to.firstName" .

###  http://www.nebularis.org/ontologies/Mork#LastName
:LastName rdf:type owl:NamedIndividual , mork:DataMapping ;
          :dataRef "path.to.lastName" .

###  http://www.nebularis.org/ontologies/Mork#MappingExample
:MappingExample rdf:type owl:NamedIndividual ,
                         :Datum ;
                :concatenation :ConcatCorporateName ;
                :exactRBoxMatch :corporateName .""" .

mork:Objectification skos:example """# We can model a mapping directly from a relationship
:Concept_Contract_Signatories
                 rdf:type owl:NamedIndividual,
                 mork:Objectification ; 
           mork:broadConceptRole :Rep_Contract ;
           mork:conceptScheme :Taxa_Scheme ; 
           mork:narrowConceptRole :Rep_Signatories ;
           skos:note "Models an association between Rep_Conditions and the attribute combinedLimitSymbols, which is represented by Rep_CombinedLimitSymbols" .

:Mapping_Signatories 
                 rdf:type owl:NamedIndividual, mork:DataMapping ;
           mork:mappingFor :Concept_Contract_Signatories ;
           skos:closeMatch contract:signatory ;
           mork:mappingScheme :Scheme_Map_Contracts ;
           mork:weighting 80 ;
           skos:note "the representation Array signatories may be related to the ontological concept signatory" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Mapping_Signatories ;
   owl:annotatedProperty skos:closeMatch ;
   owl:annotatedTarget contract:signatory ;
   skos:note "close match on 'signatories' and owl:objectProperty 'signatory'"
 ] .""" .

mork:OwlAxiom skos:example """###  Mapping between the concept Signatory_acceptingParty and an objectProperty 
###  in the target ontology (acceptingParty), met via Onto_Assoc_Contract_acceptingParty
###  since placing an instance of owl:ObjectProperty in the object position of an RDF 
###  triple is disallowed by some processing environments (e.g., owlapi).
###
###  Note that we mark Onto_Assoc_Contract_acceptingParty as representing acceptingParty
###  via the owl:sameAs construct.
###

:Map_Signatory_acceptingParty rdf:type owl:NamedIndividual ;
              skos:relatedMatch Onto_Assoc_Contract_acceptingParty ;
              mork:hypothesisMapping :Map_Signatory_Party ;
              mork:mappingScheme :Scheme_Map_Contracts .

:Onto_Assoc_Contract_acceptingParty 
                       rdf:type owl:NamedIndividual, 
                       mork:OwlObjectProperty ;
              owl:sameAs <http://www.nebularis.org/hyperthunk/examples/Contract#acceptingParty> ;
              mork:conceptName "acceptingParty" ;
              mork:iri "http://www.nebularis.org/hyperthunk/examples/Contract/acceptingParty" ;
              mork:ontologicalScheme :Scheme_Onto_Contracts .""" .

mork:ScalarValueElement skos:example """###  http://www.nebularis.org/hyperthunk/Mapping#Rep_CombinedLimitSymbols
:Rep_CombinedLimitSymbols rdf:type owl:NamedIndividual , 
                                    mork:Array ;
                          mork:elementType :Rep_CombinedLimitSymbols_Element2147483650 ;
                          mork:representationOf :Rep_CombinedLimitSymbols ;
                          mork:representationScheme :Mapping_Representation ;
                          mork:identifier "combinedLimitSymbols" ;
                          mork:orderedItems "false"^^xsd:boolean .

###  http://www.nebularis.org/hyperthunk/Mapping#Rep_CombinedLimitSymbols_Element2147483650
:Rep_CombinedLimitSymbols_Element2147483650 rdf:type owl:NamedIndividual , 
                                    mork:ScalarValueElement ;
                          mork:representationScheme :Mapping_Representation ;
                          mork:identifier "combinedLimitSymbols_Element2147483650" ;
                          rdfs:seeAlso :combinedLimitSymbols_Element2147483650 .""" .

mork:broadABoxCategoryMatch skos:example """###  http://www.example.org/Risks#isSubcategoryOf
:isSubcategoryOf rdf:type owl:ObjectProperty .

###  http://www.example.org/Risks#RegulatoryRisk
:RegulatoryRisk rdf:type owl:NamedIndividual ,
                                          risk:Risk .

###  http://www.example.org/Risks#PCIDSS
:PCIDSS rdf:type owl:NamedIndividual ,
            skos:note "Hyperonymic relation via A-Box object property" ;
            mork:hasMapping :PciDssMapping ;
            rdfs:comment "we want to instantiate an axiom `:isSubcategoryOf :RegulatoryRisk' here" .

###  http://www.example.org/Mapping#PciDssMapping
:PciDssMapping rdf:type owl:NamedIndividual ,
                      mork:DataMapping ;
            rdfs:comment "the following statements assert the desired axiom for PCIDSS, viz `isSubcategoryOf :RegulatoryRisk'" ;
            mork:exactTBoxMatch risk:Risk ;
            mork:exactRBoxMatch risk:isSubcategoryOf ;
            mork:broadABoxCategoryMatch risk:RegulatoryRisk .""" .

mork:compositeBroaderMapping skos:example "See compositeNarrowerMapping for an example" .

mork:compositeNarrowerMapping skos:example """Take some representation scheme, mapped from json: 

{
    "aardvarkName": "Peter",
    "aardvarkSex": "M"
}

This will yield two attributes, to which we will map three concepts in a concept scheme: aardvark, aardvark_Name, and aardvark_Sex.

In our ontology, we may wish to model aardvark within the t-box of the ontology:

:Aardvark rdf:type owl:Class;
            rdfs:subClassOf :Animal .

In this case, an input datum for aardvark will require that we define the class first, then assert a new individual which is a member of said class, before we can manage the input record by making DataTypeProperty assertions against the name and sex of the newly individuated animal.

Or indeed we might be required to model this by relating our new individual to some other fact within the a-box, adding meaning via object properties or annotations, e.g., using skos:

:Aardvark rdf:type owl:NamedIndividual ;
           skos:narrowerTransitive :Animal .

In either case, we are required to undertake multiple steps to individuate the record before we can begin to process the attributes that belong to (i.e. are narrower within) its concept scheme. This will yield a composition of mappings in order to create the necessary digraph in the target ontology scheme. The following example snippet (Turtle) positions the Aardvark concept in the T-Box of that target ontology, with subsequent individuals assigned to said class. Note the use of deferredMapping here, such that the class is composed of individuals, however the individuals cannot be asserted to belong to the class until it exists.

:MapAardvarkClass rdf:type owl:NamedIndividual ;
            rdfs:subClassOf mork:DataMapping ;
            mork:broadTBoxCategoryMatch ont:Animal ; 
            mork:compositeNarrowerMapping :MapAardvarkIndividual ;
            mork:conceptName "Aardvark" .

:MapAardvarkIndividual rdf:type owl:NamedIndividual ;
            rdfs:subClassOf mork:Datum ;
            mork:deferredMapping :MapAardvarkClass ;
            mork:compositeNarrowerMapping :MapAardvarkName, :MapAardvarkSex .

Subsequent mappings (for name and sex) may rely on these mappings as a hypothesis.""" .

mork:conceptNameTemplate skos:example ":Subject mork:conceptNameTemplate \"Item{$name}\"" .

mork:hypothesisMapping skos:example """A hypothesis mapping can be used to support the weighting for another mapping. Borrowing the "aardvark" datum mapping example from the compositeNarrowerMapping skos:example, we can see the the concept mapping of aardvark_name may rely on the "Aardvark Class" mapping as a hypothesis, since if we have not mapped the axiom for the whole, then the part cannot be mapped either.

:Aardvark rdf:type owl:NamedIndividual ;
            rdfs:subClassOf mork:DataConcept ;
            mork:conceptScheme :Animals_Taxo ;
            skos:closeMatch :MapAardvarkClass ;
            mork::compositeNarrower :Aardvark_Name .

:Aardvark_Name rdf:type owl:NamedIndividual ;
            rdfs:subClassOf mork:DataConcept ;
            mork:conceptScheme :Animals_Taxo ;
            mork:compositeBroader :Aardvark ;
            skos:closeMatch :MapAardvark_Name .

:MapAardvark_Name rdf:type owl:NamedIndividual ;
            rdfs:subClassOf mork:DataMapping ;
            mork:hypothesisMapping :MapAardvarkClass ;
            skos:closeMatch :Ont_prop_Animal_Name .

:MapAardvarkClass rdf:type owl:NamedIndividual ;
            rdfs:subClassOf mork:DataMapping ;
            mork:broadClassMatch ont:Animal ;
            mork:compositeNarrowerMapping :MapAardvarkIndividual ;
            mork:conceptName "Aardvark" .

:MapAardvarkIndividual rdf:type owl:NamedIndividual ;
            rdfs:subClassOf datarep:Datum ;
            mork:deferredMapping :MapAardvarkClass .

This is a somewhat unnecessary hypothesis, since it is assumed that a processing logic would traverse the concept scheme for the taxa and fail the parent (aardvark) mapping before arriving at its component properties, however it provides an illustration of the use of this construct.""" .

mork:identityTemplateMapping skos:example "Aardvark is identified by its 'name' property, and thus we must process the 'name' mapping first and use the outcome of this mapping to determine the correct IRI/identity for each individual aardvark we come across." .

mork:interpolationTemplate skos:example """:SomeMapping rdf:type owl:NamedIndividual , mork:Datum ;
    mork:dataRef "path.to.processing-context.data.id" ;
    mork:dataInline "ID" ;
    mork:interpolationTemplate "The ${mork:dataInline} is: ${mork:dataRef}" .""" .

mork:memberProperty skos:example """###  http://www.nebularis.org/hyperthunk/Mapping#Rep_Issuer
:Rep_Issuer rdf:type owl:NamedIndividual ,
                     mork:DataConcept ,
                     mork:Entity ;
            mork:conceptScheme :Mapping_Taxa ;
            mork:memberProperty :Rep_IssuerID ;
            mork:representationOf :Rep_Issuer ;
            mork:representationScheme :Mapping_Representation ;
            mork:identifier "issuer" ;
            skos:note "Individual Representation Rep_Issuer" .""" .

mork:referenceDataMapping skos:example """:Mapping_Contract_LOB rdf:type owl:NamedIndividual , mork:Datum ;
    mork:mappingScheme :Example_Scheme ;
    mork:exactTBoxMatch :Contract ;
    mork:referenceDataMapping :Mapping_Lob ;
    mork:compositeNarrowerMapping :Mapping_Contract_Details .

[ rdf:type owl:Axiom ;
  owl:annotatedSource :Mapping_Contract_LOB ;
  owl:annotationProperty mork:referenceDataMapping ;
  owl:annotatedTarget :Mapping_Lob ;
  skos:note "lob may be determined by a lookup on the value contained in the lineOfBusiness field" ] .

:Mapping_Lob rdf:type owl:NamedIndividual , mork:Lookup ;
    mork:mappingScheme :Example_Scheme ;
    mork:exactRBoxMatch :lob ;
    mork:exactTBoxMatch :LineOfBusiness ;
    mork:referenceDataPath: skos:abbreviation ;
    mork:dataRef "path.to.data.field.lineOfBusiness" ;
    skos:note "Line of business code maps to 'lob LineOfBusiness', via reference data lookup" .""" .

