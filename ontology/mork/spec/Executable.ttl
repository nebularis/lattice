@prefix : <https://www.nebularis.org/neuro-semantic/lattice/executable#> .
@prefix mork: <http://www.nebularis.org/ontologies/Mork#> .
@prefix elg: <https://www.nebularis.org/neuro-semantic/lattice/eligibility#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <https://www.nebularis.org/neuro-semantic/lattice/executable#> .

# SPDX-License-Identifier: MPL-2.0
#
# Executable semantics IR for MORK's SPARQL/SHACL/SWRL backend compilers
# (ADR-A23, ADR-A24; a scoped subset of the design in
# ontology/surface/docs/MorkEnhancements.md — see ontology/mork/docs/eligibility-executable-
# compiler.md for exactly what was carried over and what was deliberately
# left out). Sits alongside ontology/mork/spec/Mork.ttl rather than inside it, for
# the same reason Surface sits outside the substrate dependency order
# (ADR-A01): it names elg: and qnt: terms by punning, not by import, so
# that adding this compiler layer never requires Eligibility or
# Quantification to import anything from MORK or vice versa.
#
# Not implemented here, and deliberately absent from this vocabulary rather
# than declared and unused: a "native" backend (no definition of one exists
# anywhere in this repository), and runtime result tracking
# (exe:EvaluationRun, exe:ConditionResult in the design note's own terms) —
# this vocabulary describes compiled artefacts, not what running them
# produced. The diagnostic codes below name the reasons a compiled artefact
# can return for Undetermined (ADR-A89 item 6), so they describe the
# artefact's outputs, not a record of a run.

<https://www.nebularis.org/neuro-semantic/lattice/executable>
	rdf:type owl:Ontology ;
	owl:versionIRI <https://www.nebularis.org/neuro-semantic/lattice/executable/0.4.0> ;
	owl:imports <http://www.nebularis.org/ontologies/Mork> ,
		<http://www.w3.org/ns/prov-o-20130430> .

#################################################################
#    Classes
#################################################################

:ExecutablePlan a owl:Class ;
	rdfs:comment "A deterministic, implementation-neutral executable representation compiled from an Eligibility declaration." ;
	skos:definition "The common superclass of every compiled plan this vocabulary describes. Never asserted directly; every plan is one of its subclasses." .

:ConditionPlan a owl:Class ;
	rdfs:subClassOf :ExecutablePlan ;
	rdfs:comment "An executable plan for one elg:Condition." .

:ProfilePlan a owl:Class ;
	rdfs:subClassOf :ExecutablePlan ;
	rdfs:comment "An executable plan for one elg:AdmissionProfile, aggregating its condition plans by strong Kleene logic (ADR-A89 item 5)." .

:IntervalContainmentPlan a owl:Class ;
	rdfs:subClassOf :ConditionPlan ;
	rdfs:comment "A condition plan that evaluates whether a candidate range is contained by some member of a required range set (elg:IntervalContainment)." .

:ConceptMatchPlan a owl:Class ;
	rdfs:subClassOf :ConditionPlan ;
	rdfs:comment "A condition plan that matches a candidate concept against required and excluded concepts (elg:ExactMatch, elg:SetMembership, elg:HierarchicalMatch), per ADR-A87 and ADR-A89." .

:GeneratedArtefact a owl:Class ;
	rdfs:comment "A compiler output: a SPARQL query template, a SHACL shape, or a SWRL rule." .

:SparqlArtefact a owl:Class ; rdfs:subClassOf :GeneratedArtefact ;
	rdfs:comment "A mork:QueryTemplate generated by the SPARQL backend." .

:ShaclArtefact a owl:Class ; rdfs:subClassOf :GeneratedArtefact ;
	rdfs:comment "A sh:NodeShape generated by the SHACL backend." .

:SwrlArtefact a owl:Class ; rdfs:subClassOf :GeneratedArtefact ;
	rdfs:comment "A swrl:Imp generated by the SWRL backend." .

:Diagnostic a owl:Class ;
	rdfs:comment "The reason a compiled artefact gives for an Undetermined outcome (ADR-A24, ADR-A89 item 6). A closed set of named individuals." .

:MissingCandidate a :Diagnostic ;
	rdfs:comment "The question offers no candidate." .

:SeveralCandidates a :Diagnostic ;
	rdfs:comment "The question offers more than one candidate concept, and no reading of several is defined." .

:OutsideScheme a :Diagnostic ;
	rdfs:comment "The candidate concept is not a member of the scheme the condition's contract resolved to." .

:AboveExclusion a :Diagnostic ;
	rdfs:comment "Under hierarchical match, the candidate stands strictly above an excluded concept (elg:L11)." .

:ValueSpaceMismatch a :Diagnostic ;
	rdfs:comment "The value an evidence binding reaches is not read on the condition's value space." .

:RefusedOperation a :Diagnostic ;
	rdfs:comment "A profile's compatibility operation has no evaluable definition (elg:DimensionConsistent)." .

#################################################################
#    Object properties
#################################################################

:admittedBy a owl:ObjectProperty ;
	rdfs:range elg:Condition ;
	rdfs:comment "A concept the condition permits, enumerated at compile time from its expansion so that a SWRL rule derives Permitted from a positive fact (ADR-A89 item 4)." .

:deniedBy a owl:ObjectProperty ;
	rdfs:range elg:Condition ;
	rdfs:comment "A concept the condition denies, enumerated at compile time so that a SWRL rule derives Denied from a positive fact, never from absence (ADR-A89 item 4)." .

:implementsCondition a owl:ObjectProperty, owl:FunctionalProperty ;
	rdfs:domain :ConditionPlan ; rdfs:range elg:Condition ;
	rdfs:comment "The Eligibility condition a condition plan compiles." .

:implementsProfile a owl:ObjectProperty, owl:FunctionalProperty ;
	rdfs:domain :ProfilePlan ; rdfs:range elg:AdmissionProfile ;
	rdfs:comment "The Eligibility profile a profile plan compiles." .

:hasConditionPlan a owl:ObjectProperty ;
	rdfs:domain :ProfilePlan ; rdfs:range :ConditionPlan ;
	rdfs:comment "One of a profile plan's constituent condition plans." .

:usesCompatibilityOperation a owl:ObjectProperty, owl:FunctionalProperty ;
	rdfs:domain :ProfilePlan ; rdfs:range elg:CompatibilityOperation ;
	rdfs:comment "How a profile plan aggregates its condition plans' outcomes (elg:AllRequired or elg:AnySufficient)." .

:compiledFromMapping a owl:ObjectProperty ;
	rdfs:domain :ExecutablePlan ; rdfs:range mork:DataMapping ;
	rdfs:comment "The MORK mapping an executable plan was compiled alongside, where one was minted (the SHACL and SWRL backends mint one; the SPARQL backend does not, since mork:QueryTemplate has no mapping-linking property in ontology/mork/spec/Mork.ttl today)." .

:producesArtefact a owl:ObjectProperty ;
	rdfs:domain :ExecutablePlan ; rdfs:range :GeneratedArtefact ;
	rdfs:comment "An artefact an executable plan's compilation produced." .

:derivedFromEligibilityNode a owl:ObjectProperty ;
	rdfs:domain :ExecutablePlan ;
	rdfs:comment "Direct provenance link from an executable plan to an Eligibility declaration node it was compiled from." .

:derivedFromQuantificationNode a owl:ObjectProperty ;
	rdfs:domain :ExecutablePlan ;
	rdfs:comment "Direct provenance link from an executable plan to a Quantification node (qnt:RangeSet, qnt:Range, qnt:Bound, qnt:Value, qnt:ValueSpace) it was compiled from." .

:derivedFromVocabularyNode a owl:ObjectProperty ;
	rdfs:domain :ExecutablePlan ;
	rdfs:comment "Direct provenance link from an executable plan to a concept, concept scheme or scheme contract it was compiled from." .

:impliesDecision a owl:ObjectProperty ;
	rdfs:domain elg:Question ; rdfs:range elg:Decision ;
	rdfs:comment "A positive, monotonic classification a SWRL rule derived for a Question." ;
	skos:scopeNote "Introduced because elg:decisionValue's domain is elg:EligibilityDecision, not elg:Question — a SWRL rule derives a fact about the Question already in scope, not a newly minted EligibilityDecision individual (open-world reasoning gives SWRL no way to mint one safely). tools/mork_compilers/swrl_backend.py derives elg:Permitted, and elg:Denied only from an exe:deniedBy fact enumerated at compile time (ADR-A89 item 4). Deriving either from the absence of a fact, or deriving elg:Undetermined, would violate ADR-A24's positive-only restriction." .

:permittedUnder a owl:ObjectProperty ;
	rdfs:range elg:Condition ;
	rdfs:comment "A subject reached through an elg:EvidenceBinding that a SWRL rule derived the condition permits (ADR-A91). Names the condition, since one subject is evaluated by several." .

:deniedUnder a owl:ObjectProperty ;
	rdfs:range elg:Condition ;
	rdfs:comment "A subject reached through an elg:EvidenceBinding that a SWRL rule derived the condition denies, from a positive fact (ADR-A91)." .

:impliesProfileDecision a owl:ObjectProperty ;
	rdfs:range elg:Decision ;
	rdfs:comment "A positive, monotonic profile outcome a SWRL rule derived for an elg:EligibilityDecision record from its questions' exe:impliesDecision facts, or for a bound subject from its exe:permittedUnder and exe:deniedUnder facts (ADR-A89 item 5, ADR-A91)." ;
	skos:scopeNote "Separate from elg:decisionValue, which is functional: a record that already asserts a value would otherwise be forced to equate two decision individuals." .

#################################################################
#    PROV-O alignment (ADR-A92)
#################################################################
# Direct, with no Foundation import. PROV-O declares no functional or
# inverse-functional property, so this adds none. It does make every node a
# plan derives from a prov:Entity, and PROV-O declares prov:Entity disjoint
# with prov:Activity.

:ExecutablePlan rdfs:subClassOf prov:Entity .
:GeneratedArtefact rdfs:subClassOf prov:Entity .
:derivedFromEligibilityNode rdfs:subPropertyOf prov:wasDerivedFrom .
:derivedFromQuantificationNode rdfs:subPropertyOf prov:wasDerivedFrom .
:derivedFromVocabularyNode rdfs:subPropertyOf prov:wasDerivedFrom .
:compiledFromMapping rdfs:subPropertyOf prov:wasDerivedFrom .

#################################################################
#    Disjointness
#################################################################

:ConditionPlan owl:disjointWith :ProfilePlan .
:IntervalContainmentPlan owl:disjointWith :ConceptMatchPlan .
:SparqlArtefact owl:disjointWith :ShaclArtefact, :SwrlArtefact .
:ShaclArtefact owl:disjointWith :SwrlArtefact .
