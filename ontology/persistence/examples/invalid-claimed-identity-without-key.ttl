# Negative fixture for persistence-compiler-iri-sync Slice 3: an entity
# minted as a claimed surrogate that names no uniqueness constraint to
# claim from (no dal:claimsConstraint). Refused by the compiler
# (ClaimedIdentityWithoutKey) and by dal:MintingRecipeMembersShape.
@prefix dal: <https://www.nebularis.org/neuro-semantic/lattice/persistence#> .
@prefix ex:  <https://example.org/lending#> .

ex:BorrowerScope a dal:ClassScope ; dal:priority 10 ; dal:targetClass ex:Borrower .

ex:BorrowerIdentity a dal:IdentityProfile ;
    dal:appliesTo        ex:BorrowerScope ;
    dal:resourceRole     dal:EntityRole ;
    dal:identityStrategy dal:SurrogateClaimedIdentity ;
    dal:surrogateKind    dal:UuidV4Surrogate ;
    dal:mintedIriTemplate "urn:borrower:{surrogate}" .
