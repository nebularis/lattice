@prefix bhv: <https://www.nebularis.org/neuro-semantic/lattice/behaviour#> .

ino:defect-double-count a bhv:AllowanceDefinition ;
    bhv:absorptionPolicy bhv:Sequential .

ino:shared-capacity-1 a bhv:AllowanceDefinition ;
    bhv:absorptionPolicy bhv:Sequential .

ino:shared-capacity-2 a bhv:AllowanceDefinition ;
    bhv:absorptionPolicy bhv:Sequential .
