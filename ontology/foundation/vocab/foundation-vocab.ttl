###  https://www.nebularis.org/neuro-semantic/lattice/foundation#Materialised
fnd:Materialised rdf:type owl:NamedIndividual , fnd:DerivationKind ;
    rdfs:label "Materialised"@en ;
    rdfs:comment "Facts written out from rules or closures so they need not be recomputed." .

###  https://www.nebularis.org/neuro-semantic/lattice/foundation#Projected
fnd:Projected rdf:type owl:NamedIndividual , fnd:DerivationKind ;
    rdfs:label "Projected"@en ;
