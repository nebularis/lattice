###  https://www.nebularis.org/neuro-semantic/lattice/foundation#Reviewed
fnd:Reviewed rdf:type owl:NamedIndividual , fnd:GovernanceState ;
    rdfs:label "Reviewed"@en ;
    rdfs:comment "Reviewed and found sound; not yet promoted to active use." .


###  https://www.nebularis.org/neuro-semantic/lattice/foundation#Active
fnd:Active rdf:type owl:NamedIndividual , fnd:GovernanceState ;
    rdfs:label "Active"@en ;
    rdfs:comment "Currently in force and trusted for use." .


###  https://www.nebularis.org/neuro-semantic/lattice/foundation#Superseded
fnd:Superseded rdf:type owl:NamedIndividual , fnd:GovernanceState ;
    rdfs:label "Superseded"@en ;
    rdfs:comment "Replaced by a later version or decision; retained for history, not for new use." .


###  https://www.nebularis.org/neuro-semantic/lattice/foundation#Inferred
fnd:Inferred rdf:type owl:NamedIndividual , fnd:DerivationKind ;
    rdfs:label "Inferred"@en ;
    rdfs:comment "Entailed by a reasoner or rule engine." .

###  https://www.nebularis.org/neuro-semantic/lattice/foundation#Validated
fnd:Validated rdf:type owl:NamedIndividual , fnd:DerivationKind ;
