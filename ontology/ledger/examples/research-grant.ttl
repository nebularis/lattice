# SPDX-License-Identifier: MPL-2.0

# Premise. Grants, with sub-budgets (the "part of and not in addition to"
# tree, ADR-A131 decision 3) and a credit ceiling (decision 3). A 200,000
# research grant has a staff sub-budget and an
# equipment sub-budget. A draw on a sub-budget also debits the grant as its
# ancestor, in the same posting's closure. Unspent equipment funds are
# returned, but a credit never restores an account above its ceiling, so here
# the return is applied only up to what the equipment budget can still hold.
#
# | Account            | Before  | Position 1 (staff spend) | Position 2 (equipment spend) | Position 3 (equipment return, offered / applied) | After   |
# |---------------------|--------:|---------------------------|-------------------------------|----------------------------------------------------|--------:|
# | grant-budget (root) | 200,000 | -90,000 -> 110,000        | -50,000 -> 60,000             | +50,000 -> 110,000                                 | 110,000 |
# | staff-budget         | 120,000 | -90,000 -> 30,000         | --                             | --                                                   |  30,000 |
# | equipment-budget     |  80,000 | --                        | -50,000 -> 30,000              | 55,000 offered, 50,000 applied (ceiling 80,000) -> 80,000 | 80,000 |
#
# The equipment budget's credit ceiling equals its stated amount (the
# default), so of the 55,000 returned as unspent only the 50,000 that brings
# it back to 80,000 is applied, never beyond. The return is a credit of the
# example's own kind, unspent funds, and neither account names its kinds, so
# both accept it. The grant had room for the 50,000, so nothing is cut. Each
# posting records the running balance of its own account. The institution's
# ledger names the profile the deployment gave it, and each of the three
# passes, named from the ledger and a key for its evaluation, moved it by one,
# to revision 3.

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix voc:  <https://www.nebularis.org/neuro-semantic/lattice/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/research-grant/> .
@prefix pass: <https://example.org/lattice/ledger/research-grant/ledger-institution/pass/> .
@base <https://example.org/lattice/ledger/research-grant/> .

# ==== The owner, the kind of credit and the value space =======================

ex:institution a fnd:PersistentIdentity ; rdfs:comment "The grantee institution, owner of the budget accounts." .
ex:Grantee a owl:Class ; rdfs:comment "The kind of owner these accounts admit." .

ex:credit-kinds-edition-1 a voc:ConceptScheme ;
    fnd:hasIdentity ex:credit-kinds-identity ; fnd:hasGovernanceState fnd:Active ;
    skos:prefLabel "the grant's kinds of credit, first edition" .
ex:credit-kinds-identity a fnd:PersistentIdentity ;
    rdfs:comment "The scheme of credit kinds an applied module publishes, through its editions." .

ex:unspent-funds a skos:Concept ; skos:inScheme ldg:CreditKinds , ex:credit-kinds-edition-1 ;
    rdfs:isDefinedBy ex:credit-kinds-edition-1 ; skos:prefLabel "unspent funds returned" .

ex:funds a qnt:ValueSpace ;
    fnd:hasIdentity ex:funds-identity ;
    qnt:spaceKey "ledger-research-grant-funds" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Dense ; qnt:spaceHash "ledger-research-grant-funds-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:hasOperationCapability ex:funds-sum , ex:funds-difference .
ex:funds-identity a fnd:PersistentIdentity .
ex:funds-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:funds .
ex:funds-difference a qnt:OperationCapability ; qnt:operationKind qnt:Difference ; qnt:resultSpace ex:funds .

# ==== The merge policies =======================================================

ex:refused-when-exceeded a ldg:MergePolicy ;
    fnd:hasIdentity ex:refused-when-exceeded-identity ;
    ldg:mergeRule ldg:Refuse .

ex:refused-when-exceeded-identity a fnd:PersistentIdentity ;
    rdfs:comment "The merge policy these terms state." .

# ==== The ledger profile =======================================================

ex:ledger-profile a ldg:LedgerProfile ;
    fnd:hasIdentity ex:ledger-profile-identity .

ex:ledger-profile-identity a fnd:PersistentIdentity ;
    rdfs:comment "The ledger profile the deployment gives this example's ledger." .

# ==== The configuration: a budget with two sub-budgets ========================
# Each definition is a version with an identity, its stated amount and its
# ceiling minted under its IRI. None names its kinds, so none pins an edition.

ex:grant-budget a ldg:AccountDefinition ;
    fnd:hasIdentity ex:grant-budget-identity ;
    ldg:statedAmount <grant-budget/stated-amount> ; ldg:unitOfAccount ex:funds ;
    ldg:admitsOwnerKind ex:Grantee ; ldg:mergePolicy ex:refused-when-exceeded ;
    rdfs:comment "The grant's overall budget." .
<grant-budget/stated-amount> a qnt:Quantity ; qnt:onSpace ex:funds ; qnt:numericValue "200000"^^xsd:decimal .
ex:grant-budget-identity a fnd:PersistentIdentity .

ex:staff-budget a ldg:AccountDefinition ;
    fnd:hasIdentity ex:staff-budget-identity ;
    ldg:statedAmount <staff-budget/stated-amount> ; ldg:unitOfAccount ex:funds ;
    ldg:admitsOwnerKind ex:Grantee ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:partOf ex:grant-budget ;
    rdfs:comment "The staff sub-budget, part of the grant." .
<staff-budget/stated-amount> a qnt:Quantity ; qnt:onSpace ex:funds ; qnt:numericValue "120000"^^xsd:decimal .
ex:staff-budget-identity a fnd:PersistentIdentity .

ex:equipment-budget a ldg:AccountDefinition ;
    fnd:hasIdentity ex:equipment-budget-identity ;
    ldg:statedAmount <equipment-budget/stated-amount> ; ldg:unitOfAccount ex:funds ;
    ldg:admitsOwnerKind ex:Grantee ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:partOf ex:grant-budget ; ldg:creditCeiling <equipment-budget/credit-ceiling> ;
    rdfs:comment "The equipment sub-budget, part of the grant. Its credit ceiling equals its stated amount." .
<equipment-budget/stated-amount> a qnt:Quantity ; qnt:onSpace ex:funds ; qnt:numericValue "80000"^^xsd:decimal .
<equipment-budget/credit-ceiling> a qnt:Quantity ; qnt:onSpace ex:funds ; qnt:numericValue "80000"^^xsd:decimal .
ex:equipment-budget-identity a fnd:PersistentIdentity .

# ==== Position 1: staff spending ==============================================

ex:staff-spend-proposal rdfs:comment "Staff spending of 90,000." .
ex:staff-spend-request a ldg:Request ;
    ldg:forProposal ex:staff-spend-proposal ;
    ldg:requestedValue "90000"^^xsd:decimal ; ldg:grantedValue "90000"^^xsd:decimal .
ex:staff-spend-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-staff-budget ;
    ldg:inPass pass:staff-spend ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:request ex:staff-spend-request .
ex:staff-spend-posting a ldg:Posting ;
    ldg:onAccount ex:account-staff-budget ;
    ldg:inPass pass:staff-spend ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "1"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Debit ; ldg:amountValue "90000"^^xsd:decimal ;
    ldg:runningBalance "30000"^^xsd:decimal ;
    prov:wasDerivedFrom ex:staff-spend-merge , ex:staff-spend-request .

# ==== Position 2: equipment spending ==========================================

ex:equipment-spend-proposal rdfs:comment "Equipment spending of 50,000." .
ex:equipment-spend-request a ldg:Request ;
    ldg:forProposal ex:equipment-spend-proposal ;
    ldg:requestedValue "50000"^^xsd:decimal ; ldg:grantedValue "50000"^^xsd:decimal .
ex:equipment-spend-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-equipment-budget ;
    ldg:inPass pass:equipment-spend ; ldg:effectivePosition "2"^^xsd:nonNegativeInteger ;
    ldg:request ex:equipment-spend-request .
ex:equipment-spend-posting a ldg:Posting ;
    ldg:onAccount ex:account-equipment-budget ;
    ldg:inPass pass:equipment-spend ; ldg:effectivePosition "2"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "1"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Debit ; ldg:amountValue "50000"^^xsd:decimal ;
    ldg:runningBalance "30000"^^xsd:decimal ;
    prov:wasDerivedFrom ex:equipment-spend-merge , ex:equipment-spend-request .

# ==== Position 3: unspent equipment funds returned, applied up to the ceiling

ex:equipment-return-posting a ldg:Posting ;
    ldg:onAccount ex:account-equipment-budget ;
    ldg:inPass pass:equipment-return ; ldg:effectivePosition "3"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "2"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Credit ; ldg:creditKind ex:unspent-funds ;
    ldg:offeredValue "55000"^^xsd:decimal ; ldg:amountValue "50000"^^xsd:decimal ;
    ldg:runningBalance "80000"^^xsd:decimal ;
    rdfs:comment "55,000 returned as unspent, applied only at the 50,000 that reaches the ceiling (80,000)." .

# ==== The ledger, the account instances and the passes ========================

ex:ledger-institution a ldg:Ledger ;
    ldg:forOwner ex:institution ; ldg:ledgerProfile ex:ledger-profile ;
    ldg:revision "3"^^xsd:nonNegativeInteger .
ex:account-equipment-budget a ldg:Account ;
    ldg:ofDefinition ex:equipment-budget ; ldg:forOwner ex:institution ;
    ldg:partOfAccount ex:account-grant-budget .
ex:account-grant-budget a ldg:Account ;
    ldg:ofDefinition ex:grant-budget ; ldg:forOwner ex:institution .
ex:account-staff-budget a ldg:Account ;
    ldg:ofDefinition ex:staff-budget ; ldg:forOwner ex:institution ;
    ldg:partOfAccount ex:account-grant-budget .
ex:institution a ex:Grantee .
pass:staff-spend a ldg:Pass ; ldg:passPosition "1"^^xsd:integer ; ldg:passRevision "1"^^xsd:nonNegativeInteger .
pass:equipment-spend a ldg:Pass ; ldg:passPosition "2"^^xsd:integer ; ldg:passRevision "2"^^xsd:nonNegativeInteger .
pass:equipment-return a ldg:Pass ; ldg:passPosition "3"^^xsd:integer ; ldg:passRevision "3"^^xsd:nonNegativeInteger .
