# SPDX-License-Identifier: MPL-2.0

# Premise. Refused. A merge policy states no merge rule, so nothing says what
# happens where requests together exceed what is available.

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/refusal-policy-without-rule/> .

ex:OwnerKind a owl:Class .

ex:units a qnt:ValueSpace ;
    qnt:spaceKey "ledger-refusal-policy-without-rule-units" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Discrete ; qnt:spaceHash "ledger-refusal-policy-without-rule-units-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:hasOperationCapability ex:units-sum , ex:units-difference .
ex:units-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:units .
ex:units-difference a qnt:OperationCapability ; qnt:operationKind qnt:Difference ; qnt:resultSpace ex:units .

ex:q-100 a qnt:Quantity ; qnt:onSpace ex:units ; qnt:numericValue "100"^^xsd:decimal .

# ==== The merge policies =======================================================

ex:silent-policy a ldg:MergePolicy ;
    fnd:hasIdentity ex:silent-policy-identity ;
    rdfs:comment "Refused. It states no merge rule." .

ex:silent-policy-identity a fnd:PersistentIdentity ;
    rdfs:comment "The merge policy these terms state." .

ex:account a ldg:AccountDefinition ;
    ldg:statedAmount ex:q-100 ; ldg:unitOfAccount ex:units ;
    ldg:admitsOwnerKind ex:OwnerKind ; ldg:mergePolicy ex:silent-policy .
