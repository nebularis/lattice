# SPDX-License-Identifier: MPL-2.0

# Premise. Requests of no use in part, the conformance case of ADR-A131's
# second addendum of 2026-11-16. A pool of 7 units is offered in blocks, and a
# block is of no use in part. Two applications arrive at one position, for 5
# and for 4, ranked by the order in which they were made. Under the merge rule
# ldg:WholeOrNothing each is granted whole where it fits what is left, in rank
# order, and nothing otherwise. The policy allows a residual and names the
# account that takes it.
#
# | Request | Rank | Requested | Left before | Granted |
# |---------|-----:|----------:|------------:|--------:|
# | 1       |    1 |         5 |           7 |       5 |
# | 2       |    2 |         4 |           2 |       0 |
#
# The granted values, 5 and 0, and the residual of 2 sum to the 7 shared. The
# merge records both requests, the second with a granted value of 0, since the
# merge granted. Only the first request is posted.

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/whole-or-nothing/> .

# ==== The owner, the order and the value space ================================

ex:issuer a fnd:PersistentIdentity ; rdfs:comment "The issuer of the blocks, owner of the pool." .
ex:Issuer a owl:Class ; rdfs:comment "The kind of owner these accounts admit." .

ex:order-of-application a skos:Concept ;
    skos:inScheme ldg:OrderCriteria ;
    skos:prefLabel "the order in which applications were made" .

ex:units a qnt:ValueSpace ;
    qnt:spaceKey "ledger-whole-or-nothing-units" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Discrete ; qnt:spaceHash "ledger-whole-or-nothing-units-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:hasOperationCapability ex:units-sum , ex:units-difference .
ex:units-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:units .
ex:units-difference a qnt:OperationCapability ; qnt:operationKind qnt:Difference ; qnt:resultSpace ex:units .

ex:q-7 a qnt:Quantity ; qnt:onSpace ex:units ; qnt:numericValue "7"^^xsd:decimal .

# ==== The merge policies =======================================================

ex:blocks-whole a ldg:MergePolicy ;
    fnd:hasIdentity ex:blocks-whole-identity ;
    ldg:mergeRule ldg:WholeOrNothing ;
    ldg:rankCriterion ex:order-of-application ;
    ldg:allowsResiduals true ;
    ldg:residualAccount ex:unallocated .

ex:blocks-whole-identity a fnd:PersistentIdentity ;
    rdfs:comment "The merge policy the offer's terms state." .

ex:refused-when-exceeded a ldg:MergePolicy ;
    fnd:hasIdentity ex:refused-when-exceeded-identity ;
    ldg:mergeRule ldg:Refuse .

ex:refused-when-exceeded-identity a fnd:PersistentIdentity ;
    rdfs:comment "The merge policy of the account that takes a residual." .

# ==== The configuration: the pool and the account that takes a residual ======

ex:pool a ldg:AccountDefinition ;
    ldg:statedAmount ex:q-7 ; ldg:unitOfAccount ex:units ;
    ldg:admitsOwnerKind ex:Issuer ; ldg:mergePolicy ex:blocks-whole ;
    rdfs:comment "7 units, offered in blocks that are each granted whole or not at all." .

ex:unallocated a ldg:AccountDefinition ;
    ldg:statedAmount ex:q-7 ; ldg:unitOfAccount ex:units ;
    ldg:admitsOwnerKind ex:Issuer ; ldg:mergePolicy ex:refused-when-exceeded ;
    rdfs:comment "What no block took, held for a later offer under its own policy." .

# ==== Position 1: two requests, one merge record, one posting ================

ex:proposal-1 rdfs:comment "An application for a block of 5, made first." .
ex:proposal-2 rdfs:comment "An application for a block of 4, made second." .

ex:request-1 a ldg:Request ;
    ldg:forProposal ex:proposal-1 ; ldg:rank "1"^^xsd:nonNegativeInteger ;
    ldg:requestedValue "5"^^xsd:decimal ; ldg:grantedValue "5"^^xsd:decimal .
ex:request-2 a ldg:Request ;
    ldg:forProposal ex:proposal-2 ; ldg:rank "2"^^xsd:nonNegativeInteger ;
    ldg:requestedValue "4"^^xsd:decimal ; ldg:grantedValue "0"^^xsd:decimal .

ex:merge-1 a ldg:MergeRecord ;
    ldg:onAccount ex:account-pool ;
    ldg:inPass ex:pass-1 ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:availableBefore "7"^^xsd:decimal ;
    ldg:request ex:request-1 , ex:request-2 ;
    ldg:residualValue "2"^^xsd:decimal ;
    rdfs:comment "5 fits the 7 and is granted whole. 4 does not fit the 2 left and is granted nothing. 2 is left." .

ex:posting-1 a ldg:Posting ;
    ldg:onAccount ex:account-pool ;
    ldg:inPass ex:pass-1 ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "1"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Debit ; ldg:amountValue "5"^^xsd:decimal ;
    ldg:runningBalance "2"^^xsd:decimal ;
    prov:wasDerivedFrom ex:merge-1 , ex:request-1 .

# ==== The account instances and the passes ===================================

ex:account-pool a ldg:Account ;
    ldg:ofDefinition ex:pool ; ldg:forOwner ex:issuer .
ex:issuer a ex:Issuer .
ex:pass-1 a ldg:Pass ; ldg:passPosition "1"^^xsd:integer .
