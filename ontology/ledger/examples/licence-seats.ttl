# SPDX-License-Identifier: MPL-2.0

# Premise. Licensing, with seats keyed per site (ADR-A131 decision 3).
# One account definition states the amount once, and a separate account is
# derived for each key value the first draw against it names. A customer's
# seat licence grants 500 seats a year at each site. London and Porto draw
# independently in the 2027 licence year. A periodic amount is one account per
# period (PDD-15), keyed by the bin of the licence-year recurrence its
# effective position falls in, so the 2028 year's first draw at London opens a
# fresh account at the stated amount, and the 2027 accounts keep their
# balances. Nothing is credited back at the year's boundary.
#
# | Account (site, year) | Before | Position 1 | Position 2 | After |
# |-----------------------|-------:|-----------:|-----------:|------:|
# | seats, London, 2027   |    500 | -120 -> 380 | --         |   380 |
# | seats, Porto, 2027    |    500 |  -80 -> 420 | --         |   420 |
# | seats, London, 2028   |    500 | --          | -50 -> 450 |   450 |
#
# Porto's 2028 account has no record, since nothing has drawn on it. A draw
# proposes and merges even with nothing to arbitrate (decision 6), so each
# account gets its own one-grant merge record. Which bin a position falls in
# is the evaluator's to compute from the recurrence, and here positions 1 and
# 2 are stated to fall in 2027 and 2028.

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/licence-seats/> .

# ==== The owner and the key dimension ========================================

ex:customer a fnd:PersistentIdentity ;
    rdfs:comment "The licensee, owner of the seat account." .

ex:Licensee a owl:Class ;
    rdfs:comment "The kind of owner this account admits." .

ex:sites a skos:ConceptScheme ; skos:prefLabel "sites" .
ex:london a skos:Concept ; skos:inScheme ex:sites ; skos:prefLabel "London" .
ex:porto a skos:Concept ; skos:inScheme ex:sites ; skos:prefLabel "Porto" .

# ==== The value space and the configuration ==================================

ex:seats a qnt:ValueSpace ;
    qnt:spaceKey "ledger-licence-seats" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Discrete ; qnt:spaceHash "ledger-licence-seats-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:hasOperationCapability ex:seats-sum , ex:seats-difference .
ex:seats-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:seats .
ex:seats-difference a qnt:OperationCapability ; qnt:operationKind qnt:Difference ; qnt:resultSpace ex:seats .

ex:q-500 a qnt:Quantity ; qnt:onSpace ex:seats ; qnt:numericValue "500"^^xsd:decimal .

ex:licence-year a qnt:Recurrence ;
    rdfs:comment "Annual, by the licence's anniversary." .
ex:year-2027 a qnt:RecurrenceBin ; qnt:generatedByRecurrence ex:licence-year ; qnt:binKey "2027" .
ex:year-2028 a qnt:RecurrenceBin ; qnt:generatedByRecurrence ex:licence-year ; qnt:binKey "2028" .

ex:seat-licence a ldg:AccountDefinition ;
    ldg:statedAmount ex:q-500 ;
    ldg:unitOfAccount ex:seats ;
    ldg:admitsOwnerKind ex:Licensee ;
    ldg:mergeRule ldg:Refuse ;
    ldg:periodRecurrence ex:licence-year ;
    ldg:keyDimension ex:sites ;
    rdfs:comment "500 seats a year, one account derived per site and licence year." .

# ==== Position 1, in 2027: the two sites draw independently =================

ex:london-draw-proposal rdfs:comment "London's draw of 120 seats." .
ex:london-draw-grant a ldg:Grant ;
    ldg:forProposal ex:london-draw-proposal ;
    ldg:requestedValue "120"^^xsd:decimal ; ldg:grantedValue "120"^^xsd:decimal .
ex:london-draw-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-seat-licence-london-2027 ;
    ldg:inPass ex:pass-1 ; ldg:effectivePosition "1"^^xsd:integer ;
    ldg:grant ex:london-draw-grant .
ex:london-draw-posting a ldg:Posting ;
    ldg:onAccount ex:account-seat-licence-london-2027 ;
    ldg:inPass ex:pass-1 ; ldg:effectivePosition "1"^^xsd:integer ;
    ldg:recordedPosition "1"^^xsd:integer ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Debit ; ldg:amountValue "120"^^xsd:decimal ;
    prov:wasDerivedFrom ex:london-draw-merge , ex:london-draw-grant .
ex:london-balance-1 a ldg:BalanceRecord ;
    ldg:onAccount ex:account-seat-licence-london-2027 ;
    ldg:inPass ex:pass-1 ;
    ldg:remainingValue "380"^^xsd:decimal ; ldg:availableValue "380"^^xsd:decimal ;
    prov:wasDerivedFrom ex:london-draw-posting .

ex:porto-draw-proposal rdfs:comment "Porto's draw of 80 seats." .
ex:porto-draw-grant a ldg:Grant ;
    ldg:forProposal ex:porto-draw-proposal ;
    ldg:requestedValue "80"^^xsd:decimal ; ldg:grantedValue "80"^^xsd:decimal .
ex:porto-draw-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-seat-licence-porto-2027 ;
    ldg:inPass ex:pass-1 ; ldg:effectivePosition "1"^^xsd:integer ;
    ldg:grant ex:porto-draw-grant .
ex:porto-draw-posting a ldg:Posting ;
    ldg:onAccount ex:account-seat-licence-porto-2027 ;
    ldg:inPass ex:pass-1 ; ldg:effectivePosition "1"^^xsd:integer ;
    ldg:recordedPosition "1"^^xsd:integer ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Debit ; ldg:amountValue "80"^^xsd:decimal ;
    prov:wasDerivedFrom ex:porto-draw-merge , ex:porto-draw-grant .
ex:porto-balance-1 a ldg:BalanceRecord ;
    ldg:onAccount ex:account-seat-licence-porto-2027 ;
    ldg:inPass ex:pass-1 ;
    ldg:remainingValue "420"^^xsd:decimal ; ldg:availableValue "420"^^xsd:decimal ;
    prov:wasDerivedFrom ex:porto-draw-posting .

# ==== Position 2, in 2028: London's first draw of the new year ===============

ex:london-2028-draw-proposal rdfs:comment "London's draw of 50 seats in the 2028 licence year." .
ex:london-2028-draw-grant a ldg:Grant ;
    ldg:forProposal ex:london-2028-draw-proposal ;
    ldg:requestedValue "50"^^xsd:decimal ; ldg:grantedValue "50"^^xsd:decimal .
ex:london-2028-draw-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-seat-licence-london-2028 ;
    ldg:inPass ex:pass-2 ; ldg:effectivePosition "2"^^xsd:integer ;
    ldg:grant ex:london-2028-draw-grant .
ex:london-2028-draw-posting a ldg:Posting ;
    ldg:onAccount ex:account-seat-licence-london-2028 ;
    ldg:inPass ex:pass-2 ; ldg:effectivePosition "2"^^xsd:integer ;
    ldg:recordedPosition "1"^^xsd:integer ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Debit ; ldg:amountValue "50"^^xsd:decimal ;
    prov:wasDerivedFrom ex:london-2028-draw-merge , ex:london-2028-draw-grant .
ex:london-2028-balance-2 a ldg:BalanceRecord ;
    ldg:onAccount ex:account-seat-licence-london-2028 ;
    ldg:inPass ex:pass-2 ;
    ldg:remainingValue "450"^^xsd:decimal ; ldg:availableValue "450"^^xsd:decimal ;
    prov:wasDerivedFrom ex:london-2028-draw-posting .

# ==== The account instances and the passes ===================================

ex:account-seat-licence-london-2027 a ldg:Account ;
    ldg:ofDefinition ex:seat-licence ; ldg:forOwner ex:customer ;
    ldg:accountKey ex:london ; ldg:periodKey ex:year-2027 .
ex:account-seat-licence-porto-2027 a ldg:Account ;
    ldg:ofDefinition ex:seat-licence ; ldg:forOwner ex:customer ;
    ldg:accountKey ex:porto ; ldg:periodKey ex:year-2027 .
ex:account-seat-licence-london-2028 a ldg:Account ;
    ldg:ofDefinition ex:seat-licence ; ldg:forOwner ex:customer ;
    ldg:accountKey ex:london ; ldg:periodKey ex:year-2028 .
ex:customer a ex:Licensee .
ex:pass-1 a ldg:Pass ; ldg:passPosition "1"^^xsd:integer .
ex:pass-2 a ldg:Pass ; ldg:passPosition "2"^^xsd:integer .
