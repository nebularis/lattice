# SPDX-License-Identifier: MPL-2.0

# Premise. Insurance, with the full tree, a limit stated in addition to the
# aggregate, a purpose counted outside the path, and a reinstatement.
# The programme's annual aggregate (10,000,000) has two
# sections, one with a sublimit. A separate limit for one class of
# beneficiary sits beside the aggregate, "in addition to" it, so it is never
# an ancestor. A flood aggregate, also outside the tree, is debited whenever a
# draw names the flood purpose. The whole aggregate sits under an annual cap
# of twice its amount (20,000,000), the programme's hard cap across the
# original cover and one reinstatement.
#
# | Account                | Before      | Position 1 (flood loss 700,000) | Position 2 (recovery 300,000) | Position 3 (loss 9,600,000) | Position 4 (reinstatement) | After       |
# |--------------------------|------------:|-----------------------------------|----------------------------------|--------------------------------|-------------------------------|------------:|
# | annual-cap        | 20,000,000  | -700,000 -> 19,300,000           | +300,000 -> 19,600,000           | -9,600,000 -> 10,000,000        | -- (a reinstatement does not restore it) | 10,000,000  |
# | aggregate                 | 10,000,000  | -700,000 -> 9,300,000            | +300,000 -> 9,600,000            | -9,600,000 -> 0                 | +10,000,000 -> 10,000,000      | 10,000,000  |
# | section-a                 |  6,000,000  | -700,000 -> 5,300,000            | +300,000 -> 5,600,000            | --                               | --                              |  5,600,000  |
# | sublimit-a1                |  1,000,000  | -700,000 -> 300,000              | +300,000 -> 600,000              | --                               | --                              |    600,000  |
# | section-b                 |  4,000,000  | --                                 | --                                | --                               | --                              |  4,000,000  |
# | beneficiary-class-limit    |  2,000,000  | --                                 | --                                | --                               | --                              |  2,000,000  |
# | flood-aggregate            |  3,000,000  | -700,000 -> 2,300,000            | +300,000 -> 2,600,000            | --                               | --                              |  2,600,000  |
#
# Position 3's loss is paid straight from the aggregate (a liability loss not
# scoped to either section), so it does not touch section-a, sublimit-a1 or
# section-b. Every posting is written once, at the account it names, and an
# ancestor's balance is the sum over its subtree. Each credit has a kind, a
# recovery or a reinstatement, of the example's own, in the first edition of
# its kinds, which the annual cap pins. The annual cap is
# restored by recoveries alone, so position 4's reinstatement restores the
# aggregate and not the annual cap, whose balance stays the measure of total
# capacity left across the original cover and the reinstatement. Every other
# account names no kind and accepts both. No ancestor had less room than a
# credit applied, so nothing is cut. Each posting records the running balance
# of its own account. The programme's ledger names the profile the deployment
# gave it, and each of the four passes, named from the ledger and a key for
# its evaluation, moved it by one, to revision 4.

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix voc:  <https://www.nebularis.org/neuro-semantic/lattice/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/insurance-aggregate/> .
@prefix pass: <https://example.org/lattice/ledger/insurance-aggregate/ledger-programme/pass/> .
@base <https://example.org/lattice/ledger/insurance-aggregate/> .

# ==== The owner, the purpose scheme, the kinds of credit and the value space ==

ex:programme a fnd:PersistentIdentity ; rdfs:comment "The programme, owner of every account in this example." .
ex:Programme a owl:Class ; rdfs:comment "The kind of owner these accounts admit." .

ex:purposes a skos:ConceptScheme ; skos:prefLabel "loss purposes" .
ex:flood a skos:Concept ; skos:inScheme ex:purposes ; skos:prefLabel "flood" .

ex:credit-kinds-edition-1 a voc:ConceptScheme ;
    fnd:hasIdentity ex:credit-kinds-identity ; fnd:hasGovernanceState fnd:Active ;
    skos:prefLabel "the programme's kinds of credit, first edition" .
ex:credit-kinds-identity a fnd:PersistentIdentity ;
    rdfs:comment "The scheme of credit kinds an applied module publishes, through its editions." .

ex:recovery a skos:Concept ; skos:inScheme ldg:CreditKinds , ex:credit-kinds-edition-1 ;
    rdfs:isDefinedBy ex:credit-kinds-edition-1 ; skos:prefLabel "recovery" ;
    rdfs:comment "An amount recovered after a loss was paid, from a third party or salvage." .
ex:reinstatement a skos:Concept ; skos:inScheme ldg:CreditKinds , ex:credit-kinds-edition-1 ;
    rdfs:isDefinedBy ex:credit-kinds-edition-1 ; skos:prefLabel "reinstatement" ;
    rdfs:comment "The aggregate restored once it is exhausted, as the programme allows once a year." .

ex:money a qnt:ValueSpace ;
    fnd:hasIdentity ex:money-identity ;
    qnt:spaceKey "ledger-insurance-aggregate-money" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Dense ; qnt:spaceHash "ledger-insurance-aggregate-money-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:hasOperationCapability ex:money-sum , ex:money-difference .
ex:money-identity a fnd:PersistentIdentity .
ex:money-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:money .
ex:money-difference a qnt:OperationCapability ; qnt:operationKind qnt:Difference ; qnt:resultSpace ex:money .

# ==== The merge policies =======================================================

ex:refused-when-exceeded a ldg:MergePolicy ;
    fnd:hasIdentity ex:refused-when-exceeded-identity ;
    ldg:mergeRule ldg:Refuse .

ex:refused-when-exceeded-identity a fnd:PersistentIdentity ;
    rdfs:comment "The merge policy these terms state." .

# ==== The ledger profile =======================================================

ex:ledger-profile a ldg:LedgerProfile ;
    fnd:hasIdentity ex:ledger-profile-identity .

ex:ledger-profile-identity a fnd:PersistentIdentity ;
    rdfs:comment "The ledger profile the deployment gives this example's ledger." .

# ==== The configuration: the tree, a limit beside it, and a purpose outside ===
# Each definition is a version with an identity of its own, and its stated
# amount and ceiling are minted under its IRI. The annual cap names the kinds
# that restore it, so it pins the edition they were resolved against.

ex:annual-cap a ldg:AccountDefinition ;
    fnd:hasIdentity ex:annual-cap-identity ;
    ldg:statedAmount <annual-cap/stated-amount> ; ldg:unitOfAccount ex:money ;
    ldg:admitsOwnerKind ex:Programme ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:restoredBy ex:recovery ; ldg:creditKindsEdition ex:credit-kinds-edition-1 ;
    rdfs:comment "Twice the aggregate: the programme's hard cap across the original cover and one reinstatement. Recoveries restore it, and a reinstatement does not." .
<annual-cap/stated-amount> a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "20000000"^^xsd:decimal .
ex:annual-cap-identity a fnd:PersistentIdentity .

ex:aggregate a ldg:AccountDefinition ;
    fnd:hasIdentity ex:aggregate-identity ;
    ldg:statedAmount <aggregate/stated-amount> ; ldg:unitOfAccount ex:money ;
    ldg:admitsOwnerKind ex:Programme ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:partOf ex:annual-cap ; ldg:creditCeiling <aggregate/credit-ceiling> ;
    rdfs:comment "The programme's annual aggregate, reinstatable once." .
<aggregate/stated-amount> a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "10000000"^^xsd:decimal .
<aggregate/credit-ceiling> a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "10000000"^^xsd:decimal .
ex:aggregate-identity a fnd:PersistentIdentity .

ex:section-a a ldg:AccountDefinition ;
    fnd:hasIdentity ex:section-a-identity ;
    ldg:statedAmount <section-a/stated-amount> ; ldg:unitOfAccount ex:money ;
    ldg:admitsOwnerKind ex:Programme ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:partOf ex:aggregate .
<section-a/stated-amount> a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "6000000"^^xsd:decimal .
ex:section-a-identity a fnd:PersistentIdentity .

ex:sublimit-a1 a ldg:AccountDefinition ;
    fnd:hasIdentity ex:sublimit-a1-identity ;
    ldg:statedAmount <sublimit-a1/stated-amount> ; ldg:unitOfAccount ex:money ;
    ldg:admitsOwnerKind ex:Programme ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:partOf ex:section-a .
<sublimit-a1/stated-amount> a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "1000000"^^xsd:decimal .
ex:sublimit-a1-identity a fnd:PersistentIdentity .

ex:section-b a ldg:AccountDefinition ;
    fnd:hasIdentity ex:section-b-identity ;
    ldg:statedAmount <section-b/stated-amount> ; ldg:unitOfAccount ex:money ;
    ldg:admitsOwnerKind ex:Programme ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:partOf ex:aggregate .
<section-b/stated-amount> a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "4000000"^^xsd:decimal .
ex:section-b-identity a fnd:PersistentIdentity .

ex:beneficiary-class-limit a ldg:AccountDefinition ;
    fnd:hasIdentity ex:beneficiary-class-limit-identity ;
    ldg:statedAmount <beneficiary-class-limit/stated-amount> ; ldg:unitOfAccount ex:money ;
    ldg:admitsOwnerKind ex:Programme ; ldg:mergePolicy ex:refused-when-exceeded ;
    rdfs:comment "A further limit for one class of beneficiary, in addition to the aggregate: no ldg:partOf edge." .
<beneficiary-class-limit/stated-amount> a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "2000000"^^xsd:decimal .
ex:beneficiary-class-limit-identity a fnd:PersistentIdentity .

ex:flood-aggregate a ldg:AccountDefinition ;
    fnd:hasIdentity ex:flood-aggregate-identity ;
    ldg:statedAmount <flood-aggregate/stated-amount> ; ldg:unitOfAccount ex:money ;
    ldg:admitsOwnerKind ex:Programme ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:countsPurpose ex:flood ;
    rdfs:comment "Outside the tree. A draw naming the flood purpose debits this account too." .
<flood-aggregate/stated-amount> a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "3000000"^^xsd:decimal .
ex:flood-aggregate-identity a fnd:PersistentIdentity .

# ==== Position 1: a flood loss on the sublimit, and the flood purpose =========

ex:loss-1-proposal rdfs:comment "A flood loss of 700,000, paid from the sublimit." .
ex:loss-1-request a ldg:Request ;
    ldg:forProposal ex:loss-1-proposal ;
    ldg:requestedValue "700000"^^xsd:decimal ; ldg:grantedValue "700000"^^xsd:decimal .
ex:loss-1-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-sublimit-a1 ;
    ldg:inPass pass:loss-1 ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:request ex:loss-1-request .
ex:loss-1-posting a ldg:Posting ;
    ldg:onAccount ex:account-sublimit-a1 ;
    ldg:inPass pass:loss-1 ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "1"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:nonNegativeInteger ;
    ldg:direction ldg:Debit ; ldg:amountValue "700000"^^xsd:decimal ; ldg:forPurpose ex:flood ;
    ldg:runningBalance "300000"^^xsd:decimal ;
    prov:wasDerivedFrom ex:loss-1-merge , ex:loss-1-request .

ex:loss-1-flood-request a ldg:Request ;
    ldg:forProposal ex:loss-1-proposal ;
    ldg:requestedValue "700000"^^xsd:decimal ; ldg:grantedValue "700000"^^xsd:decimal .
ex:loss-1-flood-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-flood-aggregate ;
    ldg:inPass pass:loss-1 ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:request ex:loss-1-flood-request .
ex:loss-1-flood-posting a ldg:Posting ;
    ldg:onAccount ex:account-flood-aggregate ;
    ldg:inPass pass:loss-1 ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "1"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:nonNegativeInteger ;
    ldg:direction ldg:Debit ; ldg:amountValue "700000"^^xsd:decimal ; ldg:forPurpose ex:flood ;
    ldg:runningBalance "2300000"^^xsd:decimal ;
    prov:wasDerivedFrom ex:loss-1-flood-merge , ex:loss-1-flood-request .

# ==== Position 2: a recovery, credited on the same path and purpose ==========

ex:recovery-2-posting a ldg:Posting ;
    ldg:onAccount ex:account-sublimit-a1 ;
    ldg:inPass pass:recovery-2 ; ldg:effectivePosition "2"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "2"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:nonNegativeInteger ;
    ldg:direction ldg:Credit ; ldg:creditKind ex:recovery ;
    ldg:offeredValue "300000"^^xsd:decimal ; ldg:amountValue "300000"^^xsd:decimal ; ldg:forPurpose ex:flood ;
    ldg:runningBalance "600000"^^xsd:decimal ;
    prov:wasDerivedFrom ex:loss-1-posting .

ex:recovery-2-flood-posting a ldg:Posting ;
    ldg:onAccount ex:account-flood-aggregate ;
    ldg:inPass pass:recovery-2 ; ldg:effectivePosition "2"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "2"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:nonNegativeInteger ;
    ldg:direction ldg:Credit ; ldg:creditKind ex:recovery ;
    ldg:offeredValue "300000"^^xsd:decimal ; ldg:amountValue "300000"^^xsd:decimal ; ldg:forPurpose ex:flood ;
    ldg:runningBalance "2600000"^^xsd:decimal ;
    prov:wasDerivedFrom ex:loss-1-flood-posting .

# ==== Position 3: a liability loss paid straight from the aggregate ==========

ex:loss-3-proposal rdfs:comment "A liability loss of 9,600,000, not scoped to a section." .
ex:loss-3-request a ldg:Request ;
    ldg:forProposal ex:loss-3-proposal ;
    ldg:requestedValue "9600000"^^xsd:decimal ; ldg:grantedValue "9600000"^^xsd:decimal .
ex:loss-3-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-aggregate ;
    ldg:inPass pass:loss-3 ; ldg:effectivePosition "3"^^xsd:nonNegativeInteger ;
    ldg:request ex:loss-3-request .
ex:loss-3-posting a ldg:Posting ;
    ldg:onAccount ex:account-aggregate ;
    ldg:inPass pass:loss-3 ; ldg:effectivePosition "3"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "1"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:nonNegativeInteger ;
    ldg:direction ldg:Debit ; ldg:amountValue "9600000"^^xsd:decimal ;
    ldg:runningBalance "0"^^xsd:decimal ;
    prov:wasDerivedFrom ex:loss-3-merge , ex:loss-3-request .

# ==== Position 4: the aggregate is reinstated, and the annual cap is not =====

ex:reinstatement-4-posting a ldg:Posting ;
    ldg:onAccount ex:account-aggregate ;
    ldg:inPass pass:reinstatement-4 ; ldg:effectivePosition "4"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "2"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:nonNegativeInteger ;
    ldg:direction ldg:Credit ; ldg:creditKind ex:reinstatement ;
    ldg:offeredValue "10000000"^^xsd:decimal ; ldg:amountValue "10000000"^^xsd:decimal ;
    ldg:runningBalance "10000000"^^xsd:decimal ;
    rdfs:comment "Restores the aggregate to its stated amount, within its credit ceiling. The annual cap does not accept a reinstatement, so it stays at 10,000,000 and takes nothing." .

# ==== The ledger, the account instances and the passes ========================

ex:ledger-programme a ldg:Ledger ;
    ldg:forOwner ex:programme ; ldg:ledgerProfile ex:ledger-profile ;
    ldg:revision "4"^^xsd:nonNegativeInteger .
ex:account-aggregate a ldg:Account ;
    ldg:ofDefinition ex:aggregate ; ldg:forOwner ex:programme ;
    ldg:partOfAccount ex:account-annual-cap .
ex:account-flood-aggregate a ldg:Account ;
    ldg:ofDefinition ex:flood-aggregate ; ldg:forOwner ex:programme .
ex:account-annual-cap a ldg:Account ;
    ldg:ofDefinition ex:annual-cap ; ldg:forOwner ex:programme .
ex:account-section-a a ldg:Account ;
    ldg:ofDefinition ex:section-a ; ldg:forOwner ex:programme ;
    ldg:partOfAccount ex:account-aggregate .
ex:account-sublimit-a1 a ldg:Account ;
    ldg:ofDefinition ex:sublimit-a1 ; ldg:forOwner ex:programme ;
    ldg:partOfAccount ex:account-section-a .
ex:programme a ex:Programme .
pass:loss-1 a ldg:Pass ; ldg:passPosition "1"^^xsd:nonNegativeInteger ; ldg:passRevision "1"^^xsd:nonNegativeInteger .
pass:recovery-2 a ldg:Pass ; ldg:passPosition "2"^^xsd:nonNegativeInteger ; ldg:passRevision "2"^^xsd:nonNegativeInteger .
pass:loss-3 a ldg:Pass ; ldg:passPosition "3"^^xsd:nonNegativeInteger ; ldg:passRevision "3"^^xsd:nonNegativeInteger .
pass:reinstatement-4 a ldg:Pass ; ldg:passPosition "4"^^xsd:nonNegativeInteger ; ldg:passRevision "4"^^xsd:nonNegativeInteger .
