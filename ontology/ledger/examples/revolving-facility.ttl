# SPDX-License-Identifier: MPL-2.0

# Premise. Lending, with requests made in another currency than the account's.
# A 20,000,000 sterling revolving facility is drawn and repaid in sterling. The
# borrower asks in euros. Each request is converted before it reaches the
# ledger, at the rate recorded for its date, and a record of that conversion is
# kept there with the rate, its source and its date (ADR-A131, its addendum of
# 2026-11-09). Only then is the draw made, in sterling. The ledger never
# converts: each posting cites its conversion record among what it was derived
# from, as it cites a merge record, and states no term for the conversion. A
# later revaluation, at a further recorded rate, restates the sterling of the
# euros still outstanding, without a fresh drawing.
#
# | Position | Event       | EUR requested | Rate (date)       | GBP posted | Direction | Balance after |
# |----------|-------------|--------------:|-------------------|-----------:|-----------|--------------:|
# | 1        | draw        |    11,500,000 | 0.87 (2027-06-01) | 10,005,000 | debit     |     9,995,000 |
# | 2        | repayment   |     5,000,000 | 0.88 (2027-09-01) |  4,400,000 | credit    |    14,395,000 |
# | 3        | revaluation | 6,500,000 outstanding, at 0.90 (2027-12-31), against 5,605,000 already recorded | | 245,000 | debit | 14,150,000 |
#
# The facility's own stated amount (20,000,000) never changes. Position 3's
# debit is the difference between the outstanding euros revalued at the new
# rate (6,500,000 x 0.90 = 5,850,000) and the sterling already recorded for
# them net of the repayment (10,005,000 - 4,400,000 = 5,605,000): 245,000.
# The borrower's ledger names the profile the deployment gave it, and each of
# the three passes, named from the ledger and a key for its evaluation, moved
# it by one, to revision 3.

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/revolving-facility/> .
@prefix pass: <https://example.org/lattice/ledger/revolving-facility/ledger-borrower/pass/> .

# ==== The owner, units and rates ===============================================

ex:borrower a fnd:PersistentIdentity ; rdfs:comment "The borrower, owner of the facility account." .
ex:Borrower a owl:Class ; rdfs:comment "The kind of owner this account admits." .

ex:repayment a skos:Concept ; skos:inScheme ldg:CreditKinds ; skos:prefLabel "repayment" ;
    rdfs:comment "An amount the borrower repays, which a revolving facility may draw again." .

ex:currencies a qnt:UnitFamily .
ex:GBP a qnt:Unit ; rdfs:label "pound sterling" .
ex:EUR a qnt:Unit ; rdfs:label "euro" .

ex:money a qnt:ValueSpace ;
    qnt:spaceKey "ledger-revolving-facility-money" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Dense ; qnt:spaceHash "ledger-revolving-facility-money-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:unitContract [ a qnt:UnitContract ; qnt:requiresUnit true ;
                       qnt:unitFamily ex:currencies ; qnt:canonicalUnit ex:GBP ] ;
    qnt:hasOperationCapability ex:money-sum , ex:money-difference .
ex:money-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:money .
ex:money-difference a qnt:OperationCapability ; qnt:operationKind qnt:Difference ; qnt:resultSpace ex:money .

ex:eur-to-gbp a qnt:Conversion ; qnt:fromUnit ex:EUR ; qnt:toUnit ex:GBP ;
    qnt:conversionKind qnt:Contextual ; qnt:conversionFunction ex:fx-spot .
ex:fx-spot a qnt:ConversionFunction ; rdfs:label "spot exchange rate on the context's date" .

# Rate observations. Quantification has no property for the observed rate yet
# (open question, as additivity.ttl notes), so the example states it with its
# own ex:rate.
ex:fx-2027-06-01 a qnt:ConversionContext ;
    ex:forConversion ex:eur-to-gbp ; ex:rate 0.87 ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2027-06-01T00:00:00Z"^^xsd:dateTime ] ;
    fnd:hasEvidence [ a fnd:Evidence ; fnd:supports ex:fx-2027-06-01 ; fnd:recordedAt "2027-06-01T09:00:00Z"^^xsd:dateTime ] .
ex:fx-2027-09-01 a qnt:ConversionContext ;
    ex:forConversion ex:eur-to-gbp ; ex:rate 0.88 ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2027-09-01T00:00:00Z"^^xsd:dateTime ] ;
    fnd:hasEvidence [ a fnd:Evidence ; fnd:supports ex:fx-2027-09-01 ; fnd:recordedAt "2027-09-01T09:00:00Z"^^xsd:dateTime ] .
ex:fx-2027-12-31 a qnt:ConversionContext ;
    ex:forConversion ex:eur-to-gbp ; ex:rate 0.90 ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2027-12-31T00:00:00Z"^^xsd:dateTime ] ;
    fnd:hasEvidence [ a fnd:Evidence ; fnd:supports ex:fx-2027-12-31 ; fnd:recordedAt "2027-12-31T17:00:00Z"^^xsd:dateTime ] .

# ==== Conversions, recorded before the ledger =================================
# Each record is written where the request arrives, outside the ledger, and
# names the euros asked for and the rate observation it used. Its sterling is
# what the posting then records. The ledger has no term for any of it.

ex:q-draw-1-eur a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "11500000"^^xsd:decimal ; qnt:inUnit ex:EUR .
ex:draw-1-conversion a prov:Entity ;
    rdfs:comment "EUR 11,500,000 asked for, converted at 0.87 to GBP 10,005,000 before the draw." ;
    prov:wasDerivedFrom ex:q-draw-1-eur , ex:fx-2027-06-01 .

ex:q-repayment-eur a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "5000000"^^xsd:decimal ; qnt:inUnit ex:EUR .
ex:repayment-conversion a prov:Entity ;
    rdfs:comment "EUR 5,000,000 repaid, converted at 0.88 to GBP 4,400,000 before the credit." ;
    prov:wasDerivedFrom ex:q-repayment-eur , ex:fx-2027-09-01 .

ex:q-outstanding-eur a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "6500000"^^xsd:decimal ; qnt:inUnit ex:EUR .
ex:revaluation-conversion a prov:Entity ;
    rdfs:comment "EUR 6,500,000 outstanding, revalued at 0.90 to GBP 5,850,000, against GBP 5,605,000 already recorded." ;
    prov:wasDerivedFrom ex:q-outstanding-eur , ex:fx-2027-12-31 .

# ==== The facility and its merge policy ======================================

ex:q-commitment a qnt:Quantity ; qnt:onSpace ex:money ; qnt:numericValue "20000000"^^xsd:decimal ; qnt:inUnit ex:GBP .

ex:facility a ldg:AccountDefinition ;
    ldg:statedAmount ex:q-commitment ;
    ldg:unitOfAccount ex:money ;
    ldg:admitsOwnerKind ex:Borrower ;
    ldg:mergePolicy ex:refused-when-exceeded ;
    rdfs:comment "A 20,000,000 sterling revolving commitment, drawn in sterling." .

ex:refused-when-exceeded a ldg:MergePolicy ;
    fnd:hasIdentity ex:refused-when-exceeded-identity ;
    ldg:mergeRule ldg:Refuse .

ex:refused-when-exceeded-identity a fnd:PersistentIdentity ;
    rdfs:comment "The merge policy these terms state." .

# ==== The ledger profile =======================================================

ex:ledger-profile a ldg:LedgerProfile ;
    fnd:hasIdentity ex:ledger-profile-identity .

ex:ledger-profile-identity a fnd:PersistentIdentity ;
    rdfs:comment "The ledger profile the deployment gives this example's ledger." .

# ==== Position 1: a drawing, asked for in euros and made in sterling ==========

ex:draw-1-proposal rdfs:comment "A drawing of GBP 10,005,000, asked for as EUR 11,500,000." .
ex:draw-1-request a ldg:Request ;
    ldg:forProposal ex:draw-1-proposal ;
    ldg:requestedValue "10005000"^^xsd:decimal ; ldg:grantedValue "10005000"^^xsd:decimal .
ex:draw-1-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-facility ;
    ldg:inPass pass:draw-1 ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:request ex:draw-1-request .
ex:draw-1-posting a ldg:Posting ;
    ldg:onAccount ex:account-facility ;
    ldg:inPass pass:draw-1 ; ldg:effectivePosition "1"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "1"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Debit ; ldg:amountValue "10005000"^^xsd:decimal ;
    ldg:runningBalance "9995000"^^xsd:decimal ;
    prov:wasDerivedFrom ex:draw-1-merge , ex:draw-1-request , ex:draw-1-conversion .

# ==== Position 2: a repayment, made in euros and credited in sterling =========

ex:repayment-posting a ldg:Posting ;
    ldg:onAccount ex:account-facility ;
    ldg:inPass pass:repayment ; ldg:effectivePosition "2"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "2"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Credit ; ldg:creditKind ex:repayment ;
    ldg:offeredValue "4400000"^^xsd:decimal ; ldg:amountValue "4400000"^^xsd:decimal ;
    ldg:runningBalance "14395000"^^xsd:decimal ;
    prov:wasDerivedFrom ex:repayment-conversion .

# ==== Position 3: revaluation of the euros still outstanding ==================

ex:revaluation-proposal
    rdfs:comment "A mark to market of the euros still outstanding, not a fresh drawing." .
ex:revaluation-request a ldg:Request ;
    ldg:forProposal ex:revaluation-proposal ;
    ldg:requestedValue "245000"^^xsd:decimal ; ldg:grantedValue "245000"^^xsd:decimal .
ex:revaluation-merge a ldg:MergeRecord ;
    ldg:onAccount ex:account-facility ;
    ldg:inPass pass:revaluation ; ldg:effectivePosition "3"^^xsd:nonNegativeInteger ;
    ldg:request ex:revaluation-request .
ex:revaluation-posting a ldg:Posting ;
    ldg:onAccount ex:account-facility ;
    ldg:inPass pass:revaluation ; ldg:effectivePosition "3"^^xsd:nonNegativeInteger ;
    ldg:recordedPosition "3"^^xsd:nonNegativeInteger ; ldg:microPosition "0"^^xsd:integer ;
    ldg:direction ldg:Debit ; ldg:amountValue "245000"^^xsd:decimal ;
    ldg:runningBalance "14150000"^^xsd:decimal ;
    prov:wasDerivedFrom ex:revaluation-merge , ex:revaluation-request , ex:revaluation-conversion .

# ==== The ledger, the account instances and the passes ========================

ex:ledger-borrower a ldg:Ledger ;
    ldg:forOwner ex:borrower ; ldg:ledgerProfile ex:ledger-profile ;
    ldg:revision "3"^^xsd:nonNegativeInteger .
ex:account-facility a ldg:Account ;
    ldg:ofDefinition ex:facility ; ldg:forOwner ex:borrower .
ex:borrower a ex:Borrower .
pass:draw-1 a ldg:Pass ; ldg:passPosition "1"^^xsd:integer ; ldg:passRevision "1"^^xsd:nonNegativeInteger .
pass:repayment a ldg:Pass ; ldg:passPosition "2"^^xsd:integer ; ldg:passRevision "2"^^xsd:nonNegativeInteger .
pass:revaluation a ldg:Pass ; ldg:passPosition "3"^^xsd:integer ; ldg:passRevision "3"^^xsd:nonNegativeInteger .
