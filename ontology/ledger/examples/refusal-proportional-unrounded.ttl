# SPDX-License-Identifier: MPL-2.0

# Premise. Refused: an account whose merge policy has the rule Proportional but
# which states no rounding method. A proportional merge can produce a share no
# decimal in the account's unit states exactly, so a rounding method (and a
# residual allocation) must be stated wherever the rule is chosen. Refused by
# the shape requiring a proportional rule to carry a rounding method and a
# residual allocation.

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/refusal-proportional-unrounded/> .
@base <https://example.org/lattice/ledger/refusal-proportional-unrounded/> .

ex:owner a fnd:PersistentIdentity .
ex:OwnerKind a owl:Class .

ex:units a qnt:ValueSpace ;
    fnd:hasIdentity ex:units-identity ;
    qnt:spaceKey "ledger-refusal-proportional-unrounded-units" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Discrete ; qnt:granularityFloor ex:units-floor ; qnt:spaceHash "ledger-refusal-proportional-unrounded-units-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:hasOperationCapability ex:units-sum , ex:units-difference .
ex:units-identity a fnd:PersistentIdentity .
ex:units-floor a qnt:Quantity ; qnt:onSpace ex:units ; qnt:numericValue "1"^^xsd:decimal .
ex:units-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:units .
ex:units-difference a qnt:OperationCapability ; qnt:operationKind qnt:Difference ; qnt:resultSpace ex:units .

# ==== The merge policies =======================================================

ex:shared-in-proportion a ldg:MergePolicy ;
    fnd:hasIdentity ex:shared-in-proportion-identity ;
    ldg:mergeRule ldg:Proportional .

ex:shared-in-proportion-identity a fnd:PersistentIdentity ;
    rdfs:comment "The merge policy these terms state." .

ex:unrounded-account a ldg:AccountDefinition ;
    fnd:hasIdentity ex:unrounded-account-identity ;
    ldg:statedAmount <unrounded-account/stated-amount> ; ldg:unitOfAccount ex:units ;
    ldg:admitsOwnerKind ex:OwnerKind ; ldg:mergePolicy ex:shared-in-proportion ;
    rdfs:comment "Refused. Its merge policy is Proportional, with no ldg:roundingMethod and no ldg:residualAllocation stated." .
<unrounded-account/stated-amount> a qnt:Quantity ; qnt:onSpace ex:units ; qnt:numericValue "100"^^xsd:decimal .
ex:unrounded-account-identity a fnd:PersistentIdentity .
