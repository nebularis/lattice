# SPDX-License-Identifier: MPL-2.0

# Premise. Refused: two account definitions each ldg:partOf the other. A tree
# has no cycle, so a definition can never be its own ancestor through any
# chain of partOf edges. Refused by the no-cycle shape over ldg:partOf
# (SHACL-SPARQL per ADR-A128, following a cycle through the property
# rather than one hop).

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/refusal-cycle/> .
@base <https://example.org/lattice/ledger/refusal-cycle/> .

ex:owner a fnd:PersistentIdentity .
ex:OwnerKind a owl:Class .

ex:units a qnt:ValueSpace ;
    fnd:hasIdentity ex:units-identity ;
    qnt:spaceKey "ledger-refusal-cycle-units" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Discrete ; qnt:spaceHash "ledger-refusal-cycle-units-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:hasOperationCapability ex:units-sum , ex:units-difference .
ex:units-identity a fnd:PersistentIdentity .
ex:units-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:units .
ex:units-difference a qnt:OperationCapability ; qnt:operationKind qnt:Difference ; qnt:resultSpace ex:units .

# ==== The merge policies =======================================================

ex:refused-when-exceeded a ldg:MergePolicy ;
    fnd:hasIdentity ex:refused-when-exceeded-identity ;
    ldg:mergeRule ldg:Refuse .

ex:refused-when-exceeded-identity a fnd:PersistentIdentity ;
    rdfs:comment "The merge policy these terms state." .

ex:account-x a ldg:AccountDefinition ;
    fnd:hasIdentity ex:account-x-identity ;
    ldg:statedAmount <account-x/stated-amount> ; ldg:unitOfAccount ex:units ;
    ldg:admitsOwnerKind ex:OwnerKind ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:partOf ex:account-y ;
    rdfs:comment "Refused. Part of account-y, which is part of this account." .
<account-x/stated-amount> a qnt:Quantity ; qnt:onSpace ex:units ; qnt:numericValue "100"^^xsd:decimal .
ex:account-x-identity a fnd:PersistentIdentity .

ex:account-y a ldg:AccountDefinition ;
    fnd:hasIdentity ex:account-y-identity ;
    ldg:statedAmount <account-y/stated-amount> ; ldg:unitOfAccount ex:units ;
    ldg:admitsOwnerKind ex:OwnerKind ; ldg:mergePolicy ex:refused-when-exceeded ;
    ldg:partOf ex:account-x ;
    rdfs:comment "Refused. Part of account-x, which is part of this account: a two-step cycle." .
<account-y/stated-amount> a qnt:Quantity ; qnt:onSpace ex:units ; qnt:numericValue "100"^^xsd:decimal .
ex:account-y-identity a fnd:PersistentIdentity .
