# SPDX-License-Identifier: MPL-2.0

# Premise. Refused: two account definitions each ldg:partOf the other. A tree
# has no cycle, so a definition can never be its own ancestor through any
# chain of partOf edges. Refused by the no-cycle shape over ldg:partOf
# (LG-1, SHACL-SPARQL per ADR-A128, following a cycle through the property
# rather than one hop).

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/refusal-cycle/> .

ex:owner a fnd:PersistentIdentity .
ex:OwnerKind a owl:Class .

ex:units a qnt:ValueSpace ;
    qnt:spaceKey "ledger-refusal-cycle-units" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Discrete ; qnt:spaceHash "ledger-refusal-cycle-units-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:hasOperationCapability ex:units-sum .
ex:units-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:units .

ex:q-100 a qnt:Quantity ; qnt:onSpace ex:units ; qnt:numericValue "100"^^xsd:decimal .

ex:account-x a ldg:AccountDefinition ;
    ldg:statedAmount ex:q-100 ; ldg:unitOfAccount ex:units ;
    ldg:admitsOwnerKind ex:OwnerKind ; ldg:mergeRule ldg:Refuse ;
    ldg:partOf ex:account-y ;
    rdfs:comment "Refused. Part of account-y, which is part of this account." .

ex:account-y a ldg:AccountDefinition ;
    ldg:statedAmount ex:q-100 ; ldg:unitOfAccount ex:units ;
    ldg:admitsOwnerKind ex:OwnerKind ; ldg:mergeRule ldg:Refuse ;
    ldg:partOf ex:account-x ;
    rdfs:comment "Refused. Part of account-x, which is part of this account: a two-step cycle." .
