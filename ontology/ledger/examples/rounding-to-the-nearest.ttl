# SPDX-License-Identifier: MPL-2.0

# Premise. A pool of whole units is shared in proportion, each share rounded to
# the nearest, and the terms say how the difference is settled. A unit short goes
# to the share that was rounded down by the most. A unit over is taken from the
# share that was rounded up by the most. Ties fall to the order of notification.
#
# | Shared | Requests, in order of notification | Exact shares     | Rounded | Difference | Granted |
# |-------:|-------------------------------------|------------------|---------|-----------:|---------|
# |      1 | 1, 2, 2                             | 0.2, 0.4, 0.4    | 0, 0, 0 |    1 short | 0, 1, 0 |
# |      3 | 1, 1, 2                             | 0.75, 0.75, 1.5  | 1, 1, 2 |     1 over | 1, 1, 1 |
#
# Had the terms said the declared order alone, the first row would grant
# 1, 0, 0 and the second 0, 1, 2. Each grant is within one unit of its exact
# share either way, and the grants sum to what was shared.

@prefix ldg:  <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/ledger/rounding-to-the-nearest/> .
@base <https://example.org/lattice/ledger/rounding-to-the-nearest/> .

ex:OwnerKind a owl:Class .

ex:units a qnt:ValueSpace ;
    fnd:hasIdentity ex:units-identity ;
    qnt:spaceKey "ledger-rounding-to-the-nearest-units" ; qnt:orderKind qnt:TotalOrder ;
    qnt:densityKind qnt:Discrete ; qnt:granularityFloor ex:units-floor ; qnt:spaceHash "ledger-rounding-to-the-nearest-units-v1" ;
    qnt:additivity qnt:Extensive ;
    qnt:hasOperationCapability ex:units-sum , ex:units-difference .
ex:units-identity a fnd:PersistentIdentity .
ex:units-floor a qnt:Quantity ; qnt:onSpace ex:units ; qnt:numericValue "1"^^xsd:decimal .
ex:units-sum a qnt:OperationCapability ; qnt:operationKind qnt:Sum ; qnt:resultSpace ex:units .
ex:units-difference a qnt:OperationCapability ; qnt:operationKind qnt:Difference ; qnt:resultSpace ex:units .

# ==== The order the terms name =================================================

ex:order-of-notification a skos:Concept ;
    skos:inScheme ldg:OrderCriteria ;
    skos:prefLabel "the order in which requests were notified" .

# ==== The merge policies =======================================================

ex:nearest-and-settled a ldg:MergePolicy ;
    fnd:hasIdentity ex:nearest-and-settled-identity ;
    ldg:mergeRule ldg:Proportional ;
    ldg:roundingMethod ldg:HalfUp ;
    ldg:roundingDifference ldg:SettledToNearest ;
    ldg:residualAllocation ldg:LargestRemainder ;
    ldg:excessRecovery ldg:FromMostRoundedUp ;
    ldg:unitOrderCriterion ex:order-of-notification .

ex:nearest-and-settled-identity a fnd:PersistentIdentity ;
    rdfs:comment "The merge policy these terms state." .

ex:pool a ldg:AccountDefinition ;
    fnd:hasIdentity ex:pool-identity ;
    ldg:statedAmount <pool/stated-amount> ; ldg:unitOfAccount ex:units ;
    ldg:admitsOwnerKind ex:OwnerKind ; ldg:mergePolicy ex:nearest-and-settled ;
    rdfs:comment "100 whole units, shared in proportion where requests exceed what is available." .
<pool/stated-amount> a qnt:Quantity ; qnt:onSpace ex:units ; qnt:numericValue "100"^^xsd:decimal .
ex:pool-identity a fnd:PersistentIdentity .
