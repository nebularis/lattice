# SPDX-License-Identifier: MPL-2.0

@prefix dct: <http://purl.org/dc/terms/> .
@prefix fnd: <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix ldg: <https://www.nebularis.org/neuro-semantic/lattice/ledger#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qnt: <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix voc: <https://www.nebularis.org/neuro-semantic/lattice/vocabulary#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.nebularis.org/neuro-semantic/ledger-runtime> a owl:Ontology ;
    owl:versionIRI <https://www.nebularis.org/neuro-semantic/lattice/ledger-runtime/0.21.0> ;
    owl:imports <https://www.nebularis.org/neuro-semantic/lattice/ledger/0.21.0> ;
    dct:description """Ledger holds amounts that can be consumed and restored, such as a limit, commitment, seat quota, carbon budget, and so on. These are represented by an \"account\", configured by how much it holds when fresh, what unit it's held in, and the rule for arbitrating several claims on it at once. Accounts form a tree by \"part of and not in addition to\", so a single draw or credit can affect several accounts at once, along one stated path.

In order to keep a history of changes to an account, weigh several claims on it together, and let different implementations agree on a shared record, each draw or credit is recorded as a fact of its own: a claim against the account that leaves its stated amount untouched. A balance is always derived by folding an operation over those facts. Conservation then holds by construction, since no balance can disagree with the facts it is derived from. Recording a claim and applying it also become separate acts, so claims made together can be held unresolved and decided together by a stated merge rule.

Separate facts require two forms of ordering. A strict before and after ensures a balance can be read 'as of' a given point, and a mark of which facts belong together ensures they can be decided as one. Wall-clock time can supply neither (since clocks on different machines do not agree closely enough to order two claims), so an evaluator assigns the order deterministically, such that any two implementations given the same inputs will assign the same order.

Each fact carries a whole number placing it among the other facts on its account, called its position, and a second number for ordering facts that share a position, called its micro-position. The fact itself, containing one draw or credit with its account, owner, amount, direction and position, is referred to as a posting.

This one central law then, governs balances: each is a stated amount less what has been drawn, plus what has been restored, ensuring a balance is cheap to compute, but provable across properties checkable as a closed, mechanical law.

Since the effect of a posting is exactly the account plus every ancestor reached by following the ldg:partOf property upward, one fixed edge at a time, the set of accounts a draw touches is always fully enumerable (by walking one chain and checking each link), with no ambiguity about which balances a draw changes.

Avoiding storing a balance also ensures that a balance agrees with its posting history by construction, with no path by which someone might set a balance to a value the postings don't justify.

When disparate evaluations draw on the same account at the same position (being logically simultaneous, not \"whoever runs first\"), the model follows a fixed path, 'propose -> merge -> settle'.

- Propose - each evaluation states what it requires (e.g., a requested value)
- Merge - the account's own merge rule (priority order / proportionality / refusal) looks at the whole batch together and decides every grant in one pass, producing one merge record
- Settle - each evaluation then posts whatever it was actually granted

Because the merge step is a pure function of the complete set of proposals, the result can't depend on what order the evaluations happened to run in. No evaluation's outcome therefore, depends on the order in which the others ran, so they may run in parallel. Given exact arithmetic in the account's unit, the account's stated rounding and residual rules, and ties broken by an order defined on the data rather than on arrival, two conforming implementations reach the same grants in any execution order, and the same bytes once their records are written in canonical form. Conformance cases check this.

Ledger accounts do not hold observed values such as prices or temperatures, which are intensive and carry no such law.""" ;
    dct:creator <https://github.com/nebularis> .

dct:creator a owl:AnnotationProperty .

dct:description a owl:AnnotationProperty .

ldg:Account a owl:Class ;
    rdfs:comment "One account instance: an account definition held by one owner, for one key value and one period where the definition states them." ;
    fnd:utility "Mint one the first time a draw names its definition, owner, key and period, and name it from every posting, balance record, merge record and checkpoint on it. The four values stay its natural key, so an adopter holding them still resolves it. State the instance it is part of where its definition is part of another." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ldg:accountKey ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:forOwner ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:ofDefinition ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:partOfAccount ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:periodKey ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .

ldg:BalanceRecord a owl:Class ;
    rdfs:comment "An account's remaining balance and availability after one pass." ;
    fnd:utility "Materialise one per account a pass moved, and for its ancestors where a reader needs them. It is keyed by the account and the pass, so it reads along the recorded axis. A reading as of an effective position folds the postings instead (STD-278)." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ldg:availableValue ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:inPass ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:onAccount ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:remainingValue ; owl:cardinality "1"^^xsd:nonNegativeInteger ], fnd:DerivedArtefact .

ldg:Checkpoint a owl:Class ;
    rdfs:comment "An account's balance at a close, along the recorded axis." ;
    fnd:utility "Write one at each close of ldg:closingRecurrence for each account whose balance moved since its last checkpoint. It counts the postings of passes recorded by the close, whatever their effective positions, so a posting recorded later and effective earlier never disturbs it. Derive its IRI from the account and the close position." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ldg:balanceValue ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:closePosition ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:onAccount ; owl:cardinality "1"^^xsd:nonNegativeInteger ], fnd:DerivedArtefact .

ldg:Grant a owl:Class ;
    rdfs:comment "One proposal's request and what the merge granted it." ;
    fnd:utility "Part of its merge record, never a record of its own. A proportional merge's exact share is two whole numbers, a numerator and a denominator, since no store measured compares an owl:rational by value (section 9)." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ldg:forProposal ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:grantedValue ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:proportionDenominator ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:proportionNumerator ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:requestedValue ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ldg:MergeRecord a owl:Class ;
    rdfs:comment "The merge of the proposals at one account and one effective position." ;
    fnd:utility "Write one where proposals at one position draw on one account, holding one grant per proposal granted. Under ldg:Refuse an overdrawing merge holds no grant and states its reason. State the availability the merge was given, so its grants can be checked against it." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ldg:availableBefore ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:effectivePosition ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:inPass ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:onAccount ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:refusalReason ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ], fnd:DerivedArtefact .

ldg:Pass a owl:Class ;
    rdfs:comment "One evaluation's write of records, recorded at one position." ;
    fnd:utility "What an evaluation records about itself beyond its postings. Every posting, balance record, merge record and checkpoint names the pass that wrote it. A pass's position is on the effective axis, so the records it writes are effective no later than it (STD-294), and it is the recorded axis's order across accounts. A speculative pass is written to a graph that can be dropped, never flagged." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ldg:passPosition ; owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ldg:Posting a owl:Class ;
    rdfs:comment "One draw or credit on one account." ;
    fnd:utility "Write one per draw, on the account drawn, and one more on each account that counts the draw's purpose. An ancestor's balance is derived, never posted. Its read set is prov:wasDerivedFrom, which names the merge record and grant a merged draw came from." ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ldg:amountAsDrawn ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:amountValue ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:conversionUsed ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:direction ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:effectivePosition ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:forPurpose ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:inPass ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:microPosition ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:onAccount ; owl:cardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onProperty ldg:recordedPosition ; owl:cardinality "1"^^xsd:nonNegativeInteger ], fnd:DerivedArtefact .

ldg:accountKey a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The key value of an account instance, where its definition states a key dimension." ;
    rdfs:domain ldg:Account ;
    rdfs:range [ a owl:Class ; owl:unionOf ( skos:Concept qnt:Value ) ] .

ldg:amountAsDrawn a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The amount as drawn, in another value space than the account's (LG-Q8)." ;
    fnd:utility "State it with ldg:conversionUsed, both or neither." ;
    rdfs:domain ldg:Posting ;
    rdfs:range qnt:Quantity .

ldg:amountValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "A posting's amount, in its account's unit of account." ;
    rdfs:domain ldg:Posting ;
    rdfs:range xsd:decimal .

ldg:availableBefore a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "The availability a merge was given." ;
    rdfs:domain ldg:MergeRecord ;
    rdfs:range xsd:decimal .

ldg:availableValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "The least remaining balance along an account's path after a pass." ;
    rdfs:domain ldg:BalanceRecord ;
    rdfs:range xsd:decimal .

ldg:balanceValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "An account's balance at a checkpoint's close." ;
    rdfs:domain ldg:Checkpoint ;
    rdfs:range xsd:decimal .

ldg:closePosition a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "The position of the close a checkpoint was written at, on the axis of pass positions." ;
    rdfs:domain ldg:Checkpoint ;
    rdfs:range xsd:integer .

ldg:conversionUsed a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The conversion a draw in another value space used, with its rate's source and date (LG-Q8)." ;
    rdfs:domain ldg:Posting ;
    rdfs:range qnt:ConversionContext .

ldg:direction a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "Whether a posting debits or credits its account." ;
    rdfs:domain ldg:Posting ;
    rdfs:range skos:Concept .

ldg:effectivePosition a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Where a fact sits in the arrangement the accounts describe." ;
    fnd:utility "Supplied by the domain and comparable across accounts. Never later than the position of the pass that recorded the fact (STD-294)." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ldg:Posting ldg:MergeRecord ) ] ;
    rdfs:range xsd:integer .

ldg:forOwner a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The owner of an account instance." ;
    fnd:utility "Any persistent identity whose kind the definition admits, so the account outlives a new version of what owns it." ;
    rdfs:domain ldg:Account ;
    rdfs:range fnd:PersistentIdentity .

ldg:forProposal a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The evaluation that proposed a grant's draw." ;
    fnd:utility "Deliberately has no range: the layer above names its evaluations (LG-4)." ;
    rdfs:domain ldg:Grant .

ldg:forPurpose a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The purpose a draw names (LG-Q2)." ;
    rdfs:domain ldg:Posting ;
    rdfs:range skos:Concept .

ldg:grant a owl:ObjectProperty ;
    rdfs:comment "A grant a merge record holds." ;
    rdfs:domain ldg:MergeRecord ;
    rdfs:range ldg:Grant .

ldg:grantedValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "What the merge granted a proposal, in the account's unit, after rounding and residual." ;
    rdfs:domain ldg:Grant ;
    rdfs:range xsd:decimal .

ldg:inPass a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The pass that wrote a record." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ldg:Posting ldg:BalanceRecord ldg:MergeRecord ) ] ;
    rdfs:range ldg:Pass .

ldg:microPosition a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "The order of postings that share a recorded position on one account." ;
    fnd:utility "Assigned by the evaluator from an order defined on the data, never on arrival." ;
    rdfs:domain ldg:Posting ;
    rdfs:range xsd:integer .

ldg:ofDefinition a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The account definition an account instance holds." ;
    rdfs:domain ldg:Account ;
    rdfs:range ldg:AccountDefinition .

ldg:onAccount a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The account instance a record is about." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ldg:Posting ldg:BalanceRecord ldg:MergeRecord ldg:Checkpoint ) ] ;
    rdfs:range ldg:Account .

ldg:partOfAccount a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The account instance this one is part of, following its definition's ldg:partOf." ;
    fnd:utility "State it when the instance is derived: the parent definition's instance for the same owner, under the same period key. A fold over an account's subtree follows this edge." ;
    rdfs:domain ldg:Account ;
    rdfs:range ldg:Account .

ldg:passPosition a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "The position at which a pass was recorded, on the effective axis." ;
    rdfs:domain ldg:Pass ;
    rdfs:range xsd:integer .

ldg:periodKey a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "The period of an account instance, where its definition states a period recurrence." ;
    fnd:utility "The bin of the definition's ldg:periodRecurrence that the effective position of the draw which derived the account falls in. Computed at write, never supplied by a draw." ;
    rdfs:domain ldg:Account ;
    rdfs:range qnt:RecurrenceBin .

ldg:proportionDenominator a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "The denominator of a proportional grant's exact share, positive." ;
    rdfs:domain ldg:Grant ;
    rdfs:range xsd:integer .

ldg:proportionNumerator a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "The numerator of a proportional grant's exact share." ;
    fnd:utility "State it with ldg:proportionDenominator. The share is kept exact because other evaluations cite it, and the posting is rounded (LG-Q6)." ;
    rdfs:domain ldg:Grant ;
    rdfs:range xsd:integer .

ldg:recordedPosition a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "Where a posting sits in its own account's append-only sequence." ;
    fnd:utility "Assigned by the account's writer and increasing, so it is total within one account and compares nothing across accounts." ;
    rdfs:domain ldg:Posting ;
    rdfs:range xsd:integer .

ldg:refusalReason a owl:FunctionalProperty, owl:ObjectProperty ;
    rdfs:comment "Why a merge under ldg:Refuse granted nothing." ;
    rdfs:domain ldg:MergeRecord ;
    rdfs:range skos:Concept .

ldg:remainingValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "An account's remaining balance after a pass." ;
    rdfs:domain ldg:BalanceRecord ;
    rdfs:range xsd:decimal .

ldg:requestedValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:comment "What a proposal requested, in the account's unit." ;
    rdfs:domain ldg:Grant ;
    rdfs:range xsd:decimal .

[ a owl:AllDisjointClasses ; owl:members ( ldg:AccountDefinition ldg:Account ldg:Pass ldg:Posting ldg:BalanceRecord ldg:MergeRecord ldg:Grant ldg:Checkpoint ) ] .
