<https://www.nebularis.org/neuro-semantic/party-vocab> rdf:type owl:Ontology ;
                                                        owl:versionIRI <https://www.nebularis.org/neuro-semantic/lattice/party-vocab/0.8.0> ;
                                                        owl:imports <https://www.nebularis.org/neuro-semantic/lattice/party/0.8.0> .

#################################################################
#    Individuals
#################################################################

###  https://www.nebularis.org/neuro-semantic/lattice/party#Accountable
pty:Accountable rdf:type owl:NamedIndividual ,
                         pty:Role ;
                rdfs:comment "The role that remains answerable for an obligation's performance even when a different occupancy actually carries it out." ;
                rdfs:label "Accountable"@en ;
                fnd:utility "One side of the delegation split formalised by pty:Delegation. Accountability does not transfer to a Performing occupancy even when performance does." .


###  https://www.nebularis.org/neuro-semantic/lattice/party#EachForOwnShare
pty:EachForOwnShare rdf:type owl:NamedIndividual ,
                             pty:CompositionRule ;
                    rdfs:comment "A composition rule under which each member stands towards the other side for its own outward share only." ;
                    rdfs:label "Each for its own share"@en ;
                    fnd:utility "No member stands for another's shortfall. State each member's pty:outwardShare. A layer above may read it as several liability, a subscription line or any other several arrangement." .


###  https://www.nebularis.org/neuro-semantic/lattice/party#EachForWhole
pty:EachForWhole rdf:type owl:NamedIndividual ,
                          pty:CompositionRule ;
                 rdfs:comment "A composition rule under which each member stands towards the other side for the whole." ;
                 rdfs:label "Each for the whole"@en ;
                 fnd:utility "The other side may look to any member for all of it. How the members bear it among themselves is their pty:inwardShare, where stated. A layer above may read it as joint and several liability." .


###  https://www.nebularis.org/neuro-semantic/lattice/party#Guarantor
pty:Guarantor rdf:type owl:NamedIndividual ,
                       pty:Role ;
              rdfs:comment "The role of backing another occupancy's obligation, becoming answerable if that occupancy fails to perform." ;
              rdfs:label "Guarantor"@en ;
              fnd:utility "The role of backing another occupancy's obligation — becoming answerable if that occupancy fails to perform. Type a RoleOccupancy with this role for a party standing behind someone else's commitment." .


###  https://www.nebularis.org/neuro-semantic/lattice/party#Obligee
pty:Obligee rdf:type owl:NamedIndividual ,
                     pty:Role ;
            rdfs:comment "The role of being owed an obligation." ;
            rdfs:label "Obligee"@en ;
            fnd:utility "The direction-of-obligation counterpart to Obligor. Also the role a contingent occupancy — a third party with no relationship to an instrument until some event binds them in — is typed as, once occupiedBy is eventually set." .


###  https://www.nebularis.org/neuro-semantic/lattice/party#Obligor
pty:Obligor rdf:type owl:NamedIndividual ,
                     pty:Role ;
            rdfs:comment "The role of owing an obligation." ;
            rdfs:label "Obligor"@en ;
            fnd:utility "The role of owing an obligation. Type a RoleOccupancy with this role when it represents the party who owes something." .


###  https://www.nebularis.org/neuro-semantic/lattice/party#Performing
pty:Performing rdf:type owl:NamedIndividual ,
                        pty:Role ;
               rdfs:comment "The role that actually carries out an obligation's performance, discharging an Accountable occupancy's obligation without taking on its accountability." ;
               rdfs:label "Performing"@en ;
               fnd:utility "The other side of the delegation split. A pty:Delegation's delegatesTo always points at an occupancy in this role, whilst delegatesFrom always at one in the Accountable role." .


