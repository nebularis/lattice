        sh:select """
            PREFIX spc: <https://www.nebularis.org/neuro-semantic/lattice/spc#>
            SELECT $this ?other WHERE {
                $this spc:hasOptionParent ?parent ; spc:hasOptionLabel ?label .
                ?other spc:hasOptionParent ?parent ; spc:hasOptionLabel ?label .
                FILTER (?other != $this)
            }
        """
    ] .

