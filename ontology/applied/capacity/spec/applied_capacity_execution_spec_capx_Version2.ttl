# SPDX-License-Identifier: MPL-2.0

@prefix capx: <https://www.nebularis.org/neuro-semantic/lattice/applied/capacity/execution#> .
@prefix cap:  <https://www.nebularis.org/neuro-semantic/lattice/applied/capacity#> .
@prefix bhv:  <https://www.nebularis.org/neuro-semantic/lattice/behaviour#> .
@prefix qnt:  <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix elg:  <https://www.nebularis.org/neuro-semantic/lattice/eligibility#> .
@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

@base <https://www.nebularis.org/neuro-semantic/lattice/applied/capacity/execution> .

<https://www.nebularis.org/neuro-semantic/lattice/applied/capacity/execution>
  a owl:Ontology ;
  owl:versionIRI <https://www.nebularis.org/neuro-semantic/lattice/applied/capacity/execution/0.5.0> ;
  owl:imports
    <https://www.nebularis.org/neuro-semantic/lattice/foundation/0.3.0> ,
    <https://www.nebularis.org/neuro-semantic/lattice/quantification/0.4.0> ,
    <https://www.nebularis.org/neuro-semantic/lattice/eligibility/0.5.0> ,
    <https://www.nebularis.org/neuro-semantic/lattice/behaviour/0.5.0> ;
  rdfs:comment "Runtime projection profile for high-throughput capacity allocation. Source semantics remain in ontology/behaviour/quantification/capacity." .

#################################################################
# Core runtime classes
#################################################################

capx:ExecutableArrangement a owl:Class ;
  rdfs:subClassOf fnd:Version ;
  rdfs:comment "Runtime root for one projected capacity arrangement." .

capx:ExecutableResource a owl:Class ;
  rdfs:subClassOf fnd:Version ;
  rdfs:comment "Runtime-normalised finite resource row." .

capx:ExecutableBalance a owl:Class ;
  rdfs:subClassOf fnd:Evidenced ;
  rdfs:comment "Runtime balance state for one executable resource." .

capx:ExecutableDemand a owl:Class ;
  rdfs:subClassOf fnd:Evidenced ;
  rdfs:comment "Runtime demand record with canonical requested amount." .

capx:ExecutableDraw a owl:Class ;
  rdfs:subClassOf fnd:Evidenced ;
  rdfs:comment "Runtime allocation record for one demand-resource attempt." .

capx:ExecutableDependency a owl:Class ;
  rdfs:subClassOf fnd:Version ;
  rdfs:comment "Runtime dependency relation with explicit phase and precedence." .

capx:ExecutableGuardState a owl:Class ;
  rdfs:subClassOf fnd:Evidenced ;
  rdfs:comment "Pre-evaluated guard/admission snapshot consumed by runtime." .

#################################################################
# Runtime enums (mechanism intrinsic)
#################################################################

capx:DependencyKind a owl:Class .
capx:DependencyPhase a owl:Class .
capx:DrawStatus a owl:Class .

capx:DepletesTarget a capx:DependencyKind .
capx:BoundsTarget   a capx:DependencyKind .
capx:GatesTarget    a capx:DependencyKind .

capx:PreDrawPhase    a capx:DependencyPhase .
capx:ActivationPhase a capx:DependencyPhase .
capx:PostDrawPhase   a capx:DependencyPhase .

capx:Allocated         a capx:DrawStatus .
capx:PartiallyAllocated a capx:DrawStatus .
capx:Denied            a capx:DrawStatus .
capx:Unavailable       a capx:DrawStatus .
capx:Undetermined      a capx:DrawStatus .

#################################################################
# Object properties
#################################################################

capx:hasResource a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableArrangement ;
  rdfs:range capx:ExecutableResource .

capx:hasDependency a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableArrangement ;
  rdfs:range capx:ExecutableDependency .

capx:hasDemand a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableArrangement ;
  rdfs:range capx:ExecutableDemand .

capx:hasDraw a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableArrangement ;
  rdfs:range capx:ExecutableDraw .

capx:balanceRef a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableResource ;
  rdfs:range capx:ExecutableBalance .

capx:guardStateRef a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableResource ;
  rdfs:range capx:ExecutableGuardState .

capx:sourceResource a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDependency ;
  rdfs:range capx:ExecutableResource .

capx:targetResource a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDependency ;
  rdfs:range capx:ExecutableResource .

capx:forDemand a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range capx:ExecutableDemand .

capx:fromResource a owl:ObjectProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range capx:ExecutableResource .

capx:projectsFromResource a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableResource ;
  rdfs:range cap:CapacityResource .

capx:projectsFromDemand a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableDemand ;
  rdfs:range cap:CapacityDemand .

capx:projectsFromDependency a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableDependency ;
  rdfs:range cap:CapacityDependency .

capx:projectsFromDraw a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range cap:CapacityDraw .

capx:usesTransitionExecution a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range bhv:TransitionExecution .

capx:usesEffectApplication a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range bhv:EffectApplication .

capx:requiresEligibilityDecision a owl:ObjectProperty ;
  rdfs:domain capx:ExecutableGuardState ;
  rdfs:range elg:EligibilityDecision .

#################################################################
# Datatype properties
#################################################################

capx:arrangementKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableArrangement ;
  rdfs:range xsd:string .

capx:resourceKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableResource ;
  rdfs:range xsd:string .

capx:demandKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDemand ;
  rdfs:range xsd:string .

capx:drawKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range xsd:string .

capx:executionSpaceKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableResource ;
  rdfs:range xsd:string .

capx:demandSpaceKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDemand ;
  rdfs:range xsd:string .

capx:maxCapacityAmount a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableResource ;
  rdfs:range xsd:decimal .

capx:availableAmount a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableBalance ;
  rdfs:range xsd:decimal .

capx:requestedAmount a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDemand ;
  rdfs:range xsd:decimal .

capx:drawRequestedAmount a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range xsd:decimal .

capx:allocatedAmount a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range xsd:decimal .

capx:unmetAmount a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range xsd:decimal .

capx:priority a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableResource ;
  rdfs:range xsd:integer .

capx:dependencyPrecedence a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDependency ;
  rdfs:range xsd:integer .

capx:phaseOrder a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDependency ;
  rdfs:range xsd:integer .

capx:sequence a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDemand ;
  rdfs:range xsd:integer .

capx:executionOrder a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range xsd:integer .

capx:activeFlag a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableResource ;
  rdfs:range xsd:boolean .

capx:admittedFlag a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableGuardState ;
  rdfs:range xsd:boolean .

capx:activationFlag a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableGuardState ;
  rdfs:range xsd:boolean .

capx:enabledFlag a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDependency ;
  rdfs:range xsd:boolean .

capx:balanceVersion a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableBalance ;
  rdfs:range xsd:string .

capx:guardStateVersion a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableGuardState ;
  rdfs:range xsd:string .

capx:statusCode a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range xsd:string .

capx:resetProfileKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableResource ;
  rdfs:range xsd:string .

capx:lastUpdatedAt a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableBalance ;
  rdfs:range xsd:dateTime .

capx:evaluatedAt a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableGuardState ;
  rdfs:range xsd:dateTime .

capx:receivedAt a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDemand ;
  rdfs:range xsd:dateTime .

capx:executedAt a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain capx:ExecutableDraw ;
  rdfs:range xsd:dateTime .

#################################################################
# Embedded SHACL constraints
#################################################################

capx:ExecutableResourceShape a sh:NodeShape ;
  sh:targetClass capx:ExecutableResource ;
  sh:property [ sh:path capx:resourceKey ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:maxCapacityAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
  sh:property [ sh:path capx:executionSpaceKey ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:balanceRef ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:guardStateRef ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:priority ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path capx:activeFlag ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .

capx:ExecutableBalanceShape a sh:NodeShape ;
  sh:targetClass capx:ExecutableBalance ;
  sh:property [ sh:path capx:availableAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
  sh:property [ sh:path capx:balanceVersion ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:lastUpdatedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

capx:ExecutableDemandShape a sh:NodeShape ;
  sh:targetClass capx:ExecutableDemand ;
  sh:property [ sh:path capx:demandKey ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:requestedAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
  sh:property [ sh:path capx:demandSpaceKey ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:sequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path capx:receivedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

capx:ExecutableDependencyShape a sh:NodeShape ;
  sh:targetClass capx:ExecutableDependency ;
  sh:property [ sh:path capx:sourceResource ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:targetResource ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:dependencyPrecedence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path capx:phaseOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path capx:enabledFlag ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Dependency source and target must differ." ;
    sh:select """
      PREFIX capx: <https://www.nebularis.org/neuro-semantic/lattice/applied/capacity/execution#>
      SELECT $this WHERE {
        $this capx:sourceResource ?s ;
              capx:targetResource ?t .
        FILTER(?s = ?t)
      }
    """
  ] .

capx:ExecutableDrawShape a sh:NodeShape ;
  sh:targetClass capx:ExecutableDraw ;
  sh:property [ sh:path capx:drawKey ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:forDemand ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:fromResource ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:drawRequestedAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
  sh:property [ sh:path capx:allocatedAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
  sh:property [ sh:path capx:unmetAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
  sh:property [ sh:path capx:statusCode ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:executionOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path capx:executedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Allocated amount must not exceed requested amount." ;
    sh:select """
      PREFIX capx: <https://www.nebularis.org/neuro-semantic/lattice/applied/capacity/execution#>
      SELECT $this WHERE {
        $this capx:drawRequestedAmount ?rq ;
              capx:allocatedAmount ?al .
        FILTER(?al > ?rq)
      }
    """
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Draw conservation violated: requested != allocated + unmet." ;
    sh:select """
      PREFIX capx: <https://www.nebularis.org/neuro-semantic/lattice/applied/capacity/execution#>
      SELECT $this WHERE {
        $this capx:drawRequestedAmount ?rq ;
              capx:allocatedAmount ?al ;
              capx:unmetAmount ?um .
        FILTER((?al + ?um) != ?rq)
      }
    """
  ] .

capx:ExecutableGuardStateShape a sh:NodeShape ;
  sh:targetClass capx:ExecutableGuardState ;
  sh:property [ sh:path capx:admittedFlag ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path capx:activationFlag ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path capx:guardStateVersion ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path capx:evaluatedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

capx:DependencyPrecedenceUniquePerTargetPhase a sh:NodeShape ;
  sh:targetClass capx:ExecutableArrangement ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Duplicate dependency precedence for same target and phase." ;
    sh:select """
      PREFIX capx: <https://www.nebularis.org/neuro-semantic/lattice/applied/capacity/execution#>
      SELECT $this WHERE {
        $this capx:hasDependency ?d1, ?d2 .
        FILTER(?d1 != ?d2)
        ?d1 capx:targetResource ?t ;
            capx:phaseOrder ?ph ;
            capx:dependencyPrecedence ?p .
        ?d2 capx:targetResource ?t ;
            capx:phaseOrder ?ph ;
            capx:dependencyPrecedence ?p .
      }
    """
  ] .

capx:DemandSpaceMatchesResourceSpace a sh:NodeShape ;
  sh:targetClass capx:ExecutableDraw ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Demand and resource execution spaces must match for a draw." ;
    sh:select """
      PREFIX capx: <https://www.nebularis.org/neuro-semantic/lattice/applied/capacity/execution#>
      SELECT $this WHERE {
        $this capx:forDemand ?d ;
              capx:fromResource ?r .
        ?d capx:demandSpaceKey ?ds .
        ?r capx:executionSpaceKey ?rs .
        FILTER(?ds != ?rs)
      }
    """
  ] .