# SPDX-License-Identifier: MPL-2.0

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix bhv:  <https://www.nebularis.org/neuro-semantic/lattice/behaviour#> .

###############################################################################
# 8. CURRENCY AS A CONCEPT  [3.3.2 - additive]
#
# ctr:currency is an xsd:string. That is correct for interchange and wrong for reasoning.
# A literal cannot carry a broader relation, cannot be crosswalked, and cannot be the object
# of the FBO CurrencyFX dimension, which requires a skos:Concept. The projection functor was
# therefore binding a string into a concept-valued property and producing towers that failed
# validation on every monetary extent.
#
# The resolution keeps both. ctr:currency remains the mandatory lexical form; ctr:currencyConcept
# is the resolved node. The two are joined on skos:notation, never on the local name of the
# concept IRI, because local names are a naming convention and notations are a controlled key.
#
# The scheme is voc:CurrencyScheme in nsd-skos, not a CSO-local vocabulary. Currency is not a
# contract-structural term: the tower, exposure and claims strata all need the same concepts,
# and a fourth private copy is how the Territory and Valuation Basis duplications happened.
###############################################################################

# Divergence between the two forms is worse than the absence of either, because downstream
# consumers pick one and cannot detect that the other disagrees.
ctr:ExtentCurrencyAgreementShape
  a sh:NodeShape ;
  sh:targetClass ctr:MonetaryExtent ;
  rdfs:label "Monetary extent currency agreement"@en ;
  sh:property [
    sh:path ctr:currencyConcept ;
    sh:maxCount 1 ;
    sh:class skos:Concept ;
    sh:name "currency concept"@en ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "The resolved currency concept disagrees with the ISO 4217 string on this monetary extent. One of the two is wrong and downstream consumers cannot tell which."@en ;
    sh:prefixes [
      sh:declare [ sh:prefix "ctr" ; sh:namespace "https://www.nebularis.org/neuro-semantic/insurance/contract#" ] ;
      sh:declare [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#" ]
    ] ;
    sh:select """
      SELECT $this ?code ?concept WHERE {
        $this ctr:currency ?code ;
              ctr:currencyConcept ?concept .
        FILTER NOT EXISTS {
          ?concept skos:notation ?notation .
          FILTER (STR(?notation) = STR(?code))
        }
      }
    """ ;
  ] .
