# 15 concepts, sketch §5.3. Family default: typicalAgency Negligent and Accidental, onset Latent,
# definitionBasis Physical, accumulationClass Attritional, harmSubject Property, unless an
# override below says otherwise.

prl-voc:E a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ; skos:topConceptOf prl-voc:CauseScheme ;
    skos:notation "E"^^prl:ReferenceCode ;
    skos:prefLabel "Error, defect and deterioration"@en ;
    skos:definition "Harm arising from a defect, an error or the gradual deterioration of property, rather than from an external accidental event."@en ;
    skos:note "Separated from T because most property wordings treat defect and deterioration differently from a sudden accidental event, with ensuing-loss write-backs of their own."@en ;
    prl:typicalAgency prl-voc:Negligent , prl-voc:Accidental ; prl:onset prl-voc:Latent ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

