    prl:typicalAgency prl-voc:Negligent , prl-voc:Accidental ; prl:onset prl-voc:Latent ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:E.LAT a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.LAT"^^prl:ReferenceCode ;
    skos:prefLabel "Latent defect"@en ;
    skos:definition "A defect present at completion but not discoverable by reasonable inspection at the time."@en ;
    skos:note "Common construction and professional indemnity market usage."@en ;
    prl:broaderGeneric prl-voc:E ; skos:broader prl-voc:E ;
    prl:typicalAgency prl-voc:Negligent , prl-voc:Accidental ; prl:onset prl-voc:Latent ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:E.TST a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.TST"^^prl:ReferenceCode ;
    skos:prefLabel "Testing and commissioning failure"@en ;
    skos:definition "A failure that occurs during the testing or commissioning of a structure, system or installation before its ordinary operation begins."@en ;
    skos:note "Common construction and engineering market usage. Its onset is sudden: the failure manifests at a specific test or commissioning event, not gradually."@en ;
    prl:broaderGeneric prl-voc:E ; skos:broader prl-voc:E ;
    prl:typicalAgency prl-voc:Negligent , prl-voc:Accidental ; prl:onset prl-voc:Sudden ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:E.PRD a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.PRD"^^prl:ReferenceCode ;
    skos:prefLabel "Product defect"@en ;
    skos:definition "A defect in a manufactured product: a manufacturing flaw, contamination or mislabelling."@en ;
    skos:note "Common products liability market usage. Harms both property and persons, unlike the family default."@en ;
    prl:broaderGeneric prl-voc:E ; skos:broader prl-voc:E ;
    prl:typicalAgency prl-voc:Negligent , prl-voc:Accidental ; prl:onset prl-voc:Latent ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property , prl-voc:Persons .

prl-voc:E.HUM a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.HUM"^^prl:ReferenceCode ;
    skos:prefLabel "Human error"@en ;
    skos:definition "A mistake made by a person performing a task, with harm following at the time of the mistake."@en ;
    skos:note "Common casualty market usage. Its onset is sudden: the error's effect manifests at the time it is made, not gradually."@en ;
    prl:broaderGeneric prl-voc:E ; skos:broader prl-voc:E ;
    prl:typicalAgency prl-voc:Negligent , prl-voc:Accidental ; prl:onset prl-voc:Sudden ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:E.HUM.OPR a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.HUM.OPR"^^prl:ReferenceCode ;
    skos:prefLabel "Operator error"@en ;
    skos:definition "A mistake made by the person operating equipment or a process."@en ;
    skos:note "Common casualty market usage."@en ;
    prl:broaderGeneric prl-voc:E.HUM ; skos:broader prl-voc:E.HUM ;
    prl:typicalAgency prl-voc:Negligent , prl-voc:Accidental ; prl:onset prl-voc:Sudden ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:E.HUM.MNT a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.HUM.MNT"^^prl:ReferenceCode ;
    skos:prefLabel "Maintenance failure"@en ;
    skos:definition "A failure to carry out necessary maintenance, or maintenance carried out incorrectly."@en ;
    skos:note "Common engineering and casualty market usage."@en ;
    prl:broaderGeneric prl-voc:E.HUM ; skos:broader prl-voc:E.HUM ;
    prl:typicalAgency prl-voc:Negligent , prl-voc:Accidental ; prl:onset prl-voc:Sudden ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:E.PRO a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.PRO"^^prl:ReferenceCode ;
    skos:prefLabel "Professional error and omission"@en ;
    skos:definition "Negligent advice, calculation, administration or service by a professional, falling below the standard of care their profession requires."@en ;
    skos:note "Common professional indemnity market usage. What the standard of care requires is a matter the engagement and its wording define, so definition basis is wording-defined, and the harm is financial rather than physical."@en ;
    prl:broaderGeneric prl-voc:E ; skos:broader prl-voc:E ;
    prl:typicalAgency prl-voc:Negligent , prl-voc:Accidental ; prl:onset prl-voc:Latent ; prl:definitionBasis prl-voc:WordingDefined ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:FinancialInterest .

prl-voc:E.DET a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.DET"^^prl:ReferenceCode ;
    skos:prefLabel "Deterioration"@en ;
    skos:definition "The gradual decline of property's condition through a natural process, rather than through a defect or an accident."@en ;
    skos:note "Common property market usage. Its agency is natural and its onset gradual, unlike the rest of this family, since it is a natural process rather than an error."@en ;
    prl:broaderGeneric prl-voc:E ; skos:broader prl-voc:E ;
    prl:typicalAgency prl-voc:Natural ; prl:onset prl-voc:Gradual ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:E.DET.WNT a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.DET.WNT"^^prl:ReferenceCode ;
    skos:prefLabel "Wear and tear"@en ;
    skos:definition "The gradual decline of property's condition through ordinary use."@en ;
    skos:note "Common property market usage."@en ;
    prl:broaderGeneric prl-voc:E.DET ; skos:broader prl-voc:E.DET ;
    prl:typicalAgency prl-voc:Natural ; prl:onset prl-voc:Gradual ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:E.DET.COR a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.DET.COR"^^prl:ReferenceCode ;
    skos:prefLabel "Corrosion"@en ;
    skos:definition "The gradual chemical degradation of a material, typically a metal, through reaction with its environment."@en ;
    skos:note "Common property and engineering market usage."@en ;
    prl:broaderGeneric prl-voc:E.DET ; skos:broader prl-voc:E.DET ;
    prl:typicalMechanism prl-voc:Corrosion ;
    prl:typicalAgency prl-voc:Natural ; prl:onset prl-voc:Gradual ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:E.DET.INV a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "E.DET.INV"^^prl:ReferenceCode ;
    skos:prefLabel "Inherent vice"@en ;
    skos:definition "Property's own tendency to deteriorate or self-destruct from its own nature, without an external cause."@en ;
    skos:note "Common cargo and property market usage."@en ;
    prl:broaderGeneric prl-voc:E.DET ; skos:broader prl-voc:E.DET ;
    prl:typicalAgency prl-voc:Natural ; prl:onset prl-voc:Gradual ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

# 37 concepts, sketch §5.4. Family default: typicalAgency MaliciousCriminal, onset Sudden,
# definitionBasis Physical, accumulationClass Attritional, harmSubject Property, unless an
# override below says otherwise.

prl-voc:H a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ; skos:topConceptOf prl-voc:CauseScheme ;
    skos:notation "H"^^prl:ReferenceCode ;
    skos:prefLabel "Deliberate human act"@en ;
    skos:definition "An event a person brings about on purpose, with agency malicious criminal unless stated otherwise."@en ;
    skos:note "Common property and casualty market usage for this family."@en ;
    prl:typicalAgency prl-voc:MaliciousCriminal ; prl:onset prl-voc:Sudden ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:H.THF a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "H.THF"^^prl:ReferenceCode ;
    skos:prefLabel "Theft"@en ;
    skos:definition "The dishonest taking of property, with the intention of permanently depriving its owner of it."@en ;
    skos:note "Common property crime market usage."@en ;
    prl:broaderGeneric prl-voc:H ; skos:broader prl-voc:H ;
    prl:typicalMechanism prl-voc:Deprivation ;
    prl:typicalAgency prl-voc:MaliciousCriminal ; prl:onset prl-voc:Sudden ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

