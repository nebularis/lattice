    prl:typicalAgency prl-voc:Accidental ; prl:onset prl-voc:Sudden ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:T.REL.OIL a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "T.REL.OIL"^^prl:ReferenceCode ;
    skos:prefLabel "Oil spill"@en ;
    skos:definition "The accidental release of petroleum or a petroleum product."@en ;
    skos:note "Common environmental and marine market usage."@en ;
    prl:broaderGeneric prl-voc:T.REL ; skos:broader prl-voc:T.REL ;
    prl:typicalMechanism prl-voc:Contamination ;
    prl:typicalAgency prl-voc:Accidental ; prl:onset prl-voc:Sudden ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:T.REL.GLK a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "T.REL.GLK"^^prl:ReferenceCode ;
    skos:prefLabel "Gas leak"@en ;
    skos:definition "The accidental release of a flammable or toxic gas from its containment or piping."@en ;
    skos:note "Related to T.EXP.GAS, the explosion a leak can lead to."@en ;
