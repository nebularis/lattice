    prl:typicalMechanism prl-voc:Contamination ;
    prl:typicalAgency prl-voc:Accidental ; prl:onset prl-voc:Sudden ; prl:definitionBasis prl-voc:Physical ; prl:accumulationClass prl-voc:Attritional ; prl:harmSubject prl-voc:Property .

prl-voc:T.REL.RAD a skos:Concept ;
    skos:inScheme prl-voc:CauseScheme ;
    skos:notation "T.REL.RAD"^^prl:ReferenceCode ;
    skos:prefLabel "Accidental radiological release"@en ;
    skos:definition "The accidental release of radioactive material."@en ;
