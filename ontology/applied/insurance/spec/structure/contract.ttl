#-----------------------------------------------------------------------
# 4.14  PremiumFacet datatype properties  [REMEDIATION: CSO-015]
#-----------------------------------------------------------------------

ctr:premiumAmount
  a owl:DatatypeProperty ;
  rdfs:label "premium amount"@en ;
  rdfs:domain ctr:PremiumFacet ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Cardinality 0..1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:premiumCurrency
  a owl:DatatypeProperty ;
