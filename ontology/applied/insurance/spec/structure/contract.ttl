  rdfs:comment "Human-readable condition text paired with flowConditionType for typed condition semantics."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:flowPriority
  a owl:DatatypeProperty ;
  rdfs:label "flow priority"@en ;
  rdfs:domain ctr:FlowDirective ;
