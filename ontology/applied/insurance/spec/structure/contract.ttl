  rdfs:range xsd:string ;
  rdfs:comment "Legacy free-text flow condition retained for backward compatibility. Prefer flowConditionText + flowConditionType for new data."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:flowConditionText
