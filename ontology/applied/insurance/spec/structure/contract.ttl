  rdfs:range ctr:Question ;
  rdfs:comment "Min cardinality 1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:hasSubject
  a owl:ObjectProperty ;
  rdfs:label "has subject"@en ;
  rdfs:domain ctr:Question ;
  rdfs:range skos:Concept ;
  gov:constrainedToScheme ctr-voc:QuestionSubjectScheme ;
