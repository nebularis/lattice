  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range ctr:Quote ;
  rdfs:comment "The Quote linked to the tower layer for a provisional pre-bind CTB. Mutually exclusive with referencesContract by SHACL."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:relatesToLayer
  a owl:ObjectProperty ;
  rdfs:label "relates to layer"@en ;
  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range tow:Block ;
  rdfs:comment "The tower Block (layer) this CTB fulfils capacity for. Cardinality exactly 1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:participationRole
  a owl:ObjectProperty ;
  rdfs:label "participation role"@en ;
  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range skos:Concept ;
  rdfs:comment "SKOS concept from ParticipationRoleScheme: Leader, Follower, Independent. Cardinality exactly 1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:bindingStatus
  a owl:ObjectProperty ;
  rdfs:label "binding status"@en ;
  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range skos:Concept ;
  rdfs:comment "SKOS concept from BindingStatusScheme: Provisional, Bound, Endorsed, Amended, Expired, Withdrawn. Cardinality exactly 1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:uniformityType
  a owl:ObjectProperty ;
  rdfs:label "uniformity type"@en ;
  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range skos:Concept ;
  rdfs:comment "SKOS concept from UniformityTypeScheme: UniformSubscription, PanelVertical, CoInsurance, MasterMultiLayer, Mixed. Cardinality exactly 1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:contractSpan
  a owl:ObjectProperty ;
  rdfs:label "contract span"@en ;
  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range tow:CoverageSpan ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:hasFulfilmentBinding
  a owl:ObjectProperty ;
