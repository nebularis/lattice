  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:tierPayoutCap
  a owl:DatatypeProperty ;
  rdfs:label "tier payout cap"@en ;
  rdfs:domain ctr:TriggerTier ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Maximum payout for this tier. Cardinality 0..1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:tierSequence
  a owl:DatatypeProperty ;
  rdfs:label "tier sequence"@en ;
  rdfs:domain ctr:TriggerTier ;
