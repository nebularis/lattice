#-----------------------------------------------------------------------

ctr:referencesContract
  a owl:ObjectProperty ;
  rdfs:label "references contract"@en ;
  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range ctr:Contract ;
  rdfs:comment "The Contract being bound to the tower layer. Cardinality exactly 1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:referencesQuote
