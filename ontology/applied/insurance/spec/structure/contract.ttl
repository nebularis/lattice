  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range tow:LayerFulfilmentBinding ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:termDeltaRefs
  a owl:ObjectProperty ;
  rdfs:label "term delta refs"@en ;
  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range core:Fact ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:evidenceRef
  a owl:ObjectProperty ;
  rdfs:label "evidence ref"@en ;
  rdfs:domain ctr:ContractTowerBinding ;
  rdfs:range core:Fact ;
  rdfs:comment "QuoteFacts, CapacityCommitmentFacts, SigningFacts."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

