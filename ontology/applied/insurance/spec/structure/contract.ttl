#-----------------------------------------------------------------------
# 4.3  MonetaryExtent  [REMEDIATION: CSO-011]
#-----------------------------------------------------------------------

ctr:amount
  a owl:DatatypeProperty ;
  rdfs:label "amount"@en ;
  rdfs:domain ctr:MonetaryExtent ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Cardinality exactly 1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:currency
  a owl:DatatypeProperty ;
  rdfs:label "currency"@en ;
  rdfs:domain ctr:MonetaryExtent ;
  rdfs:range xsd:string ;
  rdfs:comment """ISO 4217 currency code (exactly 3 characters). Cardinality exactly 1.

This is the lexical form and remains mandatory for interchange. It is not resolvable without an
external table, so anything that reasons over currency — FX aggregation, cross-currency tower
summation, the FBO CurrencyFX dimension — should use ctr:currencyConcept (Section 8), which
carries the same code as skos:notation and is a first-class graph node."""@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

