#-----------------------------------------------------------------------
# 4.8  ReinstatementFacet datatype properties  [REMEDIATION: CSO-001]
#-----------------------------------------------------------------------

ctr:reinstatementCount
  a owl:DatatypeProperty ;
  rdfs:label "reinstatement count"@en ;
  rdfs:domain ctr:ReinstatementFacet ;
  rdfs:range xsd:integer ;
  rdfs:comment "Number of reinstatements available. Maps to FBO TankStateRecord R : ReinstatementId → N. Cardinality exactly 1. Must be ≥ 0."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:reinstatementPercentage
  a owl:DatatypeProperty ;
  rdfs:label "reinstatement percentage"@en ;
  rdfs:domain ctr:ReinstatementFacet ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Percentage of original premium charged per reinstatement. Cardinality exactly 1. Must be ≥ 0.0."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:reinstatementProRataTime
  a owl:DatatypeProperty ;
  rdfs:label "reinstatement pro rata time"@en ;
  rdfs:domain ctr:ReinstatementFacet ;
  rdfs:range xsd:boolean ;
  rdfs:comment """Whether the reinstatement premium is pro-rated as to the
remaining policy period at the time of reinstatement. When true, the premium
charged = reinstatementPercentage × originalPremium × (remainingDays /
totalPolicyDays). When false, no time adjustment applies. Independent of
ctr:reinstatementProRataAmount — both may be true simultaneously, in which
case the two adjustments apply multiplicatively.

Cardinality: exactly 1."""@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:reinstatementProRataAmount
  a owl:DatatypeProperty ;
  rdfs:label "reinstatement pro rata amount"@en ;
  rdfs:domain ctr:ReinstatementFacet ;
  rdfs:range xsd:boolean ;
  rdfs:comment """Whether the reinstatement premium is pro-rated as to the
fraction of the limit consumed by the loss that triggered the reinstatement.
When true, the premium charged = reinstatementPercentage × originalPremium ×
(lossAmount / limitAmount). When false, no amount adjustment applies —
the full reinstatement premium is charged regardless of whether the loss
partially or fully exhausted the limit.

Independent of ctr:reinstatementProRataTime — both may be true simultaneously,
in which case the two adjustments apply multiplicatively:
  RP = reinstatementPercentage × originalPremium × timeRatio × amountRatio

Common drafting: London Market XL treaties routinely distinguish between
'pro-rata as to time and amount', 'pro-rata as to time only', and
'100% flat' reinstatement premium structures.

Projection: This flag initialises the FBO reinstatementState.proRataAmount
field in TankStateRecord. Without it, the projection functor cannot correctly
compute reinstatement premiums for partially-exhausting losses.

Cardinality: exactly 1."""@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:reinstatementAutomatic
  a owl:DatatypeProperty ;
  rdfs:label "reinstatement automatic"@en ;
  rdfs:domain ctr:ReinstatementFacet ;
  rdfs:range xsd:boolean ;
  rdfs:comment "Whether reinstatements are automatic (true) or optional/insured-election (false). Cardinality exactly 1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

#-----------------------------------------------------------------------
# 4.9  AggregationFacet datatype properties  [REMEDIATION: CSO-002, CSO-003]
#-----------------------------------------------------------------------

ctr:aggregateDeductibleAmount
  a owl:DatatypeProperty ;
  rdfs:label "aggregate deductible amount"@en ;
  rdfs:domain ctr:AggregationFacet ;
  rdfs:range xsd:decimal ;
  rdfs:comment "Annual Aggregate Deductible (AAD) threshold before cover responds. Cardinality 0..1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:aggregateDeductibleCurrency
  a owl:DatatypeProperty ;
  rdfs:label "aggregate deductible currency"@en ;
  rdfs:domain ctr:AggregationFacet ;
  rdfs:range xsd:string ;
  rdfs:comment "ISO 4217 currency code for the AAD amount. Cardinality 0..1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:hoursClauseDuration
  a owl:DatatypeProperty ;
  rdfs:label "hours clause duration"@en ;
  rdfs:domain ctr:AggregationFacet ;
  rdfs:range xsd:dayTimeDuration ;
  rdfs:comment "Duration of the hours clause temporal window in ISO 8601 dayTimeDuration. When present, hoursClauseNonOverlap must also be present."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:hoursClauseNonOverlap
  a owl:DatatypeProperty ;
  rdfs:label "hours clause non-overlap"@en ;
  rdfs:domain ctr:AggregationFacet ;
  rdfs:range xsd:boolean ;
  rdfs:comment "Whether hours clause windows must not overlap. Required when hoursClauseDuration is present."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:maxWindows
  a owl:DatatypeProperty ;
  rdfs:label "max windows"@en ;
  rdfs:domain ctr:AggregationFacet ;
  rdfs:range xsd:integer ;
  rdfs:comment "Maximum number of hours-clause windows available within the applicable aggregation period. Required when hoursClauseDuration is present."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

#-----------------------------------------------------------------------
# 4.10  TriggerFacet datatype properties  [REMEDIATION: CSO-004]
#-----------------------------------------------------------------------

ctr:triggerThreshold
  a owl:DatatypeProperty ;
  rdfs:label "trigger threshold"@en ;
  rdfs:domain ctr:TriggerFacet ;
  rdfs:range xsd:decimal ;
  rdfs:comment "The threshold value at which the trigger fires."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:triggerIndex
  a owl:DatatypeProperty ;
  rdfs:label "trigger index"@en ;
  rdfs:domain ctr:TriggerFacet ;
  rdfs:range xsd:string ;
  rdfs:comment "The name or identifier of the triggering index or oracle."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:triggerSource
  a owl:DatatypeProperty ;
  rdfs:label "trigger source"@en ;
  rdfs:domain ctr:TriggerFacet ;
  rdfs:range xsd:string ;
  rdfs:comment "The oracle or data source providing trigger readings."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:payoutStructure
  a owl:ObjectProperty ;
  rdfs:label "payout structure"@en ;
  rdfs:domain ctr:TriggerFacet ;
  rdfs:range skos:Concept ;
  rdfs:comment """SKOS concept from PayoutStructureScheme indicating the functional
form of the trigger payout:
  Binary    — full limit paid if trigger fires, zero otherwise
  Linear    — payout scales linearly between linearFloorThreshold and
              linearCeilingThreshold; requires both properties to be present
  Graduated — payout follows a step table defined by TriggerTier instances;
              requires at least one TriggerTier to be present

Replaces the prior ctr:triggerGraduated boolean, which could not distinguish
Binary from Linear (both mapped to false/true respectively, conflating two
structurally distinct contractual provisions).

Projection:
  Binary    → FBO step-function TriggerGate (→^tg) with threshold = triggerThreshold
  Linear    → FBO linear interpolation FlowAction with floor/ceiling parameters
  Graduated → FBO lookup-table payout using TriggerTier instances"""@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:linearFloorThreshold
  a owl:DatatypeProperty ;
  rdfs:label "linear floor threshold"@en ;
  rdfs:domain ctr:TriggerFacet ;
  rdfs:range xsd:decimal ;
  rdfs:comment """The trigger index value at which payout begins (0% of limit).
Below this value the trigger produces no payout. Required when
ctr:payoutStructure = Linear. At this value payout = 0.0.
Above ctr:linearCeilingThreshold payout = full limit."""@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:linearCeilingThreshold
  a owl:DatatypeProperty ;
  rdfs:label "linear ceiling threshold"@en ;
  rdfs:domain ctr:TriggerFacet ;
  rdfs:range xsd:decimal ;
  rdfs:comment """The trigger index value at which payout reaches 100% of limit.
Required when ctr:payoutStructure = Linear. Must be strictly greater than
ctr:linearFloorThreshold. Between floor and ceiling, payout interpolates
linearly: payoutPct = (observed - floor) / (ceiling - floor)."""@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

ctr:cooldownPeriod
  a owl:DatatypeProperty ;
  rdfs:label "cooldown period"@en ;
  rdfs:domain ctr:TriggerFacet ;
  rdfs:range xsd:dayTimeDuration ;
  rdfs:comment "Minimum interval between successive trigger activations. Cardinality 0..1."@en ;
  rdfs:isDefinedBy <https://www.nebularis.org/neuro-semantic/insurance/contract> .

#-----------------------------------------------------------------------
# 4.11  TriggerTier datatype properties  [REMEDIATION: CSO-004]
