# SPDX-License-Identifier: MPL-2.0

# Premise. A protocol is drafted once from a sponsor's template and filled in
# per trial. Some values are shown in the text, others decide which parts of
# the text apply, and the text relies on documents outside it.
#
# A clinical trial protocol has a schedule of assessments and a section on
# visits. Clause 6.2 reads
#
#   Each follow-up visit takes place within {visit window} of its scheduled date.
#
# The visit window is shown in the text and must fall between 1 and 14 days.
# The number of study arms is a governing value: it is never shown, and later
# decides whether the arm-comparison section is included (assembly, slice C4). Clause 6.3 refers to an external regulation on
# reporting.
#
# What the example shows:
#
# | Construct                                   | Where                       |
# |---------------------------------------------|-----------------------------|
# | a schedule as an element type               | ex:schedule-1               |
# | an embedded variable with admissible values | ex:var-visit-window         |
# | a governing variable, never shown in text   | ex:gv-study-arms            |
# | a reference to an external document         | ex:cl-6-3 → ex:gcp-regulation |
# | a classification beside the element type    | ex:cl-6-3                   |
# | a table: rows in the form, columns per trial | ex:soa                     |
# | an assembled protocol for one trial          | ex:protocol-trial-7         |
#
# The schedule of assessments fixes its rows (screening, week 4, week 12) in the
# sponsor's template. The columns are the study arms, which exist only once a
# trial is set up: trial 7 has two. Each cell is the value of a row's variable
# for one arm, here the blood sample volume in millilitres.

@prefix wrd:     <https://www.nebularis.org/neuro-semantic/lattice/wording#> .
@prefix wrd-voc: <https://www.nebularis.org/neuro-semantic/lattice/wording/vocab#> .
@prefix fnd:     <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix voc:     <https://www.nebularis.org/neuro-semantic/lattice/vocabulary#> .
@prefix qnt:     <https://www.nebularis.org/neuro-semantic/lattice/quantification#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:      <https://example.org/lattice/wording/trial/> .

ex:protocol-wording a wrd:Wording ;
    fnd:hasIdentity ex:protocol-wording-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:directlyComprises ex:schedule-1 , ex:sec-6 , ex:gv-study-arms .

# ---- Schedule 1: assessments (rows and columns are slice C4's tables) ------

ex:schedule-1 a wrd:Element ;
    fnd:hasIdentity ex:schedule-1-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Schedule ;
    wrd:objectId "Schedule 1" ;
    wrd:rankKey "a0" ;
    wrd:directlyComprises ex:schedule-1-intro , ex:soa .

ex:schedule-1-intro a wrd:Text ;
    fnd:hasIdentity ex:schedule-1-intro-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ;
    wrd:objectId "S1.1" ;
    wrd:rankKey "a0" ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ; wrd:partText "Assessments are made at each visit listed below." ] .

# ---- Section 6: visits -----------------------------------------------------

ex:sec-6 a wrd:Element ;
    fnd:hasIdentity ex:sec-6-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Section ;
    wrd:objectId "6" ;
    wrd:rankKey "f0" ;
    wrd:directlyComprises ex:cl-6-2 , ex:cl-6-3 , ex:var-visit-window .

ex:cl-6-2 a wrd:Text ;
    fnd:hasIdentity ex:cl-6-2-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ;
    wrd:objectId "6.2" ;
    wrd:rankKey "b0" ;
    wrd:hasTextPart ex:cl-6-2-p0 , ex:cl-6-2-p1 , ex:cl-6-2-p2 .

ex:cl-6-2-p0 a wrd:TextPart ; wrd:partIndex 0 ; wrd:partText "Each follow-up visit takes place within " .
ex:cl-6-2-p1 a wrd:TextPart ; wrd:partIndex 1 ; wrd:refersToVariable ex:var-visit-window .
ex:cl-6-2-p2 a wrd:TextPart ; wrd:partIndex 2 ; wrd:partText " of its scheduled date." .

ex:var-visit-window a wrd:EmbeddedVariable ;
    fnd:hasIdentity ex:var-visit-window-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:variableKey "visit-window" ;
    wrd:rankKey "z0" ;
    wrd:valueSpace ex:days-space ;
    wrd:admissibleValues ex:one-to-fourteen-days ;
    wrd:multiValued false .

ex:days-space a qnt:ValueSpace .
# The bounds (1 and 14 days, both closed) are Quantification's concern.
ex:one-to-fourteen-days a qnt:RangeSet ; qnt:onSpace ex:days-space .

ex:gv-study-arms a wrd:GoverningVariable ;
    fnd:hasIdentity ex:gv-study-arms-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:variableKey "study-arms" ;
    wrd:rankKey "z0" ;
    wrd:valueSpace ex:count-space ;
    wrd:multiValued false .

ex:count-space a qnt:ValueSpace .

ex:cl-6-3 a wrd:Text ;
    fnd:hasIdentity ex:cl-6-3-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ;
    wrd:classification ex:safety-reporting ;
    wrd:objectId "6.3" ;
    wrd:rankKey "c0" ;
    wrd:hasTextPart ex:cl-6-3-p0 , ex:cl-6-3-p1 .

ex:cl-6-3-p0 a wrd:TextPart ; wrd:partIndex 0 ; wrd:partText "Adverse events are reported as required by " .
ex:cl-6-3-p1 a wrd:TextPart ; wrd:partIndex 1 ; wrd:refersToObject ex:gcp-regulation .

ex:gcp-regulation a wrd:ExternalDocument .

# A sponsor's own clause classification, bound to Wording's classification contract.
ex:sponsor-classes a voc:ConceptScheme ;
    fnd:hasIdentity ex:sponsor-classes-identity ;
    fnd:hasGovernanceState fnd:Active ;
    skos:prefLabel "Sponsor clause classes"@en .

ex:safety-reporting a skos:Concept ;
    skos:prefLabel "Safety reporting"@en ;
    skos:inScheme ex:sponsor-classes .

# ---- Schedule 1's table: rows declared here, columns supplied per trial ----

ex:soa a wrd:Table ;
    fnd:hasIdentity ex:soa-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:objectId "Table S1" ;
    wrd:rankKey "b0" ;
    wrd:directlyComprises ex:row-screening , ex:row-week-4 , ex:row-week-12 .

ex:row-screening a wrd:Row ;
    fnd:hasIdentity ex:row-screening-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:rankKey "a0" ; wrd:rowKey "Screening sample volume (ml)" ;
    wrd:rowVariable ex:var-screening ; wrd:directlyComprises ex:var-screening .
ex:row-week-4 a wrd:Row ;
    fnd:hasIdentity ex:row-week-4-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:rankKey "b0" ; wrd:rowKey "Week 4 sample volume (ml)" ;
    wrd:rowVariable ex:var-week-4 ; wrd:directlyComprises ex:var-week-4 .
ex:row-week-12 a wrd:Row ;
    fnd:hasIdentity ex:row-week-12-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:rankKey "c0" ; wrd:rowKey "Week 12 sample volume (ml)" ;
    wrd:rowVariable ex:var-week-12 ; wrd:directlyComprises ex:var-week-12 .

ex:var-screening a wrd:EmbeddedVariable ;
    fnd:hasIdentity ex:var-screening-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:variableKey "soa-screening" ; wrd:valueSpace ex:millilitre-space ; wrd:populationMethod wrd-voc:FreeEntry .
ex:var-week-4 a wrd:EmbeddedVariable ;
    fnd:hasIdentity ex:var-week-4-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:variableKey "soa-week-4" ; wrd:valueSpace ex:millilitre-space ; wrd:populationMethod wrd-voc:FreeEntry .
ex:var-week-12 a wrd:EmbeddedVariable ;
    fnd:hasIdentity ex:var-week-12-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:variableKey "soa-week-12" ; wrd:valueSpace ex:millilitre-space ; wrd:populationMethod wrd-voc:FreeEntry .

ex:millilitre-space a qnt:ValueSpace .

# ---- Trial 7: the protocol assembled for one trial, with two arms ---------

ex:arm-a a ex:StudyArm .
ex:arm-b a ex:StudyArm .

ex:protocol-trial-7 a wrd:AssembledWording ;
    fnd:hasIdentity ex:protocol-trial-7-identity ;
    fnd:hasGovernanceState fnd:Active ;
    wrd:assembledFrom ex:protocol-wording ;
    wrd:includes ex:schedule-1 , ex:schedule-1-intro , ex:soa , ex:row-screening , ex:row-week-4 , ex:row-week-12 ,
        ex:sec-6 , ex:cl-6-2 , ex:cl-6-3 ;
    wrd:hasValue ex:v-screening-a , ex:v-screening-b , ex:v-week-4-a , ex:v-week-4-b , ex:v-week-12-a , ex:v-week-12-b ,
        ex:v-visit-window , ex:v-study-arms .

ex:v-screening-a a wrd:VariableValue ; wrd:forVariable ex:var-screening ; wrd:forColumn ex:arm-a ; wrd:literalValue "20"^^xsd:decimal .
ex:v-screening-b a wrd:VariableValue ; wrd:forVariable ex:var-screening ; wrd:forColumn ex:arm-b ; wrd:literalValue "20"^^xsd:decimal .
ex:v-week-4-a    a wrd:VariableValue ; wrd:forVariable ex:var-week-4    ; wrd:forColumn ex:arm-a ; wrd:literalValue "10"^^xsd:decimal .
ex:v-week-4-b    a wrd:VariableValue ; wrd:forVariable ex:var-week-4    ; wrd:forColumn ex:arm-b ; wrd:literalValue "15"^^xsd:decimal .
ex:v-week-12-a   a wrd:VariableValue ; wrd:forVariable ex:var-week-12   ; wrd:forColumn ex:arm-a ; wrd:literalValue "10"^^xsd:decimal .
ex:v-week-12-b   a wrd:VariableValue ; wrd:forVariable ex:var-week-12   ; wrd:forColumn ex:arm-b ; wrd:literalValue "15"^^xsd:decimal .

ex:v-visit-window a wrd:VariableValue ; wrd:forVariable ex:var-visit-window ; wrd:literalValue "7"^^xsd:decimal .
ex:v-study-arms   a wrd:VariableValue ; wrd:forVariable ex:gv-study-arms ; wrd:literalValue "2"^^xsd:decimal .
