# SPDX-License-Identifier: MPL-2.0

# Premise. A commercial property policy covers loss at one unit of a business
# park. Mid-term, the insured takes a second unit and asks for it to be added.
# The insurer agrees by endorsement, a mid-term adjustment (MTA), effective
# from the date the insured asked for, which is before the insurer agreed. A
# loss at the new unit falls in between. Was the endorsement in force on the
# date of the loss?
#
# How an MTA works, as this example models it:
#
# - The insured asks for the change, here by a signed request that is also its
#   assent to the amended policy. The broker records it.
# - The insurer's underwriter agrees, and an endorsement document states the
#   change. Insurers commonly agree an MTA from the date the insured asked for,
#   even if that is before their agreement, and charge an additional premium
#   for the rest of the period. The premium is outside this example.
# - The endorsement amends the policy: here it replaces the insuring clause
#   with one naming both units. The policy's second version is in force from
#   the endorsement's effective date, once both parties have assented.
#
# The facts, by the date each is true and the date each became known:
#
# | Fact                                         | Valid       | Recorded    |
# |----------------------------------------------|-------------|-------------|
# | policy v1 in force, Unit 7                   | 1 Jan 2028  | 1 Jan 2028  |
# | insured asks to add Unit 9 from 1 March      | 20 Feb      | 20 Feb      |
# | loss A at Unit 9                             | 25 Feb      | 26 Feb      |
# | the endorsement takes effect                 | 1 Mar       |             |
# | loss B at Unit 9                             | 5 Mar       | 6 Mar       |
# | the insurer agrees: the endorsement is agreed| 10 Mar      | 10 Mar      |
# | loss C at Unit 9                             | 20 Mar      | 21 Mar      |
#
# Which version decides each loss, and so whether Unit 9 is covered:
#
# | Loss | On its date, as known when notified | On its date, as known from 10 Mar |
# |------|-------------------------------------|-----------------------------------|
# | A, 25 Feb | v1, not covered: the endorsement is not yet effective | v1, not covered |
# | B, 5 Mar  | v1, not covered: the endorsement is not yet agreed     | v2, covered: agreed later, effective earlier |
# | C, 20 Mar | v2, covered                                            | v2, covered |
#
# Loss B is the case insurers guard against. An underwriter agreeing an MTA
# with an earlier effective date usually asks the insured to declare that no
# loss has occurred since then. If the insured knew of loss B and did not say,
# the insurer may have a remedy for non-disclosure, which is outside this
# example. Without that, the endorsement covers loss B, and the answer to "was
# it covered?" depends on when it is asked. That is why each fact keeps both
# its valid time and its recording time (C9-Q2).
#
# What the example shows:
#
# | Construct                                           | Where                                |
# |-----------------------------------------------------|--------------------------------------|
# | an endorsement replacing a clause                   | ex:replace-2-1, Wording's Replace    |
# | the amendment it states, from v1 to v2              | ex:mta-1, ins:statedIn               |
# | effective before it is agreed                       | ex:mta-1's scope, the assents' times |
# | each party's assent, the insured's first            | ex:assent-insured, ex:assent-insurer |
# | the insuring clause's meaning in each version       | the bound obligations below          |

@prefix ins:     <https://www.nebularis.org/neuro-semantic/lattice/instrument#> .
@prefix ins-voc: <https://www.nebularis.org/neuro-semantic/lattice/instrument/vocab#> .
@prefix wrd:     <https://www.nebularis.org/neuro-semantic/lattice/wording#> .
@prefix wrd-voc: <https://www.nebularis.org/neuro-semantic/lattice/wording/vocab#> .
@prefix elg:     <https://www.nebularis.org/neuro-semantic/lattice/eligibility#> .
@prefix fnd:     <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix pty:     <https://www.nebularis.org/neuro-semantic/lattice/party#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:      <https://example.org/lattice/instrument/property-endorsement/> .

# ==== The policy's wording, written for this insured ==========================

ex:sec-2 a wrd:Element ;
    fnd:hasIdentity ex:sec-2-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Section ; wrd:objectId "2" ; wrd:rankKey "b0" ;
    wrd:directlyComprises ex:cl-2-1-v1 .
ex:cl-2-1-v1 a wrd:Text ;
    fnd:hasIdentity ex:cl-2-1-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "2.1" ; wrd:rankKey "a0" ;
    wrd:inclusionMode wrd-voc:Mandatory ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText "The Insurer shall indemnify the Insured for physical loss of or damage to Property at Unit 7, Riverside Park." ] .

ex:wording-v1 a wrd:AssembledWording ;
    fnd:hasIdentity ex:wording-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:directlyComprises ex:sec-2 ;
    wrd:includes ex:sec-2 , ex:cl-2-1-v1 .

# ==== The endorsement =========================================================

ex:endorsement-1 a wrd:Wording ;
    fnd:hasIdentity ex:endorsement-1-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Endorsement ;
    wrd:directlyComprises ex:endorsement-1-para-1 .
ex:endorsement-1-para-1 a wrd:Text ;
    fnd:hasIdentity ex:endorsement-1-para-1-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:objectId "1" ; wrd:rankKey "a0" ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText "With effect from 1 March 2028, clause 2.1 is replaced with the following." ] .

ex:cl-2-1-v2 a wrd:Text ;
    fnd:hasIdentity ex:cl-2-1-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:elementType wrd-voc:Clause ; wrd:objectId "2.1" ;
    prov:wasRevisionOf ex:cl-2-1-v1 ;
    wrd:hasTextPart [ a wrd:TextPart ; wrd:partIndex 0 ;
        wrd:partText "The Insurer shall indemnify the Insured for physical loss of or damage to Property at Unit 7 or Unit 9, Riverside Park." ] .

ex:replace-2-1 a wrd:Amendment ;
    wrd:operation wrd-voc:Replace ;
    wrd:amendsElement ex:cl-2-1-v1 ;
    wrd:replacement ex:cl-2-1-v2 ;
    wrd:expressedIn ex:endorsement-1-para-1 .

ex:wording-v2 a wrd:AssembledWording ;
    fnd:hasIdentity ex:wording-identity ; fnd:hasGovernanceState fnd:Active ;
    wrd:directlyComprises ex:sec-2 , ex:cl-2-1-v2 ;
    wrd:includes ex:sec-2 , ex:cl-2-1-v2 .
ex:wording-v1 fnd:supersededBy ex:wording-v2 .

# ==== Roles, places and the cover's scope =====================================

ex:Insurer a pty:Role ; rdfs:label "Insurer" .
ex:Insured a pty:Role ; rdfs:label "Insured" .

ex:unit-7 a skos:Concept ; rdfs:label "Unit 7, Riverside Park" .
ex:unit-9 a skos:Concept ; rdfs:label "Unit 9, Riverside Park" .

ex:at-unit-7 a elg:Condition ;
    elg:conditionKey "loss-at-unit-7" ;
    elg:matchStrategy elg:ExactMatch ;
    elg:compatibilityOperation elg:AllRequired ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:unit-7 .

ex:at-unit-7-or-9 a elg:Condition ;
    elg:conditionKey "loss-at-unit-7-or-9" ;
    elg:matchStrategy elg:SetMembership ;
    elg:compatibilityOperation elg:AnySufficient ;
    elg:wildcardSemantics elg:NoWildcard ;
    elg:requiredConcept ex:unit-7 , ex:unit-9 .

# ==== Stated meaning: each version of clause 2.1 ==============================

ex:term-2-1-v1 a ins:Term , ins:Template ; ins:expressedIn ex:cl-2-1-v1 .
ex:indemnify-v1 a ins:Obligation , ins:Template ;
    ins:arisesUnder ex:term-2-1-v1 ;
    ins:obligor ex:Insurer ; ins:obligee ex:Insured ;
    ins:activity ins-voc:Indemnify ;
    ins:scope ex:at-unit-7 .

ex:term-2-1-v2 a ins:Term , ins:Template ; ins:expressedIn ex:cl-2-1-v2 .
ex:indemnify-v2 a ins:Obligation , ins:Template ;
    ins:arisesUnder ex:term-2-1-v2 ;
    ins:obligor ex:Insurer ; ins:obligee ex:Insured ;
    ins:activity ins-voc:Indemnify ;
    ins:scope ex:at-unit-7-or-9 .

# ==== The policy, its two versions and the MTA ================================

ex:kestrel a pty:Actor , prov:Agent ; rdfs:label "Kestrel Insurance plc" .
ex:fenmoor a pty:Actor , prov:Agent ; rdfs:label "Fenmoor Distribution Ltd" .
ex:broker-desk a prov:Agent ; rdfs:label "the placing broker's records" .

ex:insurer-occ a pty:RoleOccupancy ; fnd:hasIdentity ex:insurer-occ-identity ;
    pty:inRole ex:Insurer ; pty:occupiedBy ex:kestrel .
ex:insured-occ a pty:RoleOccupancy ; fnd:hasIdentity ex:insured-occ-identity ;
    pty:inRole ex:Insured ; pty:occupiedBy ex:fenmoor .

ex:policy-v1 a ins:Instrument ;
    fnd:hasIdentity ex:policy-identity ;
    ins:expressedIn ex:wording-v1 ;
    ins:party ex:insurer-occ , ex:insured-occ .

ex:policy-v2 a ins:Instrument ;
    fnd:hasIdentity ex:policy-identity ;
    ins:expressedIn ex:wording-v2 ;
    ins:party ex:insurer-occ , ex:insured-occ .
ex:policy-v1 fnd:supersededBy ex:policy-v2 .

# Recorded on the request, 20 February, effective 1 March.
ex:mta-1 a ins:Amendment ;
    ins:amends ex:policy-v1 ; ins:resultsIn ex:policy-v2 ;
    ins:statedIn ex:endorsement-1 ;
    ins:affectsExisting false ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2028-03-01T00:00:00Z"^^xsd:dateTime ] ;
    fnd:hasEvidence [ a fnd:Evidence ;
        fnd:recordedAt "2028-02-20T11:00:00Z"^^xsd:dateTime ; fnd:assertedBy ex:broker-desk ] .

ex:assent-insured a ins:Assent ; ins:assentBy ex:insured-occ ; ins:assentTo ex:policy-v2 ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2028-02-20T10:30:00Z"^^xsd:dateTime ] ;
    fnd:hasEvidence [ a fnd:Evidence ;
        fnd:recordedAt "2028-02-20T11:00:00Z"^^xsd:dateTime ; fnd:assertedBy ex:broker-desk ] .

# The last assent: the MTA is agreed from 10 March.
ex:assent-insurer a ins:Assent ; ins:assentBy ex:insurer-occ ; ins:assentTo ex:policy-v2 ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2028-03-10T14:00:00Z"^^xsd:dateTime ] ;
    fnd:hasEvidence [ a fnd:Evidence ;
        fnd:recordedAt "2028-03-10T14:05:00Z"^^xsd:dateTime ; fnd:assertedBy ex:broker-desk ] .

# ==== The losses, as the claims file records them =============================
#
# The example's own record of each loss: where, when it happened (valid time)
# and when it was notified (recorded). Which version decides each is the table
# in the header.

ex:at a rdf:Property ; rdfs:label "at" ; rdfs:comment "Where a loss happened. The example's own property." .

ex:loss-a ex:at ex:unit-9 ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2028-02-25T03:00:00Z"^^xsd:dateTime ] ;
    fnd:hasEvidence [ a fnd:Evidence ; fnd:recordedAt "2028-02-26T09:00:00Z"^^xsd:dateTime ] .
ex:loss-b ex:at ex:unit-9 ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2028-03-05T22:00:00Z"^^xsd:dateTime ] ;
    fnd:hasEvidence [ a fnd:Evidence ; fnd:recordedAt "2028-03-06T08:30:00Z"^^xsd:dateTime ] .
ex:loss-c ex:at ex:unit-9 ;
    fnd:hasTemporalScope [ a fnd:TemporalScope ; fnd:validFrom "2028-03-20T13:00:00Z"^^xsd:dateTime ] ;
    fnd:hasEvidence [ a fnd:Evidence ; fnd:recordedAt "2028-03-21T10:00:00Z"^^xsd:dateTime ] .

# ==== Generated bound meaning: the expected output, not stored (D4) ===========

ex:v1-term-2-1 a ins:Term ; ins:boundIn ex:policy-v1 ; ins:boundFrom ex:term-2-1-v1 .
ex:v1-indemnify a ins:Obligation ;
    ins:boundFrom ex:indemnify-v1 ; ins:arisesUnder ex:v1-term-2-1 ;
    ins:obligor ex:insurer-occ ; ins:obligee ex:insured-occ ;
    ins:activity ins-voc:Indemnify ;
    ins:scope ex:at-unit-7 .

ex:v2-term-2-1 a ins:Term ; ins:boundIn ex:policy-v2 ; ins:boundFrom ex:term-2-1-v2 .
ex:v2-indemnify a ins:Obligation ;
    ins:boundFrom ex:indemnify-v2 ; ins:arisesUnder ex:v2-term-2-1 ;
    ins:obligor ex:insurer-occ ; ins:obligee ex:insured-occ ;
    ins:activity ins-voc:Indemnify ;
    ins:scope ex:at-unit-7-or-9 .
