# SPDX-License-Identifier: MPL-2.0

@prefix dct: <http://purl.org/dc/terms/> .
@prefix fnd: <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix voc: <https://www.nebularis.org/neuro-semantic/lattice/vocabulary#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

voc:BindingClosureShape a sh:NodeShape ;
    sh:targetClass voc:BindingClosure ;
    sh:property [ sh:path voc:closedAt ; sh:minCount 1 ; sh:maxCount 1 ], [ sh:path voc:closesBinding ; sh:minCount 1 ; sh:maxCount 1 ] .

voc:ConceptSchemeShape a sh:NodeShape ;
    sh:targetClass voc:ConceptScheme ;
    sh:property [ sh:path fnd:hasGovernanceState ; sh:minCount 1 ; sh:maxCount 1 ], [ sh:path fnd:hasIdentity ; sh:minCount 1 ; sh:maxCount 1 ] .

voc:SchemeBindingShape a sh:NodeShape ;
    sh:targetClass voc:SchemeBinding ;
    sh:property [ sh:path fnd:hasTemporalScope ; sh:minCount 1 ; sh:maxCount 1 ], [ sh:path voc:bindsScheme ; sh:minCount 1 ; sh:maxCount 1 ], [ sh:path voc:forContract ; sh:minCount 1 ; sh:maxCount 1 ] .

voc:SchemeContractShape a sh:NodeShape ;
    sh:targetClass voc:SchemeContract ;
    sh:property [ sh:path fnd:hasGovernanceState ; sh:minCount 1 ; sh:maxCount 1 ], [ sh:path fnd:hasIdentity ; sh:minCount 1 ; sh:maxCount 1 ], [ sh:path voc:boundScheme ; sh:maxCount 1 ], [ sh:path voc:constrainsProperty ; sh:minCount 1 ] .
