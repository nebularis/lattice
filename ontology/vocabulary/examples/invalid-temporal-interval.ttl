# SPDX-License-Identifier: MPL-2.0

# Negative fixture. A voc:SchemeBinding whose temporal scope ends before it
# begins. Violates voc:TemporalIntervalOrderShape (constraints.ttl).
# Covers VTB-04.

@prefix fnd:  <https://www.nebularis.org/neuro-semantic/lattice/foundation#> .
@prefix voc:  <https://www.nebularis.org/neuro-semantic/lattice/vocabulary#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/lattice/vocabulary/examples#> .

ex:bad-interval-contract a voc:SchemeContract ;
    fnd:hasIdentity ex:bad-interval-contract-identity ;
    fnd:hasGovernanceState fnd:Active ;
    voc:constrainsProperty ex:hasCategory ;
    voc:requiresGovernanceState fnd:Active .

ex:bad-interval-scheme a voc:ConceptScheme ;
    fnd:hasIdentity ex:bad-interval-scheme-identity ;
    fnd:hasGovernanceState fnd:Active ;
    skos:prefLabel "Category scheme"@en .

ex:bad-interval-binding a voc:SchemeBinding ;
    voc:forContract ex:bad-interval-contract ;
    voc:bindsScheme ex:bad-interval-scheme ;
    fnd:hasTemporalScope [
        a fnd:TemporalScope ;
        fnd:validFrom "2026-07-01T00:00:00Z"^^xsd:dateTime ;
        fnd:validTo   "2026-01-01T00:00:00Z"^^xsd:dateTime
    ] .
