# SPDX-License-Identifier: CC-BY-SA-4.0
PREFIX ldg: <https://www.nebularis.org/neuro-semantic/lattice/ledger#>
PREFIX qnt: <https://www.nebularis.org/neuro-semantic/lattice/quantification#>

# question amounts: Which account definitions state their amount as a quantity with a value?
SELECT ?account ?value WHERE { ?account a ldg:AccountDefinition ; ldg:statedAmount ?amount . ?amount qnt:numericValue ?value . }

# question units: Which account definitions state their unit of account?
SELECT ?account ?unit WHERE { ?account a ldg:AccountDefinition ; ldg:unitOfAccount ?unit . }

# question parts: Which account definitions are part of another, a sublimit within a limit?
SELECT ?part ?whole WHERE { ?part a ldg:AccountDefinition ; ldg:partOf ?whole . }

# question owners: Which account definitions say what kind of owner they admit?
SELECT ?account ?kind WHERE { ?account a ldg:AccountDefinition ; ldg:admitsOwnerKind ?kind . }

# question closing: Which ledger profiles state the recurrence at whose boundaries their accounts' books close?
SELECT ?profile ?recurrence WHERE { ?profile a ldg:LedgerProfile ; ldg:closingRecurrence ?recurrence . }

# question period: Which account definitions state a recurrence whose periods each have an account of their own?
SELECT ?account ?recurrence WHERE { ?account a ldg:AccountDefinition ; ldg:periodRecurrence ?recurrence . }

# question ceiling: Which account definitions state a ceiling above which a credit may not restore them?
SELECT ?account ?ceiling WHERE { ?account a ldg:AccountDefinition ; ldg:creditCeiling ?ceiling . }

# question purposes: Which account definitions state a purpose that, when a draw names it, also debits them outside their path?
SELECT ?account ?purpose WHERE { ?account a ldg:AccountDefinition ; ldg:countsPurpose ?purpose . }

# question restoring-kinds: Which account definitions state the kinds of credit that restore them?
SELECT ?account ?kind WHERE { ?account a ldg:AccountDefinition ; ldg:restoredBy ?kind . }
