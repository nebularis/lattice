# Default: normalize everything to LF in the repo, checkout as LF too.
* text=auto eol=lf

# Explicit text types (belt-and-braces, in case autodetection misses one)
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.ttl     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.java    text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.sh      text eol=lf
*.toml    text eol=lf
Dockerfile text eol=lf

# Windows-specific scripts that genuinely need CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files — never touch line endings, never diff as text
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.jar     binary
